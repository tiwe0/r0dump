+      String forceMethod,
+      String forceMethodDescriptor,
+      long forceMaxCalls) {
+    boolean configured =
+        r0dump_configureNative(
+            schema,
+            enabled,
+            runId,
+            targetPackage,
+            targetProcess,
+            processName,
+            outputParent,
+            preparedDirectoryFd,
+            capturePointMask,
+            maxRecords,
+            maxArtifacts,
+            maxTotalBytes,
+            maxDexBytes,
+            bufferPoolBytes,
+            maxCodeItemBytes,
+            maxFrozenGenerations,
+            flushIdleMs,
+            manifestEnabled,
+            manifestIncludeSplits,
+            manifestMaxComponents,
+            manifestMaxSplits,
+            manifestMaxEventsPerSource,
+            manifestMaxTotalEvents,
+            manifestMaxXmlDepth,
+            manifestMaxAttributeLength,
+            walkEnabled,
+            walkStart,
+            walkMode,
+            walkNamespacePrefix,
+            walkDelayMs,
+            walkMaxClasses,
+            walkMaxMethods,
+            forceInvokeEnabled,
+            forceClass,
+            forceMethod,
+            forceMethodDescriptor,
+            forceMaxCalls);
