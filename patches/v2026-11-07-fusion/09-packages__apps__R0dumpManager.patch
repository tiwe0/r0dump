+#include "r0dump_file_helper_core.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <sys/fsuid.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <array>
+#include <string>
+
+namespace r0dump::file_helper {
+namespace {
+
+constexpr mode_t kDirectoryMode = 02770;
+
+class ScopedFd final {
+public:
+  explicit ScopedFd(int fd = -1) : fd_(fd) {}
+  ~ScopedFd() {
+    if (fd_ >= 0)
+      close(fd_);
+  }
+  ScopedFd(const ScopedFd &) = delete;
+  ScopedFd &operator=(const ScopedFd &) = delete;
+  ScopedFd(ScopedFd &&other) noexcept : fd_(other.release()) {}
+  ScopedFd &operator=(ScopedFd &&other) noexcept {
+    if (this != &other) {
+      if (fd_ >= 0)
+        close(fd_);
+      fd_ = other.release();
+    }
+    return *this;
+  }
+  int get() const { return fd_; }
+  int release() {
+    int result = fd_;
+    fd_ = -1;
+    return result;
+  }
+
+private:
+  int fd_;
+};
+
+bool IsAsciiAlpha(char c) {
+  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+}
+
+bool IsAsciiDigit(char c) { return c >= '0' && c <= '9'; }
+
+Status StatusForErrno(int error) {
+  if (error == EACCES || error == EPERM)
+    return Status::kPermissionDenied;
+  if (error == ENOENT || error == ENOTDIR || error == ENODEV) {
+    return Status::kStorageUnavailable;
+  }
+  if (error == EEXIST)
+    return Status::kExists;
+  return Status::kInternalError;
+}
+
+ScopedFd OpenDirectoryAt(int parent_fd, std::string_view name) {
+  std::string owned(name);
+  return ScopedFd(openat(parent_fd, owned.c_str(),
+                         O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+}
+
+ScopedFd OpenDirectoryPathAt(int parent_fd, std::string_view name) {
+  std::string owned(name);
+  return ScopedFd(openat(parent_fd, owned.c_str(),
+                         O_PATH | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+}
+
+ScopedFd OpenDirectoryAtAsUid(int parent_fd, std::string_view name,
+                              uid_t access_uid) {
+  ScopedFd opened = OpenDirectoryAt(parent_fd, name);
+  if (opened.get() >= 0 || (errno != EACCES && errno != EPERM) ||
+      access_uid == geteuid()) {
+    return opened;
+  }
+
+  const uid_t original_fsuid = static_cast<uid_t>(setfsuid(access_uid));
+  if (static_cast<uid_t>(setfsuid(static_cast<uid_t>(-1))) != access_uid) {
+    setfsuid(original_fsuid);
+    errno = EACCES;
+    return ScopedFd();
+  }
+  opened = OpenDirectoryAt(parent_fd, name);
+  const int saved_errno = errno;
+  setfsuid(original_fsuid);
+  if (static_cast<uid_t>(setfsuid(static_cast<uid_t>(-1))) !=
+      original_fsuid) {
+    errno = EPERM;
+    return ScopedFd();
+  }
+  errno = saved_errno;
+  return opened;
+}
+
+Status OpenExistingAt(int parent_fd, std::string_view name, ScopedFd *out) {
+  ScopedFd opened = OpenDirectoryAt(parent_fd, name);
+  if (opened.get() < 0)
+    return StatusForErrno(errno);
+  *out = std::move(opened);
+  return Status::kOk;
+}
+
+Status EnsureDirectoryAt(int parent_fd, std::string_view name, uid_t uid,
+                         gid_t gid, uid_t access_uid, ScopedFd *out) {
+  std::string owned(name);
+  if (mkdirat(parent_fd, owned.c_str(), kDirectoryMode) != 0 &&
+      errno != EEXIST) {
+    return StatusForErrno(errno);
+  }
+  ScopedFd opened = OpenDirectoryAtAsUid(parent_fd, name, access_uid);
+  if (opened.get() < 0)
+    return StatusForErrno(errno);
+  if (fchown(opened.get(), uid, gid) != 0 ||
+      fchmod(opened.get(), kDirectoryMode) != 0) {
+    return StatusForErrno(errno);
+  }
+  struct stat st{};
+  if (fstat(opened.get(), &st) != 0 || !S_ISDIR(st.st_mode) ||
+      st.st_uid != uid || st.st_gid != gid ||
+      (st.st_mode & 02777) != kDirectoryMode) {
+    return Status::kPermissionDenied;
+  }
+  *out = std::move(opened);
+  return Status::kOk;
+}
+
+Status CreateOrVerifyTrustedDirectoryAt(int parent_fd, std::string_view name,
+                                        uid_t uid, gid_t gid, ScopedFd *out) {
+  std::string owned(name);
+  bool created = false;
+  if (mkdirat(parent_fd, owned.c_str(), kDirectoryMode) == 0) {
+    created = true;
+  } else if (errno != EEXIST) {
+    return StatusForErrno(errno);
+  }
+
+  ScopedFd opened = OpenDirectoryAt(parent_fd, name);
+  if (opened.get() < 0) {
+    return StatusForErrno(errno);
+  }
+  if (created && (fchown(opened.get(), uid, gid) != 0 ||
+                  fchmod(opened.get(), kDirectoryMode) != 0)) {
+    const int saved_errno = errno;
+    opened = ScopedFd();
+    unlinkat(parent_fd, owned.c_str(), AT_REMOVEDIR);
+    return StatusForErrno(saved_errno);
+  }
+
+  struct stat st{};
+  if (fstat(opened.get(), &st) != 0 || !S_ISDIR(st.st_mode) ||
+      st.st_uid != uid || st.st_gid != gid ||
+      (st.st_mode & 02777) != kDirectoryMode) {
+    if (created) {
+      opened = ScopedFd();
+      unlinkat(parent_fd, owned.c_str(), AT_REMOVEDIR);
+    }
+    return Status::kPermissionDenied;
+  }
+  *out = std::move(opened);
+  return Status::kOk;
+}
+
+Status CreateExclusiveDirectoryAt(int parent_fd, std::string_view name,
+                                  uid_t uid, gid_t gid, ScopedFd *out) {
+  std::string owned(name);
+  if (mkdirat(parent_fd, owned.c_str(), kDirectoryMode) != 0)
+    return StatusForErrno(errno);
+  ScopedFd opened = OpenDirectoryAt(parent_fd, name);
+  if (opened.get() < 0) {
+    unlinkat(parent_fd, owned.c_str(), AT_REMOVEDIR);
+    return StatusForErrno(errno);
+  }
+  if (fchown(opened.get(), uid, gid) != 0 ||
+      fchmod(opened.get(), kDirectoryMode) != 0) {
+    const int saved_errno = errno;
+    opened = ScopedFd();
+    unlinkat(parent_fd, owned.c_str(), AT_REMOVEDIR);
+    return StatusForErrno(saved_errno);
+  }
+  struct stat st{};
+  if (fstat(opened.get(), &st) != 0 || !S_ISDIR(st.st_mode) ||
+      st.st_uid != uid || st.st_gid != gid ||
+      (st.st_mode & 02777) != kDirectoryMode) {
+    opened = ScopedFd();
+    unlinkat(parent_fd, owned.c_str(), AT_REMOVEDIR);
+    return Status::kPermissionDenied;
+  }
+  *out = std::move(opened);
+  return Status::kOk;
+}
+
+void RemovePreparedBranch(int process_fd, int run_fd,
+                          std::string_view process_name) {
+  static constexpr std::array<std::string_view, 4> kFixedDirectories = {
+      "metadata", "artifacts", "records", "methods"};
+  for (std::string_view directory : kFixedDirectories) {
+    std::string owned(directory);
+    unlinkat(process_fd, owned.c_str(), AT_REMOVEDIR);
+  }
+  std::string owned(process_name);
+  unlinkat(run_fd, owned.c_str(), AT_REMOVEDIR);
+}
+
+} // namespace
+
+bool IsValidPackageName(std::string_view value) {
+  if (value.empty() || value.size() >= kPackageBytes || value.front() == '.' ||
+      value.back() == '.') {
+    return false;
+  }
+  bool has_dot = false;
+  for (char c : value) {
+    if (c == '.') {
+      has_dot = true;
+    } else if (!IsAsciiAlpha(c) && !IsAsciiDigit(c) && c != '_') {
+      return false;
+    }
+  }
+  return has_dot;
+}
+
+bool IsValidProcessName(std::string_view value) {
+  if (value.empty() || value.size() >= kProcessBytes)
+    return false;
+  for (char c : value) {
+    if (!IsAsciiAlpha(c) && !IsAsciiDigit(c) && c != '_' && c != '.' &&
+        c != ':')
+      return false;
+  }
+  return true;
+}
+
+bool IsValidRunId(std::string_view value) {
+  if (value.empty() || value.size() >= kRunIdBytes || value == "." ||
+      value == "..")
+    return false;
+  for (char c : value) {
+    if (!IsAsciiAlpha(c) && !IsAsciiDigit(c) && c != '_' && c != '.' &&
+        c != '-')
+      return false;
+  }
+  return true;
+}
+
+bool ReadFixedString(const char *value, size_t capacity,
+                     std::string_view *out) {
+  if (value == nullptr || out == nullptr || capacity == 0u)
+    return false;
+  size_t length = 0u;
+  while (length < capacity && value[length] != '\0')
+    ++length;
+  if (length == 0u || length == capacity)
+    return false;
+  for (size_t i = length + 1u; i < capacity; ++i) {
+    if (value[i] != '\0')
+      return false;
+  }
+  *out = std::string_view(value, length);
+  return true;
+}
+
+Status PrepareDirectoryTreeAt(int root_fd, const Request &request,
+                              const Ownership &ownership, int *out_process_fd) {
+  if (root_fd < 0 || out_process_fd == nullptr || request.user_id != 0u ||
+      request.target_uid == 0u || request.target_pid == 0u) {
+    return Status::kProtocolError;
+  }
+  *out_process_fd = -1;
+  std::string_view package_name;
+  std::string_view process_name;
+  std::string_view run_id;
+  if (!ReadFixedString(request.package_name, sizeof(request.package_name),
+                       &package_name) ||
+      !ReadFixedString(request.process_name, sizeof(request.process_name),
+                       &process_name) ||
+      !ReadFixedString(request.run_id, sizeof(request.run_id), &run_id) ||
+      !IsValidPackageName(package_name) || !IsValidProcessName(process_name) ||
+      !IsValidRunId(run_id)) {
+    return Status::kProtocolError;
+  }
+
+  ScopedFd android_directory;
+  ScopedFd data_directory;
+  ScopedFd package_directory;
+  ScopedFd files_directory;
+  Status status = OpenExistingAt(root_fd, "Android", &android_directory);
+  if (status != Status::kOk)
+    return status;
+  status = OpenExistingAt(android_directory.get(), "data", &data_directory);
+  if (status != Status::kOk)
+    return status;
+  status =
+      OpenExistingAt(data_directory.get(), package_name, &package_directory);
+  if (status != Status::kOk)
+    return status;
+  status = OpenExistingAt(package_directory.get(), "files", &files_directory);
+  if (status != Status::kOk)
+    return status;
+
+  ScopedFd fusion_directory;
+  ScopedFd runs_directory;
+  ScopedFd run_directory;
+  status =
+      EnsureDirectoryAt(files_directory.get(), "r0dump-fusion",
+                        ownership.shared_uid, ownership.gid,
+                        ownership.process_uid, &fusion_directory);
+  if (status != Status::kOk)
+    return status;
+  status =
+      EnsureDirectoryAt(fusion_directory.get(), "runs", ownership.shared_uid,
+                        ownership.gid, ownership.process_uid, &runs_directory);
+  if (status != Status::kOk)
+    return status;
+  status = CreateOrVerifyTrustedDirectoryAt(
+      runs_directory.get(), run_id, ownership.shared_uid, ownership.gid,
+      &run_directory);
+  if (status != Status::kOk)
+    return status;
+
+  char process_directory_name[32];
+  const int length =
+      snprintf(process_directory_name, sizeof(process_directory_name),
+               "process-%u", request.target_pid);
+  if (length <= 0 ||
+      static_cast<size_t>(length) >= sizeof(process_directory_name)) {
+    return Status::kProtocolError;
+  }
+  ScopedFd process_directory;
+  status = CreateExclusiveDirectoryAt(
+      run_directory.get(), process_directory_name, ownership.process_uid,
+      ownership.gid, &process_directory);
+  if (status != Status::kOk)
+    return status;
+
+  static constexpr std::array<std::string_view, 4> kFixedDirectories = {
+      "metadata", "artifacts", "records", "methods"};
+  for (std::string_view directory : kFixedDirectories) {
+    ScopedFd ignored;
+    status = CreateExclusiveDirectoryAt(process_directory.get(), directory,
+                                        ownership.process_uid, ownership.gid,
+                                        &ignored);
+    if (status != Status::kOk) {
+      RemovePreparedBranch(process_directory.get(), run_directory.get(),
+                           process_directory_name);
+      return status;
+    }
+  }
+  ScopedFd transfer_directory =
+      OpenDirectoryPathAt(run_directory.get(), process_directory_name);
+  if (transfer_directory.get() < 0)
+    return StatusForErrno(errno);
+  struct stat writable_stat{};
+  struct stat transfer_stat{};
+  if (fstat(process_directory.get(), &writable_stat) != 0 ||
+      fstat(transfer_directory.get(), &transfer_stat) != 0 ||
+      writable_stat.st_dev != transfer_stat.st_dev ||
+      writable_stat.st_ino != transfer_stat.st_ino) {
+    return Status::kPermissionDenied;
+  }
+  *out_process_fd = transfer_directory.release();
+  return Status::kOk;
+}
+
+} // namespace r0dump::file_helper
diff --git a/helper/r0dump_file_helper_core.h b/helper/r0dump_file_helper_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..64ccd531466e471bd63e76fc4bcb9878317effe8
--- /dev/null
+++ b/helper/r0dump_file_helper_core.h
@@ -0,0 +1,31 @@
+#ifndef R0DUMP_FILE_HELPER_CORE_H_
+#define R0DUMP_FILE_HELPER_CORE_H_
+
+#include <sys/types.h>
+
+#include <string_view>
+
+#include "r0dump_file_helper_protocol.h"
+
+namespace r0dump::file_helper {
+
+struct Ownership {
+  uid_t shared_uid;
+  uid_t process_uid;
+  gid_t gid;
+};
+
+bool IsValidPackageName(std::string_view value);
+bool IsValidProcessName(std::string_view value);
+bool IsValidRunId(std::string_view value);
+bool ReadFixedString(const char *value, size_t capacity, std::string_view *out);
+
+// root_fd must refer to /mnt/user/0/emulated/0 in production. On success,
+// returns an O_PATH|O_DIRECTORY|O_CLOEXEC descriptor for the new
+// process-<pid> directory in out_process_fd.
+Status PrepareDirectoryTreeAt(int root_fd, const Request &request,
+                              const Ownership &ownership, int *out_process_fd);
+
+} // namespace r0dump::file_helper
+
+#endif // R0DUMP_FILE_HELPER_CORE_H_
diff --git a/helper/r0dump_file_helper_protocol.h b/helper/r0dump_file_helper_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..2c642c02959966f59da6c2181f554620b1f3e463
--- /dev/null
+++ b/helper/r0dump_file_helper_protocol.h
@@ -0,0 +1,95 @@
+#ifndef R0DUMP_FILE_HELPER_PROTOCOL_H_
+#define R0DUMP_FILE_HELPER_PROTOCOL_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace r0dump::file_helper {
+
+inline constexpr uint32_t kProtocolMagic = 0x52304648u; // R0FH
+inline constexpr uint16_t kProtocolVersion = 1u;
+inline constexpr uint32_t kExportProtocolMagic = 0x52304558u; // R0EX
+inline constexpr uint16_t kExportProtocolVersion = 1u;
+inline constexpr uint32_t kExportResponseMagic = 0x52304552u; // R0ER
+inline constexpr size_t kPackageBytes = 96u;
+inline constexpr size_t kProcessBytes = 96u;
+inline constexpr size_t kRunIdBytes = 65u;
+inline constexpr size_t kArchivePathBytes = 256u;
+inline constexpr size_t kSha256Bytes = 65u;
+inline constexpr size_t kExportDetailBytes = 256u;
+
+enum class Status : int32_t {
+  kOk = 0,
+  kInvalidCaller = 1,
+  kDisabled = 2,
+  kConfigMismatch = 3,
+  kStorageUnavailable = 4,
+  kExists = 5,
+  kPermissionDenied = 6,
+  kTimeout = 7,
+  kProtocolError = 8,
+  kInternalError = 9,
+  kNoRuns = 10,
+  kBusy = 11,
+  kRepairFailed = 12,
+  kArchiveFailed = 13,
+};
+
+#pragma pack(push, 1)
+struct Request {
+  uint32_t magic;
+  uint16_t version;
+  uint16_t size;
+  uint64_t generation;
+  uint32_t user_id;
+  uint32_t target_uid;
+  uint32_t target_pid;
+  char package_name[kPackageBytes];
+  char process_name[kProcessBytes];
+  char run_id[kRunIdBytes];
+};
+
+struct Response {
+  uint32_t magic;
+  uint16_t version;
+  uint16_t size;
+  int32_t status;
+};
+
+struct ExportRequest {
+  uint32_t magic;
+  uint16_t version;
+  uint16_t size;
+  uint32_t user_id;
+  uint32_t requester_uid;
+  uint32_t apk_count;
+  char package_name[kPackageBytes];
+};
+
+struct ExportResponse {
+  uint32_t magic;
+  uint16_t version;
+  uint16_t size;
+  int32_t status;
+  uint32_t remote_artifact_count;
+  uint32_t record_count;
+  uint32_t verified;
+  uint32_t repaired;
+  uint32_t partial;
+  uint32_t usable_outputs;
+  uint32_t codeitems_backfilled;
+  char run_id[kRunIdBytes];
+  char archive_path[kArchivePathBytes];
+  char sha256[kSha256Bytes];
+  char detail[kExportDetailBytes];
+};
+#pragma pack(pop)
+
+static_assert(sizeof(Request) == 285u);
+static_assert(sizeof(Response) == 12u);
+static_assert(sizeof(ExportRequest) == 116u);
+static_assert(sizeof(ExportResponse) == 682u);
+
+} // namespace r0dump::file_helper
+
+#endif // R0DUMP_FILE_HELPER_PROTOCOL_H_
diff --git a/helper/r0dump_file_helper_test.cpp b/helper/r0dump_file_helper_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..85105b1a84789022a8df47b938686dffc8f6aff7
--- /dev/null
+++ b/helper/r0dump_file_helper_test.cpp
@@ -0,0 +1,277 @@
+#include "r0dump_export_core.h"
+#include "r0dump_file_helper_core.h"
+
+#include <fcntl.h>
+#include <gtest/gtest.h>
+#include <json/json.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <ziparchive/zip_archive.h>
+#include <ziparchive/zip_writer.h>
+
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace r0dump::file_helper {
+namespace {
+
+class HelperTest : public testing::Test {
+protected:
+  void SetUp() override {
+    char templ[] = "/tmp/r0dump-helper-XXXXXX";
+    root_ = mkdtemp(templ);
+    ASSERT_FALSE(root_.empty());
+    std::filesystem::create_directories(
+        root_ + "/Android/data/com.example.target/files");
+    root_fd_ = open(root_.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    ASSERT_GE(root_fd_, 0);
+  }
+
+  void TearDown() override {
+    if (root_fd_ >= 0)
+      close(root_fd_);
+    std::filesystem::remove_all(root_);
+  }
+
+  Request RequestFor(uint32_t pid = 1234u) {
+    Request request = {};
+    request.magic = kProtocolMagic;
+    request.version = kProtocolVersion;
+    request.size = static_cast<uint16_t>(sizeof(Request));
+    request.generation = 2u;
+    request.user_id = 0u;
+    request.target_uid = 10001u;
+    request.target_pid = pid;
+    strcpy(request.package_name, "com.example.target");
+    strcpy(request.process_name, "com.example.target:worker");
+    strcpy(request.run_id, "run-1");
+    return request;
+  }
+
+  std::string root_;
+  int root_fd_ = -1;
+};
+
+mode_t Mode(const std::string &path) {
+  struct stat st{};
+  EXPECT_EQ(stat(path.c_str(), &st), 0);
+  return st.st_mode & 02777;
+}
+
+TEST_F(HelperTest, CreatesSetgidTreeAndReturnsProcessDirectory) {
+  int process_fd = -1;
+  EXPECT_EQ(PrepareDirectoryTreeAt(root_fd_, RequestFor(),
+                                   {geteuid(), geteuid(), getegid()},
+                                   &process_fd),
+            Status::kOk);
+  ASSERT_GE(process_fd, 0);
+  struct stat st{};
+  ASSERT_EQ(fstat(process_fd, &st), 0);
+  EXPECT_TRUE(S_ISDIR(st.st_mode));
+  EXPECT_EQ(fcntl(process_fd, F_GETFL) & O_PATH, O_PATH);
+  EXPECT_EQ(st.st_gid, getegid());
+  EXPECT_EQ(st.st_mode & 02777, static_cast<mode_t>(02770));
+  close(process_fd);
+
+  const std::string run =
+      root_ + "/Android/data/com.example.target/files/r0dump-fusion/runs/run-1";
+  EXPECT_EQ(Mode(run), static_cast<mode_t>(02770));
+  const std::string process = run + "/process-1234";
+  EXPECT_EQ(Mode(process), static_cast<mode_t>(02770));
+  for (const char *name : {"metadata", "artifacts", "records", "methods"}) {
+    EXPECT_EQ(Mode(process + "/" + name), static_cast<mode_t>(02770));
+  }
+}
+
+TEST_F(HelperTest, AcceptsSystemUidForTargetProcess) {
+  Request request = RequestFor();
+  request.target_uid = 1000u;
+  int process_fd = -1;
+  EXPECT_EQ(PrepareDirectoryTreeAt(root_fd_, request,
+                                   {geteuid(), geteuid(), getegid()},
+                                   &process_fd),
+            Status::kOk);
+  EXPECT_GE(process_fd, 0);
+  close(process_fd);
+}
+
+TEST_F(HelperTest, RejectsZeroTargetUid) {
+  Request request = RequestFor();
+  request.target_uid = 0u;
+  int process_fd = -1;
+  EXPECT_EQ(PrepareDirectoryTreeAt(root_fd_, request,
+                                   {geteuid(), geteuid(), getegid()},
+                                   &process_fd),
+            Status::kProtocolError);
+  EXPECT_EQ(process_fd, -1);
+}
+
+TEST_F(HelperTest, RejectsDuplicateProcessDirectoryWithoutReusingIt) {
+  int process_fd = -1;
+  Request request = RequestFor();
+  ASSERT_EQ(PrepareDirectoryTreeAt(root_fd_, request,
+                                   {geteuid(), geteuid(), getegid()},
+                                   &process_fd),
+            Status::kOk);
+  close(process_fd);
+  process_fd = -1;
+  EXPECT_EQ(PrepareDirectoryTreeAt(root_fd_, request,
+                                   {geteuid(), geteuid(), getegid()},
+                                   &process_fd),
+            Status::kExists);
+  EXPECT_EQ(process_fd, -1);
+}
+
+TEST_F(HelperTest, RejectsExistingRunWithUntrustedOwnershipWithoutRepairingIt) {
+  const std::string run =
+      root_ + "/Android/data/com.example.target/files/r0dump-fusion/runs/run-1";
+  std::filesystem::create_directories(run);
+  ASSERT_EQ(chmod(run.c_str(), 0755), 0);
+
+  struct stat before{};
+  ASSERT_EQ(stat(run.c_str(), &before), 0);
+  int process_fd = -1;
+  EXPECT_EQ(PrepareDirectoryTreeAt(root_fd_, RequestFor(),
+                                   {geteuid(), geteuid(), getegid()},
+                                   &process_fd),
+            Status::kPermissionDenied);
+  EXPECT_EQ(process_fd, -1);
+
+  struct stat after{};
+  ASSERT_EQ(stat(run.c_str(), &after), 0);
+  EXPECT_EQ(after.st_uid, before.st_uid);
+  EXPECT_EQ(after.st_gid, before.st_gid);
+  EXPECT_EQ(after.st_mode & 02777, before.st_mode & 02777);
+  EXPECT_FALSE(std::filesystem::exists(run + "/process-1234"));
+}
+
+TEST_F(HelperTest, RejectsSymlinkInTrustedPath) {
+  std::filesystem::remove_all(root_ + "/Android/data/com.example.target");
+  ASSERT_EQ(
+      symlink("/tmp", (root_ + "/Android/data/com.example.target").c_str()), 0);
+  int process_fd = -1;
+  EXPECT_NE(PrepareDirectoryTreeAt(root_fd_, RequestFor(),
+                                   {geteuid(), geteuid(), getegid()},
+                                   &process_fd),
+            Status::kOk);
+  EXPECT_EQ(process_fd, -1);
+}
+
+TEST_F(HelperTest, RejectsPathLikeRunId) {
+  Request request = RequestFor();
+  strcpy(request.run_id, "../escape");
+  int process_fd = -1;
+  EXPECT_EQ(PrepareDirectoryTreeAt(root_fd_, request,
+                                   {geteuid(), geteuid(), getegid()},
+                                   &process_fd),
+            Status::kProtocolError);
+}
+
+TEST_F(HelperTest, ExportLatestPackagesRepairReportApkAndManifest) {
+  const std::string process =
+      root_ + "/Android/data/com.example.target/files/r0dump-fusion/runs/"
+              "run-1/process-1234";
+  std::filesystem::create_directories(process + "/artifacts");
+  std::filesystem::create_directories(process + "/records");
+  std::ofstream(process + "/session.json") << "{}\n";
+  std::ofstream(process + "/artifacts/bad.dex", std::ios::binary)
+      << "not-a-dex";
+  std::ofstream(process + "/artifacts/before.codeitem.raw", std::ios::binary)
+      << "before";
+  std::ofstream(process + "/artifacts/nterp.codeitem.raw", std::ios::binary)
+      << "after";
+  std::ofstream(process + "/records/000001.json")
+      << R"({"capture_kind":"dexfile","artifact_relative_path":"artifacts/bad.dex","site":"test","capture_point_name":"test.point"})"
+      << "\n";
+  std::ofstream(process + "/records/000002.json")
+      << R"({"capture_kind":"codeitem","artifact_relative_path":"artifacts/before.codeitem.raw","artifact_fast_hash":"1111","dex_object_id":99,"method_index":7,"active_attempt_id":3,"entry_kind":"nterp","observation_phase":"before_dispatch"})"
+      << "\n";
+  std::ofstream(process + "/records/000003.json")
+      << R"({"capture_kind":"codeitem","artifact_relative_path":"artifacts/nterp.codeitem.raw","artifact_fast_hash":"2222","dex_object_id":99,"method_index":7,"active_attempt_id":3,"entry_kind":"nterp","observation_phase":"nterp_entry"})"
+      << "\n";
+
+  const std::string apk = root_ + "/base.apk";
+  FILE *apk_file = fopen(apk.c_str(), "wb");
+  ASSERT_NE(apk_file, nullptr);
+  ZipWriter writer(apk_file);
+  ASSERT_EQ(writer.StartEntry("AndroidManifest.xml", 0), 0);
+  constexpr char manifest[] = "binary-manifest-test";
+  ASSERT_EQ(writer.WriteBytes(manifest, sizeof(manifest) - 1u), 0);
+  ASSERT_EQ(writer.FinishEntry(), 0);
+  ASSERT_EQ(writer.Finish(), 0);
+  ASSERT_EQ(fclose(apk_file), 0);
+  const int apk_fd = open(apk.c_str(), O_RDONLY | O_CLOEXEC);
+  ASSERT_GE(apk_fd, 0);
+
+  ExportSummary summary;
+  EXPECT_EQ(ExportLatest(root_, root_ + "/Downloads", "com.example.target",
+                         {apk_fd}, &summary),
+            Status::kOk);
+  close(apk_fd);
+  EXPECT_EQ(summary.run_id, "run-1");
+  EXPECT_EQ(summary.remote_artifact_count, 3u);
+  EXPECT_EQ(summary.record_count, 3u);
+  EXPECT_EQ(summary.partial, 3u);
+  EXPECT_TRUE(std::filesystem::is_regular_file(summary.archive_path));
+  EXPECT_TRUE(
+      std::filesystem::is_regular_file(summary.archive_path + ".sha256"));
+
+  ZipArchiveHandle archive = nullptr;
+  ASSERT_EQ(OpenArchive(summary.archive_path.c_str(), &archive), 0);
+  ZipEntry manifest_entry;
+  EXPECT_EQ(FindEntry(archive,
+                      "com.example.target/run-1/manifest/AndroidManifest.xml",
+                      &manifest_entry),
+            0);
+  ZipEntry report_entry;
+  EXPECT_EQ(FindEntry(archive,
+                      "com.example.target/run-1/process-1234/host-repair/"
+                      "report.json",
+                      &report_entry),
+            0);
+  std::vector<uint8_t> report_bytes(report_entry.uncompressed_length);
+  ASSERT_EQ(ExtractToMemory(archive,
+                            &report_entry,
+                            report_bytes.data(),
+                            report_entry.uncompressed_length),
+            0);
+  const std::string report_text(report_bytes.begin(), report_bytes.end());
+  Json::CharReaderBuilder json_builder;
+  std::unique_ptr<Json::CharReader> json_reader(json_builder.newCharReader());
+  Json::Value report;
+  std::string json_errors;
+  ASSERT_TRUE(json_reader->parse(report_text.data(),
+                                 report_text.data() + report_text.size(),
+                                 &report,
+                                 &json_errors))
+      << json_errors;
+  const Json::Value &paths = report["method_execution_paths"];
+  ASSERT_TRUE(paths.isArray());
+  ASSERT_EQ(paths.size(), 1u);
+  EXPECT_EQ(paths[0]["dex_object_id"].asUInt64(), 99u);
+  EXPECT_EQ(paths[0]["method_index"].asUInt(), 7u);
+  EXPECT_EQ(paths[0]["active_attempt_id"].asUInt64(), 3u);
+  EXPECT_EQ(paths[0]["first_entry_kind"].asString(), "nterp");
+  ASSERT_EQ(paths[0]["observed_phases"].size(), 2u);
+  EXPECT_EQ(paths[0]["observed_phases"][0].asString(), "before_dispatch");
+  EXPECT_EQ(paths[0]["observed_phases"][1].asString(), "nterp_entry");
+  EXPECT_EQ(paths[0]["first_artifact_fast_hash"].asString(), "1111");
+  EXPECT_EQ(paths[0]["last_artifact_fast_hash"].asString(), "2222");
+  EXPECT_TRUE(paths[0]["code_item_changed"].asBool());
+  CloseArchive(archive);
+}
+
+TEST_F(HelperTest, ExportLatestRejectsPackageWithoutCapturedRun) {
+  ExportSummary summary;
+  EXPECT_EQ(ExportLatest(root_, root_ + "/Downloads", "com.example.target",
+                         {STDIN_FILENO}, &summary),
+            Status::kNoRuns);
+  EXPECT_EQ(summary.detail, "no_run_with_artifacts");
+}
+
+} // namespace
+} // namespace r0dump::file_helper
diff --git a/helper/r0dump_mcp_bridge.cpp b/helper/r0dump_mcp_bridge.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..21d8efce2f730b09fca337c75f9267719ef00f2d
--- /dev/null
+++ b/helper/r0dump_mcp_bridge.cpp
@@ -0,0 +1,153 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// Thin stdio<->socket relay for the R0dumpManager MCP server.
+//
+// The manager app hosts an MCP (JSON-RPC 2.0) server on an abstract-namespace
+// AF_UNIX socket named "r0dump_mcp" (created by android.net.LocalServerSocket,
+// which prefixes the sun_path with a NUL byte). An MCP client on the host drives
+// it over adb with:
+//
+//     adb -s <serial> shell r0dump_mcp_bridge
+//
+// With a piped (non-tty) stdin, adb shell gives this process the client's
+// stdin/stdout as a raw byte channel (adb exec-out does not forward stdin on all
+// host/adb builds, so shell is preferred). This binary forwards those bytes to
+// and from the app socket unchanged. The framing (newline-delimited JSON-RPC) is
+// the app's concern -- the bridge is deliberately protocol-agnostic.
+
+#include <errno.h>
+#include <poll.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace {
+
+constexpr char kSocketName[] = "r0dump_mcp";
+constexpr size_t kBufferSize = 65536;
+
+int ConnectAbstractSocket(const char* name) {
+  const int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+  if (fd < 0) {
+    fprintf(stderr, "r0dump_mcp_bridge: socket: %s\n", strerror(errno));
+    return -1;
+  }
+  sockaddr_un address{};
+  address.sun_family = AF_UNIX;
+  // Abstract namespace: leading NUL, then the name (no trailing NUL counted).
+  const size_t name_length = strlen(name);
+  if (name_length + 1 > sizeof(address.sun_path)) {
+    fprintf(stderr, "r0dump_mcp_bridge: socket name too long\n");
+    close(fd);
+    return -1;
+  }
+  address.sun_path[0] = '\0';
+  memcpy(address.sun_path + 1, name, name_length);
+  const socklen_t length =
+      static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + 1 + name_length);
+  if (TEMP_FAILURE_RETRY(connect(fd, reinterpret_cast<sockaddr*>(&address),
+                                 length)) != 0) {
+    fprintf(stderr,
+            "r0dump_mcp_bridge: connect(@%s): %s (is the MCP switch on in "
+            "R0dumpManager?)\n",
+            name, strerror(errno));
+    close(fd);
+    return -1;
+  }
+  return fd;
+}
+
+// Copy everything available on src into dst. Returns false when the stream is
+// closed (EOF) or a fatal error occurs, so the caller can tear the relay down.
+bool Pump(int src, int dst) {
+  char buffer[kBufferSize];
+  const ssize_t count = TEMP_FAILURE_RETRY(read(src, buffer, sizeof(buffer)));
+  if (count == 0) {
+    return false;
+  }
+  if (count < 0) {
+    fprintf(stderr, "r0dump_mcp_bridge: read: %s\n", strerror(errno));
+    return false;
+  }
+  size_t written = 0;
+  while (written < static_cast<size_t>(count)) {
+    const ssize_t bytes = TEMP_FAILURE_RETRY(
+        write(dst, buffer + written, static_cast<size_t>(count) - written));
+    if (bytes <= 0) {
+      fprintf(stderr, "r0dump_mcp_bridge: write: %s\n", strerror(errno));
+      return false;
+    }
+    written += static_cast<size_t>(bytes);
+  }
+  return true;
+}
+
+}  // namespace
+
+int main() {
+  const int socket_fd = ConnectAbstractSocket(kSocketName);
+  if (socket_fd < 0) {
+    return 1;
+  }
+
+  pollfd fds[2];
+  fds[0] = {.fd = STDIN_FILENO, .events = POLLIN, .revents = 0};
+  fds[1] = {.fd = socket_fd, .events = POLLIN, .revents = 0};
+
+  // Once stdin closes we stop watching it but keep relaying the socket for a
+  // short idle window, so a request piped in without a persistent stdin (e.g.
+  // a one-shot probe) still receives its reply before we exit.
+  constexpr int kDrainIdleMs = 2000;
+  int status = 0;
+  bool stdin_open = true;
+  while (true) {
+    const int timeout = stdin_open ? -1 : kDrainIdleMs;
+    const int ready = TEMP_FAILURE_RETRY(poll(fds, 2, timeout));
+    if (ready < 0) {
+      fprintf(stderr, "r0dump_mcp_bridge: poll: %s\n", strerror(errno));
+      status = 1;
+      break;
+    }
+    if (ready == 0) {
+      break;  // Idle after stdin closed: assume the exchange is done.
+    }
+    if ((fds[1].revents & POLLIN) != 0 && !Pump(socket_fd, STDOUT_FILENO)) {
+      break;  // App closed the socket.
+    }
+    if (stdin_open && (fds[0].revents & POLLIN) != 0 &&
+        !Pump(STDIN_FILENO, socket_fd)) {
+      stdin_open = false;  // Client closed stdin; drain the socket, then exit.
+      fds[0].fd = -1;
+      fds[0].events = 0;
+    }
+    if ((fds[1].revents & (POLLERR | POLLHUP | POLLNVAL)) != 0) {
+      while (Pump(socket_fd, STDOUT_FILENO)) {
+      }
+      break;  // Socket gone.
+    }
+    if (stdin_open && (fds[0].revents & (POLLERR | POLLHUP | POLLNVAL)) != 0) {
+      stdin_open = false;
+      fds[0].fd = -1;
+      fds[0].events = 0;
+    }
+  }
+
+  close(socket_fd);
+  return status;
+}
