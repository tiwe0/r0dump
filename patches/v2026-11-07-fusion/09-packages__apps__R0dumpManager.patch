index 0000000000000000000000000000000000000000..68aa65073a80cf4c0ebd3a560c0487e19d19505a
--- /dev/null
+++ b/tools/export_latest.py
@@ -0,0 +1,451 @@
+#!/usr/bin/env python3
+"""Export the newest R0dump run for a package through adb and repair it locally."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+import shutil
+import shlex
+import subprocess
+import sys
+import tempfile
+import zipfile
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any, Sequence
+
+
+AOSP_ROOT = Path(__file__).resolve().parents[4]
+HOST_REPAIR_DIR = AOSP_ROOT / "art" / "tools" / "r0dump"
+sys.path.insert(0, str(HOST_REPAIR_DIR))
+
+try:
+    from r0dump_host_repair import R0DUMP_ALGORITHM_VERSION, r0dump_repair_run
+except ImportError as exc:  # pragma: no cover - only possible outside the source tree.
+    raise SystemExit(f"无法加载 {HOST_REPAIR_DIR / 'r0dump_host_repair.py'}：{exc}") from exc
+
+
+PACKAGE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z][A-Za-z0-9_]*)+$")
+REMOTE_TEMPLATE = "/sdcard/Android/data/{package}/files/r0dump-fusion/runs"
+
+
+class ExportError(RuntimeError):
+    """An expected user-facing export failure."""
+
+
+@dataclass(frozen=True)
+class RunCandidate:
+    latest_artifact_mtime: int
+    artifact_count: int
+    remote_path: str
+
+    @property
+    def run_id(self) -> str:
+        return PurePosixPath(self.remote_path).name
+
+
+class AdbClient:
+    def __init__(self, adb: str, serial: str | None, verbose: bool = False) -> None:
+        self._prefix = [adb]
+        if serial:
+            self._prefix.extend(["-s", serial])
+        self.verbose = verbose
+
+    def run(self, *args: str, capture: bool = True) -> subprocess.CompletedProcess[str]:
+        command = [*self._prefix, *args]
+        if self.verbose:
+            print("+", shlex.join(command), file=sys.stderr)
+        try:
+            return subprocess.run(
+                command,
+                check=True,
+                text=True,
+                stdout=subprocess.PIPE if capture else None,
+                stderr=subprocess.PIPE if capture else None,
+            )
+        except FileNotFoundError as exc:
+            raise ExportError(f"找不到 adb：{self._prefix[0]}") from exc
+        except subprocess.CalledProcessError as exc:
+            details = (exc.stderr or exc.stdout or "").strip()
+            suffix = f"：{details}" if details else ""
+            raise ExportError(f"adb 命令失败（exit {exc.returncode}）{suffix}") from exc
+
+    def ensure_device(self) -> str:
+        state = self.run("get-state").stdout.strip()
+        if state != "device":
+            raise ExportError(f"设备状态不可用：{state or 'unknown'}")
+        return self.run("get-serialno").stdout.strip()
+
+    def shell(self, script: str) -> str:
+        return self.run("shell", script).stdout
+
+    def pull(self, remote: str, local_directory: Path) -> None:
+        self.run("pull", remote, str(local_directory), capture=False)
+
+
+def validate_package_name(package: str) -> str:
+    if not PACKAGE_RE.fullmatch(package):
+        raise ExportError(f"无效包名：{package!r}")
+    return package
+
+
+def remote_runs_root(package: str) -> str:
+    return REMOTE_TEMPLATE.format(package=validate_package_name(package))
+
+
+def candidate_script(root: str) -> str:
+    quoted_root = shlex.quote(root)
+    return f"""
+root={quoted_root}
+for run in "$root"/*; do
+  [ -d "$run" ] || continue
+  newest=0
+  count=0
+  for process in "$run"/process-*; do
+    [ -f "$process/session.json" ] || continue
+    for artifact in "$process"/artifacts/*; do
+      [ -f "$artifact" ] || continue
+      mtime=$(stat -c %Y "$artifact" 2>/dev/null) || continue
+      [ "$mtime" -gt "$newest" ] && newest=$mtime
+      count=$((count + 1))
+    done
+  done
+  [ "$count" -gt 0 ] && printf '%s\\t%s\\t%s\\n' "$newest" "$count" "$run"
+done
+exit 0
+""".strip()
+
+
+def run_path(root: str, run_id: str) -> str:
+    """Return a validated device run path without enumerating historical runs."""
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", run_id):
+        raise ExportError(f"无效 run id：{run_id!r}")
+    return f"{root}/{run_id}"
+
+
+def parse_candidates(output: str, root: str) -> list[RunCandidate]:
+    expected_parent = PurePosixPath(root)
+    candidates: list[RunCandidate] = []
+    for line in output.splitlines():
+        if not line.strip():
+            continue
+        fields = line.split("\t", 2)
+        if len(fields) != 3:
+            raise ExportError(f"无法解析设备返回的 run 信息：{line!r}")
+        try:
+            mtime = int(fields[0])
+            count = int(fields[1])
+        except ValueError as exc:
+            raise ExportError(f"设备返回了无效的 run 统计：{line!r}") from exc
+        remote_path = fields[2]
+        path = PurePosixPath(remote_path)
+        if path.parent != expected_parent or not path.name or count <= 0 or mtime < 0:
+            raise ExportError(f"设备返回了越界的 run 路径：{remote_path!r}")
+        candidates.append(RunCandidate(mtime, count, remote_path))
+    return candidates
+
+
+def select_run(candidates: Sequence[RunCandidate], run_id: str | None) -> RunCandidate:
+    if not candidates:
+        raise ExportError("目标包下没有包含产物的 run")
+    if run_id is not None:
+        matches = [candidate for candidate in candidates if candidate.run_id == run_id]
+        if not matches:
+            raise ExportError(f"找不到包含产物的 run：{run_id}")
+        return matches[0]
+    return max(candidates, key=lambda candidate: (candidate.latest_artifact_mtime, candidate.run_id))
+
+
+def resolve_optional_tool(value: str | None, name: str) -> str | None:
+    if value is None:
+        return None
+    discovered = shutil.which(value)
+    if discovered:
+        return str(Path(discovered).resolve())
+    path = Path(value).expanduser().resolve()
+    if not path.is_file() or not os.access(path, os.X_OK):
+        raise ExportError(f"{name} 不存在或不可执行：{value}")
+    return str(path)
+
+
+def repair_summary(report: dict[str, Any]) -> dict[str, Any]:
+    records = report.get("records", [])
+    partial_records = [
+        item
+        for item in records
+        if item.get("trust") == "partial" or item.get("status") == "partial"
+    ]
+    partial_reasons: dict[str, int] = {}
+    for item in partial_records:
+        reason = str(item.get("reason") or "unspecified")
+        if reason == "capture_dropped" and item.get("drop_reason"):
+            reason = f"{reason}:{item['drop_reason']}"
+        partial_reasons[reason] = partial_reasons.get(reason, 0) + 1
+    return {
+        "verified": sum(item.get("trust") == "verified" for item in records),
+        "repaired": sum(item.get("trust") == "repaired" for item in records),
+        "partial": len(partial_records),
+        "usable_outputs": len(
+            {
+                item.get("output")
+                for item in records
+                if item.get("trust") in ("verified", "repaired") and item.get("output")
+            }
+        ),
+        "codeitems_backfilled": sum(
+            item.get("output_kind") == "codeitem_backfill" and item.get("trust") == "repaired"
+            for item in records
+        ),
+        "reconstructed_dex": sum(
+            reconstruction.get("output") is not None
+            for reconstruction in report.get("reconstructions", [])
+        ),
+        "partial_reasons": dict(sorted(partial_reasons.items())),
+    }
+
+
+def repair_export(
+    run_directory: Path,
+    dexdump: str | None = None,
+    jadx: str | None = None,
+) -> list[dict[str, Any]]:
+    process_reports: list[dict[str, Any]] = []
+    process_directories = sorted(
+        path
+        for path in run_directory.glob("process-*")
+        if path.is_dir() and (path / "session.json").is_file()
+    )
+    if not process_directories:
+        raise ExportError("导出的 run 不包含有效 process 目录")
+
+    for process_directory in process_directories:
+        output_directory = process_directory / "host-repair"
+        try:
+            report = r0dump_repair_run(process_directory, output_directory, dexdump, jadx)
+            process_reports.append(
+                {
+                    "process": process_directory.name,
+                    "status": "ok",
+                    "algorithm_version": R0DUMP_ALGORITHM_VERSION,
+                    "record_count": report.get("record_count", 0),
+                    "summary": repair_summary(report),
+                    "report": (output_directory / "report.json").relative_to(run_directory).as_posix(),
+                    "inputs": (output_directory / "inputs.json").relative_to(run_directory).as_posix(),
+                }
+            )
+        # Preserve the raw export and surface a per-process diagnostic even if
+        # a malformed record triggers an unexpected parser failure.
+        except Exception as exc:
+            process_reports.append(
+                {"process": process_directory.name, "status": "error", "error": str(exc)}
+            )
+    return process_reports
+
+
+def write_export_report(
+    run_directory: Path,
+    package: str,
+    serial: str,
+    candidate: RunCandidate,
+    process_reports: Sequence[dict[str, Any]],
+    archive_name: str,
+) -> Path:
+    report = {
+        "schema": 1,
+        "exported_at": datetime.now(timezone.utc).isoformat(),
+        "device_serial": serial,
+        "package": package,
+        "run_id": candidate.run_id,
+        "remote_path": candidate.remote_path,
+        "remote_artifact_count": candidate.artifact_count,
+        "archive": archive_name,
+        "process_reports": list(process_reports),
+    }
+    path = run_directory / "export-report.json"
+    temporary = run_directory / ".export-report.json.tmp"
+    temporary.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    temporary.replace(path)
+    return path
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def create_archive(run_directory: Path, package: str, archive: Path) -> tuple[Path, Path]:
+    temporary = archive.with_name(f".{archive.name}.partial")
+    checksum_path = archive.with_suffix(archive.suffix + ".sha256")
+    if archive.exists() or checksum_path.exists():
+        raise ExportError(f"ZIP 或校验文件已存在，不会覆盖：{archive}")
+    try:
+        with zipfile.ZipFile(
+            temporary,
+            "w",
+            compression=zipfile.ZIP_DEFLATED,
+            compresslevel=6,
+            allowZip64=True,
+        ) as output:
+            for path in sorted(run_directory.rglob("*")):
+                if path.is_symlink():
+                    raise ExportError(f"导出目录包含不允许打包的符号链接：{path}")
+                if not path.is_file():
+                    continue
+                relative = path.relative_to(run_directory)
+                archive_name = (PurePosixPath(package) / run_directory.name / relative.as_posix()).as_posix()
+                output.write(path, archive_name)
+        temporary.replace(archive)
+    finally:
+        temporary.unlink(missing_ok=True)
+    checksum = sha256_file(archive)
+    checksum_temporary = checksum_path.with_name(f".{checksum_path.name}.partial")
+    checksum_temporary.write_text(f"{checksum}  {archive.name}\n", encoding="utf-8")
+    checksum_temporary.replace(checksum_path)
+    return archive, checksum_path
+
+
+def pull_run(client: AdbClient, candidate: RunCandidate, destination: Path) -> None:
+    package_directory = destination.parent
+    temporary = Path(
+        tempfile.mkdtemp(prefix=f".{candidate.run_id}.partial-", dir=package_directory)
+    )
+    try:
+        pulled = temporary / candidate.run_id
+        pulled.mkdir()
+        # Pull directory contents into a local name we control. Windows adb invoked from WSL may
+        # truncate the remote basename when it creates the destination directory itself.
+        client.pull(f"{candidate.remote_path}/.", pulled)
+        if not any(pulled.glob("process-*/session.json")):
+            raise ExportError("导出的 run 缺少 process session.json")
+        if not any(pulled.glob("process-*/artifacts/*")):
+            raise ExportError("导出的 run 不包含产物")
+        pulled.rename(destination)
+    finally:
+        shutil.rmtree(temporary, ignore_errors=True)
+
+
+def export_latest(args: argparse.Namespace) -> Path:
+    package = validate_package_name(args.package)
+    client = AdbClient(args.adb, args.serial, args.verbose)
+    serial = client.ensure_device()
+    root = remote_runs_root(package)
+    if args.run_id is None:
+        candidate = select_run(parse_candidates(client.shell(candidate_script(root)), root), None)
+    else:
+        remote_path = run_path(root, args.run_id)
+        candidate = RunCandidate(latest_artifact_mtime=0, artifact_count=1, remote_path=remote_path)
+        # Validate the explicitly requested run before adb pull. This avoids a shell glob over all
+        # historical runs and produces a focused error for a missing/empty run.
+        probe = client.shell(
+            f"run={shlex.quote(remote_path)}; "
+            "[ -d \"$run\" ] || { echo missing >&2; exit 1; }; "
+            "count=0; for process in \"$run\"/process-*; do "
+            "[ -f \"$process/session.json\" ] || continue; "
+            "for artifact in \"$process\"/artifacts/*; do [ -f \"$artifact\" ] && count=$((count + 1)); done; "
+            "done; [ \"$count\" -gt 0 ] || { echo empty >&2; exit 1; }; printf '%s\\n' \"$count\""
+        ).strip()
+        try:
+            candidate = RunCandidate(
+                latest_artifact_mtime=0,
+                artifact_count=int(probe),
+                remote_path=remote_path,
+            )
+        except ValueError as exc:
+            raise ExportError(f"设备返回了无效的 run 统计：{probe!r}") from exc
+    dexdump = None if args.no_repair else resolve_optional_tool(args.dexdump, "dexdump")
+    jadx = None if args.no_repair else resolve_optional_tool(args.jadx, "jadx")
+
+    output_root = Path(args.output).expanduser().resolve()
+    package_directory = output_root / package
+    destination = package_directory / candidate.run_id
+    archive = package_directory / f"{candidate.run_id}.zip"
+    checksum_path = archive.with_suffix(archive.suffix + ".sha256")
+    if destination.exists() or archive.exists() or checksum_path.exists():
+        raise ExportError(f"导出目录或 ZIP 已存在，不会覆盖：{destination}")
+    package_directory.mkdir(parents=True, exist_ok=True)
+
+    pull_run(client, candidate, destination)
+
+    process_reports: list[dict[str, Any]] = []
+    if not args.no_repair:
+        process_reports = repair_export(destination, dexdump, jadx)
+    report_path = write_export_report(
+        destination, package, serial, candidate, process_reports, archive.name
+    )
+    archive_path, archive_checksum_path = create_archive(destination, package, archive)
+
+    print(f"设备：{serial}")
+    print(f"包名：{package}")
+    print(f"run：{candidate.run_id}（{candidate.artifact_count} 个设备端产物）")
+    print(f"导出：{destination}")
+    if args.no_repair:
+        print("主机修复：已跳过")
+    else:
+        for item in process_reports:
+            if item["status"] == "ok":
+                summary = item["summary"]
+                print(
+                    f"{item['process']}：{summary['verified']} verified，"
+                    f"{summary['repaired']} repaired，{summary['partial']} partial，"
+                    f"{summary['usable_outputs']} 个去重可用 DEX，"
+                    f"{summary['codeitems_backfilled']} 条 codeitem 已回填"
+                )
+                if summary["partial_reasons"]:
+                    reasons = "，".join(
+                        f"{reason}={count}"
+                        for reason, count in summary["partial_reasons"].items()
+                    )
+                    print(f"  partial 原因：{reasons}")
+            else:
+                print(f"{item['process']}：修复失败：{item['error']}", file=sys.stderr)
+    print(f"报告：{report_path}")
+    print(f"ZIP：{archive_path}")
+    print(f"SHA-256：{archive_checksum_path}")
+    if any(item["status"] != "ok" for item in process_reports):
+        raise ExportError(f"原始 run 已导出，但至少一个 process 修复失败：{destination}")
+    return archive_path
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="通过 adb 导出指定包最新的 R0dump run，并调用主机修复器处理。"
+    )
+    parser.add_argument("package", help="目标 Android 包名，例如 com.coolapk.market")
+    parser.add_argument(
+        "-o",
+        "--output",
+        default="r0dump-exports",
+        help="导出根目录（默认：./r0dump-exports）",
+    )
+    parser.add_argument("-s", "--serial", default=os.environ.get("ADB_SERIAL"), help="adb 设备序列号")
+    parser.add_argument("--adb", default=os.environ.get("ADB", "adb"), help="adb 可执行文件")
+    parser.add_argument("--run-id", help="导出指定 run；默认按最新产物修改时间选择")
+    parser.add_argument("--no-repair", action="store_true", help="只导出，不运行主机修复器")
+    parser.add_argument("--dexdump", help="可选 dexdump 路径；对 repaired DEX 做解析校验")
+    parser.add_argument("--jadx", help="可选 jadx 路径；对 repaired DEX 做反编译验证")
+    parser.add_argument("-v", "--verbose", action="store_true", help="打印执行的 adb 命令")
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    try:
+        export_latest(build_parser().parse_args(argv))
+        return 0
+    except ExportError as exc:
+        print(f"错误：{exc}", file=sys.stderr)
+        return 1
+    except KeyboardInterrupt:
+        print("已取消", file=sys.stderr)
+        return 130
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/final_acceptance.sh b/tools/final_acceptance.sh
new file mode 100755
index 0000000000000000000000000000000000000000..123011ca5a98de192866cc2d508c03ad38995189
--- /dev/null
+++ b/tools/final_acceptance.sh
@@ -0,0 +1,127 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# R0dump Manager final acceptance wrapper.
+#
+# This script intentionally does NOT flash partitions. It is the reproducible
+# post-deployment gate for the jointly built Manager, Framework and SELinux
+# artifacts. A userdebug device is the authoritative acceptance target; a user
+# build and system.img are intentionally not prerequisites.
+# By default it is non-destructive: source checks + device/system identity + UI
+# smoke only. Configuration mutations are deliberately not driven by this script. Use
+# --preflight-only before flashing to collect
+# current hashes without running the post-flash gate.
+#
+# Examples:
+#   ADB=adb ADB_HOST=127.0.0.1 ADB_PORT=5038 ADB_SERIAL=f5e3adbc \
+#     packages/apps/R0dumpManager/tools/final_acceptance.sh
+
+ADB="${ADB:-adb}"
+ADB_HOST="${ADB_HOST:-127.0.0.1}"
+ADB_PORT="${ADB_PORT:-5037}"
+ADB_SERIAL="${ADB_SERIAL:-f5e3adbc}"
+ROOT_DIR="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
+OUT_DIR="${OUT_DIR:-$ROOT_DIR/out/target/product/lemonade}"
+TOOLS_DIR="$ROOT_DIR/packages/apps/R0dumpManager/tools"
+ARTIFACT_DIR="${ARTIFACT_DIR:-/tmp/r0dump-manager-final-acceptance-$(date +%Y%m%d-%H%M%S)}"
+ALLOW_START_DUMP=0
+TARGET_PACKAGE="${TARGET_PACKAGE:-com.android.settings}"
+RESET_MANAGER_DATA=0
+PREFLIGHT_ONLY=0
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --allow-start-dump)
+      ALLOW_START_DUMP=1
+      shift
+      ;;
+    --target)
+      TARGET_PACKAGE="${2:?missing target package}"
+      shift 2
+      ;;
+    --reset-manager-data)
+      RESET_MANAGER_DATA=1
+      shift
+      ;;
+    --preflight-only)
+      PREFLIGHT_ONLY=1
+      shift
+      ;;
+    --artifact-dir)
+      ARTIFACT_DIR="${2:?missing artifact dir}"
+      shift 2
+      ;;
+    -h|--help)
+      sed -n '1,31p' "$0"
+      exit 0
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      exit 2
+      ;;
+  esac
+done
+
+mkdir -p "$ARTIFACT_DIR"
+
+log() { printf '\n== %s ==\n' "$*"; }
+adb_base=("$ADB" -H "$ADB_HOST" -P "$ADB_PORT" -s "$ADB_SERIAL")
+adb_device() { "${adb_base[@]}" "$@"; }
+
+log "tool configuration"
+{
+  echo "ROOT_DIR=$ROOT_DIR"
+  echo "OUT_DIR=$OUT_DIR"
+  echo "ADB=$ADB"
+  echo "ADB_ENDPOINT=$ADB_HOST:$ADB_PORT"
+  echo "ADB_SERIAL=$ADB_SERIAL"
+  echo "ARTIFACT_DIR=$ARTIFACT_DIR"
+  echo "TARGET_PACKAGE=$TARGET_PACKAGE"
+  echo "ALLOW_START_DUMP=$ALLOW_START_DUMP"
+  echo "RESET_MANAGER_DATA=$RESET_MANAGER_DATA"
+  echo "PREFLIGHT_ONLY=$PREFLIGHT_ONLY"
+} | tee "$ARTIFACT_DIR/final_acceptance_config.txt"
+
+log "source contracts"
+"$TOOLS_DIR/validate_source_contracts.sh" | tee "$ARTIFACT_DIR/source_contracts.txt"
+
+log "local artifact hashes"
+sha256sum \
+  "$OUT_DIR/system/priv-app/R0dumpManager/R0dumpManager.apk" \
+  "$OUT_DIR/system/etc/selinux/plat_sepolicy.cil" \
+  "$OUT_DIR/system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml" \
+  | tee "$ARTIFACT_DIR/local_hashes.txt"
+
+if [[ "$PREFLIGHT_ONLY" -eq 1 ]]; then
+  log "device preflight hashes"
+  {
+    "$ADB" -H "$ADB_HOST" -P "$ADB_PORT" devices -l || true
+    adb_device shell 'sha256sum /system/priv-app/R0dumpManager/R0dumpManager.apk 2>/dev/null || true' || true
+    adb_device shell 'sha256sum /system/etc/selinux/plat_sepolicy.cil 2>/dev/null || true' || true
+    adb_device shell 'sha256sum /system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml 2>/dev/null || true' || true
+  } | tee "$ARTIFACT_DIR/device_preflight_hashes.txt"
+  log "preflight summary"
+  cat <<SUMMARY | tee "$ARTIFACT_DIR/summary.txt"
+PASS: R0dumpManager final acceptance preflight completed
+Artifacts: $ARTIFACT_DIR
+Post-flash validation: skipped by --preflight-only
+SUMMARY
+  exit 0
+fi
+
+log "post-deployment manager validation"
+post_args=(--allow-userdebug --require-system-match --artifact-dir "$ARTIFACT_DIR/post_flash")
+if [[ "$RESET_MANAGER_DATA" -eq 1 ]]; then
+  post_args+=(--reset-manager-data)
+fi
+ADB="$ADB" ADB_HOST="$ADB_HOST" ADB_PORT="$ADB_PORT" ADB_SERIAL="$ADB_SERIAL" \
+  OUT_DIR="$OUT_DIR" "$TOOLS_DIR/validate_post_flash.sh" "${post_args[@]}" \
+  | tee "$ARTIFACT_DIR/post_flash_validation.txt"
+
+log "final acceptance summary"
+cat <<SUMMARY | tee "$ARTIFACT_DIR/summary.txt"
+PASS: R0dumpManager final acceptance wrapper completed
+Artifacts: $ARTIFACT_DIR
+Userdebug property, SELinux and UI validation: passed
+User build/system.img prerequisite: not required
+SUMMARY
