index 0000000000000000000000000000000000000000..b6efc9637dd73fa85c12861bf0a9937d38a71c30
--- /dev/null
+++ b/tools/validate_post_flash.sh
@@ -0,0 +1,133 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ADB_BIN="${ADB:-adb}"
+ADB_HOST="${ADB_HOST:-127.0.0.1}"
+ADB_PORT="${ADB_PORT:-5037}"
+ADB_SERIAL="${ADB_SERIAL:-}"
+ROOT_DIR="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
+OUT_DIR="${OUT_DIR:-$ROOT_DIR/out/target/product/lemonade}"
+ARTIFACT_DIR="${ARTIFACT_DIR:-/tmp/r0dump-manager-validation}"
+REQUIRE_SYSTEM_MATCH=0
+ALLOW_USERDEBUG=0
+RESET_MANAGER_DATA=0
+MANAGER_PACKAGE="com.android.r0dumpmanager"
+MANAGER_SYSTEM_APK="/system/priv-app/R0dumpManager/R0dumpManager.apk"
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --require-system-match) REQUIRE_SYSTEM_MATCH=1 ;;
+    --allow-userdebug) ALLOW_USERDEBUG=1 ;;
+    --reset-manager-data) RESET_MANAGER_DATA=1 ;;
+    --artifact-dir) ARTIFACT_DIR="${2:?missing artifact dir}"; shift ;;
+    -h|--help) sed -n '1,28p' "$0"; exit 0 ;;
+    *) echo "unknown argument: $1" >&2; exit 2 ;;
+  esac
+  shift
+done
+
+mkdir -p "$ARTIFACT_DIR"
+adb_base=("$ADB_BIN" -H "$ADB_HOST" -P "$ADB_PORT")
+adb_device() {
+  local args=("${adb_base[@]}")
+  [[ -n "$ADB_SERIAL" ]] && args+=(-s "$ADB_SERIAL")
+  args+=("$@")
+  "${args[@]}"
+}
+capture() { adb_device "$@" | tr -d '\r'; }
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+"${adb_base[@]}" devices -l | tee "$ARTIFACT_DIR/devices.txt"
+if [[ -z "$ADB_SERIAL" ]]; then
+  ADB_SERIAL="$(awk '$2 == "device" { print $1 }' "$ARTIFACT_DIR/devices.txt")"
+fi
+[[ -n "$ADB_SERIAL" ]] || fail "no connected device"
+[[ "$(grep -c "^$ADB_SERIAL[[:space:]]\+device" "$ARTIFACT_DIR/devices.txt")" -eq 1 ]] ||
+  fail "expected exactly one transport for $ADB_SERIAL"
+
+build_type="$(capture shell getprop ro.build.type)"
+release="$(capture shell getprop ro.build.version.release)"
+sdk="$(capture shell getprop ro.build.version.sdk)"
+enforcing="$(capture shell getenforce)"
+printf 'serial=%s\nbuild_type=%s\nrelease=%s\nsdk=%s\nselinux=%s\n' \
+  "$ADB_SERIAL" "$build_type" "$release" "$sdk" "$enforcing" | tee "$ARTIFACT_DIR/device.txt"
+[[ "$release" == "16" && "$sdk" == "36" ]] || fail "device is not Android 16/API 36"
+[[ "$enforcing" == "Enforcing" ]] || fail "SELinux is not enforcing"
+if [[ "$build_type" != "user" && "$build_type" != "userdebug" ]]; then
+  fail "validation requires a user or userdebug build"
+fi
+
+local_apk="$OUT_DIR/system/priv-app/R0dumpManager/R0dumpManager.apk"
+local_privapp="$OUT_DIR/system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml"
+if [[ "$REQUIRE_SYSTEM_MATCH" -eq 1 ]]; then
+  [[ -f "$local_apk" && -f "$local_privapp" ]] || fail "missing local Manager artifacts"
+  sha256sum "$local_apk" "$local_privapp" | tee "$ARTIFACT_DIR/local_hashes.txt"
+  capture shell sha256sum \
+    /system/priv-app/R0dumpManager/R0dumpManager.apk \
+    /system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml \
+    | tee "$ARTIFACT_DIR/device_hashes.txt"
+  grep -q "$(sha256sum "$local_apk" | awk '{print $1}')" "$ARTIFACT_DIR/device_hashes.txt" ||
+    fail "device APK differs from local artifact"
+  grep -q "$(sha256sum "$local_privapp" | awk '{print $1}')" "$ARTIFACT_DIR/device_hashes.txt" ||
+    fail "device privapp allowlist differs from local artifact"
+fi
+
+active_paths="$(capture shell pm path "$MANAGER_PACKAGE")"
+printf '%s\n' "$active_paths" | tee "$ARTIFACT_DIR/package_paths.txt"
+[[ "$active_paths" == "package:$MANAGER_SYSTEM_APK" ]] ||
+  fail "active Manager is not the system APK (remove any /data/app update first)"
+
+capture shell dumpsys package "$MANAGER_PACKAGE" > "$ARTIFACT_DIR/package.txt"
+grep -q "android.permission.FORCE_STOP_PACKAGES: granted=true" "$ARTIFACT_DIR/package.txt" ||
+  fail "FORCE_STOP_PACKAGES is not granted"
+grep -Eq 'android\.permission\.MANAGE_R0DUMP([[:space:]]|:|$)' "$ARTIFACT_DIR/package.txt" &&
+  fail "obsolete MANAGE_R0DUMP remains installed"
+
+capture shell am force-stop "$MANAGER_PACKAGE"
+if [[ "$RESET_MANAGER_DATA" -eq 1 ]]; then
+  capture shell pm clear "$MANAGER_PACKAGE" | tee "$ARTIFACT_DIR/manager_data_reset.txt"
+fi
+capture shell am start -W -n "$MANAGER_PACKAGE/.MainActivity" | tee "$ARTIFACT_DIR/activity_start.txt"
+sleep 2
+capture shell ps -AZ | grep "$MANAGER_PACKAGE" | tee "$ARTIFACT_DIR/process_context.txt"
+grep -q "u:r:r0dump_manager_app:s0" "$ARTIFACT_DIR/process_context.txt" ||
+  fail "Manager is not running in r0dump_manager_app"
+
+capture shell getprop > "$ARTIFACT_DIR/properties.txt"
+python3 - "$ARTIFACT_DIR/properties.txt" <<'PY'
+import re
+import sys
+from pathlib import Path
+
+required = {
+    "schema", "enabled", "run_id", "target_package", "target_process", "capture_point_mask",
+    "max_records", "max_artifacts", "max_total_bytes", "max_dex_bytes", "buffer_pool_bytes",
+    "max_code_item_bytes", "max_frozen_generations", "flush_idle_ms", "manifest_enabled",
+    "manifest_include_splits", "manifest_max_components", "manifest_max_splits",
+    "manifest_max_events_per_source", "manifest_max_total_events", "manifest_max_xml_depth",
+    "manifest_max_attribute_length", "walk_enabled", "walk_start", "walk_mode", "walk_delay_ms",
+    "walk_max_classes", "walk_max_methods", "force_invoke_enabled", "force_class", "force_method",
+    "force_method_descriptor", "force_max_calls", "anr_protection_enabled",
+}
+values = dict(re.findall(r"^\[persist\.sys\.r0dump\.fusion\.([^]]+)\]: \[(.*)]$", Path(sys.argv[1]).read_text(), re.M))
+missing = sorted(required - values.keys())
+if missing:
+    raise SystemExit("FAIL: missing persisted fields: " + ", ".join(missing))
+generation = int(values.get("generation", "-1"))
+if generation < 0 or generation % 2:
+    raise SystemExit(f"FAIL: unstable generation {generation}")
+print(f"PASS: complete stable snapshot generation={generation} enabled={values['enabled']}")
+PY
+
+capture shell uiautomator dump /sdcard/r0dump_manager.xml >/dev/null
+capture pull /sdcard/r0dump_manager.xml "$ARTIFACT_DIR/manager_ui.xml" >/dev/null
+grep -Eq "R0dump (Manager|管理器)" "$ARTIFACT_DIR/manager_ui.xml" ||
+  fail "Manager UI did not render in a supported locale"
+
+capture shell logcat -d -b all -t 800 > "$ARTIFACT_DIR/logcat.txt"
+if grep -E "avc: denied.*(r0dump_manager_app|r0dump_fusion_prop)|FATAL EXCEPTION.*r0dumpmanager" "$ARTIFACT_DIR/logcat.txt"; then
+  fail "Manager property denial or fatal exception detected"
+fi
+
+echo "PASS: R0dumpManager post-flash validation"
+echo "Artifacts: $ARTIFACT_DIR"
diff --git a/tools/validate_source_contracts.sh b/tools/validate_source_contracts.sh
new file mode 100755
index 0000000000000000000000000000000000000000..d30d379a42cc972548bcddb755c61f644238710a
--- /dev/null
+++ b/tools/validate_source_contracts.sh
@@ -0,0 +1,243 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "$0")/../../../.." && pwd)"
+APP_DIR="$ROOT_DIR/packages/apps/R0dumpManager"
+
+python3 - "$ROOT_DIR" "$APP_DIR" <<'PY'
+from pathlib import Path
+import re
+import subprocess
+import sys
+import xml.etree.ElementTree as ET
+
+root = Path(sys.argv[1])
+app = Path(sys.argv[2])
+errors = []
+
+def read(path: Path) -> str:
+    if not path.exists():
+        errors.append(f"missing required file: {path.relative_to(root)}")
+        return ""
+    return path.read_text(errors="ignore")
+
+framework = read(root / "frameworks/base/core/java/android/app/r0dump_FusionConfig.java")
+points = read(root / "art/runtime/r0dump/r0dump_hook_point.h")
+point_descriptors = read(root / "art/runtime/r0dump/r0dump_hook_point.cc")
+draft = read(app / "src/com/android/r0dumpmanager/domain/FusionConfigDraft.kt")
+registry = read(app / "src/com/android/r0dumpmanager/domain/CapturePointRegistry.kt")
+repository = read(app / "src/com/android/r0dumpmanager/data/property/FusionPropertyRepository.kt")
+view_model = read(app / "src/com/android/r0dumpmanager/app/R0dumpManagerViewModel.kt")
+draft_store = read(app / "src/com/android/r0dumpmanager/data/draft/DraftStateStore.kt")
+manager_screen = read(app / "src/com/android/r0dumpmanager/ui/R0dumpManagerScreen.kt")
+boot_receiver = read(app / "src/com/android/r0dumpmanager/receiver/BootCompletedReceiver.kt")
+manifest_text = read(app / "AndroidManifest.xml")
+locale_config_text = read(app / "res/xml/locales_config.xml")
+strings_en_text = read(app / "res/values/strings.xml")
+strings_zh_text = read(app / "res/values-zh-rCN/strings.xml")
+privapp = read(app / "privapp-permissions-com.android.r0dumpmanager.xml")
+bp = read(app / "Android.bp")
+helper_bp = read(app / "helper/Android.bp")
+device_mk = read(root / "device/oneplus/lemonade/device.mk")
+property_te = read(root / "system/sepolicy/private/property.te")
+property_contexts = read(root / "system/sepolicy/private/property_contexts")
+seapp_contexts = read(root / "system/sepolicy/private/seapp_contexts")
+manager_te = read(root / "system/sepolicy/private/r0dump_manager_app.te")
+helper_te = read(root / "system/sepolicy/private/r0dump_file_helper.te")
+helper_protocol = read(app / "helper/r0dump_file_helper_protocol.h")
+helper_export = read(app / "helper/r0dump_export_core.cpp")
+export_repository = read(app / "src/com/android/r0dumpmanager/data/export/ArtifactExportRepository.kt")
+activity_manager = read(root / "frameworks/base/services/core/java/com/android/server/am/ActivityManagerService.java")
+
+field_block = re.search(r"private static final Set<String> FIELDS\s*=\s*Set\.of\((.*?)\);", framework, re.S)
+framework_fields = re.findall(r'"([a-z0-9_]+)"', field_block.group(1)) if field_block else []
+draft_fields = re.findall(r"^\s*val\s+([A-Za-z][A-Za-z0-9]*):", draft, re.M)
+if len(framework_fields) != 35:
+    errors.append(f"Framework field count is {len(framework_fields)}, expected 35")
+if len(draft_fields) != 35:
+    errors.append(f"Manager draft field count is {len(draft_fields)}, expected 35")
+
+point_entries = re.findall(r"\bk[A-Za-z0-9]+\s*=\s*(\d+),", points)
+manager_points = re.findall(r"CapturePoint\((\d+),", registry)
+art_point_names = re.findall(r'\{r0dump_Point::k[A-Za-z0-9]+, "([^"]+)"\}', point_descriptors)
+manager_point_names = re.findall(r'CapturePoint\(\d+, "([^"]+)"', registry)
+if point_entries != [str(i) for i in range(43)]:
+    errors.append("ART capture points must remain contiguous bits 0..42")
+if manager_points != [str(i) for i in range(43)]:
+    errors.append("Manager capture points must exactly cover bits 0..42")
+if manager_point_names != art_point_names:
+    errors.append("Manager capture point IDs must exactly match ART descriptors")
+if "kForceInvokeNoExecute = 41" not in points or "forceNoExecuteMask: ULong = 1uL shl 41" not in registry:
+    errors.append("force no-execute bit must remain 41")
+if "defaultMask: ULong = (1uL shl 3) or (1uL shl 5) or forceNoExecuteMask" not in registry:
+    errors.append("Manager default capture points must remain bits 3, 5, and 41")
+if "0x0000020000000028" not in repository or "0x0000020000000028" not in framework:
+    errors.append("Manager and Framework default capture mask must remain bits 3, 5, and 41")
+
+production = "\n".join(path.read_text(errors="ignore") for path in (app / "src").rglob("*.kt"))
+for forbidden in (
+    "IR0dumpControlService", "ServiceManager.getService", "R0dumpPrivateStoreRepository",
+    "MANAGE_R0DUMP", "MANAGE_EXTERNAL_STORAGE", "READ_LOGS", "Runtime.getRuntime().exec",
+    "ProcessBuilder(", "adb shell", " su ", "/sdcard/Download/r0dump",
+):
+    if forbidden in production:
+        errors.append(f"production source retains forbidden boundary: {forbidden}")
+
+for required in (
+    "r0dump_writePersistedForManager", "r0dump_disablePersistedForManager",
+    "r0dump_recoverDisabledPersistedForManager", "expectedGeneration",
+):
+    if required not in framework:
+        errors.append(f"Framework manager API missing: {required}")
+for required in ("SystemProperties.get", "r0dump_writePersistedForManager", "Mutex", "readStable"):
+    if required not in repository:
+        errors.append(f"property repository contract missing: {required}")
+for required in ("publishAndLaunch", "endSession", "recoverInterrupted", "restoreDefaults", "restoreDefaultBudgets", "exportLatest"):
+    if required not in view_model:
+        errors.append(f"ViewModel workflow missing: {required}")
+for required in ("SavedStateHandle", "DRAFT_PROFILE_KEY", "createRunId", "activeTarget"):
+    if required not in view_model:
+        errors.append(f"ViewModel state/session contract missing: {required}")
+for required in ("SharedPreferences", "expectedGeneration", "FusionConfigSchema.fromJson", "fun clear"):
+    if required not in draft_store:
+        errors.append(f"generation-bound private draft persistence missing: {required}")
+for required in (
+    "PredictiveBackHandler", "LocaleManager", "applicationLocales", "language_chinese", "language_english",
+    "SearchBar", "SingleChoiceSegmentedButtonRow", "ModalBottomSheet", "stickyHeader", "target.isSystem",
+    "HorizontalFloatingToolbar", "TooltipBox", "ProcessMode", "high_cost_capture_point",
+):
+    if required not in manager_screen:
+        errors.append(f"Android 16 UI/i18n contract missing: {required}")
+if "ResetToolButton(state.canEdit, viewModel::restoreDefaults)" not in manager_screen:
+    errors.append("top app-bar reset must restore the complete default profile")
+if "onClick = viewModel::restoreDefaultBudgets" not in manager_screen:
+    errors.append("budget-page reset must remain budget-only")
+if "ACTION_LOCKED_BOOT_COMPLETED" not in boot_receiver or "createDeviceProtectedStorageContext" not in boot_receiver:
+    errors.append("direct-boot notification recovery contract missing")
+
+manifest = ET.fromstring(manifest_text) if manifest_text else None
+android_name = "{http://schemas.android.com/apk/res/android}name"
+android_locale_config = "{http://schemas.android.com/apk/res/android}localeConfig"
+uses = {node.attrib.get(android_name, "") for node in manifest.findall("uses-permission")} if manifest is not None else set()
+required_permissions = {
+    "android.permission.QUERY_ALL_PACKAGES", "android.permission.FORCE_STOP_PACKAGES",
+    "android.permission.RECEIVE_BOOT_COMPLETED",
+    "android.permission.POST_NOTIFICATIONS", "android.permission.MANAGE_R0DUMP_EXPORT",
+}
+if not required_permissions.issubset(uses):
+    errors.append(f"Manifest permissions missing: {sorted(required_permissions - uses)}")
+for forbidden in ("android.permission.MANAGE_R0DUMP", "android.permission.MANAGE_EXTERNAL_STORAGE", "android.permission.READ_LOGS"):
+    if forbidden in uses or f'name="{forbidden}"' in privapp:
+        errors.append(f"obsolete/excess permission remains: {forbidden}")
+if "android.permission.FORCE_STOP_PACKAGES" not in privapp:
+    errors.append("privapp allowlist must grant FORCE_STOP_PACKAGES")
+if "android.permission.MANAGE_R0DUMP_EXPORT" not in privapp:
+    errors.append("privapp allowlist must grant MANAGE_R0DUMP_EXPORT")
+if manifest is not None:
+    application = manifest.find("application")
+    if application is None or application.attrib.get(android_locale_config) != "@xml/locales_config":
+        errors.append("Manifest must declare the per-app locale config")
+if locale_config_text:
+    locale_config = ET.fromstring(locale_config_text)
+    locale_names = {
+        node.attrib.get(android_name, "") for node in locale_config.findall("locale")
+    }
+    if locale_names != {"en", "zh-CN"}:
+        errors.append(f"locale config must contain exactly en and zh-CN, got {sorted(locale_names)}")
+
+def strings(raw: str) -> dict[str, str]:
+    return {node.attrib["name"]: node.text or "" for node in ET.fromstring(raw).findall("string")} if raw else {}
+
+english_strings = strings(strings_en_text)
+chinese_strings = strings(strings_zh_text)
+english_keys = set(english_strings)
+chinese_keys = set(chinese_strings)
+if english_keys != chinese_keys or not english_keys:
+    errors.append(
+        f"English/Chinese string resources differ: missing zh={sorted(english_keys - chinese_keys)}, "
+        f"extra zh={sorted(chinese_keys - english_keys)}"
+    )
+for key in english_keys & chinese_keys:
+    english_args = re.findall(r"%\d+\$[a-zA-Z]", english_strings[key])
+    chinese_args = re.findall(r"%\d+\$[a-zA-Z]", chinese_strings[key])
+    if english_args != chinese_args:
+        errors.append(f"translation format arguments differ for {key}: en={english_args}, zh={chinese_args}")
+
+for required in (
+    "androidx.compose.material3_material3", "androidx.compose.material3_material3-window-size-class",
+    "androidx.compose.material_material-icons-extended", 'certificate: "platform"', "privileged: true",
+):
+    if required not in bp:
+        errors.append(f"Android.bp contract missing: {required}")
+product_packages = set()
+for assignment in re.findall(r"^PRODUCT_PACKAGES\s*\+=([^\n]*)", device_mk.replace("\\\n", " "), re.M):
+    product_packages.update(assignment.split("#", 1)[0].split())
+for module in ("R0dumpManager", "r0dump_file_helper", "r0dump_mcp_bridge"):
+    if module not in product_packages:
+        errors.append(f"lemonade user product does not include {module}")
+if not re.search(r'cc_binary\s*\{\s*name:\s*"r0dump_mcp_bridge"', helper_bp):
+    errors.append("MCP bridge must remain a native binary module")
+
+user_manager_policy = subprocess.run(
+    ["m4", "-Dtarget_build_variant=user", str(root / "system/sepolicy/public/te_macros"),
+     str(root / "system/sepolicy/private/r0dump_manager_app.te")],
+    check=True, capture_output=True, text=True,
+).stdout
+for required in (
+    "allow r0dump_manager_app self:unix_stream_socket { create bind listen accept read write getopt setopt shutdown };",
+    "allow shell r0dump_manager_app:unix_stream_socket connectto;",
+):
+    if required not in user_manager_policy:
+        errors.append(f"user build MCP SELinux contract missing: {required}")
+
+if "system_restricted_prop(r0dump_fusion_prop)" not in property_te:
+    errors.append("r0dump_fusion_prop type missing")
+if not re.search(r"persist\.sys\.r0dump\.fusion\.\s+u:object_r:r0dump_fusion_prop:s0\s+prefix", property_contexts):
+    errors.append("r0dump property prefix context missing")
+for required in (
+    "type r0dump_manager_app, domain;", "set_prop(r0dump_manager_app, r0dump_fusion_prop)",
+    "get_prop(appdomain, r0dump_fusion_prop)", "get_prop(system_server, r0dump_fusion_prop)",
+):
+    if required not in manager_te:
+        errors.append(f"Manager SELinux contract missing: {required}")
+if "name=com.android.r0dumpmanager" not in seapp_contexts or "domain=r0dump_manager_app" not in seapp_contexts:
+    errors.append("exact Manager seapp context missing")
+for generic_writer in ("set_prop(platform_app, r0dump_fusion_prop)", "set_prop(priv_app, r0dump_fusion_prop)"):
+    if generic_writer in manager_te:
+        errors.append(f"generic property writer forbidden: {generic_writer}")
+
+for required in (
+    "kExportProtocolMagic", "struct ExportRequest", "struct ExportResponse",
+    "kArchivePathBytes", "kSha256Bytes",
+):
+    if required not in helper_protocol:
+        errors.append(f"helper export protocol missing: {required}")
+for required in (
+    'kDownloadsRoot[] = "/mnt/user/0/emulated/0/Downloads"',
+    "RepairProcess", "codeitem_backfill", "AndroidManifest.xml", "CreateZip",
+    "Sha256File", "r0dump-exports",
+):
+    if required not in helper_export and required not in read(app / "helper/r0dump_file_helper.cpp"):
+        errors.append(f"helper repair/export implementation missing: {required}")
+for required in ("r0dump_exportLatest", "MANAGE_R0DUMP_EXPORT", "isUidForeground", "splitSourceDirs"):
+    if required not in activity_manager:
+        errors.append(f"system_server export boundary missing: {required}")
+for required in ("r0dump_exportLatest", "decodeResponse", "ArtifactExportResult"):
+    if required not in export_repository:
+        errors.append(f"Manager export repository missing: {required}")
+for required in ("allow r0dump_file_helper fuse:file create_file_perms", "allow r0dump_file_helper system_server:fd use"):
+    if required not in helper_te:
+        errors.append(f"helper export SELinux contract missing: {required}")
+
+if errors:
+    print("FAIL: R0dumpManager source contracts", file=sys.stderr)
+    for error in errors:
+        print(f" - {error}", file=sys.stderr)
+    raise SystemExit(1)
+
+print("PASS: 35 Framework fields and Manager draft fields")
+print("PASS: 43 ART and Manager capture points; force bit 41")
+print("PASS: direct Framework transaction boundary; no Broker/private reader")
+print("PASS: system-app manifest, product and dedicated SELinux contracts")
+print("PASS: Android 16 SavedState, predictive back, direct boot and en/zh-CN locale contracts")
+PY
