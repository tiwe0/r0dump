+    headerAction: (@Composable () -> Unit)? = null,
+    content: @Composable () -> Unit,
+) {
+    LazyColumn(modifier = modifier.fillMaxSize().imePadding().padding(horizontal = 16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
