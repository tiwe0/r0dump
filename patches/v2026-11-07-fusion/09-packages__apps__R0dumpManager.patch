@@ -0,0 +1,197 @@
+package com.android.r0dumpmanager.ui
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.requiredWidth
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.test.assertIsDisplayed
+import androidx.compose.ui.test.junit4.createComposeRule
+import androidx.compose.ui.test.onNodeWithContentDescription
+import androidx.compose.ui.test.onNodeWithText
+import androidx.compose.ui.test.performClick
+import androidx.test.platform.app.InstrumentationRegistry
+import com.android.r0dumpmanager.R
+import com.android.r0dumpmanager.app.R0dumpUiState
+import com.android.r0dumpmanager.data.property.FusionDeviceSnapshot
+import com.android.r0dumpmanager.domain.FusionConfigDraft
+import com.android.r0dumpmanager.domain.FusionConfigSchema
+import com.android.r0dumpmanager.domain.FusionConfigValidator
+import com.android.r0dumpmanager.domain.ProfileId
+import com.android.r0dumpmanager.domain.ProfileRegistry
+import com.android.r0dumpmanager.ui.theme.R0dumpManagerTheme
+import org.junit.Assert.assertEquals
+import org.junit.Rule
+import org.junit.Test
+
+class FusionActionToolbarTest {
+    @get:Rule
+    val composeTestRule = createComposeRule()
+
+    private val context get() = InstrumentationRegistry.getInstrumentation().targetContext
+
+    @Test
+    fun disabledStateEnablesFromTopBarToggle() {
+        var publishAndLaunchCalls = 0
+        setToggle(
+            state = state(snapshot = disabledSnapshot()),
+            onPublishAndLaunch = { publishAndLaunchCalls++ },
+        )
+
+        composeTestRule
+            .onNodeWithContentDescription(text(R.string.capture_toggle_enable))
+            .performClick()
+
+        assertEquals(1, publishAndLaunchCalls)
+    }
+
+    @Test
+    fun enabledStateDisablesFromTopBarToggle() {
+        var endSessionCalls = 0
+        val draft = validDraft().copy(enabled = true)
+        setToggle(
+            state = state(FusionDeviceSnapshot.Enabled(draft, 42)),
+            onEndSession = { endSessionCalls++ },
+        )
+
+        composeTestRule
+            .onNodeWithContentDescription(text(R.string.capture_toggle_disable))
+            .performClick()
+
+        assertEquals(1, endSessionCalls)
+    }
+
+    @Test
+    fun interruptedStateRecoversFromTopBarToggle() {
+        var recoveryCalls = 0
+        setToggle(
+            state = state(FusionDeviceSnapshot.Interrupted(43)),
+            onRecoverInterrupted = { recoveryCalls++ },
+        )
+
+        composeTestRule
+            .onNodeWithContentDescription(text(R.string.recover_disabled_state))
+            .performClick()
+
+        assertEquals(1, recoveryCalls)
+    }
+
+    @Test
+    fun validationToolbarNamesTheFieldAndExplainsHowToCorrectIt() {
+        setToolbar(state = invalidTargetProcessState())
+
+        composeTestRule.onNodeWithText(
+            text(
+                R.string.validation_issue_format,
+                text(R.string.target_process),
+                text(R.string.validation_target_process),
+            ),
+            substring = true,
+        ).assertIsDisplayed()
+    }
+
+    @Test
+    fun validDirtyDraftUsesToastAndTopBarPublishInsteadOfPersistentToolbar() {
+        assertEquals(false, shouldShowActionToolbar(state(snapshot = disabledSnapshot())))
+        assertEquals(false, shouldShowActionToolbar(dirtyState()))
+        assertEquals(true, shouldShowDraftPublishAction(dirtyState()))
+
+        assertEquals(false, shouldShowDraftChangedToast(consumedSerial = 0, currentSerial = 0))
+        assertEquals(true, shouldShowDraftChangedToast(consumedSerial = 0, currentSerial = 1))
+        assertEquals(false, shouldShowDraftChangedToast(consumedSerial = 1, currentSerial = 1))
+    }
+
+    @Test
+    fun processModeReflectsMainAllAndCustomTargets() {
+        val draft = validDraft()
+
+        assertEquals(ProcessMode.MAIN, processModeOf(draft))
+        assertEquals(ProcessMode.ALL, processModeOf(draft.copy(targetProcess = "")))
+        assertEquals(ProcessMode.CUSTOM, processModeOf(draft.copy(targetProcess = "${draft.targetPackage}:remote")))
+    }
+
+    private fun setToolbar(
+        state: R0dumpUiState,
+        horizontal: Boolean = false,
+    ) {
+        composeTestRule.setContent {
+            R0dumpManagerTheme {
+                Box(Modifier.requiredWidth(if (horizontal) 900.dp else 400.dp)) {
+                    FusionActionToolbar(
+                        state = state,
+                        horizontal = horizontal,
+                    )
+                }
+            }
+        }
+    }
+
+    private fun dirtyState(): R0dumpUiState {
+        val state = state(snapshot = disabledSnapshot())
+        val dirtyDraft = state.draft.copy(maxRecords = state.draft.maxRecords - 1)
+        return state.copy(
+            draft = dirtyDraft,
+            validation = FusionConfigValidator.validate(dirtyDraft, true),
+        )
+    }
+
+    private fun invalidTargetProcessState(): R0dumpUiState {
+        val state = state(snapshot = disabledSnapshot())
+        val invalidDraft = state.draft.copy(targetProcess = "${state.draft.targetPackage}:")
+        return state.copy(
+            draft = invalidDraft,
+            validation = FusionConfigValidator.validate(invalidDraft, true),
+        )
+    }
+
+    private fun setToggle(
+        state: R0dumpUiState,
+        onPublishAndLaunch: () -> Unit = {},
+        onEndSession: () -> Unit = {},
+        onRecoverInterrupted: () -> Unit = {},
+    ) {
+        composeTestRule.setContent {
+            R0dumpManagerTheme {
+                CaptureStateToggle(
+                    state = state,
+                    onPublishAndLaunch = onPublishAndLaunch,
+                    onEndSession = onEndSession,
+                    onRecoverInterrupted = onRecoverInterrupted,
+                    notificationsEnabled = true,
+                    onRequestNotifications = {},
+                )
+            }
+        }
+    }
+
+    private fun state(snapshot: FusionDeviceSnapshot): R0dumpUiState {
+        val draft = snapshot.draftOrNull() ?: validDraft()
+        return R0dumpUiState(
+            draft = draft,
+            deviceSnapshot = snapshot,
+            validation = FusionConfigValidator.validate(draft, true),
+            isForeground = true,
+        )
+    }
+
+    private fun disabledSnapshot(): FusionDeviceSnapshot.Disabled {
+        val draft = validDraft().copy(enabled = false)
+        return FusionDeviceSnapshot.Disabled(draft, 40)
+    }
+
+    private fun validDraft(): FusionConfigDraft = ProfileRegistry.apply(
+        ProfileId.COOLAPK_COOKIE_WALK,
+        FusionConfigSchema.defaults().copy(
+            runId = "20260830T000000Z-market-coolapk-cookie-walk",
+            targetPackage = "com.coolapk.market",
+            targetProcess = "com.coolapk.market",
+        ),
+    )
+
+    private fun FusionDeviceSnapshot.draftOrNull(): FusionConfigDraft? = when (this) {
+        is FusionDeviceSnapshot.Disabled -> draft
+        is FusionDeviceSnapshot.Enabled -> draft
+        else -> null
+    }
+
+    private fun text(resId: Int, vararg formatArgs: Any): String = context.getString(resId, *formatArgs)
+}
diff --git a/tools/deploy_userdebug.sh b/tools/deploy_userdebug.sh
new file mode 100755
index 0000000000000000000000000000000000000000..10cac3f2bab17b2075839595292077804cd16537
--- /dev/null
+++ b/tools/deploy_userdebug.sh
@@ -0,0 +1,203 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Incrementally deploy R0dumpManager artifacts to a debuggable physical device.
+# This script never builds or flashes a partition image.
+
+ADB_BIN="${ADB:-/mnt/c/Program Files/platformtools/adb.exe}"
+ADB_SERIAL="${ADB_SERIAL:-f5e3adbc}"
+ROOT_DIR="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
+OUT_DIR="${OUT_DIR:-$ROOT_DIR/out/target/product/lemonade}"
+WITH_FRAMEWORK=0
+WITH_ART=0
+WITH_FILE_HELPER=0
+WITH_SEPOLICY=0
+NO_REBOOT=0
+
+usage() {
+  cat <<'EOF'
+Usage: deploy_userdebug.sh [--with-framework] [--with-art]
+                           [--with-file-helper] [--with-sepolicy] [--no-reboot]
+
+By default, deploys only R0dumpManager.apk and its privapp allowlist.
+The caller must build the selected artifacts first using the userdebug lunch target.
+EOF
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --with-framework) WITH_FRAMEWORK=1 ;;
+    --with-art) WITH_ART=1 ;;
+    --with-file-helper) WITH_FILE_HELPER=1 ;;
+    --with-sepolicy) WITH_SEPOLICY=1 ;;
+    --no-reboot) NO_REBOOT=1 ;;
+    -h|--help) usage; exit 0 ;;
+    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
+  esac
+  shift
+done
+
+[[ -x "$ADB_BIN" ]] || { echo "ADB is not executable: $ADB_BIN" >&2; exit 1; }
+
+adb_device() { "$ADB_BIN" -s "$ADB_SERIAL" "$@"; }
+fail() { echo "FAIL: $*" >&2; exit 1; }
+require_file() { [[ -f "$1" ]] || fail "missing artifact: $1"; }
+push_system_file() {
+  local source="$1"
+  local destination="$2"
+  local mode="${3:-0644}"
+  echo "push: $source -> $destination"
+  adb_device push "$source" "$destination" >/dev/null
+  adb_device shell "chown root:root '$destination' && chmod '$mode' '$destination'"
+}
+
+apk="$OUT_DIR/system/priv-app/R0dumpManager/R0dumpManager.apk"
+privapp="$OUT_DIR/system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml"
+framework="$OUT_DIR/system/framework/framework.jar"
+framework_res="$OUT_DIR/system/framework/framework-res.apk"
+services="$OUT_DIR/system/framework/services.jar"
+art_apex="$OUT_DIR/system/apex/com.android.art.capex"
+file_helper="$OUT_DIR/system/bin/r0dump_file_helper"
+file_helper_rc="$OUT_DIR/system/etc/init/r0dump_file_helper.rc"
+mcp_bridge="$OUT_DIR/system/bin/r0dump_mcp_bridge"
+policy="$OUT_DIR/system/etc/selinux/plat_sepolicy.cil"
+seapp="$OUT_DIR/system/etc/selinux/plat_seapp_contexts"
+property_contexts="$OUT_DIR/system/etc/selinux/plat_property_contexts"
+file_contexts="$OUT_DIR/system/etc/selinux/plat_file_contexts"
+policy_hash="$OUT_DIR/system/etc/selinux/plat_sepolicy_and_mapping.sha256"
+
+# Split-policy devices compile platform, system_ext, and product policy
+# together when the vendor precompiled policy hash no longer matches.  Keep
+# these artifacts from the same Soong graph so a framework-only overlay cannot
+# leave init with an incompatible system_ext/product CIL pair.
+sepolicy_intermediates="$ROOT_DIR/out/soong/.intermediates/system/sepolicy"
+product_name="$(basename "$OUT_DIR")"
+plat_mapping="$(find "$sepolicy_intermediates/plat_mapping_file/android_common" \
+  -maxdepth 1 -type f -name '*.cil' -print -quit 2>/dev/null || true)"
+system_ext_policy="$sepolicy_intermediates/system_ext_sepolicy.cil/android_common/$product_name/system_ext_sepolicy.cil"
+system_ext_mapping="$(find "$sepolicy_intermediates/system_ext_mapping_file/android_common/$product_name" \
+  -maxdepth 1 -type f -name '*.cil' -print -quit 2>/dev/null || true)"
+system_ext_hash="$sepolicy_intermediates/system_ext_sepolicy_and_mapping.sha256/android_arm64_armv8-2a-dotprod_cortex-a76/system_ext_sepolicy_and_mapping.sha256"
+product_policy="$sepolicy_intermediates/product_sepolicy.cil/android_common/$product_name/product_sepolicy.cil"
+product_mapping="$(find "$sepolicy_intermediates/product_mapping_file/android_common/$product_name" \
+  -maxdepth 1 -type f -name '*.cil' -print -quit 2>/dev/null || true)"
+product_hash="$sepolicy_intermediates/product_sepolicy_and_mapping.sha256/android_arm64_armv8-2a-dotprod_cortex-a76/product_sepolicy_and_mapping.sha256"
+genfs_policy="$(find "$sepolicy_intermediates/compat" \
+  -maxdepth 4 -type f -name 'plat_sepolicy_genfs_*.cil' -print -quit 2>/dev/null || true)"
+
+# The hash is emitted as a Soong intermediate on some trees and is only copied
+# into system.img during image packaging. Accept that intermediate for adb push.
+if [[ ! -f "$policy_hash" ]]; then
+  policy_hash="$(find "$ROOT_DIR/out/soong/.intermediates/system/sepolicy/plat_sepolicy_and_mapping.sha256" \
+    -type f -name plat_sepolicy_and_mapping.sha256 -print -quit 2>/dev/null || true)"
+fi
+
+require_file "$apk"
+require_file "$privapp"
+if [[ "$WITH_FRAMEWORK" -eq 1 ]]; then
+  require_file "$framework"
+  require_file "$framework_res"
+  require_file "$services"
+fi
+if [[ "$WITH_ART" -eq 1 ]]; then
+  require_file "$art_apex"
+fi
+if [[ "$WITH_FILE_HELPER" -eq 1 ]]; then
+  require_file "$file_helper"
+  require_file "$file_helper_rc"
+  require_file "$mcp_bridge"
+fi
+if [[ "$WITH_SEPOLICY" -eq 1 ]]; then
+  require_file "$policy"
+  require_file "$seapp"
+  require_file "$property_contexts"
+  require_file "$file_contexts"
+  require_file "$policy_hash"
+  require_file "$plat_mapping"
+  require_file "$system_ext_policy"
+  require_file "$system_ext_mapping"
+  require_file "$system_ext_hash"
+  require_file "$product_policy"
+  require_file "$product_mapping"
+  require_file "$product_hash"
+fi
+
+state="$("$ADB_BIN" devices | tr -d '\r' | awk -v serial="$ADB_SERIAL" '$1 == serial {print $2}')"
+[[ "$state" == "device" ]] || fail "device $ADB_SERIAL is not available through ADB (state=${state:-missing})"
+
+build_type="$(adb_device shell getprop ro.build.type | tr -d '\r')"
+[[ "$build_type" == "userdebug" || "$build_type" == "eng" ]] ||
+  fail "incremental deployment requires userdebug/eng, found $build_type"
+
+echo "rooting adbd on $ADB_SERIAL ($build_type)"
+adb_device root >/dev/null
+adb_device wait-for-device
+[[ "$(adb_device shell id -u | tr -d '\r')" == "0" ]] || fail "adbd did not restart as root"
+
+remount_output="$(adb_device remount 2>&1 | tr -d '\r')"
+printf '%s\n' "$remount_output"
+grep -Eiq 'remount succeeded|remounted.*read-write|already mounted.*read-write' <<<"$remount_output" ||
+  fail "adb remount did not report success"
+
+adb_device shell am force-stop com.android.r0dumpmanager || true
+
+adb_device shell mkdir -p \
+  /system/priv-app/R0dumpManager /system/etc/permissions /system/framework \
+  /system/apex /system/bin /system/etc/init \
+  /system/etc/selinux /system/etc/selinux/mapping \
+  /system_ext/etc/selinux /system_ext/etc/selinux/mapping \
+  /product/etc/selinux /product/etc/selinux/mapping
+push_system_file "$apk" /system/priv-app/R0dumpManager/R0dumpManager.apk
+push_system_file "$privapp" /system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml
+
+if [[ "$WITH_FRAMEWORK" -eq 1 ]]; then
+  push_system_file "$framework" /system/framework/framework.jar
+  push_system_file "$framework_res" /system/framework/framework-res.apk
+  push_system_file "$services" /system/framework/services.jar
+fi
+
+if [[ "$WITH_ART" -eq 1 ]]; then
+  push_system_file "$art_apex" /system/apex/com.android.art.capex
+fi
+
+if [[ "$WITH_FILE_HELPER" -eq 1 ]]; then
+  push_system_file "$file_helper" /system/bin/r0dump_file_helper 0755
+  push_system_file "$file_helper_rc" /system/etc/init/r0dump_file_helper.rc
+  push_system_file "$mcp_bridge" /system/bin/r0dump_mcp_bridge 0755
+fi
+
+if [[ "$WITH_SEPOLICY" -eq 1 ]]; then
+  # Force split-policy compilation using policy pieces from one Soong graph.
+  push_system_file "$policy_hash" /system/etc/selinux/plat_sepolicy_and_mapping.sha256
+  push_system_file "$policy" /system/etc/selinux/plat_sepolicy.cil
+  push_system_file "$seapp" /system/etc/selinux/plat_seapp_contexts
+  push_system_file "$property_contexts" /system/etc/selinux/plat_property_contexts
+  push_system_file "$file_contexts" /system/etc/selinux/plat_file_contexts
+  push_system_file "$plat_mapping" "/system/etc/selinux/mapping/$(basename "$plat_mapping")"
+  push_system_file "$system_ext_policy" /system_ext/etc/selinux/system_ext_sepolicy.cil
+  push_system_file "$system_ext_mapping" "/system_ext/etc/selinux/mapping/$(basename "$system_ext_mapping")"
+  push_system_file "$system_ext_hash" /system_ext/etc/selinux/system_ext_sepolicy_and_mapping.sha256
+  push_system_file "$product_policy" /product/etc/selinux/product_sepolicy.cil
+  push_system_file "$product_mapping" "/product/etc/selinux/mapping/$(basename "$product_mapping")"
+  push_system_file "$product_hash" /product/etc/selinux/product_sepolicy_and_mapping.sha256
+  if [[ -n "$genfs_policy" ]]; then
+    push_system_file "$genfs_policy" "/system/etc/selinux/$(basename "$genfs_policy")"
+  fi
+fi
+
+adb_device shell restorecon \
+  /system/priv-app/R0dumpManager/R0dumpManager.apk \
+  /system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml \
+  /system/bin/r0dump_file_helper \
+  /system/bin/r0dump_mcp_bridge \
+  /system/etc/init/r0dump_file_helper.rc \
+  /system/apex/com.android.art.capex || true
+adb_device shell sync
+
+echo "deployed R0dumpManager artifacts successfully"
+if [[ "$NO_REBOOT" -eq 0 ]]; then
+  echo "rebooting device"
+  adb_device reboot
+else
+  echo "reboot skipped; changes requiring Framework or SELinux are not active yet"
+fi
