@@ -0,0 +1,31 @@
+package com.android.r0dumpmanager.data.ui
+
+import android.content.Context
+
+enum class UiStateKey {
+    DESTINATION,
+    CAPTURE_GROUPS,
+    BUDGET_GROUPS,
+    ADVANCED_GROUPS,
+}
+
+class UiStateStore(context: Context) {
+    private val preferences = context.applicationContext.getSharedPreferences(
+        PREFERENCES_NAME,
+        Context.MODE_PRIVATE,
+    )
+
+    fun read(key: UiStateKey): String? = preferences.getString(key.name, null)
+
+    fun write(key: UiStateKey, value: String) {
+        preferences.edit().putString(key.name, value).apply()
+    }
+
+    fun clear() {
+        preferences.edit().clear().commit()
+    }
+
+    private companion object {
+        const val PREFERENCES_NAME = "r0dump_ui_state"
+    }
+}
diff --git a/src/com/android/r0dumpmanager/domain/CapturePointRegistry.kt b/src/com/android/r0dumpmanager/domain/CapturePointRegistry.kt
new file mode 100644
index 0000000000000000000000000000000000000000..e0aceae2ef9c28becb71be4bd8dbdab575358c2b
--- /dev/null
+++ b/src/com/android/r0dumpmanager/domain/CapturePointRegistry.kt
@@ -0,0 +1,74 @@
+package com.android.r0dumpmanager.domain
+
+data class CapturePoint(
+    val bit: Int,
+    val name: String,
+    val sourceLocation: String,
+    val kind: String,
+)
+
+object CapturePointRegistry {
+    const val pointCount = 43
+    val definedMask: ULong = (1uL shl pointCount) - 1uL
+    val undefinedMask: ULong = definedMask.inv()
+    val forceNoExecuteMask: ULong = 1uL shl 41
+    // Baseline tuned to unpack first- and second-generation shells with whole-DEX
+    // capture (the design keeps records few: max_records caps at 4096, so per-method
+    // points are deliberately excluded). Covers the common load paths a gen-1 packer
+    // hands a decrypted DEX through -- OpenCommon (file), InMemory.dex.parsed
+    // (InMemoryDexClassLoader), Cookie.result.dex, RegisterDexFile.return -- plus the
+    // active DEX snapshot taken while walking (Walk.cookie.dex). ForceInvoke.no_execute
+    // materialises gen-2 method CodeItems into the in-memory image before it is
+    // snapshotted; pairing it with walk_mode=dex_names (walk every class) reaches
+    // lazily-restored methods without emitting a record per method.
+    val defaultMask: ULong = (1uL shl 0) or (1uL shl 2) or (1uL shl 3) or (1uL shl 5) or
+        (1uL shl 39) or forceNoExecuteMask
+    val points = listOf(
+        CapturePoint(0, "Cookie.result.dex", "CreateCookieFromOatFileManagerResult", "DEX snapshot"),
+        CapturePoint(1, "InMemory.buffer.copied", "DexFile_openInMemoryDexFilesNative", "raw buffer"),
+        CapturePoint(2, "InMemory.dex.parsed", "DexFile_openInMemoryDexFilesNative", "DEX snapshot"),
+        CapturePoint(3, "OpenCommon.return", "DexFileLoader::OpenCommon", "DEX snapshot"),
+        CapturePoint(4, "DefineClassNative.match", "DexFile_defineClassNative", "DEX snapshot"),
+        CapturePoint(5, "RegisterDexFile.return", "ClassLinker::RegisterDexFile", "DEX snapshot"),
+        CapturePoint(6, "DefineClass.entry", "ClassLinker::DefineClass", "class/Dex evidence"),
+        CapturePoint(7, "DefineClass.success", "ClassLinker::DefineClass", "metadata"),
+        CapturePoint(8, "LoadMethod.ready", "ClassLinker::LoadClassHelper::FillMethods", "CodeItem"),
+        CapturePoint(9, "LoadClass.entry", "ClassLinker::LoadClass", "metadata"),
+        CapturePoint(10, "LoadClass.success", "ClassLinker::LoadClass", "metadata"),
+        CapturePoint(11, "ResolveMethod.cache_hit", "ClassLinker::ResolveMethodId", "method evidence"),
+        CapturePoint(12, "ResolveMethod.lookup_success", "ClassLinker::ResolveMethodId", "method evidence"),
+        CapturePoint(13, "VerifyClass.complete", "ClassLinker::VerifyClass", "metadata"),
+        CapturePoint(14, "ClassInit.before_clinit", "ClassLinker::InitializeClass", "CodeItem/metadata"),
+        CapturePoint(15, "ClassInit.success", "ClassLinker::InitializeClass", "metadata"),
+        CapturePoint(16, "OatDexFile.open.success", "OatDexFile::OpenDexFile", "DEX snapshot"),
+        CapturePoint(17, "Vdex.load.complete", "OatFileAssistant::LoadDexFiles", "DEX snapshot"),
+        CapturePoint(18, "OatManager.file.complete", "OatFileManager::OpenDexFilesFromOat(path)", "DEX snapshot"),
+        CapturePoint(19, "OatManager.memory.complete", "OatFileManager::OpenDexFilesFromOat(memory)", "DEX/reference"),
+        CapturePoint(20, "OatManager.register.before_lock", "OatFileManager::RegisterOatFile", "metadata"),
+        CapturePoint(21, "ImageSpace.dex.tracked", "OatFileManager::OpenDexFilesFromOat(path)", "DEX/reference"),
+        CapturePoint(22, "ArtMethod.invoke.dispatch", "ArtMethod::Invoke", "method evidence"),
+        CapturePoint(23, "Interpreter.execute.entry", "interpreter::Execute", "method evidence"),
+        CapturePoint(24, "Jit.method_entered", "Jit::MethodEntered", "method evidence"),
+        CapturePoint(25, "Jit.compile.begin", "Jit::CompileMethodInternal", "CodeItem/metadata"),
+        CapturePoint(26, "Jit.compile.end", "Jit::CompileMethodInternal", "metadata"),
+        CapturePoint(27, "Reflect.method.before_invoke", "Method_invoke", "method evidence"),
+        CapturePoint(28, "Reflect.ctor.before_invoke", "Constructor_newInstance0", "method evidence"),
+        CapturePoint(29, "Instrumentation.enter", "Instrumentation::MethodEnterEventImpl", "method evidence"),
+        CapturePoint(30, "Instrumentation.exit.value", "Instrumentation::MethodExitEventImpl", "method evidence"),
+        CapturePoint(31, "Instrumentation.exit.object", "Instrumentation::MethodExitEventImpl", "method evidence"),
+        CapturePoint(32, "BDCL.path.constructor", "BaseDexClassLoader::<init>(path)", "DEX route"),
+        CapturePoint(33, "BDCL.memory.constructor", "BaseDexClassLoader::<init>(memory)", "buffer route"),
+        CapturePoint(34, "BDCL.findClass.success", "BaseDexClassLoader::findClass", "DEX route"),
+        CapturePoint(35, "BDCL.addDexPath.return", "BaseDexClassLoader::addDexPath", "DEX route"),
+        CapturePoint(36, "DexFile.open_file.return", "DexFile::openDexFile", "DEX route"),
+        CapturePoint(37, "DexFile.open_memory.return", "DexFile::openInMemoryDexFiles", "buffer route"),
+        CapturePoint(38, "DexFile.before_define", "DexFile::loadClassBinaryName", "DEX route"),
+        CapturePoint(39, "Walk.cookie.dex", "r0dump_Runtime_r0dump_CaptureCookie", "active DEX snapshot"),
+        CapturePoint(40, "Walk.executable.method", "r0dump_Runtime_r0dump_CaptureExecutable", "active method evidence"),
+        CapturePoint(41, "ForceInvoke.no_execute", "ArtMethod::Invoke", "active CodeItem"),
+        CapturePoint(42, "Nterp.method.entry", "ExecuteNterpImpl", "Nterp method evidence"),
+    )
+    init { check(points.map { it.bit } == (0 until pointCount).toList()) }
+    fun contains(mask: ULong, bit: Int) = bit in 0 until pointCount && (mask and (1uL shl bit)) != 0uL
+    fun toggle(mask: ULong, bit: Int): ULong = if (bit !in 0 until pointCount) mask else mask xor (1uL shl bit)
+}
diff --git a/src/com/android/r0dumpmanager/domain/FusionConfigDraft.kt b/src/com/android/r0dumpmanager/domain/FusionConfigDraft.kt
new file mode 100644
index 0000000000000000000000000000000000000000..cd77cafb494e767623dd1b0f3b12ebeae78b22ca
--- /dev/null
+++ b/src/com/android/r0dumpmanager/domain/FusionConfigDraft.kt
@@ -0,0 +1,54 @@
+package com.android.r0dumpmanager.domain
+
+/** Complete manager-owned representation of the Framework's strict JSON schema. */
+data class FusionConfigDraft(
+    val schema: Int = 1,
+    val enabled: Boolean = false,
+    val runId: String = "",
+    val targetPackage: String = "",
+    val targetProcess: String = "",
+    val capturePointMask: ULong = CapturePointRegistry.defaultMask,
+    // Whole-DEX captures across a multi-dex app plus its dynamically loaded shells
+    // need headroom, so the baseline runs at the validator ceiling (4096/512).
+    val maxRecords: Long = 4096,
+    val maxArtifacts: Long = 512,
+    val maxTotalBytes: Long = 1_073_741_824,
+    val maxDexBytes: Long = 268_435_456,
+    val bufferPoolBytes: Long = 536_870_912,
+    val maxCodeItemBytes: Long = 4_194_304,
+    val maxFrozenGenerations: Long = 4,
+    val flushIdleMs: Long = 500,
+    val manifestEnabled: Boolean = true,
+    val manifestIncludeSplits: Boolean = true,
+    val manifestMaxComponents: Long = 8192,
+    val manifestMaxSplits: Long = 32,
+    val manifestMaxEventsPerSource: Long = 16384,
+    val manifestMaxTotalEvents: Long = 65536,
+    val manifestMaxXmlDepth: Long = 64,
+    val manifestMaxAttributeLength: Long = 1024,
+    val walkEnabled: Boolean = true,
+    val walkStart: WalkStart = WalkStart.AFTER_APPLICATION_ON_CREATE,
+    // Walk every class named in the DEX, not only the already-loaded ones, so
+    // force-invoke reaches lazily-restored second-generation methods.
+    val walkMode: WalkMode = WalkMode.DEX_NAMES,
+    val walkNamespacePrefix: String = "",
+    val walkDelayMs: Long = 5000,
+    val walkMaxClasses: Long = 16_384,
+    val walkMaxMethods: Long = 65_536,
+    val forceInvokeEnabled: Boolean = true,
+    val forceClass: String = "",
+    val forceMethod: String = "",
+    val forceMethodDescriptor: String = "",
+    val forceMaxCalls: Long = 1,
+    val anrProtectionEnabled: Boolean = true,
+)
+
+enum class WalkStart(val propertyValue: String) {
+    AFTER_APPLICATION_ON_CREATE("after_application_on_create"),
+    AFTER_FIRST_ACTIVITY_ON_CREATE("after_first_activity_on_create"),
+}
+
+enum class WalkMode(val propertyValue: String) {
+    LOADED_ONLY("loaded_only"),
+    DEX_NAMES("dex_names"),
+}
diff --git a/src/com/android/r0dumpmanager/domain/FusionConfigSchema.kt b/src/com/android/r0dumpmanager/domain/FusionConfigSchema.kt
new file mode 100644
index 0000000000000000000000000000000000000000..884b75d4b3e46d7ea4b6ba50481e0ef09680bc15
--- /dev/null
+++ b/src/com/android/r0dumpmanager/domain/FusionConfigSchema.kt
@@ -0,0 +1,91 @@
+package com.android.r0dumpmanager.domain
+
+import org.json.JSONObject
+
+object FusionConfigSchema {
+    const val SCHEMA_VERSION = 1
+    const val PROPERTY_PREFIX = "persist.sys.r0dump.fusion."
+    const val PROPERTY_VALUE_MAX_UTF8_BYTES = 91
+    const val FIELD_COUNT = 35
+
+    val fields = listOf(
+        "schema", "enabled", "run_id", "target_package", "target_process", "capture_point_mask",
+        "max_records", "max_artifacts", "max_total_bytes", "max_dex_bytes", "buffer_pool_bytes",
+        "max_code_item_bytes", "max_frozen_generations", "flush_idle_ms", "manifest_enabled",
+        "manifest_include_splits", "manifest_max_components", "manifest_max_splits",
+        "manifest_max_events_per_source", "manifest_max_total_events", "manifest_max_xml_depth",
+        "manifest_max_attribute_length", "walk_enabled", "walk_start", "walk_mode", "walk_namespace_prefix", "walk_delay_ms",
+        "walk_max_classes", "walk_max_methods", "force_invoke_enabled", "force_class", "force_method",
+        "force_method_descriptor", "force_max_calls", "anr_protection_enabled",
+    )
+
+    fun defaults() = FusionConfigDraft()
+
+    fun restoreDefaultBudgets(draft: FusionConfigDraft): FusionConfigDraft {
+        val defaults = defaults()
+        return draft.copy(
+            maxRecords = defaults.maxRecords,
+            maxArtifacts = defaults.maxArtifacts,
+            maxTotalBytes = defaults.maxTotalBytes,
+            maxDexBytes = defaults.maxDexBytes,
+            bufferPoolBytes = defaults.bufferPoolBytes,
+            maxCodeItemBytes = defaults.maxCodeItemBytes,
+            maxFrozenGenerations = defaults.maxFrozenGenerations,
+            flushIdleMs = defaults.flushIdleMs,
+        )
+    }
+
+    fun maskText(mask: ULong): String = "0x" + mask.toString(16).padStart(16, '0')
+
+    /** Restores only the exhaustive draft representation kept in SavedStateHandle. */
+    fun fromJson(raw: String): FusionConfigDraft {
+        val json = JSONObject(raw)
+        require(json.length() == FIELD_COUNT)
+        require(json.keys().asSequence().toSet() == fields.toSet())
+        return FusionConfigDraft(
+            schema = json.getInt("schema"), enabled = json.getBoolean("enabled"),
+            runId = json.getString("run_id"), targetPackage = json.getString("target_package"),
+            targetProcess = json.getString("target_process"),
+            capturePointMask = json.getString("capture_point_mask").removePrefix("0x").toULong(16),
+            maxRecords = json.getLong("max_records"), maxArtifacts = json.getLong("max_artifacts"),
+            maxTotalBytes = json.getLong("max_total_bytes"), maxDexBytes = json.getLong("max_dex_bytes"),
+            bufferPoolBytes = json.getLong("buffer_pool_bytes"), maxCodeItemBytes = json.getLong("max_code_item_bytes"),
+            maxFrozenGenerations = json.getLong("max_frozen_generations"), flushIdleMs = json.getLong("flush_idle_ms"),
+            manifestEnabled = json.getBoolean("manifest_enabled"), manifestIncludeSplits = json.getBoolean("manifest_include_splits"),
+            manifestMaxComponents = json.getLong("manifest_max_components"), manifestMaxSplits = json.getLong("manifest_max_splits"),
+            manifestMaxEventsPerSource = json.getLong("manifest_max_events_per_source"), manifestMaxTotalEvents = json.getLong("manifest_max_total_events"),
+            manifestMaxXmlDepth = json.getLong("manifest_max_xml_depth"), manifestMaxAttributeLength = json.getLong("manifest_max_attribute_length"),
+            walkEnabled = json.getBoolean("walk_enabled"),
+            walkStart = WalkStart.entries.first { it.propertyValue == json.getString("walk_start") },
+            walkMode = WalkMode.entries.first { it.propertyValue == json.getString("walk_mode") },
+            walkNamespacePrefix = json.getString("walk_namespace_prefix"),
+            walkDelayMs = json.getLong("walk_delay_ms"), walkMaxClasses = json.getLong("walk_max_classes"),
+            walkMaxMethods = json.getLong("walk_max_methods"), forceInvokeEnabled = json.getBoolean("force_invoke_enabled"),
+            forceClass = json.getString("force_class"), forceMethod = json.getString("force_method"),
+            forceMethodDescriptor = json.getString("force_method_descriptor"), forceMaxCalls = json.getLong("force_max_calls"),
+            anrProtectionEnabled = json.getBoolean("anr_protection_enabled"),
+        )
+    }
+
+    /** Framework rejects omitted/unknown fields, so serialization is deliberately exhaustive. */
+    fun toJson(draft: FusionConfigDraft): String = JSONObject().apply {
+        put("schema", draft.schema); put("enabled", draft.enabled); put("run_id", draft.runId)
+        put("target_package", draft.targetPackage); put("target_process", draft.targetProcess)
+        put("capture_point_mask", maskText(draft.capturePointMask)); put("max_records", draft.maxRecords)
+        put("max_artifacts", draft.maxArtifacts); put("max_total_bytes", draft.maxTotalBytes)
+        put("max_dex_bytes", draft.maxDexBytes); put("buffer_pool_bytes", draft.bufferPoolBytes)
+        put("max_code_item_bytes", draft.maxCodeItemBytes); put("max_frozen_generations", draft.maxFrozenGenerations)
+        put("flush_idle_ms", draft.flushIdleMs); put("manifest_enabled", draft.manifestEnabled)
+        put("manifest_include_splits", draft.manifestIncludeSplits); put("manifest_max_components", draft.manifestMaxComponents)
+        put("manifest_max_splits", draft.manifestMaxSplits); put("manifest_max_events_per_source", draft.manifestMaxEventsPerSource)
+        put("manifest_max_total_events", draft.manifestMaxTotalEvents); put("manifest_max_xml_depth", draft.manifestMaxXmlDepth)
+        put("manifest_max_attribute_length", draft.manifestMaxAttributeLength); put("walk_enabled", draft.walkEnabled)
+        put("walk_start", draft.walkStart.propertyValue); put("walk_mode", draft.walkMode.propertyValue)
+        put("walk_namespace_prefix", draft.walkNamespacePrefix)
+        put("walk_delay_ms", draft.walkDelayMs); put("walk_max_classes", draft.walkMaxClasses)
+        put("walk_max_methods", draft.walkMaxMethods); put("force_invoke_enabled", draft.forceInvokeEnabled)
+        put("force_class", draft.forceClass); put("force_method", draft.forceMethod)
+        put("force_method_descriptor", draft.forceMethodDescriptor); put("force_max_calls", draft.forceMaxCalls)
+        put("anr_protection_enabled", draft.anrProtectionEnabled)
+    }.toString()
+}
