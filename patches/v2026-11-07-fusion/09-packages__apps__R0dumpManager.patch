+++ b/tools/test_export_latest.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+import zipfile
+
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import export_latest  # noqa: E402
+
+
+class ExportLatestTest(unittest.TestCase):
+    def test_parse_and_select_newest_candidate(self) -> None:
+        root = "/sdcard/Android/data/com.example.app/files/r0dump-fusion/runs"
+        candidates = export_latest.parse_candidates(
+            f"100\t2\t{root}/older\n200\t1\t{root}/newer\n", root
+        )
+        self.assertEqual("newer", export_latest.select_run(candidates, None).run_id)
+        self.assertEqual("older", export_latest.select_run(candidates, "older").run_id)
+        self.assertTrue(export_latest.candidate_script(root).endswith("exit 0"))
+
+    def test_rejects_invalid_package_and_remote_path(self) -> None:
+        with self.assertRaises(export_latest.ExportError):
+            export_latest.validate_package_name("com.example;id")
+        root = "/sdcard/Android/data/com.example.app/files/r0dump-fusion/runs"
+        with self.assertRaises(export_latest.ExportError):
+            export_latest.parse_candidates("1\t1\t/sdcard/other/run\n", root)
+
+    def test_explicit_run_path_is_validated_without_history_scan(self) -> None:
+        root = "/sdcard/Android/data/com.example.app/files/r0dump-fusion/runs"
+        self.assertEqual(
+            f"{root}/20260902TVCB-ui-targeted",
+            export_latest.run_path(root, "20260902TVCB-ui-targeted"),
+        )
+        for run_id in ("../escape", "run/child", "", "x" * 129):
+            with self.assertRaises(export_latest.ExportError):
+                export_latest.run_path(root, run_id)
+
+    def test_pull_run_uses_precreated_exact_destination(self) -> None:
+        class FakeClient:
+            remote = None
+            local = None
+
+            def pull(self, remote: str, local: Path) -> None:
+                self.remote = remote
+                self.local = local
+                process = local / "process-42"
+                (process / "artifacts").mkdir(parents=True)
+                (process / "session.json").write_text("{}\n", encoding="utf-8")
+                (process / "artifacts" / "one.dex.raw").write_bytes(b"dex")
+
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            destination = root / "run-with-exact-name"
+            candidate = export_latest.RunCandidate(
+                latest_artifact_mtime=1,
+                artifact_count=1,
+                remote_path="/remote/run-with-exact-name",
+            )
+            client = FakeClient()
+
+            export_latest.pull_run(client, candidate, destination)
+
+            self.assertEqual("/remote/run-with-exact-name/.", client.remote)
+            self.assertEqual("run-with-exact-name", client.local.name)
+            self.assertTrue((destination / "process-42/session.json").is_file())
+
+    def test_repairs_each_process_with_existing_host_repair(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            run = Path(directory) / "run"
+            process = run / "process-42"
+            (process / "records").mkdir(parents=True)
+            (process / "artifacts").mkdir()
+            (process / "session.json").write_text("{}\n", encoding="utf-8")
+            (process / "artifacts" / "000001.buffer.raw").write_bytes(b"not-a-dex")
+            (process / "records" / "000001.json").write_text(
+                json.dumps(
+                    {
+                        "capture_kind": "buffer",
+                        "artifact_relative_path": "artifacts/000001.buffer.raw",
+                    }
+                ),
+                encoding="utf-8",
+            )
+
+            reports = export_latest.repair_export(run)
+
+            self.assertEqual(1, len(reports))
+            self.assertEqual("ok", reports[0]["status"])
+            self.assertEqual(0, reports[0]["summary"]["verified"])
+            self.assertEqual(0, reports[0]["summary"]["repaired"])
+            self.assertEqual(1, reports[0]["summary"]["partial"])
+            self.assertEqual(0, reports[0]["summary"]["usable_outputs"])
+            self.assertEqual(
+                {"missing_dex_magic": 1}, reports[0]["summary"]["partial_reasons"]
+            )
+            report = run / reports[0]["report"]
+            self.assertTrue(report.is_file())
+            self.assertEqual("missing_dex_magic", json.loads(report.read_text())["records"][0]["reason"])
+
+    def test_missing_process_is_an_error(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            with self.assertRaises(export_latest.ExportError):
+                export_latest.repair_export(Path(directory))
+
+    def test_optional_tool_must_be_executable(self) -> None:
+        self.assertTrue(Path(export_latest.resolve_optional_tool(sys.executable, "python")).is_absolute())
+        with tempfile.TemporaryDirectory() as directory:
+            not_executable = Path(directory) / "tool"
+            not_executable.write_text("tool", encoding="utf-8")
+            with self.assertRaises(export_latest.ExportError):
+                export_latest.resolve_optional_tool(str(not_executable), "test tool")
+
+    def test_summary_counts_missing_artifact_as_partial(self) -> None:
+        summary = export_latest.repair_summary(
+            {
+                "records": [
+                    {"trust": "verified", "output": "repaired/a.dex"},
+                    {
+                        "trust": "repaired",
+                        "output": "repaired/b.dex",
+                        "output_kind": "codeitem_backfill",
+                    },
+                    {"trust": "partial"},
+                    {
+                        "status": "partial",
+                        "reason": "capture_dropped",
+                        "drop_reason": "pool_unavailable",
+                    },
+                ],
+                "reconstructions": [{"output": "repaired/b.dex"}],
+            }
+        )
+        self.assertEqual(1, summary["verified"])
+        self.assertEqual(1, summary["repaired"])
+        self.assertEqual(2, summary["partial"])
+        self.assertEqual(2, summary["usable_outputs"])
+        self.assertEqual(1, summary["codeitems_backfilled"])
+        self.assertEqual(1, summary["reconstructed_dex"])
+        self.assertEqual(
+            {"capture_dropped:pool_unavailable": 1, "unspecified": 1},
+            summary["partial_reasons"],
+        )
+
+    def test_archive_contains_run_and_has_sha256_sidecar(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            run = root / "com.example.app" / "run-1"
+            (run / "process-1" / "artifacts").mkdir(parents=True)
+            (run / "export-report.json").write_text("{}\n", encoding="utf-8")
+            (run / "process-1" / "artifacts" / "one.dex.raw").write_bytes(b"dex")
+            archive = run.parent / "run-1.zip"
+
+            archive_path, checksum_path = export_latest.create_archive(
+                run, "com.example.app", archive
+            )
+
+            self.assertTrue(archive_path.is_file())
+            self.assertEqual(
+                f"{export_latest.sha256_file(archive)}  run-1.zip\n",
+                checksum_path.read_text(encoding="utf-8"),
+            )
+            with zipfile.ZipFile(archive) as value:
+                self.assertEqual(
+                    [
+                        "com.example.app/run-1/export-report.json",
+                        "com.example.app/run-1/process-1/artifacts/one.dex.raw",
+                    ],
+                    sorted(value.namelist()),
+                )
+
+
+if __name__ == "__main__":
+    unittest.main()
