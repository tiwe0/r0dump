index 0000000000000000000000000000000000000000..b78b47d7cbe6dc77c737f1487e72b73d3dd88b4b
--- /dev/null
+++ b/test-apps/r0-multiprocess-probe/build.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+root=$(cd "$(dirname "$0")" && pwd)
+repo_root=$(cd "$root/../.." && pwd)
+android_jar="$repo_root/prebuilts/sdk/current/public/android.jar"
+aapt2="$repo_root/out/host/linux-x86/bin/aapt2"
+d8="$repo_root/out/host/linux-x86/bin/d8"
+zipalign="$repo_root/out/host/linux-x86/bin/zipalign"
+apksigner_jar="$repo_root/out/soong/.intermediates/tools/apksig/apksigner/linux_glibc_common/withres/apksigner.jar"
+work=$(mktemp -d "${TMPDIR:-/tmp}/r0-multiprocess-probe.XXXXXX")
+out="$root/r0-multiprocess-probe.apk"
+trap 'rm -rf "$work"' EXIT
+
+child_source="$root/src/com/r0dump/multiprocess/ChildService.java"
+cookie_source="$root/src/com/r0dump/multiprocess/CookieChurn.java"
+force_target_source="$root/src/com/r0dump/multiprocess/r0dump_ForceInvokeTarget.java"
+[[ $(grep -c 'return START_NOT_STICKY;' "$child_source") -eq 1 ]]
+[[ $(grep -c 'stopSelf(startId);' "$child_source") -eq 1 ]]
+! grep -q 'return START_STICKY;' "$child_source"
+[[ $(grep -c 'new InMemoryDexClassLoader' "$cookie_source") -eq 1 ]]
+[[ $(grep -c 'r0dump_noteClinit();' "$force_target_source") -eq 1 ]]
+[[ $(grep -c 'r0dump_noteDispatch();' "$force_target_source") -eq 1 ]]
+if rg -l 'r0dump_ForceInvokeTarget' "$root/src" | grep -Fvx "$force_target_source" >/dev/null; then
+  echo 'force-invoke target must not be referenced by normal app code' >&2
+  exit 1
+fi
+
+mkdir -p "$work/classes" "$work/dex"
+javac -source 8 -target 8 -bootclasspath "$android_jar" -d "$work/classes" \
+  "$root"/src/com/r0dump/multiprocess/*.java
+jar -cf "$work/classes.jar" -C "$work/classes" .
+"$d8" --min-api 35 --output "$work/dex" "$work/classes.jar"
+"$aapt2" link -I "$android_jar" --manifest "$root/AndroidManifest.xml" \
+  --min-sdk-version 35 --target-sdk-version 35 -o "$work/unsigned.apk"
+(cd "$work/dex" && zip -q "$work/unsigned.apk" classes.dex)
+"$zipalign" -f -p 4 "$work/unsigned.apk" "$work/aligned.apk"
+
+keystore="$root/.debug.keystore"
+if [[ ! -e "$keystore" ]]; then
+  keytool -genkeypair -keystore "$keystore" -storepass android -keypass android \
+    -alias androiddebugkey -keyalg RSA -keysize 2048 -validity 10000 \
+    -dname 'CN=Android Debug,O=Android,C=US'
+fi
+java -jar "$apksigner_jar" sign --ks "$keystore" --ks-key-alias androiddebugkey \
+  --ks-pass pass:android --key-pass pass:android --out "$out" "$work/aligned.apk"
+printf '%s\n' "$out"
diff --git a/test-apps/r0-multiprocess-probe/run-acceptance.sh b/test-apps/r0-multiprocess-probe/run-acceptance.sh
new file mode 100755
index 0000000000000000000000000000000000000000..f6a5de0c66d4be8ec3c90a24bec573b87490e671
--- /dev/null
+++ b/test-apps/r0-multiprocess-probe/run-acceptance.sh
@@ -0,0 +1,140 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+serial=${1:-${ANDROID_SERIAL:-}}
+if [[ -z "$serial" ]]; then
+  echo "usage: $0 <adb-serial>" >&2
+  exit 2
+fi
+
+root=$(cd "$(dirname "$0")" && pwd)
+repo_root=$(cd "$root/../.." && pwd)
+apk="$root/r0-multiprocess-probe.apk"
+dexdump="$repo_root/out/host/linux-x86/bin/dexdump"
+package=com.r0dump.multiprocess
+main_dir=/sdcard/Download/r0dump/com.r0dump.multiprocess
+child_dir=/sdcard/Download/r0dump/com.r0dump.multiprocess_child
+stamp=$(date +%Y%m%dT%H%M%S%z)
+evidence=${EVIDENCE_DIR:-/tmp/r0dump-multiprocess-evidence-$stamp}
+props=(dalvik.vm.r0dump.capture dalvik.vm.r0dump.watch_writes dalvik.vm.r0dump.watch_package)
+adb_cmd=(adb -s "$serial")
+
+mkdir -p "$evidence" "$evidence/pulled"
+"$root/build.sh" > "$evidence/build.log"
+[[ -s "$apk" ]] || { echo "missing APK: $apk" >&2; exit 1; }
+
+snapshot_props() {
+  : > "$evidence/props.before"
+  for prop in "${props[@]}"; do
+    printf '%s=%s\n' "$prop" "$("${adb_cmd[@]}" shell getprop "$prop" | tr -d '\r')" >> "$evidence/props.before"
+  done
+}
+
+restore_props() {
+  if [[ -f "$evidence/props.before" ]]; then
+    while IFS='=' read -r prop value; do
+      # `adb shell setprop name ""` must be evaluated by the device shell; passing an
+      # empty argv value directly to adb is dropped by some shell implementations.
+      "${adb_cmd[@]}" shell "setprop '$prop' '$value'" </dev/null >/dev/null || true
+    done < "$evidence/props.before"
+  fi
+  "${adb_cmd[@]}" shell am force-stop "$package" >/dev/null || true
+}
+trap restore_props EXIT
+
+"${adb_cmd[@]}" root >/dev/null || true
+"${adb_cmd[@]}" wait-for-device
+sleep 2
+snapshot_props
+"${adb_cmd[@]}" shell getprop ro.build.fingerprint | tr -d '\r' > "$evidence/build-fingerprint.txt"
+"${adb_cmd[@]}" install -r "$apk" | tee "$evidence/install.log"
+"${adb_cmd[@]}" shell "rm -rf '$main_dir' '$child_dir'" | tee "$evidence/clear-output.log"
+"${adb_cmd[@]}" shell "setprop dalvik.vm.r0dump.capture true; setprop dalvik.vm.r0dump.watch_writes true; setprop dalvik.vm.r0dump.watch_package $package"
+"${adb_cmd[@]}" logcat -c || true
+"${adb_cmd[@]}" shell am force-stop "$package" || true
+"${adb_cmd[@]}" shell monkey -p "$package" -c android.intent.category.LAUNCHER 1 | tee "$evidence/monkey.log"
+
+main_pid=
+child_pid=
+for _ in $(seq 1 60); do
+  main_pid=$("${adb_cmd[@]}" shell pidof "$package" 2>/dev/null | tr -d '\r' | awk '{print $1}' || true)
+  child_pid=$("${adb_cmd[@]}" shell pidof "$package:child" 2>/dev/null | tr -d '\r' | awk '{print $1}' || true)
+  [[ -n "$main_pid" && -n "$child_pid" ]] && break
+  sleep 1
+done
+[[ -n "$main_pid" ]] || { echo "main process did not start" >&2; exit 1; }
+[[ -n "$child_pid" ]] || { echo "child process did not start" >&2; exit 1; }
+printf 'main\t%s\t%s\nchild\t%s\t%s\n' "$package" "$main_pid" "$package:child" "$child_pid" | tee "$evidence/processes.tsv"
+
+# Let the documented 30-second quiet-period capture writers flush, then stop to satisfy acceptance cleanup.
+sleep 40
+"${adb_cmd[@]}" shell am force-stop "$package" | tee "$evidence/force-stop.log" || true
+sleep 2
+
+find_session() {
+  local dir=$1
+  "${adb_cmd[@]}" shell "find '$dir' -maxdepth 1 -type d -name 'session-*' 2>/dev/null | sort | tail -n 1" | tr -d '\r'
+}
+main_session=$(find_session "$main_dir")
+child_session=$(find_session "$child_dir")
+[[ -n "$main_session" ]] || { echo "missing main session under $main_dir" >&2; exit 1; }
+[[ -n "$child_session" ]] || { echo "missing child session under $child_dir" >&2; exit 1; }
+printf 'main_session=%s\nchild_session=%s\n' "$main_session" "$child_session" | tee "$evidence/sessions.txt"
+
+pull_session() {
+  local label=$1 remote=$2
+  local local_dir="$evidence/pulled/$label"
+  mkdir -p "$local_dir"
+  "${adb_cmd[@]}" pull "$remote" "$local_dir" >/dev/null
+  find "$local_dir" -type f | sort > "$evidence/${label}-files.txt"
+}
+pull_session main "$main_session"
+pull_session child "$child_session"
+
+validate_session() {
+  local label=$1
+  local local_root="$evidence/pulled/$label/$(basename "$main_session")"
+  if [[ "$label" == child ]]; then
+    local_root="$evidence/pulled/$label/$(basename "$child_session")"
+  fi
+  local manifest_count dex_count pass_count desc_main desc_child
+  manifest_count=$(find "$local_root" -type f -name 'manifest.tsv' -print | wc -l)
+  dex_count=$(find "$local_root" -type f -name '*.dex' ! -name 'segmented-layout.dex' -print | wc -l)
+  [[ "$manifest_count" -gt 0 ]] || { echo "$label: no manifest.tsv" >&2; exit 1; }
+  [[ "$dex_count" -gt 0 ]] || { echo "$label: no standard dex artifacts" >&2; exit 1; }
+  pass_count=0
+  : > "$evidence/${label}-dexdump.txt"
+  while IFS= read -r dex; do
+    if "$dexdump" -d "$dex" >> "$evidence/${label}-dexdump.txt" 2>&1; then
+      pass_count=$((pass_count + 1))
+      sha256sum "$dex" >> "$evidence/${label}-sha256.txt"
+    fi
+  done < <(find "$local_root" -type f -name '*.dex' ! -name 'segmented-layout.dex' -print | sort)
+  [[ "$pass_count" -gt 0 ]] || { echo "$label: no dexdump-passing standard DEX" >&2; exit 1; }
+  desc_main=$(grep -R -a -l 'Lcom/r0dump/multiprocess/MainTarget;' "$local_root" --include='*.dex' | wc -l)
+  desc_child=$(grep -R -a -l 'Lcom/r0dump/multiprocess/ChildTarget;' "$local_root" --include='*.dex' | wc -l)
+  [[ "$desc_main" -gt 0 ]] || { echo "$label: MainTarget descriptor missing" >&2; exit 1; }
+  [[ "$desc_child" -gt 0 ]] || { echo "$label: ChildTarget descriptor missing" >&2; exit 1; }
+  printf '%s\tmanifests=%s\tdex=%s\tdexdump_pass=%s\tMainTarget=%s\tChildTarget=%s\n' \
+    "$label" "$manifest_count" "$dex_count" "$pass_count" "$desc_main" "$desc_child" | tee -a "$evidence/summary.tsv"
+}
+validate_session main
+validate_session child
+
+restore_props
+trap - EXIT
+: > "$evidence/props.after"
+for prop in "${props[@]}"; do
+  printf '%s=%s\n' "$prop" "$("${adb_cmd[@]}" shell getprop "$prop" | tr -d '\r')" >> "$evidence/props.after"
+done
+if ! diff -u "$evidence/props.before" "$evidence/props.after" > "$evidence/props.diff"; then
+  echo "props were not restored" >&2
+  cat "$evidence/props.diff" >&2
+  exit 1
+fi
+if "${adb_cmd[@]}" shell pidof "$package" 2>/dev/null | grep -q .; then
+  echo "app still running after acceptance" >&2
+  exit 1
+fi
+
+echo "multiprocess acceptance PASS: $evidence"
