+package com.r0dump.v31;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.util.Log;
+
+public final class ProbeActivity extends Activity {
+    private static final String TAG = "R0V31Probe";
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        r0dump_WalkState.r0dump_begin(this);
+        // Load a known target through the ordinary app path.  Nothing in this class refers to
+        // r0dump_UninitializedSentinel: a loaded-only walk must therefore leave it unmaterialized.
+        Log.i(TAG, "walk-loaded=" + r0dump_LoadedTarget.r0dump_touch());
+
+        // Retain the older bounded-dispatch probe while the F7 fixture shares this APK.
+        Log.i(TAG, "probe=" + ProbeTarget.probe());
+    }
+}
