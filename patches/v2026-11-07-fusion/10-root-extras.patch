@@ -0,0 +1,114 @@
+#!/usr/bin/env bash
+# Verify the ART V2 write watcher against one installed protected package.
+set -euo pipefail
+
+ADB=${ADB:-adb}
+SERIAL=${R0_ADB_SERIAL:-}
+PACKAGE=
+TIMEOUT=180
+REPORT=
+
+usage() {
+  cat <<'USAGE'
+Usage: test-apps/run-v2-watch-test.sh --package PACKAGE [options]
+
+The test enables capture plus V2 monitoring only for PACKAGE, cold-starts it, then verifies that
+at least one actually-written DEX produced a coherent four-file V2 set under:
+  /sdcard/Download/r0dump/<package>/session-<pid>/write-watch/
+
+Options:
+  --package PACKAGE   Installed package to test (required)
+  --serial SERIAL     adb serial (default: R0_ADB_SERIAL or the sole device)
+  --timeout SECONDS   Wait limit for a stable V2 snapshot (default: 180)
+  --report PATH       Write one TSV result row
+  --adb PATH          adb executable (default: adb)
+USAGE
+}
+
+die() { printf 'error: %s\n' "$*" >&2; exit 2; }
+while (($#)); do
+  case "$1" in
+    --package) PACKAGE=${2:?--package requires a value}; shift 2 ;;
+    --serial) SERIAL=${2:?--serial requires a value}; shift 2 ;;
+    --timeout) TIMEOUT=${2:?--timeout requires a value}; shift 2 ;;
+    --report) REPORT=${2:?--report requires a value}; shift 2 ;;
+    --adb) ADB=${2:?--adb requires a value}; shift 2 ;;
+    -h|--help) usage; exit 0 ;;
+    *) die "unknown option: $1" ;;
+  esac
+done
+[[ -n $PACKAGE ]] || die '--package is required'
+[[ $TIMEOUT =~ ^[1-9][0-9]*$ ]] || die '--timeout must be a positive integer'
+command -v "$ADB" >/dev/null 2>&1 || die "adb not found: $ADB"
+
+if [[ -z $SERIAL ]]; then
+  mapfile -t devices < <("$ADB" devices | awk 'NR > 1 && $2 == "device" {print $1}')
+  [[ ${#devices[@]} == 1 ]] || die 'specify --serial unless exactly one device is connected'
+  SERIAL=${devices[0]}
+fi
+ADB_CMD=("$ADB" -s "$SERIAL")
+"${ADB_CMD[@]}" get-state | grep -qx device || die "device is not ready: $SERIAL"
+"${ADB_CMD[@]}" shell "pm path '$PACKAGE'" | grep -q '^package:' || die "package not installed: $PACKAGE"
+
+[[ -n $REPORT ]] || REPORT="${TMPDIR:-/tmp}/r0-v2-watch-$(date +%Y%m%d-%H%M%S).tsv"
+mkdir -p "$(dirname "$REPORT")"
+printf 'package\tstatus\tsession\tmeta_files\telapsed_s\tdetail\n' >"$REPORT"
+record() {
+  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$PACKAGE" "$1" "$2" "$3" "$4" "$5" | tee -a "$REPORT"
+}
+
+ROOT=/sdcard/Download/r0dump
+OUTPUT=$ROOT/$PACKAGE
+"${ADB_CMD[@]}" root >/dev/null
+mapfile -t old_sessions < <("${ADB_CMD[@]}" shell "find '$OUTPUT' -mindepth 1 -maxdepth 1 -type d -name 'session-*' -printf '%f\\n' 2>/dev/null" | tr -d '\r')
+"${ADB_CMD[@]}" shell "setprop dalvik.vm.dexunpack.capture true; setprop dalvik.vm.dexunpack.watch_writes true; setprop dalvik.vm.dexunpack.watch_package '$PACKAGE'; am force-stop '$PACKAGE'; logcat -c"
+"${ADB_CMD[@]}" shell "monkey -p '$PACKAGE' -c android.intent.category.LAUNCHER 1" >/dev/null || {
+  record LAUNCH_FAIL - 0 0 'monkey failed'; exit 1;
+}
+
+session=
+for elapsed in $(seq 1 "$TIMEOUT"); do
+  mapfile -t sessions < <("${ADB_CMD[@]}" shell "find '$OUTPUT' -mindepth 1 -maxdepth 1 -type d -name 'session-*' -printf '%f\\n' 2>/dev/null" | tr -d '\r')
+  for candidate in "${sessions[@]}"; do
+    seen=false
+    for old in "${old_sessions[@]}"; do [[ $candidate == "$old" ]] && { seen=true; break; }; done
+    if ! $seen; then session=$OUTPUT/$candidate; break; fi
+  done
+  [[ -n $session ]] || { sleep 1; continue; }
+  watch=$session/write-watch
+  meta_files=$("${ADB_CMD[@]}" shell "find '$watch' -maxdepth 1 -name '*.meta.json' -type f | wc -l" | tr -d '\r ')
+  [[ $meta_files =~ ^[0-9]+$ && $meta_files -gt 0 ]] || { sleep 1; continue; }
+  read -r -d '' remote_check <<'SH' || true
+for meta in "$1"/*.meta.json; do
+  [ -f "$meta" ] || continue
+  stem=${meta%.meta.json}
+  grep -q '"v2": true' "$meta" || { printf "bad-meta:%s" "$meta"; break; }
+  grep -q '"stable": true' "$meta" || { printf "unstable:%s" "$meta"; break; }
+  [ -s "$stem-initial.dex" ] && [ -s "$stem-stable.dex" ] && [ -s "$stem.diff.json" ] || {
+    printf "incomplete:%s" "$stem"; break; }
+  [ "$(od -An -N4 -tx1 "$stem-initial.dex" | tr -d " \\n")" = 6465780a ] || {
+    printf "bad-initial:%s" "$stem"; break; }
+  [ "$(od -An -N4 -tx1 "$stem-stable.dex" | tr -d " \\n")" = 6465780a ] || {
+    printf "bad-stable:%s" "$stem"; break; }
+  grep -q '"classification"' "$stem.diff.json" || { printf "bad-diff:%s" "$stem"; break; }
+done
+SH
+  encoded_check=$(printf '%s' "$remote_check" | base64 | tr -d '\n')
+  invalid=$("${ADB_CMD[@]}" shell "echo '$encoded_check' | base64 -d | sh -s '$watch'" | tr -d '\r')
+  if [[ -z $invalid ]]; then
+    record OK "$session" "$meta_files" "$elapsed" 'stable V2 initial/stable/meta/diff sets validated'
+    printf 'Report: %s\n' "$REPORT"
+    exit 0
+  fi
+  # A V2 set is expected to be briefly incomplete after the first sample; keep polling until
+  # it has the two equal post-write samples required for a stable snapshot.
+  if [[ $invalid == unstable:* || $invalid == incomplete:* ]]; then
+    sleep 1
+    continue
+  fi
+  record FAIL "$session" "$meta_files" "$elapsed" "$invalid"
+  exit 1
+done
+record TIMEOUT "${session:--}" 0 "$TIMEOUT" 'no stable V2 write-watch output'
+printf 'Report: %s\n' "$REPORT"
+exit 1
diff --git a/test-apps/tools/audit-manifest-classdefs.py b/test-apps/tools/audit-manifest-classdefs.py
new file mode 100755
index 0000000000000000000000000000000000000000..b38d4ac51384e5a0c9396e8e3377f71a09520c01
--- /dev/null
+++ b/test-apps/tools/audit-manifest-classdefs.py
@@ -0,0 +1,177 @@
+#!/usr/bin/env python3
+"""Audit manifest startup classes against r0dump segmented-layout.dex class_def tables.
+
+The audit is intentionally strict: a raw descriptor match is only a prefilter. A class
+passes only when its type index appears in the DEX class_defs section.
+"""
+import argparse
+import csv
+import importlib.util
+import os
+import struct
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+MANIFEST_TOOL = Path(__file__).with_name('manifest-key-classes.py')
+spec = importlib.util.spec_from_file_location('manifest_key_classes', MANIFEST_TOOL)
+manifest = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(manifest)
+
+
+def qualify(name, package):
+    if name.startswith('.'):
+        return package + name
+    if '.' not in name:
+        return package + '.' + name
+    return name
+
+
+def descriptor(class_name):
+    return 'L' + class_name.replace('.', '/') + ';'
+
+
+def u32(data, offset):
+    if offset < 0 or offset + 4 > len(data):
+        raise ValueError('u32 outside dex')
+    return struct.unpack_from('<I', data, offset)[0]
+
+
+def skip_uleb128(data, offset):
+    for _ in range(5):
+        if offset >= len(data):
+            raise ValueError('truncated uleb128')
+        value = data[offset]
+        offset += 1
+        if value < 0x80:
+            return offset
+    raise ValueError('overlong uleb128')
+
+
+def class_def_contains(data, wanted):
+    """Return True only if *wanted* is represented by a class_def item."""
+    if len(data) < 112 or data[:4] != b'dex\n':
+        raise ValueError('not a standard dex header')
+    string_count, string_off = u32(data, 56), u32(data, 60)
+    type_count, type_off = u32(data, 64), u32(data, 68)
+    class_count, class_off = u32(data, 96), u32(data, 100)
+    if string_off + 4 * string_count > len(data) or type_off + 4 * type_count > len(data):
+        raise ValueError('id table outside dex')
+    if class_off + 32 * class_count > len(data):
+        raise ValueError('class_def table outside dex')
+    for class_number in range(class_count):
+        type_index = u32(data, class_off + class_number * 32)
+        if type_index >= type_count:
+            raise ValueError('class_def type index outside type table')
+        string_index = u32(data, type_off + type_index * 4)
+        if string_index >= string_count:
+            raise ValueError('type string index outside string table')
+        string_data_off = u32(data, string_off + string_index * 4)
+        text_off = skip_uleb128(data, string_data_off)
+        end = data.find(b'\0', text_off)
+        if end < 0:
+            raise ValueError('unterminated dex string')
+        if data[text_off:end].decode('utf-8', 'replace') == wanted:
+            return True
+    return False
+
+
+def adb(args, *, binary=False, check=True):
+    command = [os.environ.get('ADB', 'adb'), *args]
+    return subprocess.run(command, check=check, stdout=subprocess.PIPE,
+                          stderr=subprocess.PIPE, text=not binary).stdout
+
+
+def dumped_dex_paths(package, wanted_descriptor):
+    root = f'/sdcard/Download/r0dump/{package}'
+    command = (f"find '{root}' -name segmented-layout.dex -exec "
+               f"grep -aFl -- '{wanted_descriptor}' {{}} + 2>/dev/null")
+    result = adb(['shell', command], check=False)
+    return [line.strip() for line in result.splitlines() if line.strip()]
+
+
+def audit_class(package, class_name):
+    """Verify candidate Dex files on-device with ART dexdump's class_def reader."""
+    wanted = descriptor(class_name)
+    paths = dumped_dex_paths(package, wanted)
+    if not paths:
+        return 'MISSING', '', 'no dumped Dex contains descriptor'
+    failures = []
+    for remote_path in paths:
+        command = (f"/apex/com.android.art/bin/dexdump -i -j -f '{remote_path}' "
+                   f"2>&1 | grep -F -m1 \"Class descriptor  : '{wanted}'\"")
+        match = adb(['shell', command], check=False).strip()
+        if match:
+            return 'PRESENT', remote_path, 'ART dexdump found descriptor in class_defs'
+        failures.append(remote_path)
+    return ('RAW_ONLY', ';'.join(paths),
+            'descriptor found, but ART dexdump found no matching class_def')
+
+
+def source_packages(paths):
+    result = {}
+    for path in paths:
+        package, rows = manifest.extract(str(path))
+        applications = [name for kind, name in rows if kind == 'application']
+        result[package] = (path, applications)
+    return result
+
+
+def read_runs(paths):
+    runs = {}
+    for path in paths:
+        with open(path, newline='') as source:
+            for row in csv.DictReader(source, delimiter='\t'):
+                runs[row['package']] = row
+    return runs
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--runs', action='append', required=True, type=Path)
+    parser.add_argument('--sample', action='append', required=True, type=Path)
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    sources = source_packages(args.sample)
+    runs = read_runs(args.runs)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open('w', newline='') as target:
+        fields = ['package', 'sample', 'role', 'class_name', 'capture_count',
+                  'process_after_15s', 'status', 'dex_path', 'detail']
+        writer = csv.DictWriter(target, fieldnames=fields, delimiter='\t')
+        writer.writeheader()
+        for package in sorted(sources):
+            sample, applications = sources[package]
+            run = runs.get(package, {})
+            capture_count = run.get('segmented_dex', 'NOT_RUN')
+            process = run.get('pid_after_15s', 'NOT_RUN')
+            checked = []
+            for app in applications:
+                checked.append(('application', app))
+            launch = run.get('launch', '')
+            if '/' in launch:
+                checked.append(('launcher', qualify(launch.split('/', 1)[1], package)))
+            if not checked:
+                writer.writerow({'package': package, 'sample': sample, 'role': 'startup',
+                                 'class_name': '', 'capture_count': capture_count,
+                                 'process_after_15s': process, 'status': 'NOT_DECLARED',
+                                 'dex_path': '', 'detail': 'no application or resolved launcher'})
+            seen = set()
+            for role, class_name in checked:
+                if (role, class_name) in seen:
+                    continue
+                seen.add((role, class_name))
+                if capture_count in {'0', 'NOT_RUN'}:
+                    status, dex_path, detail = ('NO_CAPTURE', '',
+                                                  'no segmented-layout.dex from this run')
+                else:
+                    status, dex_path, detail = audit_class(package, class_name)
+                writer.writerow({'package': package, 'sample': sample, 'role': role,
+                                 'class_name': class_name, 'capture_count': capture_count,
+                                 'process_after_15s': process, 'status': status,
+                                 'dex_path': dex_path, 'detail': detail})
+
+
+if __name__ == '__main__':
+    main()
