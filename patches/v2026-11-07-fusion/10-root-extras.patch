@@ -0,0 +1,49 @@
+# 刷机后测试样本
+
+将每次全量刷机后需要安装的 `.apk`、`.apks` 或 `.apkm` 放在此目录；可以使用
+子目录分类。`.apks`/`.apkm` 会被视为 split APK 压缩包处理，而不是当作普通 APK。
+
+## 安装
+
+```bash
+# 多设备时必须明确指定，避免误装到别的手机。
+./test-apps/install-samples.sh --serial f5e3adbc
+
+# 或设置默认设备序列号。
+R0_ADB_SERIAL=f5e3adbc ./test-apps/install-samples.sh
+
+# 只检查归档内容与将要选择的 split，不安装。
+./test-apps/install-samples.sh --serial f5e3adbc --dry-run
+```
+
+脚本会：
+
+- 递归扫描此目录中的三种文件格式；
+- 使用 `adb install -r -g` 安装普通 APK；
+- 对 APKS/APKM 解压，并安装 `base`/功能模块、设备 ABI 对应的 split，以及与
+  `wm density` 最接近的密度 split；
+- 自动拒绝多设备未指定序列号的情形；
+- 在 `/tmp` 生成带时间戳的 TSV 安装报告（可用 `--report` 指定保存位置），并以
+  非零退出码表示任一样本失败。
+
+要求：WSL/Linux 侧的 `adb` 与 `unzip` 均可用。默认不包含语言 split，应用会回退到
+base APK 中的资源。
+
+## 验证 ART DexUnpack 第二阶段
+
+在已刷入带 DexUnpack 的 `userdebug` 系统且已安装样本后，使用：
+
+```bash
+./test-apps/run-phase2-test.sh --serial f5e3adbc --package com.icbc.elife
+```
+
+脚本会强制停止目标应用、记录已有 session、冷启动应用，然后只等待本轮 PID 新建的
+`/sdcard/Download/r0dump/<package>/session-<pid>/manifest.tsv`。只有当该 session 的 manifest 行数与
+`.dex` 文件数相同、且每个文件均以 `dex\n` 头开始时，才报告 `PHASE2_COMPLETE`。结果默认写入
+`/tmp/r0-phase2-results-*.tsv`。
+
+每次启动保留一个 `session-<pid>` 目录。这规避了 Android 外置存储 FUSE 对已删除同名文件的重建限制，也让多轮
+结果可并存；按需清理整个包目录即可释放空间。
+
+大样本的反射遍历可持续数分钟，因此测试以**最终产物**为准，而非仅依赖 logcat 中短暂的
+`ActivityThread: DexUnpack phase 2 completed` 行。
diff --git a/test-apps/frida/icbc-aboutus-observe.js b/test-apps/frida/icbc-aboutus-observe.js
new file mode 100644
index 0000000000000000000000000000000000000000..62a9d3354b6adcf489d1cc5e2054adb7329e2088
--- /dev/null
+++ b/test-apps/frida/icbc-aboutus-observe.js
@@ -0,0 +1,89 @@
+'use strict';
+
+// Observation-only probe for the ICBC test sample. It does not replace methods, alter return
+// values, invoke app code, or write target-process memory.
+function report(kind, value) {
+  send({ kind: kind, value: String(value) });
+}
+
+function hookClassLoaders() {
+  const ClassLoader = Java.use('java.lang.ClassLoader');
+  const loadClass = ClassLoader.loadClass.overload('java.lang.String');
+  loadClass.implementation = function (name) {
+    const result = loadClass.call(this, name);
+    if (name.indexOf('AboutusActivity') !== -1) {
+      report('class-load', this.toString() + ' -> ' + name);
+    }
+    return result;
+  };
+
+  const InMemoryDexClassLoader = Java.use('dalvik.system.InMemoryDexClassLoader');
+  for (const overload of InMemoryDexClassLoader.$init.overloads) {
+    overload.implementation = function () {
+      report('in-memory-dex-init', overload.argumentTypes.map(t => t.className).join(','));
+      return overload.apply(this, arguments);
+    };
+  }
+}
+
+function hookNativeLoads() {
+  const Runtime = Java.use('java.lang.Runtime');
+  const load0 = Runtime.load0.overload('java.lang.Class', 'java.lang.String');
+  load0.implementation = function (fromClass, filename) {
+    if (filename.indexOf('dex') !== -1 || filename.indexOf('encrypt') !== -1) {
+      report('native-load', filename);
+    }
+    return load0.call(this, fromClass, filename);
+  };
+}
+
+function hookAboutusWhenAvailable() {
+  if (hookAboutusWhenAvailable.installed) return;
+  const target = 'com.icbc.elife.AboutusActivity';
+  try {
+    const Aboutus = Java.use(target);
+    ['onCreate', 'onStart', 'onResume', 'onClick'].forEach(function (methodName) {
+      if (!Aboutus[methodName]) return;
+      Aboutus[methodName].overloads.forEach(function (overload) {
+        overload.implementation = function () {
+          report('aboutus-enter', methodName + ' ' + overload.argumentTypes.map(t => t.className).join(','));
+          return overload.apply(this, arguments);
+        };
+      });
+    });
+    hookAboutusWhenAvailable.installed = true;
+    report('aboutus-hooked', target);
+  } catch (e) {
+    report('aboutus-not-yet-available', e);
+  }
+}
+hookAboutusWhenAvailable.installed = false;
+
+function reportRelevantModules() {
+  Process.enumerateModules().forEach(function (module) {
+    if (module.name.indexOf('dex') !== -1 || module.name.indexOf('encrypt') !== -1) {
+      report('module', module.name + ' @ ' + module.base + ' size=' + module.size);
+      try {
+        module.enumerateExports().forEach(function (exp) {
+          const name = exp.name.toLowerCase();
+          if (name.indexOf('dex') !== -1 || name.indexOf('decrypt') !== -1 ||
+              name.indexOf('encrypt') !== -1 || name.indexOf('code') !== -1) {
+            report('native-export', module.name + '!' + exp.name + ' @ ' + exp.address);
+          }
+        });
+      } catch (e) {
+        report('module-enumeration-error', module.name + ': ' + e);
+      }
+    }
+  });
+}
+
+Java.perform(function () {
+  report('ready', Process.id);
+  hookClassLoaders();
+  hookNativeLoads();
+  hookAboutusWhenAvailable();
+  reportRelevantModules();
+  setInterval(hookAboutusWhenAvailable, 1000);
+  setInterval(reportRelevantModules, 1500);
+});
diff --git a/test-apps/frida/observe_icbc_attached.py b/test-apps/frida/observe_icbc_attached.py
new file mode 100644
index 0000000000000000000000000000000000000000..dcd75797677b4b6daf28282672544158c3a1ca79
--- /dev/null
+++ b/test-apps/frida/observe_icbc_attached.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Attach-only observation of ICBC's AboutusActivity startup.
+
+Frida 17.9.11 cannot spawn this Android 16 build, so this deliberately starts the app through
+adb first and attaches to its already-running process. The loaded JavaScript is observation-only.
+"""
+
+from __future__ import annotations
+
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import frida
+
+
+SERIAL = sys.argv[1] if len(sys.argv) > 1 else "f5e3adbc"
+ROOT = Path(__file__).resolve().parents[2]
+SCRIPT = ROOT / "test-apps/frida/icbc-aboutus-observe.js"
+
+
+def adb(*args: str, capture: bool = False) -> str:
+    result = subprocess.run(
+        ["adb", "-s", SERIAL, *args], check=True, text=True, capture_output=capture
+    )
+    return result.stdout if capture else ""
+
+
+def wait_for_app_pid() -> str:
+    for _ in range(20):
+        result = subprocess.run(
+            ["adb", "-s", SERIAL, "shell", "pidof com.icbc.elife"], text=True, capture_output=True
+        )
+        pids = result.stdout.strip().split()
+        if pids:
+            return pids[0]
+        time.sleep(1)
+    raise RuntimeError("com.icbc.elife did not start")
+
+
+def main() -> None:
+    adb("shell", "setprop dalvik.vm.dexunpack.capture false; am force-stop com.icbc.elife; logcat -c")
+    adb("shell", "monkey -p com.icbc.elife -c android.intent.category.LAUNCHER 1")
+    pid = wait_for_app_pid()
+    print(f"attached-pid={pid}", flush=True)
+    device = frida.get_usb_device(timeout=10)
+    session = device.attach(int(pid))
+    script = session.create_script(SCRIPT.read_text())
+
+    def on_message(message, _data) -> None:
+        if message["type"] == "send":
+            print(message["payload"], flush=True)
+        else:
+            print(message, flush=True)
+
+    script.on("message", on_message)
+    script.load()
+    time.sleep(2)
+    adb("shell", "am start -W -n com.icbc.elife/.AboutusActivity")
+    time.sleep(12)
+    print("current-pids=" + adb("shell", "pidof com.icbc.elife", capture=True).strip(), flush=True)
+    session.detach()
+
+
+if __name__ == "__main__":
+    main()
