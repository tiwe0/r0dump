@@ -0,0 +1,34 @@
+package com.r0dump.v31;
+
+/** A deliberately side-effect-free target used to verify bounded V3.2 interpreter dispatch. */
+public final class ProbeTarget {
+    private ProbeTarget() {}
+
+    public static int probe() {
+        // Keep more than eight simple DEX instructions so every V3 budget in the validation
+        // ladder stops at a dispatch boundary rather than reaching the method return.
+        int a = 1;
+        int b = a + 2;
+        int c = b + 3;
+        int d = c + 4;
+        int e = d + 5;
+        int f = e + 6;
+        int g = f + 7;
+        int h = g + 8;
+        return h + 6;
+    }
+
+    /**
+     * V3.2 nested-boundary control: ART must stop before this invoke-static can transfer into
+     * {@link #nestedLeaf()}, which would otherwise bypass the bounded switch-interpreter gate.
+     */
+    public static int nestedProbe() {
+        return nestedLeaf();
+    }
+
+    private static int nestedLeaf() {
+        int value = 40;
+        return value + 2;
+    }
+}
+
