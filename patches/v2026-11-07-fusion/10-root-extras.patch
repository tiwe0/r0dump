+package com.r0dump.multiprocess;
+
+import android.app.Service;
+import android.content.Intent;
+import android.os.IBinder;
+import android.util.Log;
+
+public final class ChildService extends Service {
+    private static final String TAG = "R0MultiProbe";
+    private boolean churnStarted;
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        int value = ChildTarget.deterministicValue(11);
+        Log.i(TAG, "child target value=" + value);
+        if (!churnStarted) {
+            churnStarted = true;
+            CookieChurn.runAsync(this, new CookieChurn.Completion() {
+                @Override
+                public void accept(String result) {
+                    Log.i(TAG, result);
+                    stopSelf(startId);
+                }
+            });
+        }
+        return START_NOT_STICKY;
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+}
