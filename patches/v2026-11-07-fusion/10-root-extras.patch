+## 5. 落盘函数（`class_linker.cc`）
+
+```cpp
+void ClassLinker::DumpRegisteredDex() {
+  // 目标目录：/data/local/tmp/dexdump/<进程名>/
+  char dir[512];
+  int procid = getpid();
+  char procname[256] = {0};
+  int fd = open("/proc/self/cmdline", O_RDONLY);
+  if (fd >= 0) { read(fd, procname, 255); close(fd); }
+  snprintf(dir, sizeof(dir), "/data/local/tmp/dexdump/%s", procname);
+  mkdir(dir, 0777);  // 递归创建
+
+  MutexLock mu(Thread::Current(), *registered_dex_lock_);
+  for (auto& [key, info] : registered_dex_map_) {
+    if (info.dumped || info.dex_copy == nullptr) continue;
+    char path[512];
+    snprintf(path, sizeof(path), "%s/%lld_%zu_%s.dex",
+             dir, static_cast<long long>(info.timestamp_ns), info.size, info.location.c_str());
+    int f = open(path, O_CREAT | O_RDWR, 0666);
+    if (f >= 0) {
+      write(f, info.dex_copy.get(), info.size);
+      fsync(f);
+      close(f);
+      info.dumped = true;
+      LOG(INFO) << "DexUnpack: dumped " << path << " size=" << info.size;
+    }
+  }
+}
+```
+
+> 需要 `#include <fcntl.h>`, `<unistd.h>`, `<sys/stat.h>`。
