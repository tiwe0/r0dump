diff --git a/test-apps/install-samples.sh b/test-apps/install-samples.sh
new file mode 100755
index 0000000000000000000000000000000000000000..02a1807252244dd3a25d18435b1195a74d2c9ea5
--- /dev/null
+++ b/test-apps/install-samples.sh
@@ -0,0 +1,217 @@
+#!/usr/bin/env bash
+# Installs every APK, APKS, and APKM below this directory on one Android device.
+# APKS/APKM archives are unpacked temporarily and installed as a compatible split set.
+
+set -uo pipefail
+
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+SAMPLES_DIR=$SCRIPT_DIR
+ADB=${ADB:-adb}
+SERIAL=${R0_ADB_SERIAL:-}
+DRY_RUN=false
+REPORT=
+
+usage() {
+  cat <<'EOF'
+Usage: test-apps/install-samples.sh [options]
+
+Install all .apk, .apks, and .apkm files below the sample directory.
+
+Options:
+  --serial SERIAL       Target device serial. Required when more than one device is attached.
+  --samples-dir DIR     Directory to scan (default: the test-apps directory).
+  --adb PATH            adb executable (default: $ADB or adb from PATH).
+  --report PATH         Write a TSV result report to PATH.
+  --dry-run             Validate archives and print the selected APKs without installing.
+  -h, --help            Show this help.
+
+Environment:
+  R0_ADB_SERIAL         Default serial number, equivalent to --serial.
+  ADB                    Default adb executable, equivalent to --adb.
+
+For split archives, the installer includes all base/feature APKs, then selects the
+device-compatible ABI split and the density split closest to `wm density`. Locale
+splits are intentionally omitted: Android falls back to resources in the base APK.
+EOF
+}
+
+die() {
+  printf 'error: %s\n' "$*" >&2
+  exit 2
+}
+
+while (($#)); do
+  case "$1" in
+    --serial) SERIAL=${2:?--serial requires a value}; shift 2 ;;
+    --samples-dir) SAMPLES_DIR=${2:?--samples-dir requires a value}; shift 2 ;;
+    --adb) ADB=${2:?--adb requires a value}; shift 2 ;;
+    --report) REPORT=${2:?--report requires a value}; shift 2 ;;
+    --dry-run) DRY_RUN=true; shift ;;
+    -h|--help) usage; exit 0 ;;
+    *) die "unknown option: $1" ;;
+  esac
+done
+
+command -v "$ADB" >/dev/null 2>&1 || die "adb not found: $ADB"
+command -v unzip >/dev/null 2>&1 || die 'unzip is required'
+[[ -d $SAMPLES_DIR ]] || die "sample directory does not exist: $SAMPLES_DIR"
+
+mapfile -t attached < <("$ADB" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
+if [[ -z $SERIAL ]]; then
+  case ${#attached[@]} in
+    0) die 'no authorized Android device is attached' ;;
+    1) SERIAL=${attached[0]} ;;
+    *)
+      printf 'error: more than one Android device is attached; use --serial:\n' >&2
+      printf '  %s\n' "${attached[@]}" >&2
+      exit 2
+      ;;
+  esac
+fi
+
+ADB_CMD=("$ADB" -s "$SERIAL")
+"${ADB_CMD[@]}" get-state 2>/dev/null | grep -qx device || die "device is not ready: $SERIAL"
+
+device_abis=$("${ADB_CMD[@]}" shell getprop ro.product.cpu.abilist | tr -d '\r')
+[[ -n $device_abis ]] || device_abis=$("${ADB_CMD[@]}" shell getprop ro.product.cpu.abi | tr -d '\r')
+device_density=$("${ADB_CMD[@]}" shell wm density | sed -n 's/^Physical density: \([0-9][0-9]*\).*/\1/p' | head -n 1)
+[[ $device_density =~ ^[0-9]+$ ]] || device_density=160
+
+if [[ -z $REPORT ]]; then
+  REPORT="${TMPDIR:-/tmp}/r0-install-results-$(date +%Y%m%d-%H%M%S).tsv"
+fi
+mkdir -p "$(dirname "$REPORT")"
+printf 'sample\tformat\tresult\tdetail\n' > "$REPORT"
+
+WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/r0-sample-install.XXXXXX")
+cleanup() {
+  [[ -d $WORK_DIR ]] && rm -rf "$WORK_DIR"
+}
+trap cleanup EXIT
+
+record_result() {
+  local sample=$1 format=$2 result=$3 detail=$4
+  detail=${detail//$'\t'/ }
+  detail=${detail//$'\n'/ }
+  printf '%s\t%s\t%s\t%s\n' "$sample" "$format" "$result" "$detail" | tee -a "$REPORT"
+}
+
+split_abi_matches_device() {
+  local split_abi=$1 abi
+  IFS=, read -r -a abi_list <<< "$device_abis"
+  for abi in "${abi_list[@]}"; do
+    [[ ${abi//-/_} == "$split_abi" ]] && return 0
+  done
+  return 1
+}
+
+density_value() {
+  case "$1" in
+    ldpi) echo 120 ;; mdpi) echo 160 ;; tvdpi) echo 213 ;; hdpi) echo 240 ;;
+    xhdpi) echo 320 ;; xxhdpi) echo 480 ;; xxxhdpi) echo 640 ;;
+    *) return 1 ;;
+  esac
+}
+
+choose_density_split() {
+  local directory=$1 apk name density value distance best= best_distance=
+  while IFS= read -r -d '' apk; do
+    name=$(basename "$apk")
+    if [[ $name =~ ^split_config\.([a-z]+dpi)\.apk$ ]]; then
+      density=${BASH_REMATCH[1]}
+      value=$(density_value "$density") || continue
+      distance=$(( value > device_density ? value - device_density : device_density - value ))
+      if [[ -z $best || $distance -lt $best_distance ]]; then
+        best=$apk
+        best_distance=$distance
+      fi
+    fi
+  done < <(find "$directory" -type f -name '*.apk' -print0)
+  printf '%s' "$best"
+}
+
+install_apk() {
+  local file=$1 sample=$2 output status
+  if $DRY_RUN; then
+    record_result "$sample" apk DRY_RUN "$file"
+    return
+  fi
+  output=$("${ADB_CMD[@]}" install -r -g "$file" 2>&1); status=$?
+  if ((status == 0)); then
+    record_result "$sample" apk OK "$output"
+  else
+    record_result "$sample" apk FAIL "$output"
+  fi
+}
+
+install_split_archive() {
+  local file=$1 sample=$2 archive_dir base output status apk name split_abi selected_density
+  archive_dir="$WORK_DIR/${RANDOM}-$(basename "$file")"
+  mkdir -p "$archive_dir"
+  if ! unzip -qq "$file" '*.apk' -d "$archive_dir"; then
+    record_result "$sample" split FAIL 'could not extract APK entries'
+    return
+  fi
+
+  base=$(find "$archive_dir" -type f -name base.apk -print -quit)
+  if [[ -z $base ]]; then
+    record_result "$sample" split FAIL 'base.apk missing from archive'
+    return
+  fi
+
+  # Include base APKs and feature splits. Config splits are selected below.
+  local selected=("$base")
+  while IFS= read -r -d '' apk; do
+    [[ $apk == "$base" ]] && continue
+    name=$(basename "$apk")
+    if [[ ! $name =~ ^split_config\..*\.apk$ ]]; then
+      selected+=("$apk")
+    fi
+  done < <(find "$archive_dir" -type f -name '*.apk' -print0)
+
+  # ABI names in split file names use underscores while ro.product.cpu.abilist uses hyphens.
+  while IFS= read -r -d '' apk; do
+    name=$(basename "$apk")
+    if [[ $name =~ ^split_config\.([A-Za-z0-9_]+)\.apk$ ]]; then
+      split_abi=${BASH_REMATCH[1]}
+      if split_abi_matches_device "$split_abi"; then
+        selected+=("$apk")
+        break
+      fi
+    fi
+  done < <(find "$archive_dir" -type f -name 'split_config.*.apk' -print0)
+
+  selected_density=$(choose_density_split "$archive_dir")
+  [[ -n $selected_density ]] && selected+=("$selected_density")
+
+  if $DRY_RUN; then
+    record_result "$sample" split DRY_RUN "$(printf '%s ' "${selected[@]#$archive_dir/}")"
+    return
+  fi
+  output=$("${ADB_CMD[@]}" install-multiple -r -g "${selected[@]}" 2>&1); status=$?
+  if ((status == 0)); then
+    record_result "$sample" split OK "$output"
+  else
+    record_result "$sample" split FAIL "$output"
+  fi
+}
+
+printf 'Target: %s (ABI: %s; density: %s)\n' "$SERIAL" "$device_abis" "$device_density"
+printf 'Samples: %s\n' "$SAMPLES_DIR"
+
+count=0
+while IFS= read -r -d '' file; do
+  sample=${file#"$SAMPLES_DIR"/}
+  ((count += 1))
+  case "${file,,}" in
+    *.apk) install_apk "$file" "$sample" ;;
+    *.apks|*.apkm) install_split_archive "$file" "$sample" ;;
+  esac
+done < <(find "$SAMPLES_DIR" -type f \( -iname '*.apk' -o -iname '*.apks' -o -iname '*.apkm' \) -print0 | sort -z)
+
+((count > 0)) || die "no APK/APKS/APKM files found under: $SAMPLES_DIR"
+ok=$(awk -F '\t' 'NR > 1 && $3 == "OK" { count++ } END { print count + 0 }' "$REPORT")
+failed=$(awk -F '\t' 'NR > 1 && $3 == "FAIL" { count++ } END { print count + 0 }' "$REPORT")
+dry=$(awk -F '\t' 'NR > 1 && $3 == "DRY_RUN" { count++ } END { print count + 0 }' "$REPORT")
+printf 'Completed: %d samples; OK=%d FAIL=%d DRY_RUN=%d\nReport: %s\n' "$count" "$ok" "$failed" "$dry" "$REPORT"
+((failed == 0))
