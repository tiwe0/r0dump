+package com.r0dump.multiprocess;
+
+public final class MainTarget {
+    private MainTarget() {}
+
+    public static int deterministicValue(int seed) {
+        int value = seed ^ 0x13579bdf;
+        value = Integer.rotateLeft(value, 3) + 0x2468ace;
+        value ^= (value >>> 7);
+        value += stableMix(seed, 5);
+        return value & 0x7fffffff;
+    }
+
+    private static int stableMix(int seed, int rounds) {
+        int value = seed + 31;
+        for (int i = 0; i < rounds; i++) {
+            value = (value * 33) ^ (0x55aa00ff + i);
+        }
+        return value;
+    }
+}
