+#!/usr/bin/env bash
+# End-to-end method probe evidence validator for the deliberately harmless probe APK.
+set -euo pipefail
+
+serial=${1:-${ANDROID_SERIAL:-}}
+if [[ -z "$serial" ]]; then
+  echo "usage: $0 <adb-serial>" >&2
+  exit 2
+fi
+adb_cmd=(adb -s "$serial")
+package=com.r0dump.v31
+class=com.r0dump.v31.ProbeTarget
+
+"$(dirname "$0")/run-ladder.sh" "$serial"
+# run-ladder leaves nestedProbe as the last process; method audit waits 10 seconds of inactivity.
+sleep 15
+pid=$("${adb_cmd[@]}" shell "pidof $package" | tr -d '\r' | awk '{print $1}')
+[[ -n "$pid" ]] || { echo "probe process is not running" >&2; exit 1; }
+report=$("${adb_cmd[@]}" shell "find /sdcard/Download/r0dump/$package/session-$pid -type f -name method-audit.tsv -print 2>/dev/null | tail -n 1" | tr -d '\r')
+[[ -n "$report" ]] || { echo 'no method probe method_audit report found' >&2; exit 1; }
+tsv=$("${adb_cmd[@]}" exec-out cat "$report")
+printf '%s\n' "$tsv"
+
+header=$(head -n 1 <<<"$tsv")
+[[ "$header" == *$'method_probe_repair_class\tmethod_probe_repair_source\tmethod_probe_stopped_method'* ]] || {
+  echo 'method probe report schema is incomplete' >&2; exit 1;
+}
+awk -F '\t' '
+  $20 ~ /ProbeTarget\.nestedProbe\(\)/ {
+    found = 1
+    if ($9 != "1" || $10 != "0" || $11 != "true" || $12 != "true" ||
+        $13 != "target" || $17 != "no-change" || $18 != "retain-class_collection-output" ||
+        $19 !~ /ProbeTarget\.nestedProbe\(\)/) {
+      bad = 1
+    }
+  }
+  END { exit !(found && !bad) }
+' <<<"$tsv" || {
+  echo 'nested method probe invoke-boundary or no-change repair classification failed' >&2
+  exit 1
+}
+echo "method probe validated: $report"
