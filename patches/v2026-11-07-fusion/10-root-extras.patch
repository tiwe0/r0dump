+#!/usr/bin/env bash
+# End-to-end V3.3 evidence validation against the installed ICBC sample.
+set -euo pipefail
+
+serial=${1:-${ANDROID_SERIAL:-}}
+[[ -n "$serial" ]] || { echo "usage: $0 <adb-serial>" >&2; exit 2; }
+adb_cmd=(adb -s "$serial")
+package=com.icbc.elife
+
+cleanup() {
+  "${adb_cmd[@]}" shell 'setprop dalvik.vm.dexunpack.capture false; \
+    setprop dalvik.vm.dexunpack.watch_writes false; \
+    setprop dalvik.vm.dexunpack.v3 false; \
+    setprop dalvik.vm.dexunpack.v3.allow_execution false; \
+    setprop dalvik.vm.dexunpack.v3.instruction_budget 0' >/dev/null || true
+}
+trap cleanup EXIT
+
+"${adb_cmd[@]}" root >/dev/null || true
+sleep 2
+"${adb_cmd[@]}" shell "pm path $package" >/dev/null
+"${adb_cmd[@]}" shell "setprop dalvik.vm.dexunpack.capture true; \
+  setprop dalvik.vm.dexunpack.watch_writes true; \
+  setprop dalvik.vm.dexunpack.watch_package $package; \
+  setprop dalvik.vm.dexunpack.v3 false"
+"${adb_cmd[@]}" logcat -c
+"${adb_cmd[@]}" shell "am force-stop $package"
+"${adb_cmd[@]}" shell "monkey -p $package -c android.intent.category.LAUNCHER 1" >/dev/null
+
+for _ in $(seq 1 150); do
+  log=$("${adb_cmd[@]}" logcat -d -v brief)
+  if grep -Fq 'DexUnpackWatch: V2 snapshot' <<<"$log" &&
+      grep -Fq 'DexUnpack: phase 2 complete' <<<"$log"; then
+    break
+  fi
+  sleep 1
+done
+grep -Fq 'DexUnpackWatch: V2 snapshot' <<<"${log:-}" || {
+  echo 'V3.3 watcher never reached a stable snapshot' >&2; exit 1;
+}
+pid=$("${adb_cmd[@]}" shell "pidof $package" | tr -d '\r' | awk '{print $1}')
+[[ -n "$pid" ]] || { echo 'ICBC process is not running' >&2; exit 1; }
+
+for _ in $(seq 1 30); do
+  report=$("${adb_cmd[@]}" shell "find /sdcard/Download/r0dump/$package/session-$pid/write-watch -type f -name phase3-write-repairs.tsv -print 2>/dev/null | tail -n 1" | tr -d '\r')
+  [[ -n "$report" ]] && break
+  sleep 1
+done
+[[ -n "${report:-}" ]] || { echo 'V3.3 write-repair report was not created' >&2; exit 1; }
+tsv=$("${adb_cmd[@]}" exec-out cat "$report")
+printf '%s\n' "$tsv" | awk -F '\t' 'NR == 1 || ($1 == "method" && $18 == "code_off_retargeted" && ++shown <= 12)'
+header=$(head -n 1 <<<"$tsv")
+[[ "$header" == *$'dex_method_idx\tmethod\toriginal_code_off\tcurrent_code_off\t'* ]] || {
+  echo 'V3.3 report schema is incomplete' >&2; exit 1;
+}
+awk -F '\t' '
+  NR > 1 && $1 == "method" && $18 == "code_off_retargeted" && $10 != "unresolved" { found = 1 }
+  END { exit !found }
+' <<<"$tsv" || {
+  echo 'V3.3 did not associate an offset retarget with a resolved DEX method' >&2; exit 1;
+}
+echo "V3.3 ICBC validated: $report"
