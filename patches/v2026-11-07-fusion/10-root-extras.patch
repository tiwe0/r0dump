diff --git a/test-apps/run-phase2-test.sh b/test-apps/run-phase2-test.sh
new file mode 100755
index 0000000000000000000000000000000000000000..56019200347e70dbcb038a75f0026a494904bd64
--- /dev/null
+++ b/test-apps/run-phase2-test.sh
@@ -0,0 +1,150 @@
+#!/usr/bin/env bash
+# Launch one installed package and verify r0dump phase-2 output by the final manifest.
+set -euo pipefail
+
+ADB=${ADB:-adb}
+SERIAL=${R0_ADB_SERIAL:-}
+PACKAGE=
+TIMEOUT=300
+EXECUTE_TIMEOUT=0
+COMPONENT=
+REPORT=
+
+usage() {
+  cat <<'USAGE'
+Usage: test-apps/run-phase2-test.sh --package PACKAGE [options]
+
+Options:
+  --package PACKAGE   Installed application package to cold-start (required).
+  --serial SERIAL     adb serial; defaults to R0_ADB_SERIAL or the sole attached device.
+  --timeout SECONDS   Maximum wait for a phase-2 manifest (default: 300).
+  --execute-timeout S After the phase-2 baseline, wait up to S seconds for a phase-3
+                      execute-* snapshot and validate its DEX/method audit (default: disabled).
+  --component NAME   Explicit activity to start after the phase-2 baseline. Use with
+                     --execute-timeout to exercise a real post-baseline code path.
+  --report PATH       Write one TSV result row to PATH.
+  --adb PATH          adb executable (default: $ADB or adb from PATH).
+  -h, --help          Show help.
+
+Success requires a non-empty manifest.tsv, an equal number of .dex files, and a
+`dex\\n` header in every file. This detects final ART output directly instead of
+relying on logcat, whose buffer can roll over during a large reflective pass.
+
+ART writes each cold start into a PID-named session subdirectory below the package
+directory. This avoids Android external-storage FUSE retaining deleted file names
+from a prior process. The verifier searches that package directory recursively.
+USAGE
+}
+
+die() { printf 'error: %s\n' "$*" >&2; exit 2; }
+while (($#)); do
+  case "$1" in
+    --package) PACKAGE=${2:?--package requires a value}; shift 2 ;;
+    --serial) SERIAL=${2:?--serial requires a value}; shift 2 ;;
+    --timeout) TIMEOUT=${2:?--timeout requires a value}; shift 2 ;;
+    --execute-timeout) EXECUTE_TIMEOUT=${2:?--execute-timeout requires a value}; shift 2 ;;
+    --component) COMPONENT=${2:?--component requires a value}; shift 2 ;;
+    --report) REPORT=${2:?--report requires a value}; shift 2 ;;
+    --adb) ADB=${2:?--adb requires a value}; shift 2 ;;
+    -h|--help) usage; exit 0 ;;
+    *) die "unknown option: $1" ;;
+  esac
+done
+[[ -n $PACKAGE ]] || die '--package is required'
+[[ $TIMEOUT =~ ^[1-9][0-9]*$ ]] || die '--timeout must be a positive integer'
+[[ $EXECUTE_TIMEOUT =~ ^[0-9]+$ ]] || die '--execute-timeout must be zero or a positive integer'
+command -v "$ADB" >/dev/null 2>&1 || die "adb not found: $ADB"
+
+if [[ -z $SERIAL ]]; then
+  mapfile -t devices < <("$ADB" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
+  [[ ${#devices[@]} == 1 ]] || die 'specify --serial unless exactly one device is connected'
+  SERIAL=${devices[0]}
+fi
+ADB_CMD=("$ADB" -s "$SERIAL")
+"${ADB_CMD[@]}" get-state 2>/dev/null | grep -qx device || die "device is not ready: $SERIAL"
+"${ADB_CMD[@]}" shell "pm path '$PACKAGE'" | grep -q '^package:' || die "package not installed: $PACKAGE"
+
+ROOT=/sdcard/Download/r0dump
+OUTPUT=$ROOT/$PACKAGE
+if [[ -z $REPORT ]]; then
+  REPORT="${TMPDIR:-/tmp}/r0-phase2-results-$(date +%Y%m%d-%H%M%S).tsv"
+fi
+mkdir -p "$(dirname "$REPORT")"
+printf 'package\tlaunch\tstatus\tdex_files\tmanifest_rows\telapsed_s\tdetail\n' > "$REPORT"
+record() {
+  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$PACKAGE" "$1" "$2" "$3" "$4" "$5" "$6" | tee -a "$REPORT"
+}
+
+"${ADB_CMD[@]}" root >/dev/null
+# ART uses a PID-named session directory. Record existing sessions before launch so an
+# unremovable MediaProvider/FUSE entry from an older process cannot satisfy this run.
+mapfile -t old_sessions < <("${ADB_CMD[@]}" shell "find '$OUTPUT' -mindepth 1 -maxdepth 1 -type d -name 'session-*' -printf '%f\n' 2>/dev/null" | tr -d '\r')
+"${ADB_CMD[@]}" shell "setprop dalvik.vm.dexunpack.capture true; am force-stop '$PACKAGE'; logcat -c"
+if ! "${ADB_CMD[@]}" shell "monkey -p '$PACKAGE' -c android.intent.category.LAUNCHER 1" >/dev/null; then
+  record FAIL LAUNCH_FAIL 0 0 0 'monkey failed'
+  exit 1
+fi
+
+session=
+for elapsed in $(seq 1 "$TIMEOUT"); do
+  mapfile -t sessions < <("${ADB_CMD[@]}" shell "find '$OUTPUT' -mindepth 1 -maxdepth 1 -type d -name 'session-*' -printf '%f\n' 2>/dev/null" | tr -d '\r')
+  for candidate in "${sessions[@]}"; do
+    seen=false
+    for old in "${old_sessions[@]}"; do
+      [[ $candidate == "$old" ]] && { seen=true; break; }
+    done
+    if ! $seen; then
+      session=$OUTPUT/$candidate
+      break
+    fi
+  done
+  if [[ -z $session ]]; then
+    dex_files=0
+    manifest_rows=0
+    sleep 1
+    continue
+  fi
+  dex_files=$("${ADB_CMD[@]}" shell "find '$session' -maxdepth 1 -name '*.dex' -type f | wc -l" | tr -d '\r ')
+  manifest_rows=$("${ADB_CMD[@]}" shell "wc -l '$session/manifest.tsv' 2>/dev/null | awk '{print \$1}'" | tr -d '\r ')
+  if [[ $dex_files =~ ^[0-9]+$ && $manifest_rows =~ ^[0-9]+$ && $dex_files -gt 0 && $dex_files == "$manifest_rows" ]]; then
+    invalid=$("${ADB_CMD[@]}" shell "for f in $session/*.dex; do [ -f \"\$f\" ] || continue; [ \"\$(od -An -N4 -tx1 \"\$f\" | tr -d ' \\n')\" = 6465780a ] || { printf '%s' \"\$f\"; break; }; done" | tr -d '\r')
+    if [[ -z $invalid ]]; then
+      if ((EXECUTE_TIMEOUT == 0)); then
+        record OK PHASE2_COMPLETE "$dex_files" "$manifest_rows" "$elapsed" 'manifest and all DEX headers validated'
+        printf 'Report: %s\n' "$REPORT"
+        exit 0
+      fi
+      if [[ -n $COMPONENT ]]; then
+        if ! "${ADB_CMD[@]}" shell "am start -W -n '$COMPONENT'" >/dev/null; then
+          record FAIL COMPONENT_LAUNCH_FAIL "$dex_files" "$manifest_rows" "$elapsed" \
+              "unable to start explicit component: $COMPONENT"
+          exit 1
+        fi
+      fi
+      execute_dir=
+      for execute_elapsed in $(seq 1 "$EXECUTE_TIMEOUT"); do
+        mapfile -t execute_dirs < <("${ADB_CMD[@]}" shell "find '$session' -mindepth 1 -maxdepth 1 -type d -name 'execute-*' -printf '%f\\n' 2>/dev/null | sort -V" | tr -d '\r')
+        if ((${#execute_dirs[@]})); then
+          execute_dir=$session/${execute_dirs[-1]}
+          execute_dex=$("${ADB_CMD[@]}" shell "find '$execute_dir' -maxdepth 1 -name '*.dex' -type f | wc -l" | tr -d '\r ')
+          execute_methods=$("${ADB_CMD[@]}" shell "wc -l '$execute_dir/phase3-methods.tsv' 2>/dev/null | awk '{print \$1}'" | tr -d '\r ')
+          if [[ $execute_dex =~ ^[0-9]+$ && $execute_dex -gt 0 && $execute_methods =~ ^[0-9]+$ && $execute_methods -gt 1 ]]; then
+            record OK PHASE3_COMPLETE "$execute_dex" "$execute_methods" "$((elapsed + execute_elapsed))" "execute snapshot: $execute_dir"
+            printf 'Report: %s\n' "$REPORT"
+            exit 0
+          fi
+        fi
+        sleep 1
+      done
+      record TIMEOUT NO_EXECUTE_SNAPSHOT "$dex_files" "$manifest_rows" "$((elapsed + EXECUTE_TIMEOUT))" 'baseline complete but phase-3 execute snapshot missing or empty'
+      printf 'Report: %s\n' "$REPORT"
+      exit 1
+    fi
+    record FAIL INVALID_DEX "$dex_files" "$manifest_rows" "$elapsed" "invalid header: $invalid"
+    exit 1
+  fi
+  sleep 1
+done
+record TIMEOUT NO_FINAL_MANIFEST "${dex_files:-0}" "${manifest_rows:-0}" "$TIMEOUT" 'no matching non-empty manifest within timeout'
+printf 'Report: %s\n' "$REPORT"
+exit 1
