@@ -0,0 +1,65 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+serial=${1:-${ANDROID_SERIAL:-}}
+if [[ -z "$serial" ]]; then
+  echo "usage: $0 <adb-serial>" >&2
+  exit 2
+fi
+adb_cmd=(adb -s "$serial")
+package=com.r0dump.v31
+class=com.r0dump.v31.ProbeTarget
+method='probe():int'
+
+"${adb_cmd[@]}" root >/dev/null || true
+sleep 2
+for budget in 0 1 2 4 8; do
+  "${adb_cmd[@]}" shell "setprop dalvik.vm.r0dump.capture true; \
+    setprop dalvik.vm.r0dump.watch_writes true; \
+    setprop dalvik.vm.r0dump.watch_package $package; \
+    setprop dalvik.vm.r0dump.method_probe true; \
+    setprop dalvik.vm.r0dump.method_probe.class $class; \
+    setprop dalvik.vm.r0dump.method_probe.method '$method'; \
+    setprop dalvik.vm.r0dump.method_probe.allow_execution true; \
+    setprop dalvik.vm.r0dump.method_probe.instruction_budget $budget"
+  "${adb_cmd[@]}" logcat -c
+  "${adb_cmd[@]}" shell am force-stop "$package"
+  "${adb_cmd[@]}" shell monkey -p "$package" -c android.intent.category.LAUNCHER 1 >/dev/null
+
+  for _ in $(seq 1 90); do
+    log=$("${adb_cmd[@]}" logcat -d -v brief)
+    if grep -Fq "instructionBudget=$budget" <<<"$log"; then
+      grep -E 'R0dump method probe (snapshot|: stopped)|R0dump method probe completed' <<<"$log"
+      break
+    fi
+    sleep 1
+  done
+  grep -Fq "instructionBudget=$budget" <<<"${log:-}" || {
+    echo "budget $budget did not complete" >&2
+    exit 1
+  }
+done
+# method probe must stop before invoke-static transfers into mterp; nestedLeaf must not execute.
+"${adb_cmd[@]}" shell "setprop dalvik.vm.r0dump.method_probe.class $class; \
+  setprop dalvik.vm.r0dump.method_probe.method 'nestedProbe():int'; \
+  setprop dalvik.vm.r0dump.method_probe.instruction_budget 1"
+"${adb_cmd[@]}" logcat -c
+"${adb_cmd[@]}" shell am force-stop "$package"
+"${adb_cmd[@]}" shell monkey -p "$package" -c android.intent.category.LAUNCHER 1 >/dev/null
+for _ in $(seq 1 90); do
+  log=$("${adb_cmd[@]}" logcat -d -v brief)
+  if grep -Fq 'nestedProbe():int: entered=' <<<"$log"; then
+    grep -E 'R0dump method probe (: stopped|completed)|R0dump method probe' <<<"$log"
+    break
+  fi
+  sleep 1
+done
+grep -Fq 'nestedProbe():int: entered=' <<<"${log:-}" || {
+  echo 'nested method probe did not complete' >&2
+  exit 1
+}
+grep -Fq 'stopped int com.r0dump.v31.ProbeTarget.nestedProbe()' <<<"$log" || {
+  echo 'nested method probe did not stop at the invoke boundary' >&2
+  exit 1
+}
+"${adb_cmd[@]}" shell 'setprop dalvik.vm.r0dump.method_probe false; setprop dalvik.vm.r0dump.method_probe.allow_execution false; setprop dalvik.vm.r0dump.method_probe.instruction_budget 0'
