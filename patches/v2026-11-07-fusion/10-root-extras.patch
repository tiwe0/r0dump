--- /dev/null
+++ b/test-apps/tools/manifest-key-classes.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""List application/component class names declared by APK/APKS/APKM manifests."""
+import os
+import re
+import sys
+import tempfile
+import zipfile
+import subprocess
+
+AAPT2 = os.environ.get('AAPT2', 'out/host/linux-x86/bin/aapt2')
+COMPONENTS = {'application', 'activity', 'activity-alias', 'service', 'receiver', 'provider'}
+
+
+def apk_for(path, tmp):
+    if path.lower().endswith('.apk'):
+        return path
+    with zipfile.ZipFile(path) as archive:
+        candidates = [name for name in archive.namelist()
+                      if os.path.basename(name) == 'base.apk']
+        if not candidates:
+            raise RuntimeError('base.apk missing')
+        target = os.path.join(tmp, os.path.basename(path) + '.base.apk')
+        with open(target, 'wb') as out:
+            out.write(archive.read(candidates[0]))
+        return target
+
+
+def qualify(name, package):
+    if name.startswith('.'):
+        return package + name
+    if '.' not in name:
+        return package + '.' + name
+    return name
+
+
+def extract(path):
+    with tempfile.TemporaryDirectory() as tmp:
+        apk = apk_for(path, tmp)
+        xmltree = subprocess.check_output(
+            [AAPT2, 'dump', 'xmltree', apk, '--file', 'AndroidManifest.xml'],
+            text=True, stderr=subprocess.DEVNULL)
+        badging = subprocess.check_output([AAPT2, 'dump', 'badging', apk], text=True,
+                                          stderr=subprocess.DEVNULL)
+    package_match = re.search(r"package: name=['\"]([^'\"]+)", badging)
+    if package_match is None:
+        raise RuntimeError('package name missing from aapt2 badging')
+    package = package_match.group(1)
+    stack = []
+    rows = []
+    for line in xmltree.splitlines():
+        element = re.match(r'^(\s*)E: ([^ ]+)', line)
+        if element:
+            indent = len(element.group(1))
+            stack = [entry for entry in stack if entry[0] < indent]
+            stack.append((indent, element.group(2)))
+            continue
+        name = re.match(r'^\s*A: .*:name\([^)]*\)="([^"]+)"', line)
+        if name and stack and stack[-1][1] in COMPONENTS:
+            rows.append((stack[-1][1], qualify(name.group(1), package)))
+    return package, rows
+
+
+if __name__ == '__main__':
+    for path in sys.argv[1:]:
+        try:
+            package, rows = extract(path)
+            for kind, name in rows:
+                print(f'{path}\t{package}\t{kind}\t{name}')
+        except Exception as error:
+            print(f'{path}\tERROR\t{error}', file=sys.stderr)
