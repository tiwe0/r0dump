@@ -0,0 +1,21 @@
+package com.r0dump.multiprocess;
+
+public final class ChildTarget {
+    private ChildTarget() {}
+
+    public static int deterministicValue(int seed) {
+        int value = seed ^ 0x02468ace;
+        value = Integer.rotateRight(value, 2) + 0x13579bdf;
+        value ^= (value << 5);
+        value += stableMix(seed, 7);
+        return value & 0x7fffffff;
+    }
+
+    private static int stableMix(int seed, int rounds) {
+        int value = seed + 17;
+        for (int i = 0; i < rounds; i++) {
+            value = (value * 17) ^ (0x33cc55aa - i);
+        }
+        return value;
+    }
+}
diff --git a/test-apps/r0-multiprocess-probe/src/com/r0dump/multiprocess/CookieChurn.java b/test-apps/r0-multiprocess-probe/src/com/r0dump/multiprocess/CookieChurn.java
new file mode 100644
index 0000000000000000000000000000000000000000..81c5261bf5a303b5c50645abdf4d8a5fa6f0a09d
--- /dev/null
+++ b/test-apps/r0-multiprocess-probe/src/com/r0dump/multiprocess/CookieChurn.java
@@ -0,0 +1,94 @@
+package com.r0dump.multiprocess;
+
+import android.content.Context;
+import dalvik.system.DexClassLoader;
+import dalvik.system.DexFile;
+import dalvik.system.InMemoryDexClassLoader;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.ByteBuffer;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+
+final class CookieChurn {
+    private static final int ITERATIONS = 64;
+
+    interface Completion {
+        void accept(String result);
+    }
+
+    private CookieChurn() {}
+
+    static void runAsync(final Context context, final Completion completion) {
+        new Thread(new Runnable() {
+            @Override
+            public void run() {
+                int dexFilePasses = 0;
+                int classLoaderPasses = 0;
+                int inMemoryPasses = 0;
+                String sourceApk = context.getApplicationInfo().sourceDir;
+                File codeCache = context.getCodeCacheDir();
+                try {
+                    for (int i = 0; i < ITERATIONS; i++) {
+                        File optimized = new File(codeCache, "cookie-churn-" + i + ".dex");
+                        DexFile dexFile = null;
+                        try {
+                            dexFile = DexFile.loadDex(sourceApk, optimized.getPath(), 0);
+                            if (dexFile.entries().hasMoreElements()) {
+                                dexFilePasses++;
+                            }
+                        } finally {
+                            if (dexFile != null) {
+                                dexFile.close();
+                            }
+                            optimized.delete();
+                        }
+
+                        DexClassLoader loader = new DexClassLoader(
+                                sourceApk, codeCache.getPath(), null, context.getClassLoader());
+                        if (loader.loadClass(MainTarget.class.getName()) != null) {
+                            classLoaderPasses++;
+                        }
+                    }
+                    InMemoryDexClassLoader inMemoryLoader = new InMemoryDexClassLoader(
+                            ByteBuffer.wrap(readPrimaryDex(sourceApk)),
+                            context.getClassLoader().getParent());
+                    Class<?> inMemoryTarget = inMemoryLoader.loadClass(MainTarget.class.getName());
+                    if (inMemoryTarget.getClassLoader() == inMemoryLoader) {
+                        inMemoryPasses++;
+                    }
+                    completion.accept(
+                            "cookie_churn_complete dex_file=" + dexFilePasses
+                                    + " class_loader=" + classLoaderPasses
+                                    + " in_memory=" + inMemoryPasses);
+                } catch (Throwable failure) {
+                    completion.accept(
+                            "cookie_churn_failed dex_file=" + dexFilePasses
+                                    + " class_loader=" + classLoaderPasses
+                                    + " in_memory=" + inMemoryPasses
+                                    + " error=" + failure.getClass().getName());
+                }
+            }
+        }, "r0dump-cookie-churn").start();
+    }
+
+    private static byte[] readPrimaryDex(String sourceApk) throws IOException {
+        try (ZipFile apk = new ZipFile(sourceApk)) {
+            ZipEntry dex = apk.getEntry("classes.dex");
+            if (dex == null) {
+                throw new IOException("classes.dex missing");
+            }
+            try (InputStream input = apk.getInputStream(dex);
+                    ByteArrayOutputStream output = new ByteArrayOutputStream()) {
+                byte[] buffer = new byte[8192];
+                int count;
+                while ((count = input.read(buffer)) != -1) {
+                    output.write(buffer, 0, count);
+                }
+                return output.toByteArray();
+            }
+        }
+    }
+}
