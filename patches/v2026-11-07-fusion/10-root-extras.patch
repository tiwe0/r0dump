+package com.r0dump.v31;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.util.Log;
+
+/** Read-only shell-query endpoint.  It intentionally never loads the sentinel class. */
+public final class r0dump_WalkStateReceiver extends BroadcastReceiver {
+    private static final String r0dump_TAG = "R0WalkFixture";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (!r0dump_WalkState.r0dump_ACTION_STATE.equals(intent.getAction())) {
+            return;
+        }
+        final String r0dump_state = r0dump_WalkState.r0dump_result(context);
+        Log.i(r0dump_TAG, r0dump_state);
+        setResultCode(android.app.Activity.RESULT_OK);
+        setResultData(r0dump_state);
+        final android.os.Bundle r0dump_result = getResultExtras(true);
+        r0dump_result.putInt(r0dump_WalkState.r0dump_EXTRA_GENERATION,
+                r0dump_WalkState.r0dump_generation(context));
+        r0dump_result.putInt(r0dump_WalkState.r0dump_EXTRA_LOADED_INIT_COUNT,
+                r0dump_WalkState.r0dump_loadedInitializationCount(context));
+        r0dump_result.putInt(r0dump_WalkState.r0dump_EXTRA_SENTINEL_INIT_COUNT,
+                r0dump_WalkState.r0dump_sentinelInitializationCount(context));
+    }
+}
