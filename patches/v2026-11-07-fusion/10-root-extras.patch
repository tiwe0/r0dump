@@ -0,0 +1,75 @@
+package com.r0dump.v31;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/** Process-independent state for the ClassLoader-walk device fixture. */
+public final class r0dump_WalkState {
+    static final String r0dump_ACTION_STATE = "com.r0dump.v31.action.R0DUMP_WALK_STATE";
+    static final String r0dump_EXTRA_GENERATION = "r0dump_generation";
+    static final String r0dump_EXTRA_LOADED_INIT_COUNT = "r0dump_loaded_init_count";
+    static final String r0dump_EXTRA_SENTINEL_INIT_COUNT = "r0dump_sentinel_init_count";
+
+    private static final String r0dump_PREFERENCES = "r0dump_walk_fixture";
+    private static final String r0dump_KEY_GENERATION = "generation";
+    private static final String r0dump_KEY_LOADED_INIT_COUNT = "loaded_init_count";
+    private static final String r0dump_KEY_SENTINEL_INIT_COUNT = "sentinel_init_count";
+    private static Context r0dump_applicationContext;
+    private static boolean r0dump_started;
+
+    private r0dump_WalkState() {}
+
+    static void r0dump_begin(Context context) {
+        r0dump_applicationContext = context.getApplicationContext();
+        if (r0dump_started) {
+            return;
+        }
+        r0dump_started = true;
+        final SharedPreferences preferences = r0dump_preferences(context);
+        preferences.edit()
+                .putInt(r0dump_KEY_GENERATION,
+                        preferences.getInt(r0dump_KEY_GENERATION, 0) + 1)
+                .putInt(r0dump_KEY_LOADED_INIT_COUNT, 0)
+                .putInt(r0dump_KEY_SENTINEL_INIT_COUNT, 0)
+                .commit();
+    }
+
+    static void r0dump_recordLoadedInitialization() {
+        r0dump_increment(r0dump_KEY_LOADED_INIT_COUNT);
+    }
+
+    static void r0dump_recordSentinelInitialization() {
+        r0dump_increment(r0dump_KEY_SENTINEL_INIT_COUNT);
+    }
+
+    static int r0dump_generation(Context context) {
+        return r0dump_preferences(context).getInt(r0dump_KEY_GENERATION, 0);
+    }
+
+    static int r0dump_loadedInitializationCount(Context context) {
+        return r0dump_preferences(context).getInt(r0dump_KEY_LOADED_INIT_COUNT, 0);
+    }
+
+    static int r0dump_sentinelInitializationCount(Context context) {
+        return r0dump_preferences(context).getInt(r0dump_KEY_SENTINEL_INIT_COUNT, 0);
+    }
+
+    static String r0dump_result(Context context) {
+        return "generation=" + r0dump_generation(context)
+                + " loaded_init=" + r0dump_loadedInitializationCount(context)
+                + " sentinel_init=" + r0dump_sentinelInitializationCount(context);
+    }
+
+    private static void r0dump_increment(String key) {
+        if (r0dump_applicationContext == null) {
+            return;
+        }
+        final SharedPreferences preferences = r0dump_preferences(r0dump_applicationContext);
+        preferences.edit().putInt(key, preferences.getInt(key, 0) + 1).commit();
+    }
+
+    private static SharedPreferences r0dump_preferences(Context context) {
+        return context.getApplicationContext().getSharedPreferences(
+                r0dump_PREFERENCES, Context.MODE_PRIVATE);
+    }
+}
