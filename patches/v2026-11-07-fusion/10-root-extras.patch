diff --git a/tools/build-art.sh b/tools/build-art.sh
new file mode 100755
index 0000000000000000000000000000000000000000..7f56ddfc81d901c76532b5489f4bc7b8f5b584b8
--- /dev/null
+++ b/tools/build-art.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# Build the modified ART runtime for the local LineageOS 23.2 lemonade tree.
+#
+# The Android 16 tree must use the bp4a release config.  Do not replace it
+# with the older two-component lunch syntax or ap4a: either one regenerates an
+# incompatible Soong configuration.
+# Android's envsetup functions intentionally probe unset environment variables, so do not enable
+# nounset for this wrapper.
+set -eo pipefail
+
+readonly TOP="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+readonly PRODUCT=lineage_lemonade
+readonly RELEASE=bp4a
+readonly VARIANT=userdebug
+
+ninja_jobs="${JOBS:-8}"
+if [[ "${1:-}" == "-j" ]]; then
+  ninja_jobs="${2:?missing value after -j}"
+  shift 2
+fi
+if [[ $# -ne 0 || ! "$ninja_jobs" =~ ^[1-9][0-9]*$ ]]; then
+  echo "Usage: $0 [-j JOBS]" >&2
+  exit 2
+fi
+
+[[ -f "$TOP/build/envsetup.sh" ]] || {
+  echo "Android build tree not found: $TOP" >&2
+  exit 1
+}
+
+cd "$TOP"
+# shellcheck disable=SC1091
+source build/envsetup.sh >/dev/null
+lunch "$PRODUCT" "$RELEASE" "$VARIANT" >/dev/null
+
+if [[ "$TARGET_PRODUCT" != "$PRODUCT" || "$TARGET_RELEASE" != "$RELEASE" ||
+      "$TARGET_BUILD_VARIANT" != "$VARIANT" ]]; then
+  echo "Unexpected build target: ${TARGET_PRODUCT}/${TARGET_RELEASE}/${TARGET_BUILD_VARIANT}" >&2
+  exit 1
+fi
+
+echo "Building ART runtime for ${TARGET_PRODUCT}/${TARGET_RELEASE}/${TARGET_BUILD_VARIANT} " \
+     "(Soong graph -j2, Ninja -j${ninja_jobs})"
+# libart references DexFileLoader::SetOpenCallback. Always rebuild and deploy the matching
+# libdexfile too; replacing only libart leaves zygote with an unresolved linker symbol.
+# com.android.art packages both libraries into the deployable CAPEX. NINJA_ARGS is appended after
+# Soong UI's graph-expansion parallelism, so the final Ninja -j value remains independently tunable.
+NINJA_ARGS="-j${ninja_jobs} ${NINJA_ARGS:-}" m -j2 libart libdexfile com.android.art
+
+artifacts=(
+  out/target/product/lemonade/apex/com.android.art/lib/libart.so
+  out/target/product/lemonade/apex/com.android.art/lib/libdexfile.so
+  out/target/product/lemonade/apex/com.android.art/lib64/libart.so
+  out/target/product/lemonade/apex/com.android.art/lib64/libdexfile.so
+  out/target/product/lemonade/system/apex/com.android.art.capex
+)
+for artifact in "${artifacts[@]}"; do
+  [[ -f "$artifact" ]] || {
+    echo "Expected artifact missing: $artifact" >&2
+    exit 1
+  }
+done
+echo "Built release artifacts:"
+sha256sum "${artifacts[@]}"
