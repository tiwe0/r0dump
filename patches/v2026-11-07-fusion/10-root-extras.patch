@@ -0,0 +1,66 @@
+#!/usr/bin/env bash
+# final export integration validator: an ICBC stable snapshot must become a strict-tool-readable final DEX.
+set -euo pipefail
+
+serial=${1:-${ANDROID_SERIAL:-}}
+[[ -n "$serial" ]] || { echo "usage: $0 <adb-serial>" >&2; exit 2; }
+adb_cmd=(adb -s "$serial")
+package=com.icbc.elife
+checksum=9ef020da  # AnoymousDex containing AboutusActivity in the installed ICBC sample.
+dexdump=${DEXDUMP:-out/host/linux-x86/bin/dexdump}
+[[ -x "$dexdump" ]] || { echo "missing dexdump: $dexdump" >&2; exit 2; }
+
+cleanup() {
+  "${adb_cmd[@]}" shell 'setprop dalvik.vm.r0dump.capture false; \
+    setprop dalvik.vm.r0dump.watch_writes false; \
+    setprop dalvik.vm.r0dump.method_probe false; \
+    setprop dalvik.vm.r0dump.method_probe.allow_execution false; \
+    setprop dalvik.vm.r0dump.method_probe.instruction_budget 0' >/dev/null || true
+}
+trap cleanup EXIT
+
+"${adb_cmd[@]}" root >/dev/null || true
+sleep 2
+"${adb_cmd[@]}" shell "pm path $package" >/dev/null
+"${adb_cmd[@]}" shell "setprop dalvik.vm.r0dump.capture true; \
+  setprop dalvik.vm.r0dump.watch_writes true; \
+  setprop dalvik.vm.r0dump.watch_package $package; \
+  setprop dalvik.vm.r0dump.method_probe false"
+"${adb_cmd[@]}" logcat -c
+"${adb_cmd[@]}" shell "am force-stop $package"
+"${adb_cmd[@]}" shell "monkey -p $package -c android.intent.category.LAUNCHER 1" >/dev/null
+
+for _ in $(seq 1 180); do
+  # The launcher process can take a few seconds to appear; a nonzero pidof result is expected
+  # during that window and must not terminate this set -e validation loop.
+  pid=$("${adb_cmd[@]}" shell "pidof $package" 2>/dev/null | tr -d '\r' | awk '{print $1}' || true)
+  if [[ -n "${pid:-}" ]]; then
+    final_manifest=$("${adb_cmd[@]}" shell "find /sdcard/Download/r0dump/$package/session-$pid/final -name manifest.tsv -type f -print 2>/dev/null | tail -n 1" | tr -d '\r')
+    [[ -n "$final_manifest" ]] && break
+  fi
+  sleep 1
+done
+[[ -n "${final_manifest:-}" ]] || { echo 'final manifest was not created' >&2; exit 1; }
+
+manifest=$("${adb_cmd[@]}" exec-out cat "$final_manifest")
+printf '%s\n' "$manifest"
+header=$(head -n 1 <<<"$manifest")
+[[ "$header" == *$'final_export_selection\trepair_class\tmethod_rows\theader_normalized'* ]] || {
+  echo 'final manifest schema is incomplete' >&2; exit 1;
+}
+entry=$(awk -F '\t' -v checksum="$checksum" '
+  NR > 1 && $3 == checksum && $6 == "stable-promoted" && $8 > 0 && $9 == "sha1-adler32-map-rebuilt" { print $1; exit }
+' <<<"$manifest")
+[[ -n "$entry" ]] || { echo 'final export did not promote the expected repaired ICBC DEX' >&2; exit 1; }
+
+workdir=$(mktemp -d /tmp/r0-method_probe4-icbc.XXXXXX)
+trap 'rm -rf "$workdir"; cleanup' EXIT
+"${adb_cmd[@]}" pull "$(dirname "$final_manifest")/$entry" "$workdir/$entry" >/dev/null
+"$dexdump" -f "$workdir/$entry" >"$workdir/dexdump.txt"
+grep -Fq 'Lcom/icbc/elife/AboutusActivity;' "$workdir/dexdump.txt" || {
+  echo 'promoted DEX did not expose AboutusActivity to dexdump' >&2; exit 1;
+}
+grep -Fq 'name          : '\''onCreate'\''' "$workdir/dexdump.txt" || {
+  echo 'promoted DEX did not expose an onCreate method' >&2; exit 1;
+}
+echo "final export ICBC validated: $final_manifest/$entry"
