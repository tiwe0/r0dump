+constexpr uid_t kR0dumpAndroidUserOffset = 100000u;
+
+void r0dump_SetError(r0dump_ConfigError* error, r0dump_ConfigErrorCode code, const char* field) {
+  if (error != nullptr) {
+    error->code = code;
+    error->field = field;
+  }
+}
+
+bool r0dump_IsAsciiAlpha(char value) {
+  return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z');
+}
+
+bool r0dump_IsAsciiDigit(char value) { return value >= '0' && value <= '9'; }
+
+bool r0dump_IsJavaIdentifierSegment(std::string_view value) {
+  if (value.empty() || !(r0dump_IsAsciiAlpha(value.front()) || value.front() == '_')) {
+    return false;
+  }
+  return std::all_of(value.begin() + 1u, value.end(), [](char ch) {
+    return r0dump_IsAsciiAlpha(ch) || r0dump_IsAsciiDigit(ch) || ch == '_';
+  });
+}
+
+bool r0dump_IsPackageName(std::string_view value) {
+  if (value.empty() || value.size() > kR0dumpPropertyValueBytesHardLimit || value.front() == '.' ||
+      value.back() == '.') {
+    return false;
+  }
+  size_t start = 0u;
+  size_t segment_count = 0u;
+  while (start < value.size()) {
+    const size_t end = value.find('.', start);
+    const size_t length = (end == std::string_view::npos ? value.size() : end) - start;
+    if (!r0dump_IsJavaIdentifierSegment(value.substr(start, length))) {
+      return false;
+    }
+    ++segment_count;
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1u;
+  }
+  return segment_count >= 1u;
+}
+
+bool r0dump_IsExpectedOutputParent(std::string_view output_parent,
+                                   std::string_view target_package) {
+  const std::string expected = "/storage/emulated/" +
+                               std::to_string(getuid() / kR0dumpAndroidUserOffset) +
+                               "/Android/data/" + std::string(target_package) + "/files";
+  return output_parent == expected;
+}
+
+bool r0dump_IsRunId(std::string_view value) {
+  if (value.empty() || value.size() > 64u ||
+      !(r0dump_IsAsciiAlpha(value.front()) || r0dump_IsAsciiDigit(value.front()))) {
+    return false;
+  }
+  return std::all_of(value.begin(), value.end(), [](char ch) {
+    return r0dump_IsAsciiAlpha(ch) || r0dump_IsAsciiDigit(ch) || ch == '-' || ch == '_' ||
+           ch == '.';
+  });
+}
+
+bool r0dump_IsTargetProcess(std::string_view package_name, std::string_view process_name) {
+  if (process_name.size() > kR0dumpPropertyValueBytesHardLimit) {
+    return false;
+  }
+  if (process_name.empty() || process_name == package_name) {
+    return true;
+  }
+  if (process_name.size() <= package_name.size() + 1u ||
+      process_name.substr(0u, package_name.size()) != package_name ||
+      process_name[package_name.size()] != ':') {
+    return false;
+  }
+  const std::string_view suffix = process_name.substr(package_name.size() + 1u);
+  size_t start = 0u;
+  while (start < suffix.size()) {
+    const size_t end = suffix.find('.', start);
+    const size_t length = (end == std::string_view::npos ? suffix.size() : end) - start;
+    if (!r0dump_IsJavaIdentifierSegment(suffix.substr(start, length))) {
+      return false;
+    }
+    if (end == std::string_view::npos) {
+      return true;
+    }
+    start = end + 1u;
+  }
+  return false;
+}
+
+bool r0dump_IsBinaryClassName(std::string_view value) {
+  if (value.empty() || value.size() > kR0dumpPropertyValueBytesHardLimit ||
+      value.find('/') != std::string_view::npos) {
+    return false;
+  }
+  size_t start = 0u;
+  while (start < value.size()) {
+    const size_t end = value.find('.', start);
+    const size_t length = (end == std::string_view::npos ? value.size() : end) - start;
+    if (length == 0u) {
+      return false;
+    }
+    const std::string_view segment = value.substr(start, length);
+    if (!(r0dump_IsAsciiAlpha(segment.front()) || segment.front() == '_' ||
+          segment.front() == '$')) {
+      return false;
+    }
+    if (!std::all_of(segment.begin() + 1u, segment.end(), [](char ch) {
+          return r0dump_IsAsciiAlpha(ch) || r0dump_IsAsciiDigit(ch) || ch == '_' || ch == '$';
+        })) {
+      return false;
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1u;
+  }
+  return true;
+}
+
+bool r0dump_IsNamespacePrefix(std::string_view value) {
+  if (value.empty() || value.size() > kR0dumpPropertyValueBytesHardLimit || value.back() != '.') {
+    return false;
+  }
+  const std::string_view body = value.substr(0u, value.size() - 1u);
+  size_t start = 0u;
+  while (start < body.size()) {
+    const size_t end = body.find('.', start);
+    const size_t length = (end == std::string_view::npos ? body.size() : end) - start;
+    const std::string_view segment = body.substr(start, length);
+    if (segment.empty() || !(r0dump_IsAsciiAlpha(segment.front()) || segment.front() == '_' ||
+                             segment.front() == '$') ||
+        !std::all_of(segment.begin() + 1u, segment.end(), [](char ch) {
+          return r0dump_IsAsciiAlpha(ch) || r0dump_IsAsciiDigit(ch) || ch == '_' || ch == '$';
+        })) {
+      return false;
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1u;
+  }
+  return true;
+}
+
+bool r0dump_IsMethodName(std::string_view value) {
+  if (value.empty() || value.size() > kR0dumpPropertyValueBytesHardLimit) {
+    return false;
+  }
+  if (value == "<init>" || value == "<clinit>") {
+    return true;
+  }
+  return r0dump_IsJavaIdentifierSegment(value);
+}
+
+bool r0dump_IsMethodDescriptor(std::string_view value) {
+  if (value.size() < 3u || value.size() > kR0dumpPropertyValueBytesHardLimit ||
+      value.front() != '(' || value.find('\0') != std::string_view::npos) {
+    return false;
+  }
+  const size_t close = value.find(')');
+  if (close == std::string_view::npos || close + 1u >= value.size() ||
+      value.find(')', close + 1u) != std::string_view::npos) {
+    return false;
+  }
+
+  auto consume_type = [](std::string_view descriptor, size_t* cursor, bool allow_void) {
+    const size_t start = *cursor;
+    while (*cursor < descriptor.size() && descriptor[*cursor] == '[') {
+      ++*cursor;
+    }
+    if (*cursor >= descriptor.size()) {
+      return false;
+    }
+    const bool is_array = *cursor != start;
+    const char kind = descriptor[(*cursor)++];
+    if (kind == 'V') {
+      return allow_void && !is_array;
+    }
+    if (kind == 'L') {
+      const size_t semicolon = descriptor.find(';', *cursor);
+      if (semicolon == std::string_view::npos) {
+        return false;
+      }
+      *cursor = semicolon + 1u;
+    } else if (std::string_view("BCDFIJSZ").find(kind) == std::string_view::npos) {
+      return false;
+    }
+    const std::string type(descriptor.substr(start, *cursor - start));
+    return IsValidDescriptor(type.c_str());
+  };
+
+  size_t cursor = 1u;
+  while (cursor < close) {
+    const size_t before = cursor;
+    if (!consume_type(value.substr(0u, close), &cursor, /*allow_void=*/false) || cursor <= before) {
+      return false;
+    }
+  }
+  if (cursor != close) {
+    return false;
+  }
+  cursor = close + 1u;
+  return consume_type(value, &cursor, /*allow_void=*/true) && cursor == value.size();
+}
