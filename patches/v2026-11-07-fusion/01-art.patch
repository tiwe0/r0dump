+bool r0dump_GetCodeItemSpan(const DexFile& dex_file,
+                            const dex::CodeItem* code_item,
+                            size_t max_code_item_bytes,
+                            const uint8_t** begin,
+                            size_t* size,
+                            uint32_t* code_offset) {
+  const uint8_t* item_begin = reinterpret_cast<const uint8_t*>(code_item);
+  if (begin == nullptr || size == nullptr || code_offset == nullptr ||
+      !r0dump_IsBoundedSpan(item_begin,
+                            StandardDexFile::CodeItem::InsnsOffset(),
+                            dex_file.DataBegin(),
+                            dex_file.DataSize())) {
+    return false;
+  }
+  const CodeItemDataAccessor accessor(dex_file, code_item);
+  const uint8_t* item_end = reinterpret_cast<const uint8_t*>(accessor.CodeItemDataEnd());
+  if (item_end <= item_begin) {
+    return false;
+  }
+  const size_t item_size = static_cast<size_t>(item_end - item_begin);
+  if (item_size > max_code_item_bytes ||
+      !r0dump_IsBoundedSpan(item_begin, item_size, dex_file.DataBegin(), dex_file.DataSize())) {
+    return false;
+  }
+  *begin = item_begin;
+  *size = item_size;
+  *code_offset = static_cast<uint32_t>(item_begin - dex_file.DataBegin());
+  return true;
+}
