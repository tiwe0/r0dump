+TEST(r0dump_CaptureTest, NearbyScannerFindsCompleteDexContainingAnchor) {
+  std::unique_ptr<const DexFile> dex = r0dump_BuildTestDex();
+  ASSERT_NE(dex->Begin(), nullptr);
