+bool r0dump_ValidateConfig(const r0dump_ProcessConfig& config, r0dump_ConfigError* error) {
+  r0dump_SetError(error, r0dump_ConfigErrorCode::kNone, nullptr);
+  if (config.schema != kR0dumpConfigSchema) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kUnsupportedSchema, "schema");
+    return false;
+  }
+  if (!r0dump_IsRunId(config.run_id)) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidRunId, "run_id");
+    return false;
+  }
+  if (!r0dump_IsPackageName(config.target_package)) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidTargetPackage, "target_package");
+    return false;
+  }
+  if (!r0dump_IsTargetProcess(config.target_package, config.target_process)) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidTargetProcess, "target_process");
+    return false;
+  }
+  if (!r0dump_IsTargetProcess(config.target_package, config.process_name) ||
+      config.process_name.empty() ||
+      !config.r0dump_MatchesProcess(config.target_package, config.process_name)) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidCurrentProcess, "process_name");
+    return false;
+  }
+  if (!r0dump_IsExpectedOutputParent(config.output_parent, config.target_package)) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidOutputParent, "output_parent");
+    return false;
+  }
+  if (!r0dump_IsValidCapturePointMask(config.capture_point_mask)) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidCapturePointMask, "capture_point_mask");
+    return false;
+  }
+  if (config.max_records == 0u || config.max_records > kR0dumpMaxRecordsHardLimit ||
+      config.max_artifacts == 0u || config.max_artifacts > kR0dumpMaxArtifactsHardLimit ||
+      config.max_artifacts > config.max_records || config.max_total_bytes == 0u ||
+      config.max_total_bytes > kR0dumpMaxTotalBytesHardLimit || config.max_dex_bytes == 0u ||
+      config.max_dex_bytes > kR0dumpMaxDexBytesHardLimit ||
+      config.max_dex_bytes > config.max_total_bytes) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidBudget, "budgets");
+    return false;
+  }
+  if (config.buffer_pool_bytes < config.max_dex_bytes ||
+      config.buffer_pool_bytes > kR0dumpBufferPoolBytesHardLimit ||
+      config.max_code_item_bytes == 0u ||
+      config.max_code_item_bytes > kR0dumpMaxCodeItemBytesHardLimit ||
+      config.max_code_item_bytes > config.buffer_pool_bytes ||
+      config.max_frozen_generations == 0u ||
+      config.max_frozen_generations > kR0dumpMaxFrozenGenerationsHardLimit ||
+      config.flush_idle_ms == 0u || config.flush_idle_ms > kR0dumpFlushIdleMsHardLimit) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidBufferLimit, "buffer_limits");
+    return false;
+  }
+  if (config.manifest_max_components == 0u ||
+      config.manifest_max_components > kR0dumpManifestComponentsHardLimit ||
+      config.manifest_max_splits > kR0dumpManifestSplitsHardLimit ||
+      config.manifest_max_events_per_source == 0u ||
+      config.manifest_max_events_per_source > kR0dumpManifestEventsPerSourceHardLimit ||
+      config.manifest_max_total_events < config.manifest_max_events_per_source ||
+      config.manifest_max_total_events > kR0dumpManifestTotalEventsHardLimit ||
+      config.manifest_max_xml_depth == 0u ||
+      config.manifest_max_xml_depth > kR0dumpManifestXmlDepthHardLimit ||
+      config.manifest_max_attribute_length == 0u ||
+      config.manifest_max_attribute_length > kR0dumpManifestAttributeLengthHardLimit) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidManifestLimit, "manifest_limits");
+    return false;
+  }
+  if ((config.walk_start != r0dump_WalkStart::kAfterApplicationOnCreate &&
+       config.walk_start != r0dump_WalkStart::kAfterFirstActivityOnCreate) ||
+      (config.walk_mode != r0dump_WalkMode::kLoadedOnly &&
+       config.walk_mode != r0dump_WalkMode::kDexNames)) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidWalkSelector, "walk_selector");
+    return false;
+  }
+  if (!config.walk_namespace_prefix.empty() &&
+      !r0dump_IsNamespacePrefix(config.walk_namespace_prefix)) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidWalkSelector,
+                    "walk_namespace_prefix");
+    return false;
+  }
+  if (config.walk_max_classes == 0u || config.walk_max_classes > kR0dumpWalkClassesHardLimit ||
+      config.walk_max_methods == 0u || config.walk_max_methods > kR0dumpWalkMethodsHardLimit) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidWalkLimit, "walk_limits");
+    return false;
+  }
+  if (config.force_max_calls == 0u || config.force_max_calls > kR0dumpForceCallsHardLimit) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidForceSelector, "force_max_calls");
+    return false;
+  }
+  if (config.force_invoke_enabled) {
+    const bool selector_empty = config.force_class.empty() && config.force_method.empty() &&
+                                config.force_method_descriptor.empty();
+    if (!r0dump_IsCapturePointEnabled(config.capture_point_mask,
+                                      r0dump_Point::kForceInvokeNoExecute) ||
+        (selector_empty && !config.manifest_enabled) ||
+        (!selector_empty &&
+         (!r0dump_IsBinaryClassName(config.force_class) ||
+          !r0dump_IsMethodName(config.force_method) ||
+          !r0dump_IsMethodDescriptor(config.force_method_descriptor)))) {
+      r0dump_SetError(error, r0dump_ConfigErrorCode::kInvalidForceSelector, "force_selector");
+      return false;
+    }
+  }
+  return true;
+}
+
+r0dump_ConfigStore::~r0dump_ConfigStore() {
+  published_.store(nullptr, std::memory_order_release);
+  if (owned_ != nullptr && owned_->prepared_run_fd >= 0) {
+    close(owned_->prepared_run_fd);
+  }
+}
+
+bool r0dump_ConfigStore::r0dump_ConfigureOnce(r0dump_ProcessConfig config,
+                                              r0dump_ConfigError* error) {
+  if (!r0dump_ValidateConfig(config, error)) {
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(lock_);
+  if (owned_ != nullptr) {
+    r0dump_SetError(error, r0dump_ConfigErrorCode::kAlreadyConfigured, "config");
+    return false;
+  }
+  owned_ = std::make_unique<const r0dump_ProcessConfig>(std::move(config));
+  published_.store(owned_.get(), std::memory_order_release);
+  return true;
+}
+
+bool r0dump_ConfigStore::r0dump_IsEnabledFor(std::string_view package_name,
+                                             std::string_view process_name) const {
+  const r0dump_ProcessConfig* config = r0dump_Get();
+  return config != nullptr && config->enabled &&
+         config->r0dump_MatchesProcess(package_name, process_name);
+}
+
+static r0dump_ConfigStore& r0dump_GetProcessConfigStore() {
+  static r0dump_ConfigStore* store = new r0dump_ConfigStore;
+  return *store;
+}
+
+bool r0dump_ConfigureProcessOnce(r0dump_ProcessConfig config, r0dump_ConfigError* error) {
+  return r0dump_GetProcessConfigStore().r0dump_ConfigureOnce(std::move(config), error);
+}
+
+const r0dump_ProcessConfig* r0dump_GetProcessConfig() {
+  return r0dump_GetProcessConfigStore().r0dump_Get();
+}
+
+}  // namespace art HIDDEN
