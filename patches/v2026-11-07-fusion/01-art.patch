+TEST(r0dump_CaptureTest, ProductionFacadeSizesPoolForConfiguredDexLimit) {
+  r0dump_ProcessConfig config;
+  config.enabled = true;
+  config.run_id = "20260828T120000Z-large-dex";
+  config.target_package = "com.example.target";
+  config.target_process = "com.example.target";
+  config.process_name = "com.example.target";
+  config.output_parent = "/storage/emulated/0/Android/data/com.example.target/files";
+  config.capture_point_mask = r0dump_PointBit(r0dump_Point::kInMemoryBufferCopied);
+  config.max_records = 2u;
+  config.max_artifacts = 1u;
+  config.max_total_bytes = kR0dumpMaxDexBytesHardLimit;
+  config.max_dex_bytes = kR0dumpMaxDexBytesHardLimit;
+  config.buffer_pool_bytes = kR0dumpMaxDexBytesHardLimit;
+
+  r0dump_ConfigError error;
+  ASSERT_TRUE(r0dump_ConfigureCaptureProcessOnce(std::move(config), &error));
+
+  std::vector<uint8_t> bytes(kR0dumpDefaultBufferPoolBytes + kR0dumpChunkBytes, 0x5au);
+  DexFile::Header header = {};
+  const uint8_t magic[] = {'d', 'e', 'x', '\n', '0', '3', '5', '\0'};
+  std::memcpy(header.magic_.data(), magic, sizeof(magic));
+  header.file_size_ = bytes.size();
+  header.header_size_ = sizeof(DexFile::Header);
+  header.endian_tag_ = DexFile::kDexEndianConstant;
+  std::memcpy(bytes.data(), &header, sizeof(header));
+  const r0dump_CaptureResult result = r0dump_ObserveRawBuffer(
+      r0dump_Point::kInMemoryBufferCopied,
+      "InMemory.buffer.large",
+      bytes.data(),
+      bytes.size(),
+      bytes.data(),
+      bytes.size(),
+      {.kind = "large_test", .ordinal = 0u, .count = 1u, .in_memory = true});
+
+  EXPECT_EQ(result.status, r0dump_CaptureStatus::kSubmitted);
+  EXPECT_EQ(result.submit.status, r0dump_SubmitStatus::kAccepted);
+  r0dump_Staging* staging = r0dump_GetCaptureProcessStaging();
+  ASSERT_NE(staging, nullptr);
+  EXPECT_EQ(staging->r0dump_DexCount(), 1u);
+  EXPECT_EQ(staging->r0dump_RecordCount(), 1u);
+}
