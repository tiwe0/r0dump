+  std::vector<std::unique_ptr<r0dump_FrozenGeneration>> generations;
+  EXPECT_EQ(staging.r0dump_TryFreeze().status, r0dump_FreezeStatus::kEmpty);
+  for (size_t index = 0; index < kR0dumpMaxFrozenGenerationsHardLimit; ++index) {
+    ASSERT_EQ(staging
+                  .r0dump_SubmitDex(
+                      r0dump_CaptureKind::kDexView,
