+
+TEST(r0dump_ConfigTest, EmptyTargetProcessMatchesAllPackageProcesses) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.target_process.clear();
+  config.process_name = "com.example.target:child";
+  r0dump_ConfigStore store;
+  ASSERT_TRUE(store.r0dump_ConfigureOnce(std::move(config), nullptr));
+  EXPECT_TRUE(store.r0dump_IsEnabledFor("com.example.target", "com.example.target"));
+  EXPECT_TRUE(store.r0dump_IsEnabledFor("com.example.target", "com.example.target:child"));
+}
+
+}  // namespace
+}  // namespace art HIDDEN
