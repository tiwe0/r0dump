+static jboolean r0dump_Runtime_r0dump_PublishManifestSnapshot(JNIEnv* env,
+                                                              jclass,
+                                                              jstring java_status,
+                                                              jstring java_package_name,
+                                                              jobjectArray java_class_names,
+                                                              jobjectArray java_seed_kinds,
+                                                              jintArray java_source_ordinals,
+                                                              jobjectArray java_source_kinds,
+                                                              jobjectArray java_source_statuses,
+                                                              jintArray java_source_event_counts,
+                                                              jobjectArray java_source_limit_hits,
+                                                              jint source_count,
+                                                              jint parsed_source_count,
+                                                              jint rejected_source_count,
+                                                              jint xml_event_count,
+                                                              jstring java_limit_hit) {
+  const r0dump_ProcessConfig* config = r0dump_GetProcessConfig();
+  r0dump_LogWalkStartedOnce(config);
+  if (java_status == nullptr || java_class_names == nullptr || java_seed_kinds == nullptr ||
+      java_source_ordinals == nullptr || java_source_kinds == nullptr ||
+      java_source_statuses == nullptr || java_source_event_counts == nullptr ||
+      java_source_limit_hits == nullptr || config == nullptr || source_count < 0 ||
+      static_cast<uint32_t>(source_count) > config->manifest_max_splits + 1u ||
+      parsed_source_count < 0 || rejected_source_count < 0 || xml_event_count < 0) {
+    return JNI_FALSE;
+  }
+  const jsize seed_count = env->GetArrayLength(java_class_names);
+  if (seed_count < 0 || static_cast<uint32_t>(seed_count) > config->manifest_max_components ||
+      env->GetArrayLength(java_seed_kinds) != seed_count ||
+      env->GetArrayLength(java_source_ordinals) != seed_count) {
+    return JNI_FALSE;
+  }
+  if (env->GetArrayLength(java_source_kinds) != source_count ||
+      env->GetArrayLength(java_source_statuses) != source_count ||
+      env->GetArrayLength(java_source_event_counts) != source_count ||
+      env->GetArrayLength(java_source_limit_hits) != source_count) {
+    return JNI_FALSE;
+  }
+
+  ScopedUtfChars status(env, java_status);
+  if (status.c_str() == nullptr) {
+    return JNI_FALSE;
+  }
+  std::string package_name;
+  if (java_package_name != nullptr) {
+    ScopedUtfChars value(env, java_package_name);
+    if (value.c_str() == nullptr) {
+      return JNI_FALSE;
+    }
+    package_name = value.c_str();
+  }
+  std::string limit_hit;
+  if (java_limit_hit != nullptr) {
+    ScopedUtfChars value(env, java_limit_hit);
+    if (value.c_str() == nullptr) {
+      return JNI_FALSE;
+    }
+    limit_hit = value.c_str();
+  }
+
+  std::vector<jint> source_ordinals(static_cast<size_t>(seed_count));
+  env->GetIntArrayRegion(java_source_ordinals, 0, seed_count, source_ordinals.data());
+  if (env->ExceptionCheck() == JNI_TRUE) {
+    return JNI_FALSE;
+  }
+  std::vector<jint> source_event_counts(static_cast<size_t>(source_count));
+  env->GetIntArrayRegion(java_source_event_counts, 0, source_count, source_event_counts.data());
+  if (env->ExceptionCheck() == JNI_TRUE) {
+    return JNI_FALSE;
+  }
+  r0dump_ManifestCaptureSnapshot snapshot = {
+      .status = status.c_str(),
+      .package_name = std::move(package_name),
+      .source_count = static_cast<uint32_t>(source_count),
+      .parsed_source_count = static_cast<uint32_t>(parsed_source_count),
+      .rejected_source_count = static_cast<uint32_t>(rejected_source_count),
+      .xml_event_count = static_cast<uint32_t>(xml_event_count),
+      .limit_hit = std::move(limit_hit),
+  };
+  snapshot.sources.reserve(static_cast<size_t>(source_count));
+  for (jint index = 0; index < source_count; ++index) {
+    ScopedLocalRef<jstring> java_source_kind(
+        env, static_cast<jstring>(env->GetObjectArrayElement(java_source_kinds, index)));
+    ScopedLocalRef<jstring> java_source_status(
+        env, static_cast<jstring>(env->GetObjectArrayElement(java_source_statuses, index)));
+    ScopedLocalRef<jstring> java_source_limit_hit(
+        env, static_cast<jstring>(env->GetObjectArrayElement(java_source_limit_hits, index)));
+    if (java_source_kind.get() == nullptr || java_source_status.get() == nullptr ||
+        source_event_counts[index] < 0) {
+      return JNI_FALSE;
+    }
+    ScopedUtfChars source_kind(env, java_source_kind.get());
+    ScopedUtfChars source_status(env, java_source_status.get());
+    if (source_kind.c_str() == nullptr || source_status.c_str() == nullptr) {
+      return JNI_FALSE;
+    }
+    std::string source_limit_hit;
+    if (java_source_limit_hit.get() != nullptr) {
+      ScopedUtfChars value(env, java_source_limit_hit.get());
+      if (value.c_str() == nullptr) {
+        return JNI_FALSE;
+      }
+      source_limit_hit = value.c_str();
+    }
+    snapshot.sources.push_back({static_cast<uint32_t>(index),
+                                source_kind.c_str(),
+                                source_status.c_str(),
+                                static_cast<uint32_t>(source_event_counts[index]),
+                                std::move(source_limit_hit)});
+  }
+  snapshot.seeds.reserve(static_cast<size_t>(seed_count));
+  for (jsize index = 0; index < seed_count; ++index) {
+    ScopedLocalRef<jstring> java_class_name(
+        env, static_cast<jstring>(env->GetObjectArrayElement(java_class_names, index)));
+    ScopedLocalRef<jstring> java_seed_kind(
+        env, static_cast<jstring>(env->GetObjectArrayElement(java_seed_kinds, index)));
+    if (java_class_name.get() == nullptr || java_seed_kind.get() == nullptr ||
+        source_ordinals[index] < 0) {
+      return JNI_FALSE;
+    }
+    ScopedUtfChars class_name(env, java_class_name.get());
+    ScopedUtfChars seed_kind(env, java_seed_kind.get());
+    if (class_name.c_str() == nullptr || seed_kind.c_str() == nullptr) {
+      return JNI_FALSE;
+    }
+    snapshot.seeds.push_back(
+        {class_name.c_str(), seed_kind.c_str(), static_cast<uint32_t>(source_ordinals[index])});
+  }
+  const std::string manifest_status = snapshot.status;
+  const std::string manifest_package = snapshot.package_name;
+  const std::string source_count_string = std::to_string(snapshot.source_count);
+  const std::string parsed_source_count_string = std::to_string(snapshot.parsed_source_count);
+  const std::string rejected_source_count_string = std::to_string(snapshot.rejected_source_count);
+  const std::string xml_event_count_string = std::to_string(snapshot.xml_event_count);
+  const std::string seed_count_string = std::to_string(snapshot.seeds.size());
+  const std::string log_limit_hit = snapshot.limit_hit.empty() ? "-" : snapshot.limit_hit;
+  const bool published = r0dump_PublishCaptureManifestSnapshot(std::move(snapshot));
+  const std::string run_object = "run:" + config->run_id;
+  r0dump_Log(published ? r0dump_LogLevel::kInfo : r0dump_LogLevel::kWarn,
+             "manifest_published",
+             {{"status", published ? manifest_status : "write_failed"},
+              {"site", "Manifest.snapshot"},
+              {"object_kind", "run"},
+              {"object", run_object},
+              {"run_id", config->run_id},
+              {"package", manifest_package},
+              {"process", config->process_name},
+              {"source_count", source_count_string},
+              {"parsed_source_count", parsed_source_count_string},
+              {"rejected_source_count", rejected_source_count_string},
+              {"xml_event_count", xml_event_count_string},
+              {"seed_count", seed_count_string},
+              {"limit_hit", log_limit_hit}});
+  return published ? JNI_TRUE : JNI_FALSE;
+}
