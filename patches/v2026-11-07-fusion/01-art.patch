+  EXPECT_TRUE(r0dump_ValidateConfig(config, nullptr));
+
+  config.max_total_bytes = kR0dumpMaxDexBytesHardLimit + 1u;
+  config.max_dex_bytes = kR0dumpMaxDexBytesHardLimit + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.max_dex_bytes = config.max_total_bytes + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
