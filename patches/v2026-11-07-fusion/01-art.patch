+  EXPECT_EQ(staging.r0dump_TryFreeze().status, r0dump_FreezeStatus::kBackpressure);
+  EXPECT_FALSE(staging.r0dump_ReleaseFrozen(ids.front() + 100));
+  EXPECT_TRUE(staging.r0dump_ReleaseFrozen(ids.front()));
+  EXPECT_EQ(staging.r0dump_FrozenCount(), kR0dumpMaxFrozenGenerationsHardLimit - 1);
