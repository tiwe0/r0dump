index 0000000000000000000000000000000000000000..ff6ef92daf37de06e7629686632b632dd9558b1d
--- /dev/null
+++ b/runtime/r0dump/r0dump_f4_class_linker_source_test.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+"""Checks the narrow F4 DefineClass hook contract."""
+
+from pathlib import Path
+
+
+SOURCE = Path(__file__).parents[1] / "class_linker.cc"
+
+
+def r0dump_function_body(source: str, signature: str, end_marker: str) -> str:
+    start = source.index(signature)
+    end = source.index(end_marker, start)
+    return source[start:end]
+
+
+def r0dump_main() -> None:
+    source = SOURCE.read_text()
+    body = r0dump_function_body(
+        source,
+        "ObjPtr<mirror::Class> ClassLinker::DefineClass(",
+        "uint32_t ClassLinker::SizeOfClassWithoutEmbeddedTables",
+    )
+    for point, site in (
+        ("kDefineClassEntry", '"DefineClass.entry"'),
+        ("kDefineClassSuccess", '"DefineClass.success"'),
+    ):
+        assert body.count(point) == 2, point
+        assert body.count(site) == 1, site
+        gate = f"if (UNLIKELY(r0dump_IsCapturePointActive(r0dump_Point::{point})))"
+        assert body.count(gate) == 1, gate
+        gate_offset = body.index(gate)
+        observe_offset = body.index("r0dump_ObserveDex", gate_offset)
+        assert gate_offset < observe_offset, point
+
+    success = body.index("kDefineClassSuccess")
+    assert body.index("jit::Jit::NewTypeLoadedIfUsingJit") < success
+    assert body.index("return sdc.Finish(h_new_class);", success) > success
+    assert "r0dump_Write" not in body
+    assert "open(" not in body
+
+    register_body = r0dump_function_body(
+        source,
+        "ObjPtr<mirror::DexCache> ClassLinker::RegisterDexFile(",
+        "bool ClassLinker::IsDexFileRegistered",
+    )
+    assert register_body.count("kRegisterDexFileReturn") == 2
+    assert register_body.index("r0dump_ObserveDex") < register_body.index("PaletteNotifyDexFileLoaded")
+
+    load_body = r0dump_function_body(
+        source,
+        "void ClassLinker::LoadClass(",
+        "void ClassLinker::AppendToBootClassPath",
+    )
+    for point, site in (
+        ("kLoadClassEntry", '"LoadClass.entry"'),
+        ("kLoadClassSuccess", '"LoadClass.success"'),
+    ):
+        assert load_body.count(point) == 2, point
+        assert load_body.count(site) == 1, site
+        assert load_body.count("if (UNLIKELY(r0dump_IsCapturePointActive") == 2
+    assert load_body.index("kLoadClassEntry") < load_body.index("ClassAccessor")
+    assert load_body.index("kLoadClassSuccess") > load_body.index("AllowThreadSuspension")
+    helper_body = r0dump_function_body(
+        source,
+        "void ClassLinker::LoadClassHelper::Load(",
+        "void ClassLinker::LoadClass(",
+    )
+    assert helper_body.count("kLoadMethodReady") == 2
