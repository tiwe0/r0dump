+TEST(r0dump_BufferTest, SubmissionPathsDoNotWaitForStagingLock) {
+  auto pool = std::make_shared<r0dump_BufferPool>(kR0dumpChunkBytes * 2u);
+  r0dump_Staging staging(pool, 4u, 8u, 4u, kR0dumpChunkBytes * 2u);
+  auto dex_capture = r0dump_Capture(pool.get(), 1u);
+  auto code_capture = r0dump_Capture(pool.get(), 2u);
+  ASSERT_NE(dex_capture, nullptr);
+  ASSERT_NE(code_capture, nullptr);
+
+  std::atomic<bool> lock_acquired = false;
+  std::atomic<bool> release_lock = false;
+  std::thread lock_holder([&]() {
+    std::unique_lock<std::mutex> guard(staging.lock_);
+    lock_acquired.store(true, std::memory_order_release);
+    while (!release_lock.load(std::memory_order_acquire)) {
+      std::this_thread::yield();
+    }
+  });
+  while (!lock_acquired.load(std::memory_order_acquire)) {
+    std::this_thread::yield();
+  }
+
+  const r0dump_HookContext context =
+      r0dump_Context(r0dump_Point::kCookieResultDex, "contended", 1u);
+  EXPECT_EQ(staging
+                .r0dump_SubmitDex(r0dump_CaptureKind::kDexView,
+                                  r0dump_DexFormat::kStandard,
+                                  std::move(dex_capture),
+                                  context)
+                .status,
+            r0dump_SubmitStatus::kLockBusy);
+  const uint8_t referenced_byte = 1u;
+  const std::optional<r0dump_SubmitResult> referenced =
+      staging.r0dump_TryReferenceDex(r0dump_CaptureKind::kDexView,
+                                     r0dump_DexFormat::kStandard,
+                                     &referenced_byte,
+                                     sizeof(referenced_byte),
+                                     1u,
+                                     context);
+  EXPECT_TRUE(referenced.has_value());
+  if (referenced.has_value()) {
+    EXPECT_EQ(referenced->status, r0dump_SubmitStatus::kLockBusy);
+  }
+  EXPECT_EQ(staging.r0dump_SubmitCodeItem({}, std::move(code_capture), {}, context).status,
+            r0dump_SubmitStatus::kLockBusy);
+  EXPECT_EQ(staging
+                .r0dump_RecordDrop(
+                    context, r0dump_CaptureKind::kDexView, r0dump_DexFormat::kStandard, "contended")
+                .status,
+            r0dump_SubmitStatus::kLockBusy);
+  EXPECT_EQ(staging.r0dump_SubmitMetadata(context).status, r0dump_SubmitStatus::kLockBusy);
+
+  release_lock.store(true, std::memory_order_release);
+  lock_holder.join();
+  EXPECT_EQ(staging.r0dump_RecordCount(), 0u);
+  EXPECT_EQ(staging.r0dump_ArtifactCount(), 0u);
+  EXPECT_EQ(pool->r0dump_ReservedBytes(), 0u);
+}
