+#!/usr/bin/env python3
+"""Regression tests for r0dump_dex_rehydrate.py."""
+
+import hashlib
+import importlib.util
+import struct
+import sys
+import unittest
+from pathlib import Path
+
+
+MODULE_PATH = Path(__file__).with_name("r0dump_dex_rehydrate.py")
+SPEC = importlib.util.spec_from_file_location("r0dump_dex_rehydrate", MODULE_PATH)
+assert SPEC is not None and SPEC.loader is not None
+rehydrate = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = rehydrate
+SPEC.loader.exec_module(rehydrate)
+
+
+class R0dumpDexRehydrateTest(unittest.TestCase):
+    def test_runtime_view_accepts_embedded_section_counts(self) -> None:
+        raw = bytes(0x200)
+        metadata = {
+            "runtime_view": {
+                "data_begin": "0x1000",
+                "string_ids": "0x1000",
+                "type_ids": "0x1004",
+                "proto_ids": "0x1008",
+                "field_ids": "0x1014",
+                "method_ids": "0x101c",
+                "class_defs": "0x1024",
+                "section_counts_current": {
+                    "string_ids": 1, "type_ids": 1, "proto_ids": 1,
+                    "field_ids": 1, "method_ids": 1, "class_defs": 1,
+                },
+            }
+        }
+        layout = rehydrate.parse_runtime_layout(raw, metadata)
+        self.assertEqual(layout.count_source, "epoch_current")
+        self.assertEqual(layout.counts["class_defs"], 1)
+
+    def test_annotation_item_is_not_an_encoded_value(self) -> None:
+        # visibility=BUILD, encoded_annotation(type=1, one name/value pair),
+        # VALUE_BYTE(7).  Treating byte 1 as an encoded_value type is the
+        # regression that used to make otherwise complete snapshots fail.
+        raw = bytes((2, 1, 1, 3, 0, 7))
+        self.assertEqual(rehydrate.annotation_item_end(raw, 0), len(raw))
+        with self.assertRaisesRegex(rehydrate.LayoutError, "bogus encoded_value"):
+            rehydrate.encoded_value_end(bytes((1,)), 0)
+
+    def test_rebuild_rebases_code_and_emits_a_complete_map(self) -> None:
+        raw = bytearray(0x1000)
+        offsets = {
+            "string_ids": 0x100,
+            "type_ids": 0x200,
+            "proto_ids": 0x300,
+            "field_ids": 0x400,
+            "method_ids": 0x500,
+            "class_defs": 0x600,
+        }
+        counts = {
+            "string_ids": 3,
+            "type_ids": 2,
+            "proto_ids": 1,
+            "field_ids": 0,
+            "method_ids": 1,
+            "class_defs": 1,
+        }
+        strings = (0x700, 0x710, 0x720)
+        for index, offset in enumerate(strings):
+            struct.pack_into("<I", raw, offsets["string_ids"] + index * 4, offset)
+        raw[0x700:0x704] = b"\x01V\0\0"
+        raw[0x710:0x714] = b"\x07LV;\0"
+        raw[0x720:0x725] = b"\x01m\0\0\0"
+        struct.pack_into("<II", raw, offsets["type_ids"], 0, 1)
+        struct.pack_into("<III", raw, offsets["proto_ids"], 2, 0, 0)
+        struct.pack_into("<HHI", raw, offsets["method_ids"], 1, 0, 2)
+        struct.pack_into(
+            "<8I", raw, offsets["class_defs"], 1, 1, 0, 0, rehydrate.NO_INDEX, 0, 0x800, 0
+        )
+        # One direct method with code_item at 0x900.  The instruction stream is a NOP.
+        raw[0x800:0x808] = b"\x00\x00\x01\x00\x00\x01\x80\x12"
+        struct.pack_into("<HHHHII", raw, 0x900, 1, 0, 0, 0, 0, 1)
+        struct.pack_into("<H", raw, 0x910, 0)
+        layout = rehydrate.RuntimeLayout(len(raw), offsets, counts, "unit_test")
+
+        dex, report = rehydrate.build_rehydrated_dex(bytes(raw), layout)
+
+        self.assertTrue(report["dump_ready"])
+        self.assertEqual(report["code_items"], 1)
+        self.assertEqual(dex[12:32], hashlib.sha1(dex[32:]).digest())
+        class_defs_off = struct.unpack_from("<I", dex, 100)[0]
+        class_data_off = struct.unpack_from("<I", dex, class_defs_off + 24)[0]
+        parsed, _ = rehydrate.parse_class_data(dex, class_data_off)
+        self.assertEqual(parsed.direct_methods[0][2], report["raw_base"] + 0x900)
+        map_off = struct.unpack_from("<I", dex, 52)[0]
+        map_count = struct.unpack_from("<I", dex, map_off)[0]
+        map_types = {struct.unpack_from("<H", dex, map_off + 4 + index * 12)[0] for index in range(map_count)}
