+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return {.status = r0dump_CaptureStatus::kDisabled};
+  }
+  if (method == nullptr || method->IsRuntimeMethod()) {
+    return {.status = r0dump_CaptureStatus::kInvalidRange};
