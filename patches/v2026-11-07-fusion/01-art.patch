+#ifndef ART_RUNTIME_R0DUMP_R0DUMP_HOOK_POINT_H_
+#define ART_RUNTIME_R0DUMP_R0DUMP_HOOK_POINT_H_
+
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+#include "base/macros.h"
+
+namespace art HIDDEN {
+
+// These values are persisted in capture_point_mask. Do not reorder or reuse them.
+enum class r0dump_Point : uint8_t {
+  kCookieResultDex = 0,
+  kInMemoryBufferCopied = 1,
+  kInMemoryDexParsed = 2,
+  kOpenCommonReturn = 3,
+  kDefineClassNativeMatch = 4,
+  kRegisterDexFileReturn = 5,
+  kDefineClassEntry = 6,
+  kDefineClassSuccess = 7,
+  kLoadMethodReady = 8,
+  kLoadClassEntry = 9,
+  kLoadClassSuccess = 10,
+  kResolveMethodCacheHit = 11,
+  kResolveMethodLookupSuccess = 12,
+  kVerifyClassComplete = 13,
+  kClassInitBeforeClinit = 14,
+  kClassInitSuccess = 15,
+  kOatDexFileOpenSuccess = 16,
+  kVdexLoadComplete = 17,
+  kOatManagerFileComplete = 18,
+  kOatManagerMemoryComplete = 19,
+  kOatManagerRegisterBeforeLock = 20,
+  kImageSpaceDexTracked = 21,
+  kArtMethodInvokeDispatch = 22,
+  kInterpreterExecuteEntry = 23,
+  kJitMethodEntered = 24,
+  kJitCompileBegin = 25,
+  kJitCompileEnd = 26,
+  kReflectMethodBeforeInvoke = 27,
+  kReflectCtorBeforeInvoke = 28,
+  kInstrumentationEnter = 29,
+  kInstrumentationExitValue = 30,
+  kInstrumentationExitObject = 31,
+  kBdclPathConstructor = 32,
+  kBdclMemoryConstructor = 33,
+  kBdclFindClassSuccess = 34,
+  kBdclAddDexPathReturn = 35,
+  kDexFileOpenFileReturn = 36,
+  kDexFileOpenMemoryReturn = 37,
+  kDexFileBeforeDefine = 38,
+  kWalkCookieDex = 39,
+  kWalkExecutableMethod = 40,
+  kForceInvokeNoExecute = 41,
+  kNterpMethodEntry = 42,
+};
+
+using r0dump_CapturePointMask = uint64_t;
+
+constexpr uint8_t kR0dumpPointCount = 43;
+constexpr r0dump_CapturePointMask kR0dumpDefinedPointMask =
+    (r0dump_CapturePointMask{1} << kR0dumpPointCount) - 1;
+
+constexpr uint8_t r0dump_PointIndex(r0dump_Point point) { return static_cast<uint8_t>(point); }
+
+constexpr bool r0dump_IsDefinedPoint(r0dump_Point point) {
+  return r0dump_PointIndex(point) < kR0dumpPointCount;
+}
+
+constexpr r0dump_CapturePointMask r0dump_PointBit(r0dump_Point point) {
+  return r0dump_IsDefinedPoint(point) ? r0dump_CapturePointMask{1} << r0dump_PointIndex(point)
+                                      : r0dump_CapturePointMask{0};
+}
+
+constexpr bool r0dump_IsDefinedPointMask(r0dump_CapturePointMask mask) {
+  return (mask & ~kR0dumpDefinedPointMask) == 0;
+}
+
+constexpr bool r0dump_IsValidCapturePointMask(r0dump_CapturePointMask mask) {
+  return r0dump_IsDefinedPointMask(mask);
+}
+
+constexpr bool r0dump_IsCapturePointEnabled(r0dump_CapturePointMask mask, r0dump_Point point) {
+  return r0dump_IsDefinedPoint(point) && (mask & r0dump_PointBit(point)) != 0u;
+}
+
+std::string_view r0dump_PointName(r0dump_Point point);
+std::optional<r0dump_Point> r0dump_PointFromName(std::string_view name);
+
+}  // namespace art HIDDEN
+
+#endif  // ART_RUNTIME_R0DUMP_R0DUMP_HOOK_POINT_H_
