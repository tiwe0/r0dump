+static jclass r0dump_Runtime_r0dump_FindLoadedClass(JNIEnv* env,
+                                                    jclass,
+                                                    jobject java_loader,
+                                                    jstring java_name) {
+  ScopedObjectAccess soa(env);
+  ObjPtr<mirror::ClassLoader> loader = soa.Decode<mirror::ClassLoader>(java_loader);
+  ScopedUtfChars name(env, java_name);
+  if (loader == nullptr || name.c_str() == nullptr) {
+    return nullptr;
+  }
+  const std::string descriptor = DotToDescriptor(name.c_str());
+  ObjPtr<mirror::Class> klass =
+      Runtime::Current()->GetClassLinker()->LookupClass(soa.Self(), descriptor, loader);
+  if (klass == nullptr || !klass->IsResolved()) {
+    g_r0dump_walk_class_resolve_failed.fetch_add(1u, std::memory_order_relaxed);
+    return nullptr;
+  }
+  return soa.AddLocalReference<jclass>(klass);
+}
