+#!/usr/bin/env python3
+
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def r0dump_read(path: str) -> str:
+    return (ROOT / path).read_text(encoding="utf-8")
+
+
+def r0dump_assert_order(text: str, first: str, second: str) -> None:
+    first_index = text.index(first)
+    second_index = text.index(second, first_index)
+    assert first_index < second_index, f"expected {first!r} before {second!r}"
+
+
+def r0dump_test_framework_worker() -> None:
+    walk = r0dump_read(
+        "frameworks/base/core/java/android/app/r0dump_ClassLoaderWalk.java"
+    )
+    assert "loadedApk.getClassLoader()" in walk
+    assert "getContextClassLoader()" in walk
+    assert "current = current.getParent()" in walk
+    assert "r0dump_GetRegisteredClassLoaders()" in walk
+    assert "IdentityHashMap<ClassLoader" in walk
+    assert "r0dump_GetDexCookies(loader)" in walk
+    assert "r0dump_GetDexCacheClassNames(loader, config.walkNamespacePrefix)" in walk
+    assert "r0dump_GetLoadedClassNames(loader)" in walk
+    assert "r0dump_ManifestHelper.r0dump_parse" in walk
+    assert "r0dump_FindLoadedClass(loader, className)" in walk
+    assert "Class.forName(className, false, loader)" in walk
+    assert "klass.getDeclaredMethods()" in walk
+    assert "klass.getDeclaredConstructors()" in walk
+    assert "r0dump_CaptureCookie" in walk
+    assert "r0dump_CaptureExecutable" in walk
+    walk_capture = walk.split("private static void r0dump_captureExecutables", 1)[1]
+    walk_capture = walk_capture.split("private static int r0dump_forceInvokeExact", 1)[0]
+    for forbidden in ("r0dump_ForceInvoke", "java.io.", "PackageManager"):
+        assert forbidden not in walk_capture
+    for forbidden in ("java.io.", "PackageManager"):
+        assert forbidden not in walk
+
+    manifest = r0dump_read(
+        "frameworks/base/core/java/android/app/r0dump_ManifestHelper.java"
+    )
+    for forbidden in (
+        "overlayPaths",
+        "resourceDirs",
+        "sharedLibraryFiles",
+        "getOverlayPaths",
+    ):
+        assert forbidden not in manifest
+
+    run = walk.split("private static boolean r0dump_run", 1)[1].split(
+        "private static void r0dump_publishManifestSnapshot", 1
+    )[0]
+    manifest_gate = run.index("if (request.config.manifestEnabled)")
+    manifest_parse = run.index("r0dump_ManifestHelper.r0dump_parse", manifest_gate)
+    manifest_else = run.index("} else {", manifest_parse)
+    assert manifest_gate < manifest_parse < manifest_else
+    assert "HashSet<String>" in walk
+    assert "!state.r0dump_markClass(loader, className)" in walk
+    assert "r0dump_matchesConfiguredNamespace" in walk
+    assert "r0dump_SOURCE_DEX_CACHE" in walk
+
+
+def r0dump_test_passive_only_request_starts_the_single_worker() -> None:
+    walk = r0dump_read(
+        "frameworks/base/core/java/android/app/r0dump_ClassLoaderWalk.java"
+    )
+    file_worker = r0dump_read(
+        "frameworks/base/core/java/android/app/r0dump_FileWorker.java"
+    )
+    prepare = walk.split("static void r0dump_prepare", 1)[1].split(
+        "static void r0dump_schedule", 1
+    )[0]
+    schedule = walk.split("static void r0dump_schedule", 1)[1].split(
+        "private static boolean r0dump_run", 1
+    )[0]
+    assert "(!config.walkEnabled && !config.forceInvokeEnabled)" not in prepare
+    assert "r0dump_FileWorker.r0dump_schedule(" in schedule
+    assert "AtomicBoolean" not in walk
+    assert "new Thread(" not in walk
+    assert "SystemClock.sleep" not in walk
+    assert "r0dump_ServiceFlush" not in walk
+    assert "Executor" not in walk
+    assert '"r0dump-fusion-writer"' in file_worker
+    assert "interface r0dump_Work" in file_worker
+    assert "boolean r0dump_run();" in file_worker
+    assert "AtomicBoolean" in file_worker
+    assert "!r0dump_SCHEDULED.compareAndSet(false, true)" in file_worker
+    assert file_worker.count("new Thread(") == 1
+
+
+def r0dump_test_worker_always_completes_walk_in_finally() -> None:
+    worker = r0dump_read(
+        "frameworks/base/core/java/android/app/r0dump_FileWorker.java"
+    )
+    runnable = worker.split("() -> {", 1)[1].split(
+        "r0dump_WORKER_NAME", 1
+    )[0]
+    assert "try {" in runnable
+    assert "finally {" in runnable
+    assert "r0dump_Runtime.r0dump_CompleteWalk(r0dump_completed)" in runnable
+    assert "r0dump_Runtime.r0dump_ServiceFlush()" in runnable
+    assert "r0dump_serviceFlushForever()" in runnable
+    service = worker.split("private static void r0dump_serviceFlushForever", 1)[1]
+    assert "while (true)" in service
+    assert "SystemClock.sleep(250L)" in service
+    assert "r0dump_Runtime.r0dump_ServiceFlush()" in service
+
+
+def r0dump_test_activity_lifecycle_order() -> None:
+    activity_thread = r0dump_read(
+        "frameworks/base/core/java/android/app/ActivityThread.java"
