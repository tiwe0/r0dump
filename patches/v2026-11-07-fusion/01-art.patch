+
+r0dump_ProcessConfig r0dump_ValidConfig() {
+  r0dump_ProcessConfig config;
+  config.enabled = true;
+  config.run_id = "20260824T120000Z-a1b2c3d4";
+  config.target_package = "com.example.target";
+  config.target_process = "com.example.target";
+  config.process_name = "com.example.target";
+  config.output_parent = r0dump_OutputParent(config.target_package);
+  config.capture_point_mask = r0dump_PointBit(r0dump_Point::kCookieResultDex);
+  return config;
+}
+
+TEST(r0dump_ConfigTest, AcceptsCanonicalConfig) {
+  r0dump_ConfigError error;
+  EXPECT_TRUE(r0dump_ValidateConfig(r0dump_ValidConfig(), &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kNone);
+  EXPECT_EQ(error.field, nullptr);
+}
+
+TEST(r0dump_ConfigTest, RejectsUndefinedCapturePointBit) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.capture_point_mask |= uint64_t{1} << 43u;
+  r0dump_ConfigError error;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kInvalidCapturePointMask);
+}
+
+TEST(r0dump_ConfigTest, ForceInvokeRequiresNoExecutePointAndBoundedScope) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.force_invoke_enabled = true;
+  config.force_class = "com.example.target.Entry";
+  config.force_method = "materialize";
+  config.force_method_descriptor = "()V";
+
+  r0dump_ConfigError error;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kInvalidForceSelector);
+
+  config.capture_point_mask |= r0dump_PointBit(r0dump_Point::kForceInvokeNoExecute);
+  EXPECT_TRUE(r0dump_ValidateConfig(config, &error));
+
+  config.force_method_descriptor = "";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+
+  config.force_method_descriptor = "(Ljava.lang.String;)V";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+
+  config.force_method_descriptor = "([Ljava/lang/String;I)Ljava/lang/Object;";
+  EXPECT_TRUE(r0dump_ValidateConfig(config, &error));
+
+  config.force_class.clear();
+  config.force_method.clear();
+  config.force_method_descriptor.clear();
+  config.manifest_enabled = true;
+  EXPECT_TRUE(r0dump_ValidateConfig(config, &error));
+
+  config.manifest_enabled = false;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+
+  config.manifest_enabled = true;
+  config.force_class = "com.example.target.Entry";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+}
+
+TEST(r0dump_ConfigTest, RejectsPathLikeIdentityFields) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.run_id = "../escape";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.target_process = "com.other.process";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.target_process = "com.example.target:child";
+  config.process_name = "com.example.target:child";
+  EXPECT_TRUE(r0dump_ValidateConfig(config, nullptr));
+}
+
+TEST(r0dump_ConfigTest, NamespacePrefixIsExplicitAndSegmentBounded) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.walk_namespace_prefix = "com.example.ui.";
+  EXPECT_TRUE(r0dump_ValidateConfig(config, nullptr));
+
+  config.walk_namespace_prefix = "com.example.ui";
+  r0dump_ConfigError error;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kInvalidWalkSelector);
+  EXPECT_STREQ(error.field, "walk_namespace_prefix");
+}
+
+TEST(r0dump_ConfigTest, AcceptsOnlyCanonicalOutputParent) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.output_parent = r0dump_OutputParent("com.other.target");
+  r0dump_ConfigError error;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kInvalidOutputParent);
+
+  config.output_parent += "/../escape";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config.output_parent = "/data/user/0/com.example.target/files";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config.output_parent = "/sdcard/Android/data/com.example.target/files";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+}
+
+TEST(r0dump_ConfigTest, RejectsBudgetsOutsideDocumentedHardLimits) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.max_total_bytes = kR0dumpMaxTotalBytesHardLimit;
+  config.max_dex_bytes = kR0dumpMaxDexBytesHardLimit;
+  config.buffer_pool_bytes = kR0dumpBufferPoolBytesHardLimit;
+  config.max_code_item_bytes = kR0dumpMaxCodeItemBytesHardLimit;
+  EXPECT_TRUE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.max_total_bytes = kR0dumpMaxTotalBytesHardLimit + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.max_total_bytes = kR0dumpMaxDexBytesHardLimit;
+  config.max_dex_bytes = kR0dumpMaxDexBytesHardLimit;
