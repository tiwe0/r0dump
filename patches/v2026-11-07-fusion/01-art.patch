+void r0dump_ObserveMethodCodeItemOrMetadata(r0dump_Point point,
+                                            std::string_view site,
+                                            ArtMethod* method,
+                                            r0dump_CodeItemRole role,
+                                            uint64_t attempt_id,
+                                            std::string_view source_kind,
+                                            r0dump_RecordMetadata metadata)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return;
+  }
+  if (r0dump_ObserveMethodCodeItem(point, site, method, role, attempt_id, source_kind)) {
+    return;
+  }
+  if (method != nullptr && !method->IsRuntimeMethod()) {
+    r0dump_SetMethodExecutionMetadata(method, r0dump_ObservationPhase(point), &metadata);
+    r0dump_ObserveMethodMetadata(point, site, method, std::move(metadata));
+  }
