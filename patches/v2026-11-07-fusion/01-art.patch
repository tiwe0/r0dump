+bool r0dump_ObserveMethodCodeItem(r0dump_Point point,
+                                  std::string_view site,
+                                  ArtMethod* method,
+                                  r0dump_CodeItemRole role,
+                                  uint64_t attempt_id,
+                                  std::string_view source_kind)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return false;
+  }
+  r0dump_CaptureProcessState* state =
+      g_r0dump_capture_process_state.load(std::memory_order_acquire);
+  DCHECK(state != nullptr);
+  if (method == nullptr || method->IsRuntimeMethod() || method->IsProxyMethod() ||
+      method->IsAbstract() || method->IsNative() || !method->HasCodeItem()) {
+    return false;
+  }
+  const DexFile* dex_file = method->GetDexFile();
+  const dex::CodeItem* code_item = method->GetCodeItem();
+  if (dex_file == nullptr || code_item == nullptr) {
+    return false;
+  }
+  const uint64_t dex_identity = r0dump_DexIdentity(*dex_file);
+  const uint32_t method_index = method->GetDexMethodIndex();
+  if (!r0dump_TryClaimMethodObservation(state, point, dex_identity, method_index)) {
+    return false;
+  }
+
+  // The nearby snapshot is submitted before the first CodeItem so that the
+  // configured artifact cap cannot be consumed by CodeItems before their base
+  // DEX becomes available for host-side backfill.
+  r0dump_CaptureNearbyDexCandidate(state, point, site, *dex_file, code_item);
+
+  r0dump_PreparedCodeItem prepared;
+  if (r0dump_TryPrepareCodeItem(point,
+                                site,
+                                *dex_file,
+                                code_item,
+                                method_index,
+                                method->GetClassDefIndex(),
+                                role,
+                                method->GetDeclaringClass()->IsInitialized(),
+                                /* no_execute= */ false,
+                                &prepared) != r0dump_CaptureStatus::kSubmitted) {
+    r0dump_ReleaseMethodObservation(state, point, dex_identity, method_index);
+    return false;
+  }
+  prepared.attempt_id = attempt_id;
+  prepared.class_name = method->GetDeclaringClassDescriptorView();
+  prepared.method_name = method->GetNameView();
+  prepared.method_descriptor = method->GetSignature().ToString();
+  prepared.source_kind = source_kind;
+  r0dump_SetPreparedMethodState(method, r0dump_ObservationPhase(point), &prepared);
+  const r0dump_SubmitResult submit = r0dump_SubmitPreparedCodeItem(std::move(prepared)).submit;
+  const bool accepted = submit.status == r0dump_SubmitStatus::kAccepted ||
+                        submit.status == r0dump_SubmitStatus::kDuplicate;
+  if (!accepted) {
+    r0dump_ReleaseMethodObservation(state, point, dex_identity, method_index);
+  }
+  return accepted;
+}
