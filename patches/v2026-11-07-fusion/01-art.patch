+        "libcore/libart/src/main/java/dalvik/system/r0dump_Runtime.java"
+    )
+    runtime_native = r0dump_read(
+        "art/runtime/native/dalvik_system_r0dump_Runtime.cc"
+    )
+    bridge_names = (
+        "r0dump_GetRegisteredClassLoaders",
+        "r0dump_GetLoadedClassNames",
+        "r0dump_GetCookieClassNames",
+        "r0dump_GetDexCacheClassNames",
+        "r0dump_FindLoadedClass",
+        "r0dump_CaptureCookie",
+        "r0dump_CaptureExecutable",
+        "r0dump_PublishManifestSnapshot",
+    )
+    for name in bridge_names:
+        assert name in runtime_java
+        assert f"NATIVE_METHOD(r0dump_Runtime" in runtime_native
+        assert name in runtime_native
+    assert "ClassLinker()->GetClassLoaders" in runtime_native
+    assert "GetClassTable()->Visit" in runtime_native
+    assert "namespace_prefix" in runtime_native
+    assert "r0dump_ConvertJavaArrayToDexFiles" in runtime_native
+    assert "kWalkCookieDex" in runtime_native
+    assert "kWalkExecutableMethod" in runtime_native
+    assert "kWalkExecutable" in runtime_native
+    assert '"walk_started"' in runtime_native
+    assert '"walk_completed"' in runtime_native
+    r0dump_assert_order(
+        worker,
+        "r0dump_ManifestHelper.r0dump_parse(",
+        "r0dump_publishManifestSnapshot(r0dump_manifest);",
+    )
+    r0dump_assert_order(
+        worker,
+        "r0dump_publishManifestSnapshot(r0dump_manifest);",
+        "r0dump_walkManifestNames(r0dump_manifest",
+    )
+    walk_native = runtime_native.split(
+        "static void r0dump_Runtime_r0dump_CaptureExecutable", 1
+    )[1].split("static jboolean r0dump_Runtime_r0dump_ForceInvoke", 1)[0]
+    for forbidden in (
+        "EnsureInitialized",
+        "ArtMethod::Invoke",
+        "kForceInvokeNoExecute",
+        "ForceInvoke.no_execute",
+    ):
+        assert forbidden not in walk_native
+
+    base_loader = r0dump_read(
+        "libcore/dalvik/src/main/java/dalvik/system/BaseDexClassLoader.java"
+    )
+    dex_path_list = r0dump_read(
+        "libcore/dalvik/src/main/java/dalvik/system/DexPathList.java"
+    )
+    dex_file = r0dump_read("libcore/dalvik/src/main/java/dalvik/system/DexFile.java")
+    assert "static Object[] r0dump_GetDexCookies(ClassLoader loader)" in base_loader
+    assert "return r0dump_GetDexCookies(loader, 0);" in base_loader
+    assert "pathList.r0dump_GetDexCookies(firstElement)" in base_loader
+    assert "element.r0dump_GetDexCookie()" in dex_path_list
+    assert "dexFile.r0dump_GetCookie()" in dex_path_list
+    assert "return mCookie;" in dex_file
+    assert "getDeclaredField" not in runtime_java
+
+
+if __name__ == "__main__":
+    r0dump_test_framework_worker()
+    r0dump_test_passive_only_request_starts_the_single_worker()
+    r0dump_test_worker_always_completes_walk_in_finally()
