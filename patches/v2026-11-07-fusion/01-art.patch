+TEST(r0dump_BufferTest, ConcurrentAcquireAndReleaseUsesLockFreePoolAccounting) {
+  constexpr size_t kThreadCount = 8u;
+  constexpr size_t kIterations = 1000u;
+  r0dump_BufferPool pool(kR0dumpChunkBytes * kThreadCount);
+  std::atomic<size_t> successes = 0u;
+  std::vector<std::thread> workers;
+  workers.reserve(kThreadCount);
+  for (size_t thread = 0u; thread != kThreadCount; ++thread) {
+    workers.emplace_back([&]() {
+      for (size_t iteration = 0u; iteration != kIterations; ++iteration) {
+        std::unique_ptr<r0dump_OwnedCapture> capture =
+            r0dump_Capture(&pool, static_cast<uint8_t>(iteration));
+        if (capture != nullptr) {
+          ++successes;
+        }
+      }
+    });
+  }
+  for (std::thread& worker : workers) {
+    worker.join();
+  }
+  EXPECT_GT(successes.load(), 0u);
+  EXPECT_EQ(pool.r0dump_ReservedBytes(), 0u);
+  EXPECT_LE(pool.r0dump_HighWaterBytes(), pool.r0dump_CapacityBytes());
+}
