+
+#ifndef ART_RUNTIME_R0DUMP_R0DUMP_LOG_H_
+#define ART_RUNTIME_R0DUMP_R0DUMP_LOG_H_
+
+#include <cstdint>
+#include <initializer_list>
+#include <string_view>
+
+#include "base/macros.h"
+
+namespace art HIDDEN {
+
+enum class r0dump_LogLevel : uint8_t {
+  kDebug,
+  kInfo,
+  kWarn,
+  kError,
+};
+
+struct r0dump_LogField {
+  std::string_view key;
+  std::string_view value;
+};
+
+using r0dump_LogSink = void (*)(r0dump_LogLevel level, std::string_view line);
+using r0dump_LogClock = uint64_t (*)();
+
+// Formats a structured lifecycle record and sends it to the fixed R0dumpFusion tag. Callers must
+// gate this function on the r0dump enabled path; this module intentionally has no configuration
+// dependency. Field values must be bounded, non-user-derived metadata.
+void r0dump_Log(r0dump_LogLevel level,
+                std::string_view event,
+                std::initializer_list<r0dump_LogField> fields);
+
+// Test seams. They are process-global and must not be changed while production logging is active.
+void r0dump_SetLogSinkForTesting(r0dump_LogSink sink);
+void r0dump_SetLogClockForTesting(r0dump_LogClock clock);
+void r0dump_ResetLogStateForTesting();
+
+}  // namespace art HIDDEN
+
+#endif  // ART_RUNTIME_R0DUMP_R0DUMP_LOG_H_
