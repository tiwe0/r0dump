+  uint64_t r0dump_WalkCookieRecords() const { return walk_cookie_records_; }
+  uint64_t r0dump_WalkLoadedTableRecords() const { return walk_loaded_table_records_; }
+  uint64_t r0dump_WalkManifestRecords() const { return walk_manifest_records_; }
+  uint64_t r0dump_ForceAttemptRecords() const { return force_attempt_records_; }
+  uint64_t r0dump_ForceMaterializedRecords() const { return force_materialized_records_; }
+  uint64_t r0dump_ForceNoDispatchRecords() const { return force_no_dispatch_records_; }
+
+ private:
+  friend r0dump_GenerationWriteResult r0dump_WriteFrozenGeneration(
+      int, std::string_view, uint32_t, const r0dump_FrozenGeneration&, r0dump_WriterState*);
+  friend r0dump_FileResult r0dump_WriteSummaryFile(int,
+                                                   const r0dump_BufferSummary&,
+                                                   const std::array<uint64_t, kR0dumpPointCount>&,
