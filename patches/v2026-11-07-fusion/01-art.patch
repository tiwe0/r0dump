+#include "r0dump/r0dump_buffer.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <functional>
+#include <new>
+
+#include "base/logging.h"
+
+namespace art HIDDEN {
+
+class r0dump_BufferState final {
+ public:
+  r0dump_BufferState(size_t capacity, r0dump_HashFunction hash)
+      : storage(capacity == 0u ? nullptr : new (std::nothrow) uint8_t[capacity]),
+        free_chunk_words(
+            capacity == 0u ? nullptr
+                           : new (std::nothrow)
+                                 std::atomic<uint64_t>[(capacity / kR0dumpChunkBytes + 63u) / 64u]),
+        capacity_bytes(storage != nullptr && free_chunk_words != nullptr ? capacity : 0u),
+        chunk_count(capacity_bytes / kR0dumpChunkBytes),
+        free_word_count((chunk_count + 63u) / 64u),
+        hash_function(hash) {
+    if (capacity_bytes == 0u) {
+      storage.reset();
+      free_chunk_words.reset();
+      return;
+    }
+    for (size_t word = 0u; word != free_word_count; ++word) {
+      const size_t remaining = chunk_count - word * 64u;
+      const uint64_t free_bits = remaining >= 64u ? ~uint64_t{0} : (uint64_t{1} << remaining) - 1u;
+      free_chunk_words[word].store(free_bits, std::memory_order_relaxed);
+    }
+  }
+
+  std::unique_ptr<uint8_t[]> storage;
+  std::unique_ptr<std::atomic<uint64_t>[]> free_chunk_words;
+  const size_t capacity_bytes;
+  const size_t chunk_count;
+  const size_t free_word_count;
+  std::atomic<size_t> reserved_chunks{0u};
+  std::atomic<size_t> reserved_chunks_high_water{0u};
+  const r0dump_HashFunction hash_function;
+};
+
+namespace {
+
+uint64_t r0dump_AppendHash(uint64_t hash, const uint8_t* data, size_t size) {
+  for (size_t index = 0; index < size; ++index) {
+    hash ^= data[index];
+    hash *= 1099511628211ULL;
+  }
+  return hash;
+}
+
+size_t r0dump_ChunkCount(size_t size) {
+  return size == 0 ? 0 : ((size - 1) / kR0dumpChunkBytes) + 1;
+}
+
+size_t r0dump_ClampPoolBytes(size_t bytes) {
+  bytes = std::min<size_t>(bytes, kR0dumpBufferPoolBytesHardLimit);
+  return (bytes / kR0dumpChunkBytes) * kR0dumpChunkBytes;
+}
+
+template <size_t kMaxChunks>
+bool r0dump_TryClaimChunks(const std::shared_ptr<r0dump_BufferState>& state,
+                           size_t required_chunks,
+                           std::array<uint16_t, kMaxChunks>* chunks) {
+  size_t claimed = 0u;
+  for (size_t word = 0u; word != state->free_word_count && claimed != required_chunks; ++word) {
+    uint64_t available = state->free_chunk_words[word].load(std::memory_order_acquire);
+    while (available != 0u && claimed != required_chunks) {
+      const uint64_t bit = uint64_t{1} << __builtin_ctzll(available);
+      if (state->free_chunk_words[word].compare_exchange_weak(
+              available, available & ~bit, std::memory_order_acq_rel, std::memory_order_acquire)) {
+        (*chunks)[claimed++] =
+            static_cast<uint16_t>(word * 64u + static_cast<size_t>(__builtin_ctzll(bit)));
+      }
+    }
+  }
+  if (claimed != required_chunks) {
+    for (size_t index = 0u; index != claimed; ++index) {
+      const size_t chunk = (*chunks)[index];
+      state->free_chunk_words[chunk / 64u].fetch_or(uint64_t{1} << (chunk % 64u),
+                                                    std::memory_order_release);
+    }
+    return false;
+  }
+
+  const size_t reserved =
+      state->reserved_chunks.fetch_add(required_chunks, std::memory_order_acq_rel) +
+      required_chunks;
+  size_t high_water = state->reserved_chunks_high_water.load(std::memory_order_relaxed);
+  while (high_water < reserved &&
+         !state->reserved_chunks_high_water.compare_exchange_weak(
+             high_water, reserved, std::memory_order_relaxed, std::memory_order_relaxed)) {}
+  return true;
+}
+
+template <size_t kMaxChunks>
+bool r0dump_TryCopyIntoChunks(const std::shared_ptr<r0dump_BufferState>& state,
+                              const uint8_t* data,
+                              size_t size,
+                              std::array<uint16_t, kMaxChunks>* chunks,
+                              size_t* chunk_count,
+                              uint64_t* hash) {
+  if (data == nullptr || size == 0u || chunks == nullptr || chunk_count == nullptr ||
+      hash == nullptr) {
+    return false;
+  }
+  const size_t required_chunks = r0dump_ChunkCount(size);
+  if (required_chunks == 0u || required_chunks > kMaxChunks) {
+    return false;
+  }
+  std::unique_ptr<r0dump_Segment[]> custom_segments;
+  if (state->hash_function != r0dump_HashSegments) {
+    custom_segments.reset(new (std::nothrow) r0dump_Segment[required_chunks]);
+    if (custom_segments == nullptr) {
+      return false;
+    }
+  }
+  if (!r0dump_TryClaimChunks(state, required_chunks, chunks)) {
+    return false;
+  }
+
+  size_t copied = 0u;
+  uint64_t rolling_hash = 1469598103934665603ULL;
+  for (size_t index = 0u; index != required_chunks; ++index) {
+    const size_t count = std::min(size - copied, kR0dumpChunkBytes);
+    uint8_t* destination =
+        state->storage.get() + static_cast<size_t>((*chunks)[index]) * kR0dumpChunkBytes;
+    std::memcpy(destination, data + copied, count);
+    if (custom_segments != nullptr) {
+      custom_segments[index] = {destination, count};
+    } else {
+      rolling_hash = r0dump_AppendHash(rolling_hash, destination, count);
+    }
+    copied += count;
+  }
+  *chunk_count = required_chunks;
+  *hash = custom_segments == nullptr ? rolling_hash
+                                     : state->hash_function(custom_segments.get(), required_chunks);
+  return true;
+}
+
+template <size_t kMaxChunks>
+void r0dump_ReleaseChunks(const std::shared_ptr<r0dump_BufferState>& state,
+                          const std::array<uint16_t, kMaxChunks>& chunks,
+                          size_t chunk_count) {
+  const size_t previous_reserved =
+      state->reserved_chunks.fetch_sub(chunk_count, std::memory_order_acq_rel);
+  DCHECK_GE(previous_reserved, chunk_count);
+  for (size_t index = 0u; index != chunk_count; ++index) {
+    const size_t chunk = chunks[index];
+    const uint64_t bit = uint64_t{1} << (chunk % 64u);
+    const uint64_t previous_free_bits =
+        state->free_chunk_words[chunk / 64u].fetch_or(bit, std::memory_order_release);
+    DCHECK_EQ(previous_free_bits & bit, 0u);
+  }
+}
+
+}  // namespace
+
+uint64_t r0dump_HashBytes(const uint8_t* data, size_t size) {
+  return r0dump_AppendHash(1469598103934665603ULL, data, size);
+}
+
+uint64_t r0dump_HashSegments(const r0dump_Segment* segments, size_t segment_count) {
+  uint64_t hash = 1469598103934665603ULL;
+  for (size_t segment_index = 0; segment_index < segment_count; ++segment_index) {
+    const r0dump_Segment& segment = segments[segment_index];
+    hash = r0dump_AppendHash(hash, segment.data, segment.size);
+  }
+  return hash;
+}
+
+r0dump_OwnedCapture::r0dump_OwnedCapture(std::shared_ptr<r0dump_BufferState> state)
+    : state_(std::move(state)) {}
+
+r0dump_OwnedCapture::r0dump_OwnedCapture(std::shared_ptr<r0dump_BufferState> state,
+                                         const uint16_t* chunks,
+                                         size_t chunk_count,
+                                         size_t size,
+                                         uint64_t hash)
+    : state_(std::move(state)), chunk_count_(chunk_count), size_(size), hash_(hash) {
+  std::copy_n(chunks, chunk_count, chunks_.begin());
+}
+
+r0dump_OwnedCapture::r0dump_OwnedCapture(r0dump_OwnedCapture&& other) noexcept
+    : state_(std::move(other.state_)),
+      chunks_(other.chunks_),
+      chunk_count_(other.chunk_count_),
+      size_(other.size_),
+      hash_(other.hash_) {
+  other.chunk_count_ = 0u;
+  other.size_ = 0;
+  other.hash_ = 0;
+}
+
+r0dump_OwnedCapture& r0dump_OwnedCapture::operator=(r0dump_OwnedCapture&& other) noexcept {
+  if (this != &other) {
+    r0dump_Release();
+    state_ = std::move(other.state_);
+    chunks_ = other.chunks_;
+    chunk_count_ = other.chunk_count_;
+    size_ = other.size_;
+    hash_ = other.hash_;
+    other.chunk_count_ = 0u;
+    other.size_ = 0;
+    other.hash_ = 0;
+  }
+  return *this;
+}
+
+r0dump_OwnedCapture::~r0dump_OwnedCapture() { r0dump_Release(); }
+
+void r0dump_OwnedCapture::r0dump_Release() {
+  if (state_ == nullptr) {
+    return;
+  }
+  std::shared_ptr<r0dump_BufferState> state = std::move(state_);
+  r0dump_ReleaseChunks(state, chunks_, chunk_count_);
+  chunk_count_ = 0u;
+  size_ = 0u;
+  hash_ = 0u;
+}
+
+r0dump_PreparedCapture::r0dump_PreparedCapture(r0dump_PreparedCapture&& other) noexcept
+    : state_(std::move(other.state_)),
+      chunks_(other.chunks_),
+      chunk_count_(other.chunk_count_),
+      size_(other.size_),
+      hash_(other.hash_) {
+  other.chunk_count_ = 0u;
+  other.size_ = 0u;
+  other.hash_ = 0u;
+}
+
+r0dump_PreparedCapture& r0dump_PreparedCapture::operator=(r0dump_PreparedCapture&& other) noexcept {
+  if (this != &other) {
+    r0dump_Release();
+    state_ = std::move(other.state_);
+    chunks_ = other.chunks_;
+    chunk_count_ = other.chunk_count_;
+    size_ = other.size_;
+    hash_ = other.hash_;
+    other.chunk_count_ = 0u;
+    other.size_ = 0u;
+    other.hash_ = 0u;
+  }
+  return *this;
+}
+
+r0dump_PreparedCapture::~r0dump_PreparedCapture() { r0dump_Release(); }
+
+void r0dump_PreparedCapture::r0dump_Release() {
+  if (state_ == nullptr) {
+    return;
+  }
+  std::shared_ptr<r0dump_BufferState> state = std::move(state_);
+  r0dump_ReleaseChunks(state, chunks_, chunk_count_);
+  chunk_count_ = 0u;
+  size_ = 0u;
+  hash_ = 0u;
+}
+
+std::unique_ptr<r0dump_OwnedCapture> r0dump_PreparedCapture::r0dump_Consume() {
+  if (state_ == nullptr) {
+    return nullptr;
+  }
+  std::unique_ptr<r0dump_OwnedCapture> capture(
+      new (std::nothrow) r0dump_OwnedCapture(state_, chunks_.data(), chunk_count_, size_, hash_));
+  if (capture != nullptr) {
+    state_.reset();
+    chunk_count_ = 0u;
+    size_ = 0u;
+    hash_ = 0u;
+  }
+  return capture;
+}
+
+r0dump_Segment r0dump_OwnedCapture::r0dump_GetSegment(size_t index) const {
+  if (state_ == nullptr || index >= chunk_count_) {
+    return {};
+  }
+  const size_t begin = index * kR0dumpChunkBytes;
+  const size_t remaining = size_ > begin ? size_ - begin : 0;
+  return {state_->storage.get() + static_cast<size_t>(chunks_[index]) * kR0dumpChunkBytes,
+          std::min(remaining, kR0dumpChunkBytes)};
+}
+
+bool r0dump_OwnedCapture::r0dump_Equals(const r0dump_OwnedCapture& other) const {
+  if (size_ != other.size_ || hash_ != other.hash_) {
+    return false;
+  }
+  size_t left_segment = 0;
+  size_t right_segment = 0;
+  size_t left_offset = 0;
+  size_t right_offset = 0;
+  size_t compared = 0;
+  while (compared < size_) {
+    const r0dump_Segment left = r0dump_GetSegment(left_segment);
+    const r0dump_Segment right = other.r0dump_GetSegment(right_segment);
+    const size_t count = std::min(left.size - left_offset, right.size - right_offset);
+    if (std::memcmp(left.data + left_offset, right.data + right_offset, count) != 0) {
+      return false;
+    }
+    compared += count;
+    left_offset += count;
+    right_offset += count;
+    if (left_offset == left.size) {
+      ++left_segment;
+      left_offset = 0;
+    }
+    if (right_offset == right.size) {
+      ++right_segment;
+      right_offset = 0;
+    }
+  }
+  return true;
+}
+
+bool r0dump_OwnedCapture::r0dump_EqualsBytes(const uint8_t* data,
+                                             size_t size,
+                                             uint64_t hash) const {
+  if (data == nullptr || size_ != size || hash_ != hash) {
+    return false;
+  }
+  size_t compared = 0u;
+  for (size_t index = 0u; index != chunk_count_; ++index) {
+    const r0dump_Segment segment = r0dump_GetSegment(index);
+    if (std::memcmp(segment.data, data + compared, segment.size) != 0) {
+      return false;
+    }
+    compared += segment.size;
+  }
+  return compared == size;
+}
