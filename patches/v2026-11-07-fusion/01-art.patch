+TEST(r0dump_BufferTest, PartialClaimFailureRollsBackClaimedChunks) {
+  r0dump_BufferPool pool(kR0dumpChunkBytes * 2u);
+  auto first = r0dump_Capture(&pool, 1u, kR0dumpChunkBytes);
+  ASSERT_NE(first, nullptr);
+
+  EXPECT_EQ(r0dump_Capture(&pool, 2u, kR0dumpChunkBytes * 2u), nullptr);
+  EXPECT_EQ(pool.r0dump_ReservedBytes(), kR0dumpChunkBytes);
+
+  first.reset();
+  auto complete = r0dump_Capture(&pool, 3u, kR0dumpChunkBytes * 2u);
+  ASSERT_NE(complete, nullptr);
+  EXPECT_EQ(complete->r0dump_SegmentCount(), 2u);
+  EXPECT_EQ(pool.r0dump_ReservedBytes(), kR0dumpChunkBytes * 2u);
+}
