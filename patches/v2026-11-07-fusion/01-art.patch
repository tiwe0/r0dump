+std::string r0dump_NumberedName(uint64_t number, std::string_view suffix) {
+  if (number == 0u || number > 999999u) {
+    return {};
+  }
+  char name[64];
+  const int length = snprintf(name,
+                              sizeof(name),
+                              "%06" PRIu64 "%.*s",
+                              number,
+                              static_cast<int>(suffix.size()),
+                              suffix.data());
+  return length > 0 && static_cast<size_t>(length) < sizeof(name) ? std::string(name, length)
+                                                                  : std::string();
+}
+
+void r0dump_AppendJsonString(std::string* json, std::string_view value) {
+  constexpr char kR0dumpHex[] = "0123456789abcdef";
+  json->push_back('"');
+  for (const unsigned char character : value) {
+    switch (character) {
+      case '"':
+        json->append("\\\"");
+        break;
+      case '\\':
+        json->append("\\\\");
+        break;
+      case '\b':
+        json->append("\\b");
+        break;
+      case '\f':
+        json->append("\\f");
+        break;
+      case '\n':
+        json->append("\\n");
+        break;
+      case '\r':
+        json->append("\\r");
+        break;
+      case '\t':
+        json->append("\\t");
+        break;
+      default:
+        if (character < 0x20u) {
+          json->append("\\u00");
+          json->push_back(kR0dumpHex[character >> 4]);
+          json->push_back(kR0dumpHex[character & 0x0fu]);
+        } else {
+          json->push_back(static_cast<char>(character));
+        }
+    }
+  }
+  json->push_back('"');
+}
+
+void r0dump_AppendJsonField(std::string* json,
+                            std::string_view name,
+                            std::string_view value,
+                            bool* first) {
+  if (!*first) {
+    json->push_back(',');
+  }
+  *first = false;
+  r0dump_AppendJsonString(json, name);
+  json->push_back(':');
+  if (value.empty()) {
+    json->append("null");
+  } else {
+    r0dump_AppendJsonString(json, value);
+  }
+}
+
+template <typename T>
+void r0dump_AppendJsonNumber(std::string* json,
+                             std::string_view name,
+                             std::optional<T> value,
+                             bool* first) {
+  if (!*first) {
+    json->push_back(',');
+  }
+  *first = false;
+  r0dump_AppendJsonString(json, name);
+  json->push_back(':');
+  if (value.has_value()) {
+    json->append(std::to_string(*value));
+  } else {
+    json->append("null");
+  }
+}
+
+void r0dump_AppendJsonBoolean(std::string* json,
+                              std::string_view name,
+                              std::optional<bool> value,
+                              bool* first) {
+  if (!*first) {
+    json->push_back(',');
+  }
+  *first = false;
+  r0dump_AppendJsonString(json, name);
+  json->push_back(':');
+  json->append(value.has_value() ? (*value ? "true" : "false") : "null");
+}
+
+std::string r0dump_HexHash(uint64_t hash) {
+  char value[19];
+  const int length = snprintf(value, sizeof(value), "0x%016" PRIx64, hash);
+  return length == 18 ? std::string(value, length) : std::string();
+}
