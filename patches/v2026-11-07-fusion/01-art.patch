+#!/usr/bin/env python3
+"""Conservative host-side validation and repair for r0dump generations."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import struct
+import subprocess
+import sys
+import zlib
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Iterable
+
+
+def _load_rehydrator():
+    """Load the strict logical-view rehydrator without making it a package dependency."""
+    module_path = Path(__file__).with_name("r0dump_dex_rehydrate.py")
+    spec = importlib.util.spec_from_file_location("r0dump_dex_rehydrate", module_path)
+    if spec is None or spec.loader is None:
+        return None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+_R0DUMP_REHYDRATOR = _load_rehydrator()
+
+
+R0DUMP_ALGORITHM_VERSION = "r0dump-host-repair-v2"
+DEX_HEADER_SIZE = 0x70
+DEX_MAGIC_PREFIX = b"dex\n"
+CDEX_MAGIC_PREFIX = b"cdex"
+
+R0DUMP_FIXED_MAP_ITEM_SIZE = {
+    0x0000: DEX_HEADER_SIZE,
+    0x0001: 4,
+    0x0002: 4,
+    0x0003: 12,
+    0x0004: 8,
+    0x0005: 8,
+    0x0006: 32,
+}
+
+
+@dataclass(frozen=True)
+class r0dump_DexLayout:
+    file_size: int
+    header_size: int
+    map_off: int
+    data_off: int
+    data_size: int
+    sections: tuple[tuple[int, int, int], ...]
+
+
+@dataclass(frozen=True)
+class r0dump_Validation:
+    kind: str
+    reason: str | None
+    layout: r0dump_DexLayout | None
+
+
+def r0dump_sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def r0dump_read_u32(data: bytes, offset: int) -> int:
+    return struct.unpack_from("<I", data, offset)[0]
+
+
+def r0dump_check_range(offset: int, size: int, limit: int) -> bool:
+    return 0 <= offset <= limit and 0 <= size <= limit - offset
+
+
+def r0dump_parse_map(data: bytes, map_off: int, file_size: int) -> tuple[tuple[int, int, int], ...] | None:
+    if not r0dump_check_range(map_off, 4, file_size):
+        return None
+    count = r0dump_read_u32(data, map_off)
+    if count > 4096 or not r0dump_check_range(map_off + 4, count * 12, file_size):
+        return None
+    entries = []
+    seen_types = set()
+    previous_offset = -1
+    for index in range(count):
+        entry = map_off + 4 + index * 12
+        item_type, unused, size, offset = struct.unpack_from("<HHII", data, entry)
+        if unused != 0 or item_type in seen_types or offset < previous_offset:
+            return None
+        seen_types.add(item_type)
+        previous_offset = offset
+        fixed_size = R0DUMP_FIXED_MAP_ITEM_SIZE.get(item_type)
+        if fixed_size is not None:
+            if size > file_size // fixed_size or not r0dump_check_range(offset, size * fixed_size, file_size):
+                return None
+        elif item_type == 0x1000:
+            if size != 1 or offset != map_off:
+                return None
+        elif size and not r0dump_check_range(offset, 1, file_size):
+            return None
+        entries.append((item_type, size, offset))
+    if (0x0000, 1, 0) not in entries or (0x1000, 1, map_off) not in entries:
+        return None
+    return tuple(entries)
+
+
+def r0dump_validate_dex(data: bytes) -> r0dump_Validation:
+    if len(data) < 8:
+        return r0dump_Validation("unknown", "truncated_header", None)
+    if data.startswith(CDEX_MAGIC_PREFIX):
+        return r0dump_Validation("cdex", "compact_dex_not_repaired", None)
+    if not data.startswith(DEX_MAGIC_PREFIX):
+        return r0dump_Validation("unknown", "missing_dex_magic", None)
+    if data[7] != 0 or not data[4:7].isdigit():
+        return r0dump_Validation("standard", "invalid_dex_version", None)
+    if len(data) < DEX_HEADER_SIZE:
+        return r0dump_Validation("standard", "truncated_header", None)
+    header_size = r0dump_read_u32(data, 36)
+    file_size = r0dump_read_u32(data, 32)
+    endian_tag = r0dump_read_u32(data, 40)
+    map_off = r0dump_read_u32(data, 52)
+    link_size = r0dump_read_u32(data, 44)
+    link_off = r0dump_read_u32(data, 48)
+    data_size = r0dump_read_u32(data, 104)
+    data_off = r0dump_read_u32(data, 108)
+    if header_size != DEX_HEADER_SIZE:
+        return r0dump_Validation("standard", "unsupported_header_size", None)
+    if endian_tag != 0x12345678:
+        return r0dump_Validation("standard", "unsupported_endian", None)
+    if file_size < DEX_HEADER_SIZE or file_size > len(data):
+        return r0dump_Validation("standard", "file_size_out_of_bounds", None)
+    if (link_size == 0 and link_off != 0) or (link_size != 0 and not r0dump_check_range(link_off, link_size, file_size)):
+        return r0dump_Validation("standard", "link_range_out_of_bounds", None)
+    for size_offset, offset_offset, item_size in (
+        (56, 60, 4),
+        (64, 68, 4),
+        (72, 76, 12),
+        (80, 84, 8),
+        (88, 92, 8),
+        (96, 100, 32),
+    ):
+        count = r0dump_read_u32(data, size_offset)
+        offset = r0dump_read_u32(data, offset_offset)
+        if count == 0:
+            if offset != 0:
+                return r0dump_Validation("standard", "empty_section_has_offset", None)
+        elif count > file_size // item_size or not r0dump_check_range(offset, count * item_size, file_size):
+            return r0dump_Validation("standard", "section_out_of_bounds", None)
+    if data_off < DEX_HEADER_SIZE or not r0dump_check_range(data_off, data_size, file_size) or data_off + data_size != file_size:
+        return r0dump_Validation("standard", "data_range_out_of_bounds", None)
+    if not (data_off <= map_off < file_size):
+        return r0dump_Validation("standard", "map_outside_data_section", None)
+    sections = r0dump_parse_map(data, map_off, file_size)
+    if sections is None:
+        return r0dump_Validation("standard", "map_out_of_bounds", None)
+    layout = r0dump_DexLayout(file_size, header_size, map_off, data_off, data_size, sections)
+    return r0dump_Validation("standard", None, layout)
+
+
+def r0dump_repair_dexfixed(data: bytes) -> tuple[bytes | None, dict[str, Any]]:
+    validation = r0dump_validate_dex(data)
+    if validation.layout is None:
+        return None, {"trust": "partial", "reason": validation.reason, "kind": validation.kind}
+    layout = validation.layout
+    repaired = bytearray(data[: layout.file_size])
+    original_signature = bytes(repaired[12:32])
+    original_checksum = r0dump_read_u32(repaired, 8)
+    expected_checksum_before = zlib.adler32(repaired[12:]) & 0xFFFFFFFF
+    signature = hashlib.sha1(repaired[32:]).digest()
+    repaired[12:32] = signature
+    expected_checksum_after = zlib.adler32(repaired[12:]) & 0xFFFFFFFF
+    struct.pack_into("<I", repaired, 8, expected_checksum_after)
+    changed = []
+    if original_signature != signature:
+        changed.append("signature")
+    if original_checksum != r0dump_read_u32(repaired, 8):
+        changed.append("checksum")
+    return bytes(repaired), {
+        "trust": "repaired" if changed else "verified",
+        "kind": "standard",
+        "file_size": layout.file_size,
+        "map_off": layout.map_off,
+        "checksum_valid_before": original_checksum == expected_checksum_before,
+        "checksum_repaired": original_checksum != expected_checksum_after,
+        "checksum_valid_after": r0dump_read_u32(repaired, 8) == expected_checksum_after,
+        "modified_fields": changed,
+    }
+
+
+def r0dump_read_uleb128(data: bytes, offset: int, limit: int) -> tuple[int, int]:
+    value = 0
+    for index in range(5):
+        if offset >= limit:
+            raise ValueError("truncated_uleb128")
+        byte = data[offset]
+        offset += 1
+        value |= (byte & 0x7F) << (index * 7)
+        if byte & 0x80 == 0:
+            if index == 4 and byte > 0x0F:
+                raise ValueError("uleb128_overflow")
+            return value, offset
+    raise ValueError("uleb128_overflow")
+
+
+def r0dump_read_sleb128(data: bytes, offset: int, limit: int) -> tuple[int, int]:
+    value = 0
+    shift = 0
+    for index in range(5):
+        if offset >= limit:
+            raise ValueError("truncated_sleb128")
+        byte = data[offset]
+        offset += 1
+        value |= (byte & 0x7F) << shift
+        shift += 7
+        if byte & 0x80 == 0:
+            if shift < 32 and byte & 0x40:
+                value -= 1 << shift
+            if not -(1 << 31) <= value < (1 << 31):
+                raise ValueError("sleb128_overflow")
+            return value, offset
+    raise ValueError("sleb128_overflow")
+
+
+def r0dump_method_code_entries(data: bytes, layout: r0dump_DexLayout) -> dict[int, tuple[int, int]]:
+    class_count = r0dump_read_u32(data, 96)
+    class_off = r0dump_read_u32(data, 100)
+    method_count = r0dump_read_u32(data, 88)
+    entries: dict[int, tuple[int, int]] = {}
+    for class_index in range(class_count):
+        class_def = class_off + class_index * 32
+        class_data_off = r0dump_read_u32(data, class_def + 24)
+        if class_data_off == 0:
+            continue
+        if not layout.data_off <= class_data_off < layout.file_size:
+            raise ValueError("class_data_out_of_bounds")
+        cursor = class_data_off
+        counts = []
+        for _ in range(4):
+            value, cursor = r0dump_read_uleb128(data, cursor, layout.file_size)
+            counts.append(value)
+        if any(count > layout.file_size for count in counts):
+            raise ValueError("class_data_count_out_of_bounds")
+        for field_count in counts[:2]:
+            for _ in range(field_count):
+                _, cursor = r0dump_read_uleb128(data, cursor, layout.file_size)
+                _, cursor = r0dump_read_uleb128(data, cursor, layout.file_size)
+        for method_list_count in counts[2:]:
+            method_index = 0
+            for _ in range(method_list_count):
+                method_delta, cursor = r0dump_read_uleb128(data, cursor, layout.file_size)
+                method_index += method_delta
+                _, cursor = r0dump_read_uleb128(data, cursor, layout.file_size)
+                code_off, cursor = r0dump_read_uleb128(data, cursor, layout.file_size)
+                if method_index >= method_count:
+                    raise ValueError("method_index_out_of_bounds")
+                if code_off != 0:
+                    if not layout.data_off <= code_off < layout.file_size:
+                        raise ValueError("code_item_offset_out_of_bounds")
+                    value = (code_off, class_index)
+                    previous = entries.get(method_index)
+                    if previous is not None and previous != value:
+                        raise ValueError("method_code_offset_conflict")
+                    entries[method_index] = value
+    return entries
+
+
+def r0dump_dex_string(data: bytes, layout: r0dump_DexLayout, string_index: int) -> str:
+    string_count = r0dump_read_u32(data, 56)
+    string_off = r0dump_read_u32(data, 60)
+    if not 0 <= string_index < string_count:
+        raise ValueError("string_index_out_of_bounds")
+    data_offset = r0dump_read_u32(data, string_off + string_index * 4)
+    if not layout.data_off <= data_offset < layout.file_size:
+        raise ValueError("string_data_out_of_bounds")
+    _, cursor = r0dump_read_uleb128(data, data_offset, layout.file_size)
+    terminator = data.find(b"\0", cursor, layout.file_size)
+    if terminator < 0:
+        raise ValueError("unterminated_string_data")
+    try:
+        return data[cursor:terminator].decode("utf-8")
+    except UnicodeDecodeError as error:
+        raise ValueError("unsupported_modified_utf8") from error
+
+
+def r0dump_type_descriptor(data: bytes, layout: r0dump_DexLayout, type_index: int) -> str:
+    type_count = r0dump_read_u32(data, 64)
+    type_off = r0dump_read_u32(data, 68)
+    if not 0 <= type_index < type_count:
+        raise ValueError("type_index_out_of_bounds")
+    return r0dump_dex_string(data, layout, r0dump_read_u32(data, type_off + type_index * 4))
+
+
+def r0dump_method_catalog(data: bytes, layout: r0dump_DexLayout) -> dict[int, dict[str, Any]]:
+    method_count = r0dump_read_u32(data, 88)
+    method_off = r0dump_read_u32(data, 92)
+    proto_count = r0dump_read_u32(data, 72)
+    proto_off = r0dump_read_u32(data, 76)
+    code_entries = r0dump_method_code_entries(data, layout)
+    catalog: dict[int, dict[str, Any]] = {}
+    for method_index, (code_off, class_def_index) in code_entries.items():
+        if not 0 <= method_index < method_count:
+            raise ValueError("method_index_out_of_bounds")
+        class_index, proto_index, name_index = struct.unpack_from(
+            "<HHI", data, method_off + method_index * 8)
+        if not 0 <= proto_index < proto_count:
+            raise ValueError("proto_index_out_of_bounds")
+        _, return_type_index, parameters_off = struct.unpack_from(
+            "<III", data, proto_off + proto_index * 12)
+        parameters: list[str] = []
+        if parameters_off != 0:
+            if not r0dump_check_range(parameters_off, 4, layout.file_size):
+                raise ValueError("parameter_list_out_of_bounds")
+            parameter_count = r0dump_read_u32(data, parameters_off)
+            if parameter_count > (layout.file_size - parameters_off - 4) // 2:
+                raise ValueError("parameter_list_out_of_bounds")
+            for index in range(parameter_count):
+                type_index = int.from_bytes(
+                    data[parameters_off + 4 + index * 2:parameters_off + 6 + index * 2],
+                    "little",
+                )
+                parameters.append(r0dump_type_descriptor(data, layout, type_index))
+        catalog[method_index] = {
+            "class_name": r0dump_type_descriptor(data, layout, class_index),
+            "method_name": r0dump_dex_string(data, layout, name_index),
+            "method_descriptor":
+                "(" + "".join(parameters) + ")" +
+                r0dump_type_descriptor(data, layout, return_type_index),
+            "class_def_index": class_def_index,
+            "code_off": code_off,
+        }
+    return catalog
+
+
+def r0dump_normalize_class_name(value: str) -> str:
+    if value.startswith("L") and value.endswith(";"):
+        return "L" + value[1:-1].replace(".", "/") + ";"
+    return "L" + value.replace(".", "/") + ";"
+
+
+def r0dump_match_code_item(record: dict[str, Any], catalog: dict[int, dict[str, Any]]) -> int | None:
+    method_index = record.get("method_index")
+    if not isinstance(method_index, int):
+        return None
+    candidate = catalog.get(method_index)
+    if candidate is None:
+        return None
+    class_name = record.get("class_name")
+    method_name = record.get("method_name")
+    descriptor = record.get("method_descriptor")
+    if not all(isinstance(value, str) and value for value in (class_name, method_name, descriptor)):
+        return None
+    if r0dump_normalize_class_name(class_name) != candidate["class_name"]:
+        return None
+    if method_name != candidate["method_name"] or descriptor != candidate["method_descriptor"]:
+        return None
+    class_def_index = record.get("class_def_index")
+    if isinstance(class_def_index, int) and class_def_index != candidate["class_def_index"]:
+        return None
+    return candidate["code_off"]
+
+
+def r0dump_code_item_size(data: bytes, offset: int, limit: int) -> int:
+    if not r0dump_check_range(offset, 16, limit):
+        raise ValueError("code_item_header_out_of_bounds")
+    tries_size = int.from_bytes(data[offset + 6:offset + 8], "little")
+    insns_size = r0dump_read_u32(data, offset + 12)
+    cursor = offset + 16
+    if insns_size > (limit - cursor) // 2:
+        raise ValueError("code_item_instructions_out_of_bounds")
+    cursor += insns_size * 2
+    if tries_size == 0:
+        return cursor - offset
+    if insns_size & 1:
+        cursor += 2
+    if tries_size > (limit - cursor) // 8:
+        raise ValueError("code_item_tries_out_of_bounds")
+    cursor += tries_size * 8
+    handler_count, cursor = r0dump_read_uleb128(data, cursor, limit)
+    if handler_count > limit - cursor:
+        raise ValueError("code_item_handler_count_out_of_bounds")
+    for _ in range(handler_count):
+        handler_size, cursor = r0dump_read_sleb128(data, cursor, limit)
+        for _ in range(abs(handler_size)):
+            _, cursor = r0dump_read_uleb128(data, cursor, limit)
+            _, cursor = r0dump_read_uleb128(data, cursor, limit)
+        if handler_size <= 0:
+            _, cursor = r0dump_read_uleb128(data, cursor, limit)
+    return cursor - offset
+
+
+def r0dump_backfill_code_items(
+        dex_data: bytes, patches: list[dict[str, Any]]) -> tuple[bytes | None, list[dict[str, Any]]]:
+    validation = r0dump_validate_dex(dex_data)
+    if validation.layout is None:
+        return None, [{"record": patch["record"], "status": "partial",
+                       "reason": validation.reason} for patch in patches]
+    layout = validation.layout
+    try:
+        method_catalog = r0dump_method_catalog(dex_data, layout)
+    except ValueError as error:
+        return None, [{"record": patch["record"], "status": "partial",
+                       "reason": str(error)} for patch in patches]
+
+    outcomes: list[dict[str, Any]] = []
+    accepted: dict[int, tuple[bytes, list[str]]] = {}
+    conflicted_offsets: set[int] = set()
+    for patch in patches:
+        record_name = patch["record"]
+        method_index = patch.get("method_index")
+        target_offset = patch.get("target_offset")
+        code = patch.get("data")
+        if not isinstance(method_index, int) or not isinstance(target_offset, int):
+            outcomes.append({"record": record_name, "status": "partial",
+                             "reason": "code_item_mapping_missing"})
+            continue
+        if not isinstance(code, bytes) or not code:
+            outcomes.append({"record": record_name, "status": "partial",
+                             "reason": "code_item_bytes_missing"})
+            continue
+        if method_catalog.get(method_index, {}).get("code_off") != target_offset:
+            outcomes.append({"record": record_name, "status": "partial",
+                             "reason": "method_code_offset_mismatch"})
+            continue
+        declared_size = patch.get("code_item_size")
+        if isinstance(declared_size, int) and declared_size != len(code):
+            outcomes.append({"record": record_name, "status": "partial",
+                             "reason": "code_item_size_mismatch"})
+            continue
+        try:
+            source_size = r0dump_code_item_size(dex_data, target_offset, layout.file_size)
+            captured_size = r0dump_code_item_size(code, 0, len(code))
+        except ValueError as error:
+            outcomes.append({"record": record_name, "status": "partial", "reason": str(error)})
+            continue
+        if captured_size != len(code) or source_size != len(code):
+            outcomes.append({"record": record_name, "status": "partial",
+                             "reason": "code_item_span_mismatch"})
+            continue
+        if target_offset in conflicted_offsets:
+            outcomes.append({"record": record_name, "status": "partial",
+                             "reason": "code_item_conflict"})
+            continue
+        previous = accepted.get(target_offset)
+        if previous is not None and previous[0] != code:
+            for previous_record in previous[1]:
+                for outcome in outcomes:
+                    if outcome["record"] == previous_record:
+                        outcome.update({"status": "partial", "reason": "code_item_conflict"})
+            outcomes.append({"record": record_name, "status": "partial",
+                             "reason": "code_item_conflict"})
+            accepted.pop(target_offset)
+            conflicted_offsets.add(target_offset)
+            continue
+        if previous is None:
+            accepted[target_offset] = (code, [record_name])
+        else:
+            previous[1].append(record_name)
+        outcomes.append({"record": record_name, "status": "applied",
+                         "method_index": method_index, "offset": target_offset,
+                         "size": len(code)})
+
+    if not accepted:
+        return None, outcomes
+    repaired = bytearray(dex_data[:layout.file_size])
+    for target_offset, (code, _) in sorted(accepted.items()):
+        repaired[target_offset:target_offset + len(code)] = code
+    repaired[12:32] = hashlib.sha1(repaired[32:]).digest()
+    struct.pack_into("<I", repaired, 8, zlib.adler32(repaired[12:]) & 0xFFFFFFFF)
+    return bytes(repaired), outcomes
+
+
+def r0dump_repair_artifact(record: dict[str, Any], data: bytes) -> tuple[bytes | None, dict[str, Any]]:
+    capture_kind = record.get("capture_kind")
+    if capture_kind == "dexdata":
+        return None, {
+            "trust": "partial",
+            "kind": "dexdata",
+            "output_kind": "dexrecon",
+            "reason": "dexrecon_missing_runtime_tables",
+            "missing_inputs": [
+                "complete_runtime_table_bundle",
+                "runtime_table_layout",
+                "complete_conflict_free_code_items",
+            ],
+        }
+    if capture_kind == "codeitem":
+        return None, {
+            "trust": "partial",
+            "kind": "codeitem",
+            "output_kind": "dexrecon",
+            "reason": "method_evidence_only",
+        }
+    repaired, details = r0dump_repair_dexfixed(data)
+    details["output_kind"] = "dexfixed"
+    return repaired, details
+
+
+def r0dump_load_json(path: Path) -> Any:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def r0dump_iter_records(run_dir: Path) -> Iterable[tuple[Path, dict[str, Any]]]:
+    for path in sorted((run_dir / "records").glob("*.json")):
+        value = r0dump_load_json(path)
+        if isinstance(value, dict):
+            yield path, value
+
+
+def r0dump_find_artifact(run_dir: Path, record: dict[str, Any]) -> Path | None:
+    relative = record.get("artifact_relative_path")
+    if not isinstance(relative, str) or Path(relative).is_absolute() or ".." in Path(relative).parts:
+        return None
+    path = run_dir / relative
+    try:
+        path.resolve().relative_to(run_dir.resolve())
+    except ValueError:
+        return None
+    return path if path.is_file() else None
+
+
+def r0dump_find_runtime_metadata(run_dir: Path, artifact: Path,
+                                 record: dict[str, Any]) -> Path | None:
+    """Find the sidecar describing a logical-data capture.
+
+    Runtime metadata may be embedded in the record or emitted next to the raw
+    artifact.  Keeping this lookup permissive lets old runs be inspected while
+    giving new Fusion writers a stable `logical-layout.json` convention.
+    """
+    if isinstance(record.get("runtime_view"), dict):
+        return None
+    candidates = [
+        artifact.with_suffix(artifact.suffix + ".json"),
+        artifact.with_suffix(".json"),
+        artifact.parent / "logical-layout.json",
+        artifact.parent / "runtime-view.json",
+        run_dir / "metadata" / "logical-layout.json",
+        run_dir / "metadata" / "runtime-view.json",
+    ]
+    for candidate in candidates:
+        if candidate.is_file():
+            try:
+                value = r0dump_load_json(candidate)
+            except (OSError, ValueError, json.JSONDecodeError):
+                continue
+            if isinstance(value, dict) and isinstance(value.get("runtime_view"), dict):
+                return candidate
+    return None
+
+
+def r0dump_try_rehydrate_logical(run_dir: Path, record: dict[str, Any], artifact: Path,
+                                 data: bytes) -> tuple[bytes | None, dict[str, Any]]:
+    """Rebuild a standard DEX only when a complete runtime view is available."""
+    if _R0DUMP_REHYDRATOR is None or record.get("capture_kind") != "dexdata":
+        return None, {}
+    metadata: dict[str, Any] | None = None
+    if isinstance(record.get("runtime_view"), dict):
+        metadata = record
+    else:
+        sidecar = r0dump_find_runtime_metadata(run_dir, artifact, record)
+        if sidecar is not None:
+            metadata = r0dump_load_json(sidecar)
+    if metadata is None:
+        # Keep the established dexrecon_missing_runtime_tables report for old
+        # runs; a logical-layout report is emitted only once a view is present.
+        return None, {}
+    try:
+        layout = _R0DUMP_REHYDRATOR.parse_runtime_layout(data, metadata)
+        rebuilt, report = _R0DUMP_REHYDRATOR.build_rehydrated_dex(data, layout)
+    except (OSError, ValueError, struct.error, json.JSONDecodeError) as error:
+        return None, {"trust": "partial", "kind": "dexdata", "output_kind": "logical_layout",
+                      "reason": "dexrecon_layout_invalid", "error": str(error)}
+    report = dict(report)
+    report.update({"trust": "reconstructed_standard_verified", "kind": "dexdata",
+                   "output_kind": "reconstructed_standard"})
+    return rebuilt, report
+
+
+def r0dump_method_identity(record: dict[str, Any]) -> tuple[Any, ...] | None:
+    if record.get("capture_kind") != "codeitem":
+        return None
+    method_index = record.get("method_index")
+    if not isinstance(method_index, int):
+        return None
+    class_name = record.get("class_name")
+    method_name = record.get("method_name")
+    descriptor = record.get("method_descriptor")
+    if all(isinstance(value, str) and value for value in (class_name, method_name, descriptor)):
+        return (r0dump_normalize_class_name(class_name), method_name, descriptor, method_index)
+    dex_identity = record.get("dex_object_id")
+    return None if dex_identity is None else (dex_identity, method_index)
+
+
+def r0dump_execution_path_key(record: dict[str, Any]) -> tuple[Any, int, Any] | None:
+    dex_identity = record.get("dex_object_id")
+    method_index = record.get("method_index")
+    if dex_identity is None or not isinstance(method_index, int):
+        return None
+    attempt_id = record.get("active_attempt_id")
+    return (dex_identity, method_index, attempt_id if isinstance(attempt_id, int) else None)
+
+
+def r0dump_method_execution_paths(
+    discovered: list[tuple[Path, dict[str, Any], Path | None, bytes | None, str | None]],
+) -> list[dict[str, Any]]:
+    paths: dict[tuple[Any, int, Any], dict[str, Any]] = {}
+    artifact_hashes: dict[tuple[Any, int, Any], list[str]] = {}
+    for _, record, artifact, data, _ in discovered:
+        phase = record.get("observation_phase")
+        key = r0dump_execution_path_key(record)
+        if key is None or not isinstance(phase, str) or not phase:
+            continue
+        path = paths.setdefault(
+            key,
+            {
+                "dex_object_id": key[0],
+                "method_index": key[1],
+                "active_attempt_id": key[2],
+                "first_entry_kind": record.get("entry_kind") or "unknown",
+                "observed_phases": [],
+                "first_artifact_fast_hash": None,
+                "last_artifact_fast_hash": None,
+                "code_item_changed": "unknown",
+            },
+        )
+        if phase not in path["observed_phases"]:
+            path["observed_phases"].append(phase)
+        fast_hash = record.get("artifact_fast_hash")
+        if (record.get("capture_kind") == "codeitem" and artifact is not None and
+                data is not None and isinstance(fast_hash, str) and fast_hash):
+            artifact_hashes.setdefault(key, []).append(fast_hash)
+
+    for key, path in paths.items():
+        hashes = artifact_hashes.get(key, [])
+        if hashes:
+            path["first_artifact_fast_hash"] = hashes[0]
+            path["last_artifact_fast_hash"] = hashes[-1]
+        if len(hashes) >= 2:
+            path["code_item_changed"] = hashes[0] != hashes[-1]
+    return list(paths.values())
+
+
+def r0dump_run_tool(command: list[str], timeout: int = 30) -> dict[str, Any]:
+    try:
+        result = subprocess.run(
+            command,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            timeout=timeout,
+            check=False,
+        )
+    except (OSError, subprocess.TimeoutExpired) as error:
+        return {"status": "unavailable", "error": str(error)}
+    return {"status": "passed" if result.returncode == 0 else "failed", "returncode": result.returncode,
+            "stdout": result.stdout[-4096:], "stderr": result.stderr[-4096:]}
+
+
+def r0dump_repair_run(run_dir: Path, output_dir: Path, dexdump: str | None = None,
+                      jadx: str | None = None) -> dict[str, Any]:
+    if not run_dir.is_dir():
+        raise ValueError(f"run directory does not exist: {run_dir}")
+    output_dir.mkdir(parents=True, exist_ok=True)
+    blobs_dir = output_dir / "blobs"
+    repaired_dir = output_dir / "repaired"
+    partial_dir = output_dir / "partial"
+    for directory in (blobs_dir, repaired_dir, partial_dir):
+        directory.mkdir(exist_ok=True)
+    records: list[dict[str, Any]] = []
+    record_items: dict[str, dict[str, Any]] = {}
+    seen: set[str] = set()
+    discovered: list[tuple[Path, dict[str, Any], Path | None, bytes | None, str | None]] = []
+    method_hashes: dict[tuple[Any, ...], set[str]] = {}
+    for record_path, record in r0dump_iter_records(run_dir):
+        artifact = r0dump_find_artifact(run_dir, record)
+        if artifact is None:
+            discovered.append((record_path, record, None, None, None))
+            continue
+        data = artifact.read_bytes()
+        digest = r0dump_sha256(data)
+        identity = r0dump_method_identity(record)
+        if identity is not None:
+            method_hashes.setdefault(identity, set()).add(digest)
+        discovered.append((record_path, record, artifact, data, digest))
+
+    dex_candidates: dict[str, dict[str, Any]] = {}
+    for _, record, artifact, data, digest in discovered:
+        if artifact is None or data is None or digest is None or record.get("capture_kind") == "codeitem":
+            continue
+        validation = r0dump_validate_dex(data)
+        candidate_data = data
+        candidate_artifact = str(artifact.relative_to(run_dir))
+        rehydrated = False
+        if validation.layout is None and record.get("capture_kind") == "dexdata":
+            candidate_data, _ = r0dump_try_rehydrate_logical(run_dir, record, artifact, data)
+            if candidate_data is not None:
+                validation = r0dump_validate_dex(candidate_data)
+                rehydrated = validation.layout is not None
+        if validation.layout is None:
+            continue
+        try:
+            catalog = r0dump_method_catalog(candidate_data, validation.layout)
+        except ValueError:
+            continue
+        candidate_digest = r0dump_sha256(candidate_data)
+        dex_candidates.setdefault(
+            candidate_digest,
+            {"data": candidate_data, "artifact": candidate_artifact, "catalog": catalog,
+             "rehydrated": rehydrated,
+             "dex_object_ids": set()},
+        )
+        object_id = record.get("dex_object_id")
+        if object_id is not None:
+            dex_candidates[candidate_digest]["dex_object_ids"].add(object_id)
+
+    input_entries: dict[str, dict[str, Any]] = {}
+    code_discovered: list[tuple[Path, dict[str, Any], bytes, str]] = []
+    for record_path, record, artifact, data, digest in discovered:
+        if artifact is None or data is None or digest is None:
+            capture_was_dropped = record.get("status") == "dropped"
+            reason = "capture_dropped" if capture_was_dropped else "missing_artifact"
+            drop_reason = record.get("drop_reason") if capture_was_dropped else None
+            item = {"algorithm_version": R0DUMP_ALGORITHM_VERSION,
+                    "record": record_path.name, "status": "partial",
+                    "reason": reason, "drop_reason": drop_reason,
+                    "site": record.get("site"),
+                    "capture_point": record.get("capture_point_name")}
+            records.append(item)
+            record_items[record_path.name] = item
+            continue
+        blob_path = blobs_dir / f"{digest}.bin"
+        if digest not in seen:
+            blob_path.write_bytes(data)
+            seen.add(digest)
+        input_entry = input_entries.setdefault(
+            digest, {"sha256": digest, "size": len(data),
+                     "artifact": str(artifact.relative_to(run_dir)), "records": []}
+        )
+        input_entry["records"].append(record_path.name)
+        repaired = None
+        details: dict[str, Any] = {}
+        if record.get("capture_kind") == "dexdata":
+            repaired, details = r0dump_try_rehydrate_logical(run_dir, record, artifact, data)
+        if not details:
+            repaired, details = r0dump_repair_artifact(record, data)
+        identity = r0dump_method_identity(record)
+        conflicts = []
+        if identity is not None and len(method_hashes[identity]) > 1:
+            conflicts.append({"type": "code_item_bytes", "method_identity": list(identity),
+                              "candidate_sha256": sorted(method_hashes[identity])})
+        item: dict[str, Any] = {"algorithm_version": R0DUMP_ALGORITHM_VERSION,
+                                "record": record_path.name, "input_sha256": digest,
+                                "artifact": str(artifact.relative_to(run_dir)),
+                                "site": record.get("site"),
+                                "capture_point": record.get("capture_point_name"),
+                                "conflicts": conflicts, **details}
+        records.append(item)
+        record_items[record_path.name] = item
+        if conflicts:
+            repaired = None
+            item.update({"trust": "partial", "reason": "code_item_conflict"})
+        if record.get("capture_kind") == "codeitem":
+            code_discovered.append((record_path, record, data, digest))
+            continue
+        if repaired is None:
+            partial_path = partial_dir / f"{digest}.partial.json"
+            partial_path.write_text(json.dumps(item, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+            item["output"] = str(partial_path.relative_to(output_dir))
+        else:
+            suffix = ".rehydrated.dex" if details.get("output_kind") == "reconstructed_standard" else ".dexfixed.dex"
+            fixed_path = repaired_dir / f"{digest}{suffix}"
+            fixed_path.write_bytes(repaired)
+            item["output"] = str(fixed_path.relative_to(output_dir))
+            if dexdump:
+                item["dexdump"] = r0dump_run_tool([dexdump, "-f", str(fixed_path)])
+                if item["dexdump"]["status"] != "passed":
+                    item.update({"trust": "partial", "reason": "dexdump_failed"})
+            if jadx:
+                item["jadx"] = r0dump_run_tool([jadx, "-d", str(output_dir / "jadx"), str(fixed_path)])
+    patch_groups: dict[str, list[dict[str, Any]]] = {}
+    for record_path, record, data, digest in code_discovered:
+        item = record_items[record_path.name]
+        if item.get("reason") == "code_item_conflict":
+            continue
+        matches = []
+        object_id = record.get("dex_object_id")
+        scoped_candidates = dex_candidates.items()
+        if object_id is not None:
+            identity_matches = [
+                (digest, candidate)
+                for digest, candidate in dex_candidates.items()
+                if object_id in candidate["dex_object_ids"]
+            ]
+            if identity_matches:
+                scoped_candidates = identity_matches
+        for candidate_digest, candidate in scoped_candidates:
+            target_offset = r0dump_match_code_item(record, candidate["catalog"])
+            if target_offset is not None:
+                matches.append((candidate_digest, target_offset))
+        if not matches:
+            item.update({"trust": "partial", "reason": "target_dex_not_found"})
+            continue
+        if len(matches) != 1:
+            item.update({"trust": "partial", "reason": "target_dex_ambiguous",
+                         "candidate_dex_sha256": sorted(match[0] for match in matches)})
+            continue
+        candidate_digest, target_offset = matches[0]
+        patch_groups.setdefault(candidate_digest, []).append({
+            "record": record_path.name,
+            "method_index": record.get("method_index"),
+            "target_offset": target_offset,
+            "code_item_size": record.get("code_item_size"),
+            "data": data,
+            "input_sha256": digest,
+        })
+
+    reconstructions: list[dict[str, Any]] = []
+    for candidate_digest, patches in sorted(patch_groups.items()):
+        candidate = dex_candidates[candidate_digest]
+        backfilled, outcomes = r0dump_backfill_code_items(candidate["data"], patches)
+        fixed_path = repaired_dir / f"{candidate_digest}.codeitem.dex"
+        relative_output = str(fixed_path.relative_to(output_dir))
+        reconstruction: dict[str, Any] = {
+            "base_sha256": candidate_digest,
+            "base_artifact": candidate["artifact"],
+            "output": relative_output if backfilled is not None else None,
+            "outcomes": outcomes,
+        }
+        if backfilled is not None:
+            fixed_path.write_bytes(backfilled)
+            reconstruction["output_sha256"] = r0dump_sha256(backfilled)
+            if dexdump:
+                reconstruction["dexdump"] = r0dump_run_tool([dexdump, "-f", str(fixed_path)])
+                if reconstruction["dexdump"]["status"] != "passed":
+                    reconstruction.update({
+                        "output": None,
+                        "partial_output": relative_output,
+                        "reason": "dexdump_failed",
+                    })
+            if jadx:
+                reconstruction["jadx"] = r0dump_run_tool(
+                    [jadx, "-d", str(output_dir / "jadx-codeitem"), str(fixed_path)])
+        reconstructions.append(reconstruction)
+        for outcome in outcomes:
+            item = record_items[outcome["record"]]
+            if (outcome["status"] == "applied" and backfilled is not None
+                    and reconstruction["output"] is not None):
+                item.pop("reason", None)
+                item.update({
+                    "trust": "repaired",
+                    "output_kind": "codeitem_backfill",
+                    "output": relative_output,
+                    "target_dex_sha256": candidate_digest,
+                    "backfill_offset": outcome["offset"],
+                    "backfill_size": outcome["size"],
+                })
+            else:
+                item.update({
+                    "trust": "partial",
+                    "reason": outcome.get("reason", reconstruction.get("reason", "backfill_failed")),
+                })
+
+    for record_path, _, _, digest in code_discovered:
+        item = record_items[record_path.name]
+        if item.get("trust") != "partial":
+            continue
+        partial_path = partial_dir / f"{record_path.stem}-{digest}.partial.json"
+        partial_path.write_text(json.dumps(item, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+        item["output"] = str(partial_path.relative_to(output_dir))
+
+    report = {"algorithm_version": R0DUMP_ALGORITHM_VERSION, "input": str(run_dir),
+              "records": records, "record_count": len(records),
+              "reconstructions": reconstructions,
+              "method_execution_paths": r0dump_method_execution_paths(discovered)}
+    inputs = {"run": str(run_dir), "blobs": sorted(input_entries.values(), key=lambda item: item["sha256"])}
+    (output_dir / "inputs.json").write_text(json.dumps(inputs, sort_keys=True, indent=2) + "\n",
+                                             encoding="utf-8")
+    (output_dir / "report.json").write_text(json.dumps(report, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    return report
+
+
+def r0dump_main(argv: list[str]) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("run_dir", type=Path)
+    parser.add_argument("output_dir", type=Path)
+    parser.add_argument("--dexdump")
+    parser.add_argument("--jadx")
+    args = parser.parse_args(argv)
+    report = r0dump_repair_run(args.run_dir, args.output_dir, args.dexdump, args.jadx)
+    print(json.dumps(report, sort_keys=True, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(r0dump_main(sys.argv[1:]))
