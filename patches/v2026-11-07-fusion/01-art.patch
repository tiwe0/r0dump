+    case r0dump_Point::kBdclPathConstructor:
+      *route = {r0dump_Point::kBdclPathConstructor,
+                "BDCL.path.constructor",
+                "bdcl_path_constructor",
+                false};
+      return true;
+    case r0dump_Point::kBdclMemoryConstructor:
+      *route = {r0dump_Point::kBdclMemoryConstructor,
+                "BDCL.memory.constructor",
+                "bdcl_memory_constructor",
+                false};
+      return true;
+    case r0dump_Point::kBdclFindClassSuccess:
+      *route = {
+          r0dump_Point::kBdclFindClassSuccess, "BDCL.findClass.success", "bdcl_find_class", true};
+      return true;
+    case r0dump_Point::kBdclAddDexPathReturn:
+      *route = {r0dump_Point::kBdclAddDexPathReturn,
+                "BDCL.addDexPath.return",
+                "bdcl_add_dex_path",
+                false};
+      return true;
+    case r0dump_Point::kDexFileOpenFileReturn:
+      *route = {r0dump_Point::kDexFileOpenFileReturn,
+                "DexFile.open_file.return",
+                "dex_file_open_file",
+                false};
+      return true;
+    case r0dump_Point::kDexFileOpenMemoryReturn:
+      *route = {r0dump_Point::kDexFileOpenMemoryReturn,
+                "DexFile.open_memory.return",
+                "dex_file_open_memory",
+                false};
+      return true;
+    case r0dump_Point::kDexFileBeforeDefine:
+      *route = {r0dump_Point::kDexFileBeforeDefine,
+                "DexFile.before_define",
