diff --git a/runtime/r0dump/r0dump_f2_flush_source_test.py b/runtime/r0dump/r0dump_f2_flush_source_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..41e9f429288e7d8b17c2d0558c559edc4e81f5fc
--- /dev/null
+++ b/runtime/r0dump/r0dump_f2_flush_source_test.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+
+"""Source contracts for the F2 flush coordinator.
+
+The writer state machine is intentionally kept out of capture hooks.  These
+contracts name the narrow hand-off expected from the production coordinator;
+the C++ unit tests can exercise it once that hand-off exists.
+"""
+
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def r0dump_read(path: str) -> str:
+    return (ROOT / path).read_text(encoding="utf-8")
+
+
+def r0dump_method_body(text: str, signature: str) -> str:
+    start = text.index(signature)
+    body_start = text.index("{", start)
+    depth = 0
+    for index in range(body_start, len(text)):
+        if text[index] == "{":
+            depth += 1
+        elif text[index] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[body_start : index + 1]
+    raise AssertionError(f"unterminated method {signature!r}")
+
+
+def r0dump_test_staging_exposes_active_flush_state() -> None:
+    header = r0dump_read("art/runtime/r0dump/r0dump_buffer.h")
+    for declaration in (
+        "struct r0dump_ActiveFlushState",
+        "size_t active_pending_bytes",
+        "uint64_t last_activity_ns",
+        "bool watermark_latched",
+        "r0dump_ActiveFlushState r0dump_GetActiveFlushState() const",
+    ):
+        assert declaration in header, declaration
+
+
+def r0dump_test_staging_latches_watermark_and_updates_last_activity() -> None:
+    source = r0dump_read("art/runtime/r0dump/r0dump_buffer.cc")
+    body = r0dump_method_body(source, "r0dump_Staging::r0dump_SubmitDex")
+    assert "active_pending_bytes_ += payload_size" in body
+    assert "last_activity_ns_ = context.monotonic_ns" in body
+    assert "watermark_latched_ = active_pending_bytes_ >= flush_watermark_bytes_" in body
+
+
+def r0dump_test_submission_paths_do_not_wait_for_staging_lock() -> None:
+    source = r0dump_read("art/runtime/r0dump/r0dump_buffer.cc")
+    for signature in (
+        "r0dump_Staging::r0dump_SubmitDex",
+        "r0dump_Staging::r0dump_TryReferenceDex",
+        "r0dump_Staging::r0dump_SubmitCodeItem",
+        "r0dump_Staging::r0dump_RecordDrop",
+        "r0dump_Staging::r0dump_TrySubmitMetadata",
+    ):
+        body = r0dump_method_body(source, signature)
+        assert "std::try_to_lock" in body, signature
+        assert "owns_lock()" in body, signature
+        assert "kLockBusy" in body, signature
+        assert "std::lock_guard" not in body, signature
+
+
+def r0dump_test_staging_requests_flush_at_configured_idle_deadline() -> None:
+    source = r0dump_read("art/runtime/r0dump/r0dump_buffer.cc")
+    body = r0dump_method_body(source, "r0dump_Staging::r0dump_ShouldFlush")
+    assert "flush_idle_ns_" in body
+    assert "now_ns - last_activity_ns_ >= flush_idle_ns_" in body
+    assert "watermark_latched_" in body
+
+
+def r0dump_test_force_completion_requests_flush_without_waiting() -> None:
+    source = r0dump_read("art/runtime/r0dump/r0dump_buffer.cc")
+    body = r0dump_method_body(source, "r0dump_Staging::r0dump_ShouldFlush")
+    assert "force_completion" in body
+    assert "condition_variable" not in body
+    assert ".wait(" not in body
+
+
+def r0dump_test_writer_releases_only_successful_generation() -> None:
+    source = r0dump_read("art/runtime/r0dump/r0dump_file.cc")
+    body = r0dump_method_body(source, "r0dump_WriteAndReleaseFrozenGeneration")
+    release = body.index("r0dump_ReleaseFrozen")
+    success = body.index("result.ok")
+    assert success < release
+    assert "if (result.ok)" in body
+
+
+def r0dump_test_writer_failure_retains_generation_and_marks_degraded() -> None:
+    source = r0dump_read("art/runtime/r0dump/r0dump_file.cc")
+    body = r0dump_method_body(source, "r0dump_WriteAndReleaseFrozenGeneration")
+    assert "result.degraded" in body
+    assert "return result" in body
+    assert "r0dump_ReleaseFrozen" not in body[body.index("if (!result.ok)") :]
+
+
+def r0dump_test_file_module_owns_writer_coordination_without_capture_state() -> None:
+    capture_header = r0dump_read("art/runtime/r0dump/r0dump_capture.h")
+    file_source = r0dump_read("art/runtime/r0dump/r0dump_file.cc")
+    capture_source = r0dump_read("art/runtime/r0dump/r0dump_capture.cc")
+    native_source = r0dump_read(
+        "art/runtime/native/dalvik_system_r0dump_Runtime.cc"
+    )
+    assert "bool r0dump_ServiceFlush(const r0dump_ProcessConfig& config," in file_source
+    assert "g_r0dump_pending_generation" in file_source
+    assert "g_r0dump_run_fd" in file_source
+    for forbidden in (
+        '#include "r0dump/r0dump_capture.h"',
+        "r0dump_GetCaptureProcessStaging",
+        "r0dump_GetCapturePointSeen",
+        "g_r0dump_active_capture_point_mask",
+        "r0dump_GetProcessConfig",
+    ):
+        assert forbidden not in file_source, forbidden
+    assert "r0dump_ServiceCaptureFlush(false, false)" in native_source
+    assert "r0dump_PublishCaptureManifestSnapshot(std::move(snapshot))" in native_source
+    assert "r0dump_RequestCaptureFlush(true)" in native_source
+    assert "r0dump_ServiceCaptureFlush(bool force_completion, bool try_lock)" in capture_source
+    assert "r0dump_ServiceFlush(*config, *staging, force_completion, try_lock)" in capture_source
+    assert '#include "r0dump/r0dump_file.h"' not in capture_header
+    assert "struct r0dump_ManifestCaptureSnapshot final" in capture_header
+    assert "struct r0dump_ManifestCaptureSeed final" in capture_header
+    assert '#include "r0dump/r0dump_file.h"' not in native_source
+    assert "g_r0dump_pending_generation" not in native_source
+    assert "g_r0dump_run_fd" not in native_source
+
+
+def r0dump_test_runtime_uses_single_terminal_finalizer() -> None:
+    runtime = r0dump_read("art/runtime/runtime.cc")
+    destructor = r0dump_method_body(runtime, "Runtime::~Runtime")
+    assert "r0dump_FinalizeCaptureFlushRun" in destructor
+    assert "r0dump_CloseFlushRunFile" not in destructor
+    file_source = r0dump_read("art/runtime/r0dump/r0dump_file.cc")
+    finalizer = r0dump_method_body(file_source, "r0dump_FinalizeFlushRun")
+    assert "summary.json" not in finalizer
+    assert "r0dump_WriteSummaryFile" in finalizer
+    assert "g_r0dump_active_capture_point_mask" not in finalizer
+    capture_source = r0dump_read("art/runtime/r0dump/r0dump_capture.cc")
+    capture_finalizer = r0dump_method_body(capture_source, "r0dump_FinalizeCaptureFlushRun")
+    assert "r0dump_SetActiveCapturePointMask(0u)" in capture_finalizer
+    assert "r0dump_FinalizeFlushRun(*config, *staging" in capture_finalizer
+
+
+def r0dump_test_configure_and_hooks_do_not_call_file_io() -> None:
+    capture = r0dump_read("art/runtime/r0dump/r0dump_capture.cc")
+    config = r0dump_read("art/runtime/r0dump/r0dump_config.cc")
+    # The nearby protected-Dex candidate path may read /proc/self/maps, but
+    # capture/configure must never publish or mutate files from a hook.
+    forbidden = ("write(", "fsync(", "renameat(")
+    for token in forbidden:
+        assert token not in capture, f"capture must not perform I/O: {token}"
+        assert token not in config, f"configure must not perform I/O: {token}"
+
+
+if __name__ == "__main__":
+    r0dump_test_staging_exposes_active_flush_state()
+    r0dump_test_staging_latches_watermark_and_updates_last_activity()
+    r0dump_test_submission_paths_do_not_wait_for_staging_lock()
+    r0dump_test_staging_requests_flush_at_configured_idle_deadline()
+    r0dump_test_force_completion_requests_flush_without_waiting()
+    r0dump_test_writer_releases_only_successful_generation()
+    r0dump_test_writer_failure_retains_generation_and_marks_degraded()
+    r0dump_test_file_module_owns_writer_coordination_without_capture_state()
+    r0dump_test_runtime_uses_single_terminal_finalizer()
+    r0dump_test_configure_and_hooks_do_not_call_file_io()
