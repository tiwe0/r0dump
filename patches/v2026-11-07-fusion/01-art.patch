+
+r0dump_RecordMetadata r0dump_DexMetadata(const DexFile& dex) {
+  const std::shared_ptr<DexFileContainer>& container = dex.GetContainer();
+  r0dump_RecordMetadata metadata = {
+      .checksum = dex.GetLocationChecksum(),
+      .declared_size = dex.Size(),
+      .data_size = dex.DataSize(),
+      .container_size = container == nullptr
+                            ? std::optional<uint64_t>()
+                            : std::optional<uint64_t>(container->End() - container->Begin()),
+  };
+  metadata.dex_object_id = r0dump_DexIdentity(dex);
+  if (dex.Begin() != nullptr) {
+    metadata.begin = reinterpret_cast<uintptr_t>(dex.Begin());
+  }
+  if (dex.DataBegin() != nullptr) {
+    metadata.data_begin = reinterpret_cast<uintptr_t>(dex.DataBegin());
+  }
+  // Preserve the old r0dump logical-view contract using ART's actual private table pointers. This
+  // remains metadata-only; bytes are copied through the guarded kDexData path and validated by the
+  // host before any pointer is dereferenced.
+  DexFile::R0dumpRuntimeView runtime = dex.GetR0dumpRuntimeView();
+  const uintptr_t header_address = r0dump_UntagAddress(runtime.header);
+  if (header_address != 0u &&
+      r0dump_IsReadableSpan(reinterpret_cast<const uint8_t*>(header_address),
+                            sizeof(DexFile::Header))) {
+    DexFile::Header header = {};
+    std::memcpy(&header, reinterpret_cast<const void*>(header_address), sizeof(header));
+    runtime.string_ids_count = header.string_ids_size_;
+    runtime.type_ids_count = header.type_ids_size_;
+    runtime.field_ids_count = header.field_ids_size_;
+    runtime.method_ids_count = header.method_ids_size_;
+    runtime.proto_ids_count = header.proto_ids_size_;
+    runtime.class_defs_count = header.class_defs_size_;
+  }
+  const uintptr_t logical_begin = runtime.data_begin;
+  const size_t logical_size = runtime.data_size;
+  const auto pointer_in_logical_image = [&](uintptr_t pointer, uint32_t count, size_t item_size) {
+    if (logical_begin == 0u || logical_size == 0u || pointer < logical_begin ||
+        pointer - logical_begin > logical_size) {
+      return false;
+    }
+    const uint64_t relative = static_cast<uint64_t>(pointer - logical_begin);
+    return static_cast<uint64_t>(count) * item_size <= logical_size - relative;
+  };
+  if (pointer_in_logical_image(runtime.string_ids, runtime.string_ids_count, 4u) &&
+      pointer_in_logical_image(runtime.type_ids, runtime.type_ids_count, 4u) &&
+      pointer_in_logical_image(runtime.proto_ids, runtime.proto_ids_count, 12u) &&
+      pointer_in_logical_image(runtime.field_ids, runtime.field_ids_count, 8u) &&
+      pointer_in_logical_image(runtime.method_ids, runtime.method_ids_count, 8u) &&
+      pointer_in_logical_image(runtime.class_defs, runtime.class_defs_count, 32u)) {
+    char value[32];
+    const auto hex = [&](uintptr_t address) {
+      std::snprintf(value, sizeof(value), "0x%llx",
+                    static_cast<unsigned long long>(address));
+      return std::string(value);
+    };
+    metadata.runtime_view_json = "{\"data_begin\":\"" + hex(logical_begin) +
+        "\",\"string_ids\":\"" + hex(runtime.string_ids) +
+        "\",\"type_ids\":\"" + hex(runtime.type_ids) +
+        "\",\"proto_ids\":\"" + hex(runtime.proto_ids) +
+        "\",\"field_ids\":\"" + hex(runtime.field_ids) +
+        "\",\"method_ids\":\"" + hex(runtime.method_ids) +
+        "\",\"class_defs\":\"" + hex(runtime.class_defs) + "\"";
+    metadata.runtime_view_json += ",\"header_source\":\"current\"";
+    const bool have_runtime_counts = runtime.string_ids_count != 0u || runtime.type_ids_count != 0u ||
+                                     runtime.proto_ids_count != 0u || runtime.field_ids_count != 0u ||
+                                     runtime.method_ids_count != 0u || runtime.class_defs_count != 0u;
+    if (have_runtime_counts) {
+      metadata.runtime_view_json += ",\"section_counts_current\":{\"string_ids\":" +
+          std::to_string(runtime.string_ids_count) + ",\"type_ids\":" +
+          std::to_string(runtime.type_ids_count) + ",\"proto_ids\":" +
+          std::to_string(runtime.proto_ids_count) + ",\"field_ids\":" +
+          std::to_string(runtime.field_ids_count) + ",\"method_ids\":" +
+          std::to_string(runtime.method_ids_count) + ",\"class_defs\":" +
+          std::to_string(runtime.class_defs_count) + "}";
+    }
+    metadata.runtime_view_json += "}";
+  }
+  r0dump_SetLocationMetadata(dex.GetLocation(), &metadata);
+  return metadata;
+}
