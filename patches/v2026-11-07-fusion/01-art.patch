+NO_INLINE r0dump_SubmitResult r0dump_SubmitDexReference(
+    r0dump_CaptureProcessState* state,
+    const r0dump_HookContext& context,
+    const DexFile& dex,
+    std::unique_ptr<r0dump_RecordMetadata> metadata) {
+  const std::shared_ptr<DexFileContainer>& container = dex.GetContainer();
+  const r0dump_DexFormat format =
+      r0dump_ValidateDexImage(dex.Begin(), dex.Size()).value_or(r0dump_DexFormat::kNotApplicable);
+  if (dex.Size() > state->max_dex_bytes || dex.Size() > kR0dumpMaxDexBytesHardLimit ||
+      container == nullptr || format == r0dump_DexFormat::kNotApplicable ||
+      !r0dump_IsBoundedSpan(
+          dex.Begin(), dex.Size(), container->Begin(), container->End() - container->Begin())) {
+    return state->staging->r0dump_TrySubmitMetadata(context, std::move(*metadata));
+  }
+  return state->staging->r0dump_TryReferenceDexOrMetadata(r0dump_CaptureKind::kDexView,
+                                                           format,
+                                                           dex.Begin(),
+                                                           dex.Size(),
+                                                           r0dump_HashBytes(dex.Begin(), dex.Size()),
+                                                           context,
+                                                           std::move(*metadata));
+}
+
+bool r0dump_ObserveDexReference(r0dump_Point point,
+                                std::string_view site,
+                                const DexFile& dex,
+                                const r0dump_SourceInfo& source,
+                                std::string_view class_name) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return false;
+  }
+  r0dump_CaptureProcessState* state =
+      g_r0dump_capture_process_state.load(std::memory_order_acquire);
+  DCHECK(state != nullptr);
+  r0dump_CountPointObservation(state, point);
+  const uint64_t dex_identity = r0dump_DexIdentity(dex);
+  if (!r0dump_TryClaimRouteObservation(state, point, dex_identity)) {
+    return false;
+  }
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    r0dump_ReleaseRouteObservation(state, point, dex_identity);
+    return false;
+  }
+
+  const r0dump_HookContext context = r0dump_MakeHookContext(point, site);
+  auto metadata = std::make_unique<r0dump_RecordMetadata>(r0dump_DexMetadata(dex));
+  r0dump_SetSourceMetadata(source, metadata.get());
+  metadata->class_name = class_name;
+  r0dump_SubmitResult submit =
+      r0dump_SubmitDexReference(state, context, dex, std::move(metadata));
+  if (submit.status == r0dump_SubmitStatus::kLockBusy ||
+      submit.status == r0dump_SubmitStatus::kInvalid) {
+    r0dump_ReleaseRouteObservation(state, point, dex_identity);
+  }
+  return submit.status == r0dump_SubmitStatus::kAccepted ||
+         submit.status == r0dump_SubmitStatus::kDuplicate;
+}
