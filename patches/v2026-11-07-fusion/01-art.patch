@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Source contract for the opt-in Nterp method-entry observation point."""
+
+from pathlib import Path
+
+
+ART = Path(__file__).resolve().parents[2]
+
+
+def read(relative: str) -> str:
+    return (ART / relative).read_text(encoding="utf-8")
+
+
+def test_point_42_is_defined_but_not_enabled_by_default() -> None:
+    header = read("runtime/r0dump/r0dump_hook_point.h")
+    config = read("runtime/r0dump/r0dump_config.h")
+    assert "kNterpMethodEntry = 42" in header
+    assert "kR0dumpPointCount = 43" in header
+    assert "kNterpMethodEntry" not in config
+
+
+def test_nterp_helper_uses_existing_capture_facade_only() -> None:
+    source = read("runtime/interpreter/mterp/nterp.cc")
+    start = source.index('extern "C" void NterpR0dumpMethodEntry')
+    body = source[start:source.index("\n}\n", start) + 3]
+    assert "r0dump_ObserveMethodCodeItem(" in body
+    assert "kNterpMethodEntry" in body
+    assert "kNterpEntry" in body
+    for forbidden in ("open(", "fopen(", "std::thread", "dladdr(", '"/proc'):
+        assert forbidden not in body
+
+
+def test_every_supported_abi_has_fast_gate_and_trampoline() -> None:
+    for relative in (
+        "runtime/interpreter/mterp/armng/main.S",
+        "runtime/interpreter/mterp/arm64ng/main.S",
+        "runtime/interpreter/mterp/x86ng/main.S",
+        "runtime/interpreter/mterp/x86_64ng/main.S",
+        "runtime/interpreter/mterp/riscv64/main.S",
+    ):
+        source = read(relative)
+        macro = source[source.index(".macro START_EXECUTING_INSTRUCTIONS"):]
+        macro = macro[:macro.index(".endm")]
+        assert "g_r0dump_nterp_method_entry_enabled" in macro, relative
+        assert "nterp_r0dump_method_entry" in macro, relative
+        assert "NTERP_TRAMPOLINE nterp_r0dump_method_entry, NterpR0dumpMethodEntry" in source
+
+
+def test_fast_gate_tracks_capture_lifecycle() -> None:
+    source = read("runtime/r0dump/r0dump_capture.cc")
+    assert 'extern "C" std::atomic<uint32_t> g_r0dump_nterp_method_entry_enabled' in source
+    assert "r0dump_SetActiveCapturePointMask(active_mask)" in source
+    assert source.count("r0dump_SetActiveCapturePointMask(0u)") >= 2
+
+
+# Per-ABI "branch when the gate is disabled" mnemonic.  When the flag is zero this branch must
+# skip straight to the local `8:` label, so the disabled interpreter path never reaches the
+# r0dump call and executes the original method-entry body byte-for-byte.
+_DISABLED_BRANCH = {
+    "armng": "beq 8f",
+    "arm64ng": "cbz w1, 8f",
+    "x86ng": "je 8f",
+    "x86_64ng": "je 8f",
+    "riscv64": "beqz t0, 8f",
+}
+
+
+def test_disabled_gate_branches_over_hook_without_touching_original_body() -> None:
+    for abi, branch in _DISABLED_BRANCH.items():
+        relative = f"runtime/interpreter/mterp/{abi}/main.S"
+        source = read(relative)
+        macro = source[source.index(".macro START_EXECUTING_INSTRUCTIONS"):]
+        macro = macro[: macro.index(".endm")]
+        gate = macro.index("g_r0dump_nterp_method_entry_enabled")
+        branch_at = macro.index(branch, gate)
+        call_at = macro.index("nterp_r0dump_method_entry", branch_at)
+        label_at = macro.index("\n8:", branch_at)
+        # Order must be: read flag -> branch-if-disabled -> hook call -> skip label, so a cleared
+        # flag lands control exactly on the label with the hook call jumped over.
+        assert gate < branch_at < call_at < label_at, relative
+        # Everything after the skip label is the unmodified ART method-entry body, and the hook
+        # must not appear again on the disabled fall-through path.
+        body_after_label = macro[label_at:]
+        assert "ART_METHOD_HOTNESS_COUNT_OFFSET" in body_after_label, relative
+        assert "nterp_r0dump_method_entry" not in body_after_label, relative
+
