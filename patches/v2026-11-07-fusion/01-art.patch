+// Writes a canonical file through a unique same-directory temporary file, then fsyncs the file,
+// renames it, and fsyncs the directory. Segments are written in order without coalescing.
+r0dump_FileResult r0dump_WriteAtomicFileSegments(int run_fd,
+                                                 std::string_view file_name,
+                                                 const r0dump_FileSegment* segments,
+                                                 size_t segment_count);
