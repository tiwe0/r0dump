+r0dump_JitCompileAttempt::r0dump_JitCompileAttempt(ArtMethod* method) : method_(method) {
+  const bool observe_begin = r0dump_IsCapturePointActiveFast(r0dump_Point::kJitCompileBegin);
+  const bool observe_end = r0dump_IsCapturePointActiveFast(r0dump_Point::kJitCompileEnd);
+  if (!observe_begin && !observe_end) {
+    return;
+  }
+  attempt_id_ = g_r0dump_jit_compile_attempt_id.fetch_add(1u, std::memory_order_relaxed) + 1u;
+  if (observe_begin) {
+    r0dump_RecordMetadata metadata;
+    metadata.source_kind = "jit_compile";
+    metadata.active_attempt_id = attempt_id_;
+    metadata.materialize_status = "attempt_started";
+    r0dump_ObserveMethodCodeItemOrMetadata(r0dump_Point::kJitCompileBegin,
+                                           "Jit.compile.begin",
+                                           method_,
+                                           r0dump_CodeItemRole::kJitCompile,
+                                           attempt_id_,
+                                           "jit_compile",
+                                           std::move(metadata));
+  }
+}
+
+bool r0dump_JitCompileAttempt::r0dump_Return(bool result) {
+  if (r0dump_IsCapturePointActiveFast(r0dump_Point::kJitCompileEnd)) {
+    r0dump_RecordMetadata metadata;
+    metadata.source_kind = "jit_compile";
+    metadata.active_attempt_id = attempt_id_;
+    metadata.materialize_status = result ? "compiled" : "not_compiled";
+    r0dump_ObserveMethodMetadata(
+        r0dump_Point::kJitCompileEnd, "Jit.compile.end", method_, std::move(metadata));
+  }
+  return result;
+}
