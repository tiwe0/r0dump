+void r0dump_ObserveMethodMetadata(r0dump_Point point,
+                                  std::string_view site,
+                                  ArtMethod* method,
+                                  r0dump_RecordMetadata metadata)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (!r0dump_IsCapturePointActive(point) || method == nullptr || method->IsRuntimeMethod()) {
+    return;
+  }
+  r0dump_CaptureProcessState* state =
+      g_r0dump_capture_process_state.load(std::memory_order_acquire);
+  DCHECK(state != nullptr);
+  r0dump_CountPointObservation(state, point);
+  r0dump_SetMethodMetadata(method, &metadata);
