+bool r0dump_RefreshSessionLocked(const r0dump_ProcessConfig& config) {
+  Runtime* runtime = Runtime::Current();
+  const std::string fingerprint = runtime == nullptr ? std::string() : runtime->GetFingerprint();
+  const std::string apex_versions = runtime == nullptr ? std::string() : runtime->GetApexVersions();
+  const r0dump_FileResult written = r0dump_WriteSessionFile(g_r0dump_run_fd,
+                                                            config,
+                                                            static_cast<uint32_t>(getpid()),
+                                                            static_cast<uint32_t>(geteuid()),
+                                                            g_r0dump_start_monotonic_ns,
+                                                            fingerprint,
+                                                            apex_versions,
+                                                            g_r0dump_manifest_status,
+                                                            g_r0dump_bootstrap_inventory_status);
+  return written.ok;
+}
