+              r0dump_SubmitStatus::kAccepted);
+    auto result = staging.r0dump_TryFreeze();
+    ASSERT_EQ(result.status, r0dump_FreezeStatus::kFrozen);
+    ids.push_back(result.generation->generation_id);
+    generations.push_back(std::move(result.generation));
+  }
+  ASSERT_EQ(staging
+                .r0dump_SubmitDex(r0dump_CaptureKind::kDexView,
+                                  r0dump_DexFormat::kStandard,
+                                  r0dump_Capture(pool.get(), 9),
+                                  r0dump_Context(r0dump_Point::kCookieResultDex, "blocked", 9u))
