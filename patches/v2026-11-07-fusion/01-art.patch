+TEST(r0dump_BufferTest, DuplicateMergesObservationWhileCollisionAndFormatStayDistinct) {
+  auto pool = std::make_shared<r0dump_BufferPool>(kR0dumpChunkBytes * 4, r0dump_ConstantHash);
+  r0dump_Staging staging(pool, 512, 64, 64, kR0dumpMaxTotalBytesHardLimit);
+  auto first = r0dump_Capture(pool.get(), 1, 2);
+  auto duplicate = r0dump_Capture(pool.get(), 1, 2);
+  auto second = r0dump_Capture(pool.get(), 2, 2);
+  ASSERT_EQ(staging
+                .r0dump_SubmitDex(r0dump_CaptureKind::kDexView,
+                                  r0dump_DexFormat::kStandard,
+                                  std::move(first),
+                                  r0dump_Context(r0dump_Point::kCookieResultDex, "first", 1u))
+                .status,
+            r0dump_SubmitStatus::kAccepted);
+  ASSERT_EQ(staging
+                .r0dump_SubmitDex(r0dump_CaptureKind::kDexView,
+                                  r0dump_DexFormat::kStandard,
+                                  std::move(duplicate),
+                                  r0dump_Context(r0dump_Point::kInMemoryDexParsed, "duplicate", 9u))
+                .status,
+            r0dump_SubmitStatus::kDuplicate);
+  ASSERT_EQ(
+      staging
+          .r0dump_SubmitDex(r0dump_CaptureKind::kDexView,
+                            r0dump_DexFormat::kStandard,
+                            std::move(second),
+                            r0dump_Context(r0dump_Point::kInMemoryBufferCopied, "collision", 2u))
+          .status,
+      r0dump_SubmitStatus::kAccepted);
+  ASSERT_EQ(staging
+                .r0dump_SubmitDex(r0dump_CaptureKind::kBuffer,
+                                  r0dump_DexFormat::kStandard,
+                                  r0dump_Capture(pool.get(), 1, 2),
+                                  r0dump_Context(r0dump_Point::kOpenCommonReturn, "format", 3u))
+                .status,
+            r0dump_SubmitStatus::kAccepted);
+  EXPECT_EQ(staging.r0dump_DexCount(), 3u);
+
+  r0dump_FreezeResult frozen = staging.r0dump_TryFreeze();
+  ASSERT_EQ(frozen.status, r0dump_FreezeStatus::kFrozen);
+  const r0dump_DexBlobKey duplicate_key = {
+      .capture_kind = r0dump_CaptureKind::kDexView,
+      .dex_format = r0dump_DexFormat::kStandard,
+      .size = 2u,
+      .hash = 7u,
+  };
+  const auto bucket = frozen.generation->dex->find(duplicate_key);
+  ASSERT_NE(bucket, frozen.generation->dex->end());
+  ASSERT_EQ(bucket->second.size(), 2u);
+  EXPECT_EQ(bucket->second.front().observation.first_sequence, 1u);
+  EXPECT_EQ(bucket->second.front().observation.last_sequence, 2u);
+  EXPECT_EQ(bucket->second.front().observation.point_mask, 5u);
+  ASSERT_EQ(frozen.generation->records->size(), 4u);
+  EXPECT_EQ(frozen.generation->records->at(1u).status, r0dump_RecordStatus::kDuplicate);
+  EXPECT_EQ(frozen.generation->records->at(1u).duplicate_of, 1u);
+  EXPECT_EQ(frozen.generation->records->at(1u).site, "duplicate");
+  EXPECT_TRUE(staging.r0dump_ReleaseFrozen(frozen.generation->generation_id));
+}
