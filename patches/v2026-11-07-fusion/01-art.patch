+  const uint8_t* anchor = dex->Begin() + dex->Size() / 2u;
+  const std::vector<r0dump_NearbyDexCandidate> candidates = r0dump_FindNearbyDexCandidates(
+      anchor, dex->Size(), dex->Size(), dex->Size());
+  ASSERT_FALSE(candidates.empty());
+  EXPECT_EQ(candidates.front().begin, dex->Begin());
+  EXPECT_EQ(candidates.front().size, dex->Size());
+  EXPECT_EQ(candidates.front().distance, dex->Size() / 2u);
+}
