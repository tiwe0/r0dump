+#ifndef ART_RUNTIME_R0DUMP_R0DUMP_CONFIG_H_
+#define ART_RUNTIME_R0DUMP_R0DUMP_CONFIG_H_
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+#include "base/macros.h"
+
+namespace art HIDDEN {
+
+inline constexpr uint32_t kR0dumpConfigSchema = 1u;
+inline constexpr size_t kR0dumpPropertyValueBytesHardLimit = 91u;
+inline constexpr uint32_t kR0dumpMaxRecordsHardLimit = 4096u;
+inline constexpr uint32_t kR0dumpMaxArtifactsHardLimit = 512u;
+inline constexpr uint64_t kR0dumpMaxTotalBytesHardLimit = 1024u * 1024u * 1024u;
+inline constexpr uint64_t kR0dumpMaxDexBytesHardLimit = 256u * 1024u * 1024u;
+inline constexpr uint64_t kR0dumpDefaultBufferPoolBytes = 64u * 1024u * 1024u;
+inline constexpr uint64_t kR0dumpBufferPoolBytesHardLimit = 512u * 1024u * 1024u;
+inline constexpr uint64_t kR0dumpMaxCodeItemBytesHardLimit = 4u * 1024u * 1024u;
+inline constexpr uint32_t kR0dumpMaxFrozenGenerationsHardLimit = 4u;
+inline constexpr uint32_t kR0dumpFlushIdleMsHardLimit = 60000u;
+inline constexpr uint32_t kR0dumpDefaultFlushIdleMs = 500u;
+inline constexpr uint64_t kR0dumpDefaultFlushIdleNs =
+    static_cast<uint64_t>(kR0dumpDefaultFlushIdleMs) * 1000u * 1000u;
+inline constexpr uint32_t kR0dumpManifestComponentsHardLimit = 16384u;
+inline constexpr uint32_t kR0dumpManifestSplitsHardLimit = 32u;
+inline constexpr uint32_t kR0dumpManifestEventsPerSourceHardLimit = 262144u;
+inline constexpr uint32_t kR0dumpManifestTotalEventsHardLimit = 1048576u;
+inline constexpr uint32_t kR0dumpManifestXmlDepthHardLimit = 256u;
+inline constexpr uint32_t kR0dumpManifestAttributeLengthHardLimit = 4096u;
+inline constexpr uint32_t kR0dumpWalkClassesHardLimit = 1000000u;
+inline constexpr uint32_t kR0dumpWalkMethodsHardLimit = 10000000u;
+// Force-invoke is opt-in and defaults to a single call; the cap is the global
+// attempt budget for a whole walk, so it tracks the method budget rather than a
+// tiny fixed ceiling that would make it the binding limit for full-package dumps.
+inline constexpr uint32_t kR0dumpForceCallsHardLimit = 10000000u;
+enum class r0dump_WalkStart : uint8_t {
+  kAfterApplicationOnCreate,
+  kAfterFirstActivityOnCreate,
+};
+
+enum class r0dump_WalkMode : uint8_t {
+  kLoadedOnly,
+  kDexNames,
+};
+
+enum class r0dump_ConfigErrorCode : uint8_t {
+  kNone,
+  kAlreadyConfigured,
+  kUnsupportedSchema,
+  kInvalidRunId,
+  kInvalidTargetPackage,
+  kInvalidTargetProcess,
+  kInvalidCurrentProcess,
+  kInvalidOutputParent,
+  kInvalidCapturePointMask,
+  kInvalidBudget,
+  kInvalidBufferLimit,
+  kInvalidManifestLimit,
+  kInvalidWalkSelector,
+  kInvalidWalkLimit,
+  kInvalidForceSelector,
+};
+
+struct r0dump_ConfigError {
+  r0dump_ConfigErrorCode code = r0dump_ConfigErrorCode::kNone;
+  const char* field = nullptr;
+};
+
+struct r0dump_ProcessConfig {
+  uint32_t schema = kR0dumpConfigSchema;
+  bool enabled = false;
+  std::string run_id;
+  std::string target_package;
+  std::string target_process;
+  std::string process_name;
+  std::string output_parent;
+  int prepared_run_fd = -1;
+  uint64_t capture_point_mask = 0u;
+
+  uint32_t max_records = 512u;
+  uint32_t max_artifacts = 128u;
+  uint64_t max_total_bytes = 192u * 1024u * 1024u;
+  uint64_t max_dex_bytes = 32u * 1024u * 1024u;
+  uint64_t buffer_pool_bytes = 64u * 1024u * 1024u;
+  uint64_t max_code_item_bytes = 1024u * 1024u;
+  uint32_t max_frozen_generations = 4u;
+  uint32_t flush_idle_ms = kR0dumpDefaultFlushIdleMs;
+
+  bool manifest_enabled = true;
+  bool manifest_include_splits = true;
+  uint32_t manifest_max_components = 8192u;
+  uint32_t manifest_max_splits = 32u;
+  uint32_t manifest_max_events_per_source = 16384u;
+  uint32_t manifest_max_total_events = 65536u;
+  uint32_t manifest_max_xml_depth = 64u;
+  uint32_t manifest_max_attribute_length = 1024u;
+
+  bool walk_enabled = false;
+  r0dump_WalkStart walk_start = r0dump_WalkStart::kAfterApplicationOnCreate;
+  r0dump_WalkMode walk_mode = r0dump_WalkMode::kLoadedOnly;
+  std::string walk_namespace_prefix;
+  uint32_t walk_delay_ms = 5000u;
+  uint32_t walk_max_classes = 2000u;
+  uint32_t walk_max_methods = 20000u;
+
+  bool force_invoke_enabled = false;
+  std::string force_class;
+  std::string force_method;
+  std::string force_method_descriptor;
+  uint32_t force_max_calls = 1u;
+
+  bool r0dump_MatchesProcess(std::string_view package_name, std::string_view current_process) const;
+};
+
+bool r0dump_ValidateConfig(const r0dump_ProcessConfig& config, r0dump_ConfigError* error);
+
+class r0dump_ConfigStore final {
+ public:
+  r0dump_ConfigStore() = default;
+  ~r0dump_ConfigStore();
+
+  r0dump_ConfigStore(const r0dump_ConfigStore&) = delete;
+  r0dump_ConfigStore& operator=(const r0dump_ConfigStore&) = delete;
+
+  bool r0dump_ConfigureOnce(r0dump_ProcessConfig config, r0dump_ConfigError* error);
+
+  const r0dump_ProcessConfig* r0dump_Get() const {
+    return published_.load(std::memory_order_acquire);
+  }
+
+  bool r0dump_IsEnabledFor(std::string_view package_name, std::string_view process_name) const;
+
+ private:
+  mutable std::mutex lock_;
+  std::unique_ptr<const r0dump_ProcessConfig> owned_;
+  std::atomic<const r0dump_ProcessConfig*> published_{nullptr};
+};
+
+// Process-global immutable snapshot used by capture gates after ActivityThread bind.
+bool r0dump_ConfigureProcessOnce(r0dump_ProcessConfig config, r0dump_ConfigError* error);
+const r0dump_ProcessConfig* r0dump_GetProcessConfig();
+
+}  // namespace art HIDDEN
+
+#endif  // ART_RUNTIME_R0DUMP_R0DUMP_CONFIG_H_
diff --git a/runtime/r0dump/r0dump_config_boundary_source_test.py b/runtime/r0dump/r0dump_config_boundary_source_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..2d99c1f1071d2cf98eaea24673f9129e8f84f2f0
--- /dev/null
+++ b/runtime/r0dump/r0dump_config_boundary_source_test.py
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+
+from pathlib import Path
+
+
+ART = Path(__file__).resolve().parents[2]
+TOP = ART.parent
+FRAMEWORK_APP = TOP / "frameworks/base/core/java/android/app"
+FRAMEWORK_CONFIG = FRAMEWORK_APP / "r0dump_FusionConfig.java"
+LIBCORE_RUNTIME = TOP / "libcore/libart/src/main/java/dalvik/system/r0dump_Runtime.java"
+NATIVE_RUNTIME = ART / "runtime/native/dalvik_system_r0dump_Runtime.cc"
+NATIVE_CONFIG = ART / "runtime/r0dump/r0dump_config.h"
+
+LIMITS = {
+    "max_records": "maxRecords",
+    "max_artifacts": "maxArtifacts",
+    "max_total_bytes": "maxTotalBytes",
+    "max_dex_bytes": "maxDexBytes",
+    "buffer_pool_bytes": "bufferPoolBytes",
+    "max_code_item_bytes": "maxCodeItemBytes",
+    "max_frozen_generations": "maxFrozenGenerations",
+    "flush_idle_ms": "flushIdleMs",
+    "manifest_max_components": "manifestMaxComponents",
+    "manifest_max_splits": "manifestMaxSplits",
+    "manifest_max_events_per_source": "manifestMaxEventsPerSource",
+    "manifest_max_total_events": "manifestMaxTotalEvents",
+    "manifest_max_xml_depth": "manifestMaxXmlDepth",
+    "manifest_max_attribute_length": "manifestMaxAttributeLength",
+    "walk_delay_ms": "walkDelayMs",
+    "walk_max_classes": "walkMaxClasses",
+    "walk_max_methods": "walkMaxMethods",
+    "force_max_calls": "forceMaxCalls",
+}
+
+
+def r0dump_read(path: Path) -> str:
+    return path.read_text(encoding="utf-8")
+
+
+def r0dump_assert_property_boundary() -> None:
+    config = r0dump_read(FRAMEWORK_CONFIG)
+    assert 'PROPERTY_PREFIX = "persist.sys.r0dump.fusion."' in config
+    assert "Settings.Global" not in config
+
+    for source_path in FRAMEWORK_APP.glob("r0dump_*.java"):
+        if source_path == FRAMEWORK_CONFIG:
+            continue
+        source = r0dump_read(source_path)
+        assert "SystemProperties" not in source, source_path
+        assert "persist.sys.r0dump" not in source, source_path
+
+
+def r0dump_assert_limit_forwarding() -> None:
+    framework = r0dump_read(FRAMEWORK_CONFIG)
+    libcore = r0dump_read(LIBCORE_RUNTIME)
+    native = r0dump_read(NATIVE_RUNTIME)
+    snapshot = r0dump_read(NATIVE_CONFIG)
+
+    for snake, camel in LIMITS.items():
+        assert f'"{snake}"' in framework, snake
+        assert f'properties, "{snake}"' in framework, snake
+        assert f"config.{camel}" in framework, camel
+        assert libcore.count(camel) >= 3, camel
+        assert snake in native, snake
+        assert snake in snapshot, snake
+    assert '"walk_namespace_prefix"' in framework
+    assert "walkNamespacePrefix" in framework
+    assert "walk_namespace_prefix" in native
+    assert "walk_namespace_prefix" in snapshot
+
+
+if __name__ == "__main__":
+    r0dump_assert_property_boundary()
+    r0dump_assert_limit_forwarding()
