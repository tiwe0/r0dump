+uint64_t r0dump_DexIdentity(const DexFile& dex_file) {
+  return (static_cast<uint64_t>(dex_file.GetLocationChecksum()) << 32) ^
+         static_cast<uint64_t>(reinterpret_cast<uintptr_t>(&dex_file));
+}
+
+NO_INLINE std::optional<r0dump_DexFormat> r0dump_ValidateDexImage(const uint8_t* begin,
+                                                                   size_t size);
+r0dump_RecordMetadata r0dump_DexMetadata(const DexFile& dex);
+
+// Protected loaders commonly repoint or clear DexFile::Begin()/DataBegin() after
+// methods have been linked.  The CodeItem is still a useful anchor at walk time,
+// so look for a complete standard image in a tightly bounded neighborhood and
+// submit it through the normal buffer/staging path.  This is intentionally
+// limited to the executable class-walk point; it must not add a maps scan to
+// ordinary ART method dispatch or parsing.
+bool r0dump_CaptureNearbyDexCandidate(r0dump_CaptureProcessState* state,
+                                      r0dump_Point point,
+                                      std::string_view site,
+                                      const DexFile& dex_file,
+                                      const dex::CodeItem* code_item)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (state == nullptr || point != r0dump_Point::kWalkExecutableMethod || code_item == nullptr) {
+    return false;
+  }
+  const uint64_t dex_identity = r0dump_DexIdentity(dex_file);
+  // Record the attempt before scanning. Otherwise a protected DexFile with no
+  // valid nearby image would repeat the full scan for every executable method.
+  // Do not hold this lock while reading maps or copying a candidate.
+  {
+    std::lock_guard<std::mutex> identity_guard(state->nearby_snapshot_lock);
+    if (!state->nearby_snapshot_attempted_identities.insert(dex_identity).second) {
+      return false;
+    }
+  }
+  constexpr size_t kBytesBefore = 64u * 1024u * 1024u;
+  constexpr size_t kBytesAfter = 8u * 1024u * 1024u;
+  // Prefer ART's logical data anchor when it is readable.  Protected loaders may relocate the
+  // CodeItem into a detached mapping; scanning from DataBegin preserves the intended DEX image
+  // neighborhood while retaining the CodeItem as a safe fallback for ordinary files.
+  const uint8_t* scan_anchor = reinterpret_cast<const uint8_t*>(code_item);
+  if (dex_file.DataBegin() != nullptr && dex_file.DataSize() != 0u &&
+      r0dump_IsReadableSpan(dex_file.DataBegin(), 1u)) {
+    scan_anchor = dex_file.DataBegin();
+  }
+  const std::vector<r0dump_NearbyDexCandidate> candidates = r0dump_FindNearbyDexCandidates(
+      scan_anchor,
+      kBytesBefore,
+      kBytesAfter,
+      std::min(state->max_dex_bytes, static_cast<size_t>(kR0dumpMaxDexBytesHardLimit)));
+  for (const r0dump_NearbyDexCandidate& candidate : candidates) {
+    const std::optional<r0dump_DexFormat> format =
+        r0dump_ValidateDexImage(candidate.begin, candidate.size);
+    if (!format.has_value() || *format != r0dump_DexFormat::kStandard) {
+      continue;
+    }
+    r0dump_RecordMetadata metadata = r0dump_DexMetadata(dex_file);
+    metadata.capture_role = "nearby_candidate";
+    metadata.source_kind = "code_item_nearby";
+    metadata.declared_size = candidate.size;
+    metadata.data_size = candidate.size;
+    metadata.container_size = candidate.size;
+    metadata.begin = reinterpret_cast<uintptr_t>(candidate.begin);
+    metadata.data_begin = reinterpret_cast<uintptr_t>(candidate.begin);
+    const r0dump_CaptureResult result = r0dump_CaptureBuffer(
+        *state->pool,
+        *state->staging,
+        {candidate.begin, candidate.size, candidate.begin, candidate.size},
+        r0dump_MakeHookContext(point, site),
+        std::move(metadata));
+    if (r0dump_IsCaptureStaged(result)) {
+      return true;
+    }
+  }
+  return false;
+}
