+++ b/runtime/r0dump/r0dump_log_test.cc
@@ -0,0 +1,106 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "r0dump/r0dump_log.h"
+
+#include <atomic>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "gtest/gtest.h"
+
+namespace art HIDDEN {
+namespace {
+
+std::atomic<uint64_t> g_now_ns(0);
+std::vector<std::string>* g_lines = nullptr;
+std::mutex g_lines_lock;
+
+uint64_t r0dump_TestClock() { return g_now_ns.load(); }
+
+void r0dump_Collect(r0dump_LogLevel, std::string_view line) {
+  std::lock_guard<std::mutex> lock(g_lines_lock);
+  g_lines->emplace_back(line);
+}
+
+class r0dump_LogTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    g_now_ns.store(0);
+    g_lines = &lines_;
+    r0dump_SetLogClockForTesting(r0dump_TestClock);
+    r0dump_SetLogSinkForTesting(r0dump_Collect);
+    r0dump_ResetLogStateForTesting();
+  }
+
+  void TearDown() override {
+    r0dump_SetLogSinkForTesting(nullptr);
+    r0dump_SetLogClockForTesting(nullptr);
+    r0dump_ResetLogStateForTesting();
+    g_lines = nullptr;
+  }
+
+  std::vector<std::string> lines_;
+};
+
+TEST_F(r0dump_LogTest, FormatsAndEscapesStructuredFields) {
+  r0dump_Log(r0dump_LogLevel::kInfo,
+             "capture staged",
+             {{"status", "ok"}, {"site", "dex=raw"}, {"path", "a b\\c\n"}});
+
+  ASSERT_EQ(1u, lines_.size());
+  EXPECT_EQ("event=capture\\sstaged status=ok site=dex\\=raw path=a\\sb\\\\c\\n", lines_[0]);
+}
+
+TEST_F(r0dump_LogTest, LimitsEachEventStatusAndSiteAndReportsSuppression) {
+  for (size_t i = 0; i != 12; ++i) {
+    r0dump_Log(r0dump_LogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "42"}});
+  }
+  EXPECT_EQ(10u, lines_.size());
+
+  g_now_ns.store(UINT64_C(1000000000));
+  r0dump_Log(r0dump_LogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "42"}});
+  ASSERT_EQ(12u, lines_.size());
+  EXPECT_EQ("event=hook_seen status=ok site=42 suppressed=2", lines_[10]);
+  EXPECT_EQ("event=hook_seen status=ok site=42", lines_[11]);
+}
+
+TEST_F(r0dump_LogTest, UsesIndependentRateBuckets) {
+  for (size_t i = 0; i != 11; ++i) {
+    r0dump_Log(r0dump_LogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "1"}});
+  }
+  r0dump_Log(r0dump_LogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "2"}});
+  EXPECT_EQ(11u, lines_.size());
+}
+
+TEST_F(r0dump_LogTest, SerializesConcurrentCalls) {
+  constexpr size_t kThreadCount = 4;
+  std::vector<std::thread> threads;
+  for (size_t i = 0; i != kThreadCount; ++i) {
+    threads.emplace_back([]() {
+      r0dump_Log(r0dump_LogLevel::kInfo, "walk_completed", {{"status", "ok"}, {"site", "1"}});
+    });
+  }
+  for (std::thread& thread : threads) {
+    thread.join();
+  }
+  EXPECT_EQ(kThreadCount, lines_.size());
+}
+
+}  // namespace
+}  // namespace art HIDDEN
