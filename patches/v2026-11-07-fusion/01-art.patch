+
+  std::promise<void> lock_acquired;
+  std::promise<void> release_lock;
+  std::future<void> lock_acquired_future = lock_acquired.get_future();
+  std::future<void> release_lock_future = release_lock.get_future();
+  std::thread lock_holder([&]() {
+    std::unique_lock<std::mutex> guard(staging->lock_);
+    lock_acquired.set_value();
+    release_lock_future.wait();
+  });
+  lock_acquired_future.wait();
+  r0dump_RecordMetadata contended_metadata;
+  contended_metadata.source_kind = "instrumentation";
+  EXPECT_EQ(r0dump_TryObserveMetadata(r0dump_Point::kInstrumentationEnter,
