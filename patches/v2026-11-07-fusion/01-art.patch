+TEST(r0dump_CaptureTest, StagedResultRequiresAcceptedOrDuplicateSubmit) {
+  r0dump_CaptureResult result = {
+      .status = r0dump_CaptureStatus::kSubmitted,
+      .submit = {.status = r0dump_SubmitStatus::kAccepted},
+  };
+  EXPECT_TRUE(r0dump_IsCaptureStaged(result));
+  result.submit.status = r0dump_SubmitStatus::kDuplicate;
+  EXPECT_TRUE(r0dump_IsCaptureStaged(result));
+  result.submit.status = r0dump_SubmitStatus::kLockBusy;
+  EXPECT_FALSE(r0dump_IsCaptureStaged(result));
+  result.submit.status = r0dump_SubmitStatus::kRecordLimit;
+  EXPECT_FALSE(r0dump_IsCaptureStaged(result));
+  result.status = r0dump_CaptureStatus::kPoolUnavailable;
+  result.submit.status = r0dump_SubmitStatus::kAccepted;
+  EXPECT_FALSE(r0dump_IsCaptureStaged(result));
+}
