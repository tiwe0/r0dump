+void r0dump_SetMethodMetadata(ArtMethod* method, r0dump_RecordMetadata* metadata)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  const DexFile* dex_file = method->GetDexFile();
+  metadata->dex_object_id = dex_file == nullptr
+                                ? std::optional<uint64_t>()
+                                : std::optional<uint64_t>(r0dump_DexIdentity(*dex_file));
+  metadata->class_def_index = method->IsProxyMethod()
+                                  ? std::optional<uint32_t>()
+                                  : std::optional<uint32_t>(method->GetClassDefIndex());
+  metadata->method_index = method->GetDexMethodIndex();
