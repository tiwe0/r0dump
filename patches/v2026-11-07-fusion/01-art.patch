+static jboolean r0dump_Runtime_r0dump_configureNative(JNIEnv* env,
+                                                      jclass,
+                                                      jint schema,
+                                                      jboolean enabled,
+                                                      jstring java_run_id,
+                                                      jstring java_target_package,
+                                                      jstring java_target_process,
+                                                      jstring java_process_name,
+                                                      jstring java_output_parent,
+                                                      jint prepared_directory_fd,
+                                                      jlong capture_point_mask,
+                                                      jlong max_records,
+                                                      jlong max_artifacts,
+                                                      jlong max_total_bytes,
+                                                      jlong max_dex_bytes,
+                                                      jlong buffer_pool_bytes,
+                                                      jlong max_code_item_bytes,
+                                                      jlong max_frozen_generations,
+                                                      jlong flush_idle_ms,
+                                                      jboolean manifest_enabled,
+                                                      jboolean manifest_include_splits,
+                                                      jlong manifest_max_components,
+                                                      jlong manifest_max_splits,
+                                                      jlong manifest_max_events_per_source,
+                                                      jlong manifest_max_total_events,
+                                                      jlong manifest_max_xml_depth,
+                                                      jlong manifest_max_attribute_length,
+                                                      jboolean walk_enabled,
+                                                      jint walk_start,
+                                                      jint walk_mode,
+                                                      jstring java_walk_namespace_prefix,
+                                                      jlong walk_delay_ms,
+                                                      jlong walk_max_classes,
+                                                      jlong walk_max_methods,
+                                                      jboolean force_invoke_enabled,
+                                                      jstring java_force_class,
+                                                      jstring java_force_method,
+                                                      jstring java_force_method_descriptor,
+                                                      jlong force_max_calls) {
+  if (enabled != JNI_TRUE) {
+    return JNI_FALSE;
+  }
+
+  ScopedUtfChars run_id(env, java_run_id);
+  ScopedUtfChars target_package(env, java_target_package);
+  ScopedUtfChars target_process(env, java_target_process);
+  ScopedUtfChars process_name(env, java_process_name);
+  ScopedUtfChars output_parent(env, java_output_parent);
+  ScopedUtfChars walk_namespace_prefix(env, java_walk_namespace_prefix);
+  ScopedUtfChars force_class(env, java_force_class);
+  ScopedUtfChars force_method(env, java_force_method);
+  ScopedUtfChars force_method_descriptor(env, java_force_method_descriptor);
+  if (run_id.c_str() == nullptr || target_package.c_str() == nullptr ||
+      target_process.c_str() == nullptr || process_name.c_str() == nullptr ||
+      output_parent.c_str() == nullptr || force_class.c_str() == nullptr ||
+      walk_namespace_prefix.c_str() == nullptr || force_method.c_str() == nullptr ||
+      force_method_descriptor.c_str() == nullptr) {
+    r0dump_LogRejected("strings");
+    return JNI_FALSE;
+  }
+
+  r0dump_ProcessConfig config;
+  config.schema = static_cast<uint32_t>(schema);
+  config.enabled = true;
+  config.run_id = run_id.c_str();
+  config.target_package = target_package.c_str();
+  config.target_process = target_process.c_str();
+  config.process_name = process_name.c_str();
+  config.output_parent = output_parent.c_str();
+  config.capture_point_mask = static_cast<uint64_t>(capture_point_mask);
+  config.max_total_bytes = static_cast<uint64_t>(max_total_bytes);
+  config.max_dex_bytes = static_cast<uint64_t>(max_dex_bytes);
+  config.buffer_pool_bytes = static_cast<uint64_t>(buffer_pool_bytes);
+  config.max_code_item_bytes = static_cast<uint64_t>(max_code_item_bytes);
+  config.manifest_enabled = manifest_enabled == JNI_TRUE;
+  config.manifest_include_splits = manifest_include_splits == JNI_TRUE;
+  config.walk_enabled = walk_enabled == JNI_TRUE;
+  config.force_invoke_enabled = force_invoke_enabled == JNI_TRUE;
+  config.force_class = force_class.c_str();
+  config.force_method = force_method.c_str();
+  config.force_method_descriptor = force_method_descriptor.c_str();
+
+  if (!r0dump_ToUint32(max_records, &config.max_records) ||
+      !r0dump_ToUint32(max_artifacts, &config.max_artifacts) ||
+      !r0dump_ToUint32(max_frozen_generations, &config.max_frozen_generations) ||
+      !r0dump_ToUint32(flush_idle_ms, &config.flush_idle_ms) ||
+      !r0dump_ToUint32(manifest_max_components, &config.manifest_max_components) ||
+      !r0dump_ToUint32(manifest_max_splits, &config.manifest_max_splits) ||
+      !r0dump_ToUint32(manifest_max_events_per_source, &config.manifest_max_events_per_source) ||
+      !r0dump_ToUint32(manifest_max_total_events, &config.manifest_max_total_events) ||
+      !r0dump_ToUint32(manifest_max_xml_depth, &config.manifest_max_xml_depth) ||
+      !r0dump_ToUint32(manifest_max_attribute_length, &config.manifest_max_attribute_length) ||
+      !r0dump_ToUint32(walk_delay_ms, &config.walk_delay_ms) ||
+      !r0dump_ToUint32(walk_max_classes, &config.walk_max_classes) ||
+      !r0dump_ToUint32(walk_max_methods, &config.walk_max_methods) ||
+      !r0dump_ToUint32(force_max_calls, &config.force_max_calls)) {
+    r0dump_LogRejected("integer_range");
+    return JNI_FALSE;
+  }
+  if (walk_start < 0 || walk_start > 1 || walk_mode < 0 || walk_mode > 1) {
+    r0dump_LogRejected("walk_selector");
+    return JNI_FALSE;
+  }
+  config.walk_start = static_cast<r0dump_WalkStart>(walk_start);
+  config.walk_mode = static_cast<r0dump_WalkMode>(walk_mode);
+  config.walk_namespace_prefix = walk_namespace_prefix.c_str();
+
+  Runtime* runtime = Runtime::Current();
+  if (runtime == nullptr || runtime->GetProcessPackageName() != config.target_package) {
+    r0dump_LogRejected("process_identity");
+    return JNI_FALSE;
+  }
+
+  if (!r0dump_IsPreparedRunDirectory(prepared_directory_fd)) {
+    r0dump_LogRejected("prepared_directory_fd");
+    return JNI_FALSE;
+  }
+  const int owned_directory_fd = fcntl(prepared_directory_fd, F_DUPFD_CLOEXEC, 0);
+  if (owned_directory_fd < 0) {
+    r0dump_LogRejected("prepared_directory_fd");
+    return JNI_FALSE;
+  }
+  config.prepared_run_fd = owned_directory_fd;
+
+  r0dump_ConfigError error;
+  if (!r0dump_ConfigureCaptureProcessOnce(std::move(config), &error)) {
+    close(owned_directory_fd);
+    r0dump_LogRejected(error.field == nullptr ? "config" : error.field);
+    return JNI_FALSE;
+  }
+  r0dump_ResetWalkCounters();
+  r0dump_InitializeCaptureFlushRun(NanoTime());
+  const r0dump_ProcessConfig* active_config = r0dump_GetProcessConfig();
+  const std::string run_object =
+      active_config == nullptr ? "-" : "run:" + std::string(active_config->run_id);
+  r0dump_Log(r0dump_LogLevel::kInfo,
+             "config_loaded",
+             {{"status", "enabled"},
+              {"site", "AT.bind.configure"},
+              {"object_kind", "run"},
+              {"object", run_object},
+              {"run_id", active_config == nullptr ? std::string_view("-") : active_config->run_id},
+              {"package",
+               active_config == nullptr ? std::string_view("-") : active_config->target_package},
+              {"process",
+               active_config == nullptr ? std::string_view("-") : active_config->process_name}});
+  return JNI_TRUE;
+}
