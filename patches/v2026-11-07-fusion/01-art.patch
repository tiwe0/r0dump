+r0dump_BufferPool::r0dump_BufferPool(size_t capacity_bytes,
+                                     r0dump_HashFunction hash,
+                                     size_t max_code_item_bytes)
+    : state_(std::make_shared<r0dump_BufferState>(r0dump_ClampPoolBytes(capacity_bytes),
+                                                  hash == nullptr ? r0dump_HashSegments : hash)),
+      max_code_item_bytes_(
+          std::min<size_t>(max_code_item_bytes, kR0dumpMaxCodeItemBytesHardLimit)) {}
+
+r0dump_BufferPool::~r0dump_BufferPool() = default;
+
+std::unique_ptr<r0dump_OwnedCapture> r0dump_BufferPool::r0dump_TryAcquire(const uint8_t* data,
+                                                                          size_t size) {
+  std::unique_ptr<r0dump_OwnedCapture> capture(new (std::nothrow) r0dump_OwnedCapture(state_));
+  if (capture == nullptr) {
+    return nullptr;
+  }
+  if (!r0dump_TryCopyIntoChunks(
+          state_, data, size, &capture->chunks_, &capture->chunk_count_, &capture->hash_)) {
+    capture->state_.reset();
+    return nullptr;
+  }
+  capture->size_ = size;
+  return capture;
+}
+
+bool r0dump_BufferPool::r0dump_TryPrepareCodeItem(const uint8_t* data,
+                                                  size_t size,
+                                                  r0dump_PreparedCapture* prepared) {
+  if (prepared == nullptr || prepared->r0dump_IsReady() || size > max_code_item_bytes_) {
+    return false;
+  }
+  size_t chunk_count = 0u;
+  uint64_t hash = 0u;
+  if (!r0dump_TryCopyIntoChunks(state_, data, size, &prepared->chunks_, &chunk_count, &hash)) {
+    return false;
+  }
+  prepared->state_ = state_;
+  prepared->chunk_count_ = chunk_count;
+  prepared->size_ = size;
+  prepared->hash_ = hash;
+  return true;
+}
+
+bool r0dump_BufferPool::r0dump_IsReady() const { return state_->capacity_bytes != 0u; }
+
+size_t r0dump_BufferPool::r0dump_CapacityBytes() const { return state_->capacity_bytes; }
+
+size_t r0dump_BufferPool::r0dump_ReservedBytes() const {
+  return state_->reserved_chunks.load(std::memory_order_acquire) * kR0dumpChunkBytes;
+}
+
+size_t r0dump_BufferPool::r0dump_HighWaterBytes() const {
+  return state_->reserved_chunks_high_water.load(std::memory_order_acquire) * kR0dumpChunkBytes;
+}
+
+void r0dump_ObservationSummary::r0dump_Merge(uint64_t mask, uint64_t sequence) {
+  if (point_mask == 0) {
+    first_sequence = sequence;
+    last_sequence = sequence;
+  } else {
+    first_sequence = std::min(first_sequence, sequence);
+    last_sequence = std::max(last_sequence, sequence);
+  }
+  point_mask |= mask;
+}
+
+bool r0dump_DexBlobKey::operator==(const r0dump_DexBlobKey& other) const {
+  return capture_kind == other.capture_kind && dex_format == other.dex_format &&
+         size == other.size && hash == other.hash;
+}
+
+size_t r0dump_DexBlobKeyHash::operator()(const r0dump_DexBlobKey& key) const {
+  return static_cast<size_t>(key.hash) ^ (key.size << 1) ^
+         (static_cast<size_t>(key.capture_kind) << 17) ^
+         (static_cast<size_t>(key.dex_format) << 21);
+}
+
+bool r0dump_CodeItemKey::operator==(const r0dump_CodeItemKey& other) const {
+  return dex_hash == other.dex_hash && dex_size == other.dex_size &&
+         method_index == other.method_index && code_offset == other.code_offset &&
+         attempt_id == other.attempt_id && role == other.role && code_size == other.code_size &&
+         code_hash == other.code_hash;
+}
+
+size_t r0dump_CodeItemKeyHash::operator()(const r0dump_CodeItemKey& key) const {
+  size_t hash = static_cast<size_t>(key.dex_hash);
+  hash ^= key.dex_size + (hash << 6) + (hash >> 2);
+  hash ^= key.method_index + (hash << 6) + (hash >> 2);
+  hash ^= key.code_offset + (hash << 6) + (hash >> 2);
+  hash ^= key.attempt_id + (hash << 6) + (hash >> 2);
+  hash ^= key.code_size + (hash << 6) + (hash >> 2);
+  hash ^= key.code_hash + (hash << 6) + (hash >> 2);
+  return hash ^ std::hash<std::string>{}(key.role);
+}
