+TEST(r0dump_BufferTest, ExactPoolExhaustionReturnsImmediately) {
+  r0dump_BufferPool pool(kR0dumpChunkBytes * 2u);
+  auto first = r0dump_Capture(&pool, 1u, kR0dumpChunkBytes);
+  auto second = r0dump_Capture(&pool, 2u, kR0dumpChunkBytes);
+  ASSERT_NE(first, nullptr);
+  ASSERT_NE(second, nullptr);
+  EXPECT_EQ(pool.r0dump_ReservedBytes(), kR0dumpChunkBytes * 2u);
+  EXPECT_EQ(r0dump_Capture(&pool, 3u), nullptr);
+}
