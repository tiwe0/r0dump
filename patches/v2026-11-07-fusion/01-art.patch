+      r0dump_ObserveDex(r0dump_Point::kOpenCommonReturn, "OpenCommon.return", *dex).submit.status,
+      r0dump_SubmitStatus::kAccepted);
+  EXPECT_EQ(
+      r0dump_ObserveDex(r0dump_Point::kOpenCommonReturn, "OpenCommon.return", *dex).submit.status,
+      r0dump_SubmitStatus::kDuplicate);
+  r0dump_RecordMetadata metadata;
