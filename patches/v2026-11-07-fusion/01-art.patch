+TEST(r0dump_CaptureTest, CopiesDexViewsAndRejectsOutOfContainerRange) {
+  std::unique_ptr<const DexFile> dex = r0dump_BuildTestDex();
+  auto pool = std::make_shared<r0dump_BufferPool>(4u * kR0dumpChunkBytes);
+  r0dump_Staging staging(pool, 8u, 16u, 8u, 4u * kR0dumpChunkBytes);
+  const r0dump_BorrowedDex borrowed{*dex, nullptr};
+
+  r0dump_CaptureResult view =
+      r0dump_CaptureDex(*pool,
+                        staging,
+                        borrowed,
+                        r0dump_CaptureKind::kDexView,
+                        r0dump_Context(r0dump_Point::kCookieResultDex, "dex", 1u));
+  EXPECT_EQ(view.status, r0dump_CaptureStatus::kSubmitted);
+  EXPECT_EQ(view.submit.status, r0dump_SubmitStatus::kAccepted);
+  const r0dump_BorrowedBuffer raw = {
+      .begin = dex->Begin(),
+      .size = dex->Size(),
+      .container_begin = dex->GetContainer()->Begin(),
+      .container_size =
+          static_cast<size_t>(dex->GetContainer()->End() - dex->GetContainer()->Begin()),
+  };
+  r0dump_CaptureResult buffer = r0dump_CaptureBuffer(
+      *pool, staging, raw, r0dump_Context(r0dump_Point::kInMemoryBufferCopied, "buffer", 2u));
+  EXPECT_EQ(buffer.submit.status, r0dump_SubmitStatus::kAccepted);
+
+  const r0dump_BorrowedBuffer invalid = {
+      .begin = dex->GetContainer()->End() - 1u,
+      .size = 2u,
+      .container_begin = dex->GetContainer()->Begin(),
+      .container_size =
+          static_cast<size_t>(dex->GetContainer()->End() - dex->GetContainer()->Begin()),
+  };
+  EXPECT_EQ(r0dump_CaptureBuffer(*pool,
+                                 staging,
+                                 invalid,
+                                 r0dump_Context(r0dump_Point::kInMemoryBufferCopied, "invalid", 3u))
+                .status,
+            r0dump_CaptureStatus::kInvalidRange);
+  EXPECT_EQ(staging.r0dump_RecordCount(), 3u);
+}
