+TEST(r0dump_BufferTest, ConcurrentAcquireIsNonBlockingAndBounded) {
+  r0dump_BufferPool pool(kR0dumpChunkBytes * 8);
+  std::atomic<bool> start = false;
+  std::array<std::unique_ptr<r0dump_OwnedCapture>, 16> captures;
+  std::array<std::thread, 16> threads;
+  for (size_t index = 0u; index != threads.size(); ++index) {
+    threads[index] = std::thread([&, index]() {
+      while (!start.load(std::memory_order_acquire)) {}
+      captures[index] = r0dump_Capture(&pool, 1, kR0dumpChunkBytes);
+    });
+  }
+  start.store(true, std::memory_order_release);
+  for (auto& thread : threads) {
+    thread.join();
+  }
+  const size_t acquired = std::count_if(
+      captures.begin(), captures.end(), [](const auto& capture) { return capture != nullptr; });
+  EXPECT_GT(acquired, 0u);
+  EXPECT_LE(acquired, 8u);
+  EXPECT_EQ(pool.r0dump_ReservedBytes(), acquired * kR0dumpChunkBytes);
