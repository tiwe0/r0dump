+#!/usr/bin/env python3
+"""Checks the narrow F5 OAT/VDEX/ImageSpace hook contract."""
+
+from pathlib import Path
+
+
+ART = Path(__file__).resolve().parents[2]
+OAT_FILE = (ART / "runtime/oat/oat_file.cc").read_text()
+ASSISTANT = (ART / "runtime/oat/oat_file_assistant.cc").read_text()
+MANAGER = (ART / "runtime/oat/oat_file_manager.cc").read_text()
+CAPTURE = (ART / "runtime/r0dump/r0dump_capture.cc").read_text()
+
+
+def r0dump_body(source: str, start: str, end: str) -> str:
+    start_offset = source.index(start)
+    return source[start_offset : source.index(end, start_offset)]
+
+
+def r0dump_assert_no_io(block: str) -> None:
+    assert all(token not in block for token in ("r0dump_Write", "open(", "write("))
+
+
+open_body = r0dump_body(
+    OAT_FILE,
+    "std::unique_ptr<const DexFile> OatDexFile::OpenDexFile(",
+    "uint32_t OatDexFile::GetOatClassOffset",
+)
+assert open_body.count("kOatDexFileOpenSuccess") == 2
+assert open_body.count('"OatDexFile.open.success"') == 1
+assert open_body.index("dex_file_loader.OpenOne") < open_body.index("r0dump_ObserveDex")
+assert open_body.index("r0dump_ObserveDex") < open_body.index("return dex_file;")
+r0dump_assert_no_io(open_body[open_body.index("if (dex_file != nullptr") :])
+
+vdex_body = r0dump_body(
+    ASSISTANT,
+    "bool OatFileAssistant::LoadDexFiles(",
+    "OatFileAssistant::OatStatus OatFileAssistant::GivenOatFileStatus",
+)
+assert vdex_body.count("kVdexLoadComplete") == 2
+assert vdex_body.count('"Vdex.load.complete"') == 1
+assert vdex_body.index("out_dex_files->push_back") < vdex_body.index("r0dump_ObserveDexSources")
+assert vdex_body.index("r0dump_ObserveDexSources") < vdex_body.index("return true;")
+r0dump_assert_no_io(vdex_body[vdex_body.index("kVdexLoadComplete") :])
+
+sources_body = r0dump_body(
+    CAPTURE,
+    "void r0dump_ObserveDexSources(",
+    "bool r0dump_ObserveDexReference",
+)
+assert "r0dump_IsCapturePointActive(point)" in sources_body
+assert "std::vector<std::unique_ptr<const DexFile>>" in sources_body
+assert "r0dump_ObserveDexSource" in sources_body
+r0dump_assert_no_io(sources_body)
+
+register_body = r0dump_body(
+    MANAGER,
+    "const OatFile* OatFileManager::RegisterOatFile(",
+    "void OatFileManager::UnRegisterAndDeleteOatFile",
+)
+assert register_body.count("kOatManagerRegisterBeforeLock") == 2
+assert register_body.count('"OatManager.register.before_lock"') == 1
+observe_register = register_body.index("r0dump_ObserveOatFileRegistration")
+assert observe_register < register_body.index("WriterMutexLock")
+assert "OpenDexFile" not in register_body[observe_register : register_body.index("WriterMutexLock")]
+r0dump_assert_no_io(register_body[observe_register : register_body.index("WriterMutexLock")])
+
+file_body = r0dump_body(
+    MANAGER,
+    "std::vector<std::unique_ptr<const DexFile>> OatFileManager::OpenDexFilesFromOat(\n"
+    "    const char* dex_location",
+    "static std::vector<const DexFile::Header*> GetDexFileHeaders",
+)
+assert file_body.count("kOatManagerFileComplete") == 2
+assert file_body.count('"OatManager.file.complete"') == 1
+assert file_body.index("RegisterDexFiles") < file_body.index("kOatManagerFileComplete")
+assert file_body.index("kOatManagerFileComplete") < file_body.index("NotifyDexFileLoaded")
+
+assert file_body.count("kImageSpaceDexTracked") == 2
+assert file_body.count('"ImageSpace.dex.tracked"') == 1
+tracked = file_body.index("kImageSpaceDexTracked")
+assert file_body.rindex("dex::tracking::RegisterDexFile", 0, tracked) < tracked
+assert file_body.rindex("AddImageSpaces", 0, tracked) < tracked
+critical_end = file_body.index("}", file_body.index('ScopedSuspendAll ssa("Add image space")'))
+assert critical_end < tracked
+r0dump_assert_no_io(file_body[tracked : file_body.index("} else {", tracked)])
+
+memory_body = r0dump_body(
+    MANAGER,
+    "std::vector<std::unique_ptr<const DexFile>> OatFileManager::OpenDexFilesFromOat(\n"
+    "    std::vector<MemMap>&& dex_mem_maps",
+    "std::vector<std::unique_ptr<const DexFile>> OatFileManager::OpenDexFilesFromOat_Impl",
+)
+assert memory_body.count("kOatManagerMemoryComplete") == 2
+assert memory_body.count('"OatManager.memory.complete"') == 1
+assert memory_body.index("DisableWrite") < memory_body.index("kOatManagerMemoryComplete")
+assert memory_body.index("kOatManagerMemoryComplete") < memory_body.index("return dex_files;")
+r0dump_assert_no_io(memory_body[memory_body.index("kOatManagerMemoryComplete") :])
