+TEST(r0dump_BufferTest, RejectsNullAndZeroAndHandlesChunkBoundaries) {
+  r0dump_BufferPool pool(kR0dumpChunkBytes * 4);
+  EXPECT_EQ(pool.r0dump_TryAcquire(nullptr, 1), nullptr);
+  EXPECT_EQ(pool.r0dump_TryAcquire(reinterpret_cast<const uint8_t*>("x"), 0), nullptr);
+  EXPECT_NE(r0dump_Capture(&pool, 1, 65535), nullptr);
+  EXPECT_NE(r0dump_Capture(&pool, 2, 65536), nullptr);
+  EXPECT_NE(r0dump_Capture(&pool, 3, 65537), nullptr);
+}
