+std::unique_ptr<r0dump_OwnedCapture> r0dump_Capture(r0dump_BufferPool* pool,
+                                                    uint8_t value,
+                                                    size_t size = 1) {
+  std::vector<uint8_t> bytes(size, value);
+  return pool->r0dump_TryAcquire(bytes.data(), bytes.size());
