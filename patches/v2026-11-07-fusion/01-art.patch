+TEST(r0dump_ConfigTest, RejectsUnknownWalkSelectors) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.walk_start = static_cast<r0dump_WalkStart>(2u);
+  r0dump_ConfigError error;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kInvalidWalkSelector);
