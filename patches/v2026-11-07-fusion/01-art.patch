+void r0dump_MarkFlushDegradedLocked() {
+  g_r0dump_flush_degraded = true;
+  const std::string run_object =
+      g_r0dump_log_run_id.empty() ? "run:-" : "run:" + g_r0dump_log_run_id;
+  r0dump_Log(r0dump_LogLevel::kError,
+             "run_degraded",
+             {{"status", "write_failed"},
+              {"site", "file.flush"},
+              {"object_kind", "run"},
+              {"object", run_object},
+              {"run_id", g_r0dump_log_run_id},
+              {"package", g_r0dump_log_package},
+              {"process", g_r0dump_log_process}});
+}
+
+bool r0dump_ServiceFlushLocked(const r0dump_ProcessConfig& config,
+                               r0dump_Staging& staging,
+                               bool force_completion,
+                               bool try_freeze) {
+  if (g_r0dump_flush_degraded ||
+      (g_r0dump_writer_state != nullptr && g_r0dump_writer_state->r0dump_IsDegraded())) {
+    return false;
+  }
+  if (force_completion && staging.r0dump_ShouldFlush(NanoTime(), true)) {
+    g_r0dump_flush_requested.store(true, std::memory_order_release);
+  }
+  if (g_r0dump_pending_generation == nullptr &&
+      !g_r0dump_flush_requested.load(std::memory_order_acquire) &&
+      !staging.r0dump_ShouldFlush(NanoTime(), false)) {
+    return false;
+  }
+  if (g_r0dump_pending_generation == nullptr) {
+    r0dump_FreezeResult frozen = staging.r0dump_TryFreeze(try_freeze);
+    if (frozen.status != r0dump_FreezeStatus::kFrozen) {
+      return false;
+    }
+    g_r0dump_pending_generation = std::move(frozen.generation);
+  }
+  if (!r0dump_EnsureRunOpenLocked(config)) {
+    r0dump_MarkFlushDegradedLocked();
+    return false;
+  }
+  const r0dump_GenerationWriteResult result =
+      r0dump_WriteAndReleaseFrozenGeneration(g_r0dump_run_fd,
+                                             config.run_id,
+                                             static_cast<uint32_t>(getpid()),
+                                             *g_r0dump_pending_generation,
+                                             &staging,
+                                             g_r0dump_writer_state.get());
+  if (!result.ok) {
+    r0dump_MarkFlushDegradedLocked();
+    return false;
+  }
+  g_r0dump_pending_generation.reset();
+  g_r0dump_flush_requested.store(false, std::memory_order_release);
+  return staging.r0dump_ShouldFlush(NanoTime(), false);
+}
+
+}  // namespace
+
+void r0dump_InitializeFlushRun(const r0dump_ProcessConfig& config, uint64_t start_monotonic_ns) {
+  std::lock_guard<std::mutex> flush_lock(g_r0dump_flush_lock);
+  g_r0dump_log_run_id = config.run_id;
+  g_r0dump_log_package = config.target_package;
+  g_r0dump_log_process = config.process_name;
+  if (g_r0dump_start_monotonic_ns == 0u) {
+    g_r0dump_start_monotonic_ns = start_monotonic_ns;
+  }
+  if (g_r0dump_manifest_status.empty()) {
+    g_r0dump_manifest_status = config.manifest_enabled ? "pending" : "disabled";
+  }
+}
+
+bool r0dump_RequestFlush(r0dump_Staging& staging, bool force_completion) {
+  if (!staging.r0dump_ShouldFlush(NanoTime(), force_completion)) {
+    return false;
+  }
+  g_r0dump_flush_requested.store(true, std::memory_order_release);
+  return true;
+}
+
+bool r0dump_ServiceFlush(const r0dump_ProcessConfig& config,
+                         r0dump_Staging& staging,
+                         bool force_completion,
+                         bool try_lock) {
+  std::unique_lock<std::mutex> flush_lock(g_r0dump_flush_lock, std::defer_lock);
+  if (try_lock) {
+    if (!flush_lock.try_lock()) {
+      return false;
+    }
+  } else {
+    flush_lock.lock();
+  }
+
+  return r0dump_ServiceFlushLocked(config, staging, force_completion, try_lock);
+}
+
+bool r0dump_IsFlushDegraded() {
+  std::lock_guard<std::mutex> flush_lock(g_r0dump_flush_lock);
+  return g_r0dump_flush_degraded;
+}
+
+bool r0dump_PublishManifestSnapshot(const r0dump_ProcessConfig& config,
+                                    const r0dump_ManifestSnapshot& snapshot) {
+  std::lock_guard<std::mutex> flush_lock(g_r0dump_flush_lock);
+  if (!config.manifest_enabled || g_r0dump_flush_degraded || !r0dump_EnsureRunOpenLocked(config)) {
+    return false;
+  }
+  const r0dump_FileResult written = r0dump_WriteManifestFile(g_r0dump_run_fd, snapshot);
+  if (!written.ok) {
+    r0dump_MarkFlushDegradedLocked();
+    return false;
+  }
+  g_r0dump_manifest_status = snapshot.status;
+  if (!r0dump_RefreshSessionLocked(config)) {
+    r0dump_MarkFlushDegradedLocked();
+    return false;
+  }
+  return true;
+}
+
+void r0dump_CompleteBootstrapInventory(const r0dump_ProcessConfig& config, bool completed) {
+  std::lock_guard<std::mutex> flush_lock(g_r0dump_flush_lock);
+  if (g_r0dump_flush_degraded) {
+    return;
+  }
+  g_r0dump_bootstrap_inventory_status = completed ? "complete" : "failed";
+  if (!r0dump_EnsureRunOpenLocked(config) || !r0dump_RefreshSessionLocked(config)) {
+    r0dump_MarkFlushDegradedLocked();
+  }
+}
+
+void r0dump_FinalizeFlushRun(const r0dump_ProcessConfig& config,
+                             r0dump_Staging& staging,
+                             const std::array<uint64_t, kR0dumpPointCount>& point_seen,
+                             bool try_lock) {
+  std::unique_lock<std::mutex> flush_lock(g_r0dump_flush_lock, std::defer_lock);
+  if (try_lock) {
+    if (!flush_lock.try_lock()) {
+      return;
+    }
+  } else {
+    flush_lock.lock();
+  }
+  for (size_t attempt = 0u; attempt != kR0dumpMaxFrozenGenerationsHardLimit + 2u; ++attempt) {
+    if (g_r0dump_pending_generation == nullptr && !staging.r0dump_ShouldFlush(NanoTime(), true)) {
+      break;
+    }
+    r0dump_ServiceFlushLocked(
+        config, staging, /* force_completion= */ true, /* try_freeze= */ true);
+  }
+  const bool incomplete = g_r0dump_flush_degraded || g_r0dump_pending_generation != nullptr ||
+                          staging.r0dump_ShouldFlush(NanoTime(), true) ||
+                          g_r0dump_bootstrap_inventory_status == "pending" ||
+                          (config.manifest_enabled && g_r0dump_manifest_status == "pending");
+  r0dump_BufferSummary buffer_summary;
+  const bool summary_available =
+      !incomplete && staging.r0dump_GetSummary(&buffer_summary, try_lock);
+  if (!incomplete && !summary_available) {
+    r0dump_MarkFlushDegradedLocked();
+  } else if (summary_available && r0dump_EnsureRunOpenLocked(config)) {
+    unique_fd methods_directory = r0dump_OpenPreparedDirectory(g_r0dump_run_fd, "methods");
+    const r0dump_FileResult methods_written =
+        methods_directory.get() < 0
+            ? r0dump_Failure("open_methods", errno)
+            : r0dump_WriteAtomicFile(methods_directory.get(),
+                                     "methods.jsonl",
+                                     g_r0dump_writer_state->r0dump_MethodsJsonl().data(),
+                                     g_r0dump_writer_state->r0dump_MethodsJsonl().size());
+    const bool session_written = methods_written.ok && r0dump_RefreshSessionLocked(config);
+    const r0dump_FileResult summary_written = session_written
+                                                  ? r0dump_WriteSummaryFile(g_r0dump_run_fd,
+                                                                            buffer_summary,
+                                                                            point_seen,
+                                                                            *g_r0dump_writer_state,
+                                                                            "runtime_teardown")
+                                                  : r0dump_Failure("finalize_prerequisite", EIO);
+    if (!methods_written.ok || !session_written || !summary_written.ok) {
+      r0dump_MarkFlushDegradedLocked();
+    } else {
+      const std::string run_object = "run:" + config.run_id;
+      r0dump_Log(r0dump_LogLevel::kInfo,
+                 "run_completed",
+                 {{"status", "ok"},
+                  {"site", "runtime.teardown"},
+                  {"object_kind", "run"},
+                  {"object", run_object},
+                  {"run_id", config.run_id},
+                  {"package", config.target_package},
+                  {"process", config.process_name},
+                  {"pid", std::to_string(getpid())}});
+    }
+  }
+  if (g_r0dump_run_fd >= 0) {
+    close(g_r0dump_run_fd);
+    g_r0dump_run_fd = -1;
+  }
+}
+
+void r0dump_SetFileIoForTesting(const r0dump_FileIo* io) {
+  g_r0dump_file_io.store(io == nullptr ? &kR0dumpDefaultFileIo : io, std::memory_order_release);
+}
+
+}  // namespace art HIDDEN
