+
+enum class r0dump_TestFailure {
+  kNone,
+  kWrite,
+  kFsyncFile,
+  kRename,
+  kFsyncDirectory,
+};
+
+struct r0dump_TestIoState {
+  r0dump_TestFailure failure = r0dump_TestFailure::kNone;
+  bool interrupt_first_write = false;
+  bool interrupt_first_fsync = false;
+  size_t max_write = SIZE_MAX;
+  size_t fail_write_call = 0u;
+  size_t write_calls = 0u;
+  size_t fsync_calls = 0u;
+};
+
+r0dump_TestIoState* g_r0dump_test_io_state = nullptr;
+
+ssize_t r0dump_TestWrite(int fd, const void* data, size_t size) {
+  r0dump_TestIoState& state = *g_r0dump_test_io_state;
+  ++state.write_calls;
+  if (state.interrupt_first_write && state.write_calls == 1u) {
+    errno = EINTR;
+    return -1;
+  }
+  if (state.failure == r0dump_TestFailure::kWrite &&
+      (state.fail_write_call == 0u || state.write_calls == state.fail_write_call)) {
+    errno = ENOSPC;
+    return -1;
+  }
+  return write(fd, data, std::min(size, state.max_write));
+}
+
+int r0dump_TestFsync(int fd) {
+  r0dump_TestIoState& state = *g_r0dump_test_io_state;
+  ++state.fsync_calls;
+  if (state.interrupt_first_fsync && state.fsync_calls == 1u) {
+    errno = EINTR;
+    return -1;
+  }
+  struct stat status = {};
+  if (fstat(fd, &status) != 0) {
+    return -1;
+  }
+  if ((state.failure == r0dump_TestFailure::kFsyncFile && S_ISREG(status.st_mode)) ||
+      (state.failure == r0dump_TestFailure::kFsyncDirectory && S_ISDIR(status.st_mode))) {
+    errno = EIO;
+    return -1;
+  }
+  return fsync(fd);
+}
+
+int r0dump_TestRenameAt(int old_dir_fd,
+                        const char* old_name,
+                        int new_dir_fd,
+                        const char* new_name) {
+  if (g_r0dump_test_io_state->failure == r0dump_TestFailure::kRename) {
+    errno = EIO;
+    return -1;
+  }
+  return renameat(old_dir_fd, old_name, new_dir_fd, new_name);
+}
+
+const r0dump_FileIo kR0dumpTestFileIo = {
+    .write_fn = r0dump_TestWrite,
+    .fsync_fn = r0dump_TestFsync,
+    .renameat_fn = r0dump_TestRenameAt,
+};
+
+std::string r0dump_ReadFileAt(int directory_fd, std::string_view name) {
+  const std::string component(name);
+  int fd = openat(directory_fd, component.c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+  if (fd < 0) {
+    return {};
+  }
+  struct stat status = {};
+  if (fstat(fd, &status) != 0 || status.st_size < 0) {
+    close(fd);
+    return {};
+  }
+  std::string contents(static_cast<size_t>(status.st_size), '\0');
+  size_t offset = 0u;
+  while (offset != contents.size()) {
+    const ssize_t count = read(fd, contents.data() + offset, contents.size() - offset);
+    if (count <= 0) {
+      contents.clear();
+      break;
+    }
+    offset += static_cast<size_t>(count);
+  }
+  close(fd);
+  return contents;
+}
+
+int r0dump_OpenDirectoryAt(int parent_fd, std::string_view name) {
+  const std::string component(name);
+  return openat(parent_fd, component.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+}
+
+r0dump_HookContext r0dump_Context(r0dump_Point point,
+                                  std::string_view site,
+                                  uint64_t monotonic_ns) {
+  return {.point = point, .site = site, .tid = 321u, .monotonic_ns = monotonic_ns};
+}
+
+void r0dump_StageDuplicate(r0dump_BufferPool* pool, r0dump_Staging* staging) {
+  const uint8_t bytes[] = {'d', 'e', 'x'};
+  ASSERT_EQ(staging
+                ->r0dump_SubmitDex(r0dump_CaptureKind::kDexView,
+                                   r0dump_DexFormat::kStandard,
+                                   pool->r0dump_TryAcquire(bytes, sizeof(bytes)),
+                                   r0dump_Context(r0dump_Point::kCookieResultDex, "first", 1u))
+                .status,
+            r0dump_SubmitStatus::kAccepted);
+  ASSERT_EQ(staging
+                ->r0dump_SubmitDex(r0dump_CaptureKind::kDexView,
+                                   r0dump_DexFormat::kStandard,
+                                   pool->r0dump_TryAcquire(bytes, sizeof(bytes)),
+                                   r0dump_Context(r0dump_Point::kOpenCommonReturn, "duplicate", 2u))
+                .status,
+            r0dump_SubmitStatus::kDuplicate);
+}
+
+size_t r0dump_CountTemporaryFiles(int directory_fd) {
+  DIR* directory = fdopendir(dup(directory_fd));
+  if (directory == nullptr) {
+    return SIZE_MAX;
+  }
+  size_t count = 0u;
+  while (dirent* entry = readdir(directory)) {
+    if (std::string_view(entry->d_name).starts_with(".r0dump-")) {
+      ++count;
+    }
+  }
+  closedir(directory);
+  return count;
+}
+
+mode_t r0dump_Mode(std::string_view path) {
+  const std::string owned_path(path);
+  struct stat status = {};
+  return stat(owned_path.c_str(), &status) == 0 ? status.st_mode & 0777 : 0u;
+}
+
+class r0dump_FileTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    char path[] = "/tmp/r0dump-file-test-XXXXXX";
+    ASSERT_NE(mkdtemp(path), nullptr);
+    scratch_dir_ = path;
+    output_parent_ = scratch_dir_ + "/files";
+    ASSERT_EQ(mkdir(output_parent_.c_str(), 0700), 0);
+  }
+
+  void TearDown() override {
+    r0dump_SetFileIoForTesting(nullptr);
+    g_r0dump_test_io_state = nullptr;
+    if (!scratch_dir_.empty()) {
+      std::filesystem::remove_all(scratch_dir_);
+    }
+  }
+
