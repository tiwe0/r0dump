+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+}
+
+TEST(r0dump_ConfigTest, PublishesOneImmutableSnapshot) {
+  r0dump_ConfigStore store;
+  r0dump_ConfigError error;
+  EXPECT_TRUE(store.r0dump_ConfigureOnce(r0dump_ValidConfig(), &error));
+  ASSERT_NE(store.r0dump_Get(), nullptr);
+  EXPECT_TRUE(store.r0dump_IsEnabledFor("com.example.target", "com.example.target"));
+  EXPECT_FALSE(store.r0dump_IsEnabledFor("com.example.other", "com.example.other"));
+
+  r0dump_ProcessConfig replacement = r0dump_ValidConfig();
+  replacement.run_id = "replacement";
+  EXPECT_FALSE(store.r0dump_ConfigureOnce(std::move(replacement), &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kAlreadyConfigured);
+  EXPECT_EQ(store.r0dump_Get()->run_id, "20260824T120000Z-a1b2c3d4");
