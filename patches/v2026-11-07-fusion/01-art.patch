+static jboolean r0dump_Runtime_r0dump_CompleteWalk(JNIEnv*, jclass, jboolean bootstrap_completed) {
+  const r0dump_ProcessConfig* config = r0dump_GetProcessConfig();
+  if (config != nullptr &&
+      (config->manifest_enabled || config->walk_enabled || config->force_invoke_enabled)) {
+    r0dump_LogWalkStartedOnce(config);
+    const std::string run_object = "run:" + config->run_id;
+    r0dump_Log(r0dump_LogLevel::kInfo,
+               "walk_completed",
+               {{"status", bootstrap_completed == JNI_TRUE ? "complete" : "failed"},
+                {"site", "Walk.inventory"},
+                {"object_kind", "run"},
+                {"object", run_object},
+                {"run_id", config->run_id},
+                {"package", config->target_package},
+                {"process", config->process_name},
+                {"dex_count", std::to_string(g_r0dump_walk_dex_count.load())},
+                {"dex_cache_count", std::to_string(g_r0dump_walk_dex_cache_count.load())},
+                {"class_candidates", std::to_string(g_r0dump_walk_class_candidates.load())},
+                {"classes_loaded", std::to_string(g_r0dump_walk_classes_loaded.load())},
+                {"class_resolve_failed", std::to_string(g_r0dump_walk_class_resolve_failed.load())},
+                {"method_candidates", std::to_string(g_r0dump_walk_method_candidates.load())},
+                {"code_items_captured", std::to_string(g_r0dump_walk_code_items_captured.load())},
+                {"code_items_rejected", std::to_string(g_r0dump_walk_code_items_rejected.load())}});
+  }
+  r0dump_CompleteCaptureBootstrapInventory(bootstrap_completed == JNI_TRUE);
+  return r0dump_RequestCaptureFlush(true) ? JNI_TRUE : JNI_FALSE;
+}
