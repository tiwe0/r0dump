+        "mInstrumentation.callApplicationOnCreate(app);",
+        "r0dump_ClassLoaderWalk.r0dump_schedule(\n"
+        "                        r0dump_FusionConfig.WALK_START_AFTER_APPLICATION_ON_CREATE);",
+    )
+    r0dump_assert_order(
+        activity_thread,
+        "r.setState(ON_CREATE);",
+        "r0dump_ClassLoaderWalk.r0dump_schedule(\n"
+        "                    r0dump_FusionConfig.WALK_START_AFTER_FIRST_ACTIVITY_ON_CREATE);",
+    )
+    r0dump_assert_order(
+        activity_thread,
+        "r0dump_FusionConfig.r0dump_configureForApp(",
+        "r0dump_ClassLoaderWalk.r0dump_prepare(",
+    )
+
+
+def r0dump_test_libcore_and_art_bridge() -> None:
+    worker = r0dump_read(
+        "frameworks/base/core/java/android/app/r0dump_ClassLoaderWalk.java"
+    )
