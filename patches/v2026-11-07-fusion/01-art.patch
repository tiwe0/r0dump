+r0dump_Staging::r0dump_Staging(std::shared_ptr<r0dump_BufferPool> pool,
+                               size_t max_active_entries,
+                               size_t max_records,
+                               size_t max_artifacts,
+                               size_t max_total_bytes,
+                               size_t max_frozen_generations,
+                               uint64_t flush_idle_ns)
+    : pool_(std::move(pool)),
+      active_dex_(std::make_unique<r0dump_PendingDexMap>()),
+      active_code_items_(std::make_unique<r0dump_PendingCodeItemMap>()),
+      active_records_(std::make_unique<r0dump_PendingRecordList>()),
+      max_active_entries_(std::min<size_t>(max_active_entries, kR0dumpMaxArtifactsHardLimit)),
+      max_records_(std::min<size_t>(max_records, kR0dumpMaxRecordsHardLimit)),
+      max_artifacts_(std::min<size_t>(max_artifacts, kR0dumpMaxArtifactsHardLimit)),
+      max_total_bytes_(std::min<size_t>(max_total_bytes, kR0dumpMaxTotalBytesHardLimit)),
+      max_frozen_generations_(
+          std::min<size_t>(max_frozen_generations, kR0dumpMaxFrozenGenerationsHardLimit)),
+      flush_idle_ns_(flush_idle_ns),
+      flush_watermark_bytes_(std::max<size_t>(
+          1u,
+          std::min(pool_ == nullptr ? max_total_bytes_ : pool_->r0dump_CapacityBytes(),
+                   max_total_bytes_) /
+              2u)) {
+  active_dex_->reserve(max_active_entries_);
+  active_code_items_->reserve(max_active_entries_);
+  active_records_->reserve(max_records_);
+}
