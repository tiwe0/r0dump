+bool r0dump_PublishCaptureManifestSnapshot(r0dump_ManifestCaptureSnapshot&& snapshot) {
+  const r0dump_ProcessConfig* config = r0dump_GetProcessConfig();
+  if (config == nullptr) {
+    return false;
+  }
+  r0dump_ManifestSnapshot file_snapshot = {
+      .status = std::move(snapshot.status),
+      .package_name = std::move(snapshot.package_name),
+      .sources = {},
+      .source_count = snapshot.source_count,
+      .parsed_source_count = snapshot.parsed_source_count,
+      .rejected_source_count = snapshot.rejected_source_count,
+      .xml_event_count = snapshot.xml_event_count,
+      .limit_hit = std::move(snapshot.limit_hit),
+  };
+  file_snapshot.sources.reserve(snapshot.sources.size());
+  for (r0dump_ManifestCaptureSource& source : snapshot.sources) {
+    file_snapshot.sources.push_back({source.ordinal,
+                                     std::move(source.kind),
+                                     std::move(source.status),
+                                     source.event_count,
+                                     std::move(source.limit_hit)});
+  }
+  file_snapshot.seeds.reserve(snapshot.seeds.size());
+  for (r0dump_ManifestCaptureSeed& seed : snapshot.seeds) {
+    file_snapshot.seeds.push_back(
+        {std::move(seed.class_name), std::move(seed.kind), seed.source_ordinal});
+  }
+  const bool published = r0dump_PublishManifestSnapshot(*config, file_snapshot);
+  r0dump_DisableCaptureForDegradedFlush();
+  return published;
+}
