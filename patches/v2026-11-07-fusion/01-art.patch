+  const_cast<uint8_t*>(dex->Begin())[0] = 'X';
+  r0dump_FreezeResult frozen = staging.r0dump_TryFreeze();
+  ASSERT_EQ(frozen.status, r0dump_FreezeStatus::kFrozen);
+  ASSERT_EQ(frozen.generation->dex->size(), 1u);
+  const r0dump_PendingDex& pending = frozen.generation->dex->begin()->second.front();
+  EXPECT_EQ(pending.capture->r0dump_GetSegment(0u).data[0], 'd');
+  const r0dump_Segment segment = pending.capture->r0dump_GetSegment(0u);
+  EXPECT_EQ(frozen.generation->dex->begin()->first.hash, r0dump_HashSegments(&segment, 1u));
