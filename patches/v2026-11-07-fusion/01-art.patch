+#include "r0dump/r0dump_force_invoke.h"
+
+#include <optional>
+#include <string>
+
+#include "art_method-inl.h"
+#include "dex/descriptors_names.h"
+#include "mirror/class-inl.h"
+#include "r0dump/r0dump_capture.h"
+
+namespace art HIDDEN {
+namespace {
+
+struct r0dump_ForceInvokeState final {
+  ArtMethod* expected_method = nullptr;
+  uint64_t attempt_id = 0u;
+  bool handled = false;
+  bool captured = false;
+};
+
+thread_local r0dump_ForceInvokeState g_r0dump_force_invoke_state;
+
+bool r0dump_IsForceInvokeCandidate(ArtMethod* method)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  return method != nullptr && !method->IsRuntimeMethod() && !method->IsProxyMethod() &&
+         !method->IsAbstract() && !method->IsNative() && method->HasCodeItem();
+}
+
+}  // namespace
+
+r0dump_ForceInvokeAttempt::r0dump_ForceInvokeAttempt(ArtMethod* expected_method,
+                                                     uint64_t attempt_id)
+    : expected_method_(expected_method),
+      entered_(expected_method != nullptr &&
+               g_r0dump_force_invoke_state.expected_method == nullptr) {
+  if (entered_) {
+    g_r0dump_force_invoke_state = {
+        .expected_method = expected_method,
+        .attempt_id = attempt_id,
+    };
+  }
+}
+
+r0dump_ForceInvokeAttempt::~r0dump_ForceInvokeAttempt() {
+  if (entered_) {
+    CHECK_EQ(g_r0dump_force_invoke_state.expected_method, expected_method_);
+    g_r0dump_force_invoke_state = {};
+  }
+}
+
+bool r0dump_ForceInvokeAttempt::r0dump_Entered() const { return entered_; }
+
+bool r0dump_ForceInvokeAttempt::r0dump_WasCaptured() const {
+  return entered_ && g_r0dump_force_invoke_state.expected_method == expected_method_ &&
+         g_r0dump_force_invoke_state.handled && g_r0dump_force_invoke_state.captured;
+}
+
+bool r0dump_TryHandleForceInvokeNoExecute(ArtMethod* method) {
+  r0dump_ForceInvokeState& state = g_r0dump_force_invoke_state;
+  const r0dump_ProcessConfig* config = r0dump_GetProcessConfig();
+  if (state.expected_method != method || state.handled || config == nullptr ||
+      !config->force_invoke_enabled ||
+      !r0dump_IsCapturePointActive(r0dump_Point::kForceInvokeNoExecute) ||
+      !r0dump_IsForceInvokeCandidate(method)) {
+    return false;
+  }
+
+  state.handled = true;
+  const DexFile* dex_file = method->GetDexFile();
+  const dex::CodeItem* code_item = method->GetCodeItem();
+  if (dex_file == nullptr || code_item == nullptr ||
+      !method->GetDeclaringClass()->IsInitialized()) {
+    return true;
+  }
+  ObjPtr<mirror::Class> declaring_class = method->GetDeclaringClass();
+  std::string descriptor_storage;
+  const std::string class_name =
+      DescriptorToDot(declaring_class->GetDescriptor(&descriptor_storage));
+  const std::optional<uint32_t> class_def_index =
+      method->IsProxyMethod() ? std::nullopt : std::optional<uint32_t>(method->GetClassDefIndex());
+  r0dump_PreparedCodeItem prepared;
+  if (r0dump_TryPrepareCodeItem(r0dump_Point::kForceInvokeNoExecute,
+                                "ForceInvoke.no_execute",
+                                *dex_file,
+                                code_item,
+                                method->GetDexMethodIndex(),
+                                class_def_index,
+                                r0dump_CodeItemRole::kForceInvoke,
+                                true,
+                                true,
+                                &prepared) != r0dump_CaptureStatus::kSubmitted) {
+    return true;
+  }
+  prepared.attempt_id = state.attempt_id;
+  prepared.class_name = class_name;
+  prepared.method_name = method->GetNameView();
+  prepared.method_descriptor = method->GetSignature().ToString();
+  prepared.source_kind = "force_invoke";
+  r0dump_SetPreparedMethodState(method, "no_execute_capture", &prepared);
+  state.captured = r0dump_IsCaptureStaged(r0dump_SubmitPreparedCodeItem(std::move(prepared)));
+  return true;
+}
+
+}  // namespace art HIDDEN
