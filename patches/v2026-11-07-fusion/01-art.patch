+static void r0dump_Runtime_r0dump_CaptureCookie(JNIEnv* env,
+                                                jclass,
+                                                jobject cookie,
+                                                jint source_id) {
+  if (!r0dump_IsCapturePointActive(r0dump_Point::kWalkCookieDex)) {
+    return;
+  }
+  std::vector<const DexFile*> dex_files;
+  const OatFile* oat_file = nullptr;
+  if (!r0dump_ConvertJavaArrayToDexFiles(env, cookie, dex_files, oat_file)) {
+    return;
+  }
+  const r0dump_SourceInfo source = {
+      .kind = r0dump_SourceKind(source_id),
+      .count = static_cast<uint32_t>(dex_files.size()),
+  };
+  for (size_t i = 0; i < dex_files.size(); ++i) {
+    if (dex_files[i] == nullptr) {
+      continue;
+    }
+    r0dump_SourceInfo current = source;
+    current.ordinal = static_cast<uint32_t>(i);
+    r0dump_ObserveDexSource(
+        r0dump_Point::kWalkCookieDex, "Walk.cookie.dex", *dex_files[i], current);
+  }
+}
