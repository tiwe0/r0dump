+static jobjectArray r0dump_Runtime_r0dump_GetLoadedClassNames(JNIEnv* env,
+                                                              jclass,
+                                                              jobject java_loader) {
+  ScopedObjectAccess soa(env);
+  ObjPtr<mirror::ClassLoader> loader = soa.Decode<mirror::ClassLoader>(java_loader);
+  if (loader == nullptr || loader->GetClassTable() == nullptr) {
+    return r0dump_NewStringArray(env, {});
+  }
+  const r0dump_ProcessConfig* config = r0dump_GetProcessConfig();
+  const uint32_t limit = config == nullptr ? 2000u : config->walk_max_classes;
+  VariableSizedHandleScope classes(soa.Self());
+  auto visitor = [&](ObjPtr<mirror::Class> klass) REQUIRES_SHARED(Locks::mutator_lock_) {
+    if (classes.Size() >= limit) {
+      return false;
+    }
+    if (!klass->IsPrimitive() && klass->GetClassLoader() == loader) {
+      classes.NewHandle(klass);
+    }
+    return true;
+  };
+  loader->GetClassTable()->Visit(visitor);
+
+  std::vector<std::string> names;
+  names.reserve(classes.Size());
+  for (uint32_t i = 0; i < classes.Size(); ++i) {
+    Handle<mirror::Class> klass = classes.GetHandle<mirror::Class>(i);
+    std::string descriptor_storage;
+    names.push_back(DescriptorToDot(klass->GetDescriptor(&descriptor_storage)));
+  }
+  g_r0dump_walk_classes_loaded.fetch_add(names.size(), std::memory_order_relaxed);
+  return r0dump_NewStringArray(env, names);
+}
+
+static jobjectArray r0dump_Runtime_r0dump_GetCookieClassNames(JNIEnv* env, jclass, jobject cookie) {
+  std::vector<const DexFile*> dex_files;
+  const OatFile* oat_file = nullptr;
+  if (!r0dump_ConvertJavaArrayToDexFiles(env, cookie, dex_files, oat_file)) {
+    return r0dump_NewStringArray(env, {});
+  }
+  const r0dump_ProcessConfig* config = r0dump_GetProcessConfig();
+  const size_t limit = config == nullptr ? 2000u : config->walk_max_classes;
+  std::vector<std::string> names;
+  std::unordered_set<std::string> seen;
+  names.reserve(std::min(limit, static_cast<size_t>(256u)));
+  for (const DexFile* dex_file : dex_files) {
+    if (dex_file == nullptr) {
+      continue;
+    }
+    for (uint32_t i = 0; i < dex_file->NumClassDefs() && names.size() < limit; ++i) {
+      const std::string name =
+          DescriptorToDot(dex_file->GetClassDescriptor(dex_file->GetClassDef(i)));
+      if (seen.insert(name).second) {
+        names.push_back(name);
+      }
+    }
+    if (names.size() >= limit) {
+      break;
+    }
+  }
+  g_r0dump_walk_class_candidates.fetch_add(names.size(), std::memory_order_relaxed);
+  g_r0dump_walk_dex_count.fetch_add(dex_files.size(), std::memory_order_relaxed);
+  return r0dump_NewStringArray(env, names);
+}
+
+static jobjectArray r0dump_Runtime_r0dump_GetDexCacheClassNames(JNIEnv* env,
+                                                                 jclass,
+                                                                 jobject java_loader,
+                                                                 jstring java_namespace_prefix) {
+  ScopedObjectAccess soa(env);
+  ObjPtr<mirror::ClassLoader> loader = soa.Decode<mirror::ClassLoader>(java_loader);
+  if (loader == nullptr) {
+    return r0dump_NewStringArray(env, {});
+  }
+  ScopedUtfChars namespace_prefix(env, java_namespace_prefix);
+  if (namespace_prefix.c_str() == nullptr) {
+    return r0dump_NewStringArray(env, {});
+  }
+  const r0dump_ProcessConfig* config = r0dump_GetProcessConfig();
+  const size_t limit = config == nullptr ? 2000u : config->walk_max_classes;
+  std::vector<std::string> names;
+  std::unordered_set<std::string> seen;
+  names.reserve(std::min(limit, static_cast<size_t>(256u)));
+
+  class Visitor final : public DexCacheVisitor {
+   public:
+    Visitor(ObjPtr<mirror::ClassLoader> loader,
+            size_t limit,
+            std::string_view namespace_prefix,
+            std::vector<std::string>* names,
+            std::unordered_set<std::string>* seen)
+        : loader_(loader),
+          limit_(limit),
+          namespace_prefix_(namespace_prefix),
+          names_(names),
+          seen_(seen) {}
+
+    void Visit(ObjPtr<mirror::DexCache> dex_cache)
+        REQUIRES_SHARED(Locks::dex_lock_, Locks::mutator_lock_) override {
+      if (names_->size() >= limit_ || dex_cache == nullptr ||
+          dex_cache->GetClassLoader() != loader_) {
+        return;
+      }
+      const DexFile* dex_file = dex_cache->GetDexFile();
+      if (dex_file == nullptr) {
+        return;
+      }
+      g_r0dump_walk_dex_cache_count.fetch_add(1u, std::memory_order_relaxed);
+      for (uint32_t i = 0; i < dex_file->NumClassDefs() && names_->size() < limit_; ++i) {
+        const std::string name =
+            DescriptorToDot(dex_file->GetClassDescriptor(dex_file->GetClassDef(i)));
+        if (!namespace_prefix_.empty() && name.rfind(namespace_prefix_, 0u) != 0u) {
+          continue;
+        }
+        if (seen_->insert(name).second) {
+          names_->push_back(name);
+        }
+      }
+    }
+
+   private:
+    ObjPtr<mirror::ClassLoader> loader_;
+    size_t limit_;
+    std::string_view namespace_prefix_;
+    std::vector<std::string>* names_;
+    std::unordered_set<std::string>* seen_;
+  } visitor(loader, limit, namespace_prefix.c_str(), &names, &seen);
+
+  ClassLinker* class_linker = Runtime::Current()->GetClassLinker();
+  if (class_linker != nullptr) {
+    ReaderMutexLock mu(soa.Self(), *Locks::dex_lock_);
+    class_linker->VisitDexCaches(&visitor);
+  }
+  g_r0dump_walk_class_candidates.fetch_add(names.size(), std::memory_order_relaxed);
+  return r0dump_NewStringArray(env, names);
+}
