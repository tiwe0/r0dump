@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+
+from pathlib import Path
+
+
+r0dump_art = Path(__file__).resolve().parents[2]
+r0dump_native = (r0dump_art / "runtime/native/dalvik_system_DexFile.cc").read_text()
+r0dump_loader = (r0dump_art / "libdexfile/dex/dex_file_loader.cc").read_text()
+r0dump_capture = (r0dump_art / "runtime/r0dump/r0dump_capture.cc").read_text()
+
+
+def r0dump_method_body(text: str, signature: str) -> str:
+    start = text.index(signature)
+    body_start = text.index("{", start)
+    depth = 0
+    for index in range(body_start, len(text)):
+        if text[index] == "{":
+            depth += 1
+        elif text[index] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[body_start : index + 1]
+    raise AssertionError(f"unterminated method {signature!r}")
+
+r0dump_native_contracts = (
+    (
+        "kCookieResultDex",
+        "if (dex_files.empty())",
+        "ConvertDexFilesToJavaArray(env, oat_file, dex_files)",
+        "r0dump_ObserveDexFiles",
+    ),
+    (
+        "kInMemoryBufferCopied",
+        "env->GetByteArrayRegion(array, start, end - start, destination)",
+        "dex_mem_maps.push_back(std::move(dex_data))",
+        "r0dump_ObserveRawBuffer",
+    ),
+    (
+        "kInMemoryDexParsed",
+        "OpenDexFilesFromOat(std::move(dex_mem_maps)",
+        "return CreateCookieFromOatFileManagerResult",
+        "r0dump_ObserveDexSources",
+    ),
+    (
+        "kDefineClassNativeMatch",
+        "if (dex_class_def != nullptr)",
+        "ScopedObjectAccess soa(env)",
+        "r0dump_ObserveDex",
+    ),
+)
+
+for r0dump_point, r0dump_before, r0dump_after, r0dump_observe in r0dump_native_contracts:
+    r0dump_gate = f"r0dump_IsCapturePointActive(r0dump_Point::{r0dump_point})"
+    r0dump_before_index = r0dump_native.index(r0dump_before)
+    r0dump_observe_index = r0dump_native.index(r0dump_observe, r0dump_before_index)
+    r0dump_after_index = r0dump_native.index(r0dump_after, r0dump_observe_index)
+    r0dump_block = r0dump_native[r0dump_observe_index:r0dump_after_index]
+    assert r0dump_block.count(r0dump_observe) == 1, r0dump_point
+    assert r0dump_native.count(r0dump_gate) == 1, r0dump_point
+    assert all(r0dump_token not in r0dump_block for r0dump_token in ("open(", "write(", "LOG("))
+
+r0dump_loader_gate = "UNLIKELY(r0dump_observer != nullptr)"
+assert r0dump_loader.count(r0dump_loader_gate) == 1
+r0dump_loader_gate_index = r0dump_loader.index(r0dump_loader_gate)
+r0dump_loader_return_index = r0dump_loader.index("return dex_file", r0dump_loader_gate_index)
+r0dump_loader_block = r0dump_loader[r0dump_loader_gate_index:r0dump_loader_return_index]
+assert r0dump_loader_block.count("r0dump_observer(*dex_file)") == 1
+assert all(r0dump_token not in r0dump_loader_block for r0dump_token in ("open(", "write(", "LOG("))
+
+r0dump_vector_facade = r0dump_method_body(r0dump_capture, "void r0dump_ObserveDexFiles(")
+assert "if (!r0dump_IsCapturePointActive(point))" in r0dump_vector_facade
+assert "for (const std::unique_ptr<const DexFile>& dex_file : dex_files)" in r0dump_vector_facade
+assert "if (dex_file != nullptr)" in r0dump_vector_facade
+assert "r0dump_ObserveDex(point, site, *dex_file)" in r0dump_vector_facade
+assert all(
+    r0dump_token not in r0dump_vector_facade
+    for r0dump_token in ("open(", "openat(", "write(", "fsync(", "LOG(")
+)
+
+r0dump_in_memory = r0dump_method_body(
+    r0dump_native, "static jobject DexFile_openInMemoryDexFilesNative("
+)
+assert "std::atomic<uint64_t> g_r0dump_in_memory_attempt_id" in r0dump_native
+assert "fetch_add(1u, std::memory_order_relaxed) + 1u" in r0dump_in_memory
+assert r0dump_in_memory.index("const uint64_t r0dump_attempt_id") < r0dump_in_memory.index(
+    "for (jsize i = 0; i < buffers_length; ++i)"
+)
+assert "static_cast<uint32_t>(i)" in r0dump_in_memory
+assert "static_cast<uint32_t>(buffers_length)" in r0dump_in_memory
+assert '.kind = "in_memory_input"' in r0dump_in_memory
+assert ".active_attempt_id = r0dump_attempt_id" in r0dump_in_memory
+assert '"in_memory_parsed"' in r0dump_in_memory
+assert r0dump_in_memory.count("r0dump_attempt_id") == 3
+
+r0dump_source_metadata = r0dump_method_body(
+    r0dump_capture, "void r0dump_SetSourceMetadata("
+)
+assert "metadata->active_attempt_id = source.active_attempt_id" in r0dump_source_metadata
+
+r0dump_raw_facade = r0dump_method_body(
+    r0dump_capture, "r0dump_CaptureResult r0dump_ObserveRawBuffer("
+)
+assert "const r0dump_SourceInfo& source" in r0dump_capture
+assert "r0dump_SetSourceMetadata(source, metadata.get())" in r0dump_raw_facade
+
+r0dump_source_vector_facade = r0dump_method_body(
+    r0dump_capture, "void r0dump_ObserveDexSources("
+)
+assert "std::optional<uint64_t> active_attempt_id" in r0dump_capture
+assert ".active_attempt_id = active_attempt_id" in r0dump_source_vector_facade
diff --git a/runtime/r0dump/r0dump_f4_class_linker_source_test.py b/runtime/r0dump/r0dump_f4_class_linker_source_test.py
