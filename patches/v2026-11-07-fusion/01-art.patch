+r0dump_CaptureResult r0dump_ObserveRawBuffer(r0dump_Point point,
+                                             std::string_view site,
+                                             const uint8_t* begin,
+                                             size_t size,
+                                             const uint8_t* container_begin,
+                                             size_t container_size,
+                                             const r0dump_SourceInfo& source) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return {.status = r0dump_CaptureStatus::kDisabled};
+  }
+  r0dump_CaptureProcessState* state =
+      g_r0dump_capture_process_state.load(std::memory_order_acquire);
+  DCHECK(state != nullptr);
+  r0dump_CountPointObservation(state, point);
+  const r0dump_HookContext context = r0dump_MakeHookContext(point, site);
+  auto metadata = std::make_unique<r0dump_RecordMetadata>();
+  r0dump_SetSourceMetadata(source, metadata.get());
+  if (size > state->max_dex_bytes) {
+    return {
+        .status = r0dump_CaptureStatus::kInvalidRange,
+        .submit = state->staging->r0dump_RecordDrop(context,
+                                                    r0dump_CaptureKind::kBuffer,
+                                                    r0dump_DexFormat::kNotApplicable,
+                                                    "dex_bytes_limit",
+                                                    std::move(*metadata)),
+    };
+  }
+  return r0dump_CaptureBuffer(*state->pool,
+                              *state->staging,
+                              {begin, size, container_begin, container_size},
+                              context,
+                              std::move(*metadata));
+}
