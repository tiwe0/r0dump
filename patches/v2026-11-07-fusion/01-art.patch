+// Convert ART's diagnostic entry-point labels into the stable on-disk enum.
+// Raw entry addresses are process-local and are never used as identities. Keep the
+// classifier header-local so ART gtests exercise the exact runtime mapping under LTO.
+inline std::string_view r0dump_EntryKindFromInstrumentationString(std::string_view runtime_kind) {
+  if (runtime_kind == "interpreter") {
+    return "quick_to_interpreter_bridge";
+  }
+  if (runtime_kind == "resolution") {
+    return "resolution_stub";
+  }
+  if (runtime_kind == "generic jni") {
+    return "generic_jni_stub";
+  }
+  if (runtime_kind == "jit") {
+    return "jit_code";
+  }
+  if (runtime_kind == "oat") {
+    return "aot_code";
+  }
+  if (runtime_kind == "nterp") {
+    return "nterp";
+  }
+  if (runtime_kind == "nterp with clinit") {
+    return "nterp_with_clinit";
+  }
+  if (runtime_kind == "unknown") {
+    return "unknown";
+  }
+  return "other_quick_code";
+}
