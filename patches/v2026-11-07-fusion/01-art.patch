+r0dump_CaptureResult r0dump_ObserveDex(r0dump_Point point,
+                                       std::string_view site,
+                                       const DexFile& dex,
+                                       r0dump_CaptureKind kind,
+                                       const ArtMethod* method,
+                                       std::optional<uint32_t> class_def_index) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return {.status = r0dump_CaptureStatus::kDisabled};
+  }
+  r0dump_CaptureProcessState* state =
+      g_r0dump_capture_process_state.load(std::memory_order_acquire);
+  DCHECK(state != nullptr);
+  r0dump_CountPointObservation(state, point);
+  const std::optional<r0dump_DexFormat> view_format =
+      r0dump_ValidateDexImage(dex.Begin(), dex.Size());
+  const bool standard_view_valid =
+      view_format.has_value() && *view_format == r0dump_DexFormat::kStandard;
+  const r0dump_HookContext context = r0dump_MakeHookContext(point, site);
+  if (standard_view_valid && r0dump_IsEarlyRecoveryPoint(point)) {
+    return r0dump_CaptureDex(*state->pool,
+                             *state->staging,
+                             {dex, method, class_def_index},
+                             r0dump_CaptureKind::kDexView,
+                             context,
+                             "standard_snapshot");
+  }
+  // A protected or relocated DexFile may no longer expose a valid standard
+  // header, while its logical DataBegin/DataSize range is still live. Capture
+  // that range as dexdata so host rehydration can use a runtime view later.
+  r0dump_CaptureKind capture_kind = kind;
+  if (kind == r0dump_CaptureKind::kDexView &&
+      !r0dump_ValidateDexImage(dex.Begin(), dex.Size()).has_value() &&
+      dex.DataBegin() != nullptr && dex.DataSize() != 0u) {
+    capture_kind = r0dump_CaptureKind::kDexData;
+  }
+  const size_t size = capture_kind == r0dump_CaptureKind::kDexData ? dex.DataSize() : dex.Size();
+  if (size > state->max_dex_bytes) {
+    return {
+        .status = r0dump_CaptureStatus::kInvalidRange,
+        .submit = state->staging->r0dump_RecordDrop(context,
+                                                    capture_kind,
+                                                    r0dump_DexFormat::kNotApplicable,
+                                                    "dex_bytes_limit",
+                                                    r0dump_DexMetadata(dex)),
+    };
+  }
+  return r0dump_CaptureDex(
+      *state->pool, *state->staging, {dex, method, class_def_index}, capture_kind, context);
+}
+
+r0dump_CaptureResult r0dump_ObserveDexSource(r0dump_Point point,
+                                             std::string_view site,
+                                             const DexFile& dex,
+                                             const r0dump_SourceInfo& source) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return {.status = r0dump_CaptureStatus::kDisabled};
+  }
+  r0dump_CaptureProcessState* state =
+      g_r0dump_capture_process_state.load(std::memory_order_acquire);
+  DCHECK(state != nullptr);
+  r0dump_CountPointObservation(state, point);
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return {.status = r0dump_CaptureStatus::kReentrant};
+  }
+  const r0dump_HookContext context = r0dump_MakeHookContext(point, site);
+  r0dump_RecordMetadata metadata = r0dump_DexMetadata(dex);
+  r0dump_SetSourceMetadata(source, &metadata);
+  const std::shared_ptr<DexFileContainer>& container = dex.GetContainer();
+  const std::optional<r0dump_DexFormat> view_format =
+      r0dump_ValidateDexImage(dex.Begin(), dex.Size());
+  const bool view_bounded =
+      container != nullptr && view_format.has_value() &&
+      r0dump_IsBoundedSpan(
+          dex.Begin(), dex.Size(), container->Begin(), container->End() - container->Begin());
+  // A protected/relocated DexFile can retain a useful logical data mapping while its public
+  // header view has been repointed or invalidated.  The class-walk path is the last source
+  // observation before CodeItems are emitted, so keep that mapping instead of dropping the only
+  // DEX identity that can be used for host-side CodeItem backfill.  DataBegin/DataSize are the
+  // same range ART itself uses for section and CodeItem access; the size and header checks below
+  // remain the hard safety boundary before copying it into the pool.
+  const uint8_t* capture_begin = dex.Begin();
+  size_t capture_size = dex.Size();
+  r0dump_CaptureKind capture_kind = r0dump_CaptureKind::kDexView;
+  std::optional<r0dump_DexFormat> format = view_format;
+  std::unique_ptr<uint8_t[]> safe_fallback_copy;
+  bool logical_copy_complete = true;
+  size_t logical_copy_bytes = 0u;
+  if (!view_bounded) {
+    capture_begin = dex.DataBegin();
+    capture_size = dex.DataSize();
+    capture_kind = r0dump_CaptureKind::kDexData;
+  }
+  if (capture_begin == nullptr || capture_size == 0u ||
+      capture_size > state->max_dex_bytes || capture_size > kR0dumpMaxDexBytesHardLimit ||
+      (capture_kind == r0dump_CaptureKind::kDexView &&
+       !r0dump_IsReadableSpan(capture_begin, capture_size)) ||
+      (!format.has_value() && capture_kind == r0dump_CaptureKind::kDexView)) {
+    return r0dump_RecordDexSourceDrop(*state->staging,
+                                      context,
+                                      format.value_or(r0dump_DexFormat::kNotApplicable),
+                                      std::move(metadata));
+  }
+  if (capture_kind == r0dump_CaptureKind::kDexData) {
+    safe_fallback_copy = r0dump_CopyLogicalData(
+        capture_begin, capture_size, &logical_copy_complete, &logical_copy_bytes);
+    if (safe_fallback_copy == nullptr || logical_copy_bytes == 0u) {
+      return r0dump_RecordDexSourceDrop(*state->staging,
+                                        context,
+                                        format.value_or(r0dump_DexFormat::kNotApplicable),
+                                        std::move(metadata));
+    }
+    capture_begin = safe_fallback_copy.get();
+    r0dump_AnnotateLogicalCopy(&metadata, logical_copy_complete, logical_copy_bytes);
+    if (r0dump_IsReadableSpan(capture_begin, sizeof(DexFile::Header))) {
+      format = r0dump_ValidateDexImage(capture_begin, capture_size);
+    }
+  }
+  const uint64_t hash = r0dump_HashBytes(capture_begin, capture_size);
+  std::optional<r0dump_SubmitResult> referenced = state->staging->r0dump_TryReferenceDex(
+      capture_kind,
+      format.value_or(r0dump_DexFormat::kNotApplicable),
+      capture_begin,
+      capture_size,
+      hash,
+      context,
+      metadata);
+  if (referenced.has_value()) {
+    return {.status = r0dump_CaptureStatus::kSubmitted, .submit = *referenced};
+  }
+  return r0dump_CopyAndSubmitDex(*state->pool,
+                                 *state->staging,
+                                 capture_begin,
+                                 capture_size,
+                                 capture_kind,
+                                 format.value_or(r0dump_DexFormat::kNotApplicable),
+                                 context,
+                                 std::move(metadata));
+}
