+bool r0dump_TryClaimObservation(std::mutex* lock,
+                                r0dump_ObservationSlots* observations,
+                                size_t* observation_count,
+                                size_t max_observations,
+                                const r0dump_ObservationKey& key) {
+  std::unique_lock<std::mutex> guard(*lock, std::try_to_lock);
+  if (!guard.owns_lock()) {
+    return false;
+  }
+  const size_t start = r0dump_ObservationKeyHash{}(key) % observations->size();
+  r0dump_ObservationSlot* deleted = nullptr;
+  for (size_t offset = 0u; offset != observations->size(); ++offset) {
+    r0dump_ObservationSlot& slot = (*observations)[(start + offset) % observations->size()];
+    if (slot.state == r0dump_ObservationSlotState::kOccupied && slot.key == key) {
+      return false;
+    }
+    if (slot.state == r0dump_ObservationSlotState::kDeleted && deleted == nullptr) {
+      deleted = &slot;
+      continue;
+    }
+    if (slot.state == r0dump_ObservationSlotState::kEmpty) {
+      r0dump_ObservationSlot* target = deleted == nullptr ? &slot : deleted;
+      if (*observation_count >= max_observations) {
+        return false;
+      }
+      target->key = key;
+      target->state = r0dump_ObservationSlotState::kOccupied;
+      ++*observation_count;
+      return true;
+    }
+  }
+  if (deleted == nullptr || *observation_count >= max_observations) {
+    return false;
+  }
+  deleted->key = key;
+  deleted->state = r0dump_ObservationSlotState::kOccupied;
+  ++*observation_count;
+  return true;
+}
+
+void r0dump_ReleaseObservation(std::mutex* lock,
+                               r0dump_ObservationSlots* observations,
+                               size_t* observation_count,
+                               const r0dump_ObservationKey& key) {
+  std::unique_lock<std::mutex> guard(*lock, std::try_to_lock);
+  if (!guard.owns_lock()) {
+    return;
+  }
+  const size_t start = r0dump_ObservationKeyHash{}(key) % observations->size();
+  for (size_t offset = 0u; offset != observations->size(); ++offset) {
+    r0dump_ObservationSlot& slot = (*observations)[(start + offset) % observations->size()];
+    if (slot.state == r0dump_ObservationSlotState::kEmpty) {
+      return;
+    }
+    if (slot.state == r0dump_ObservationSlotState::kOccupied && slot.key == key) {
+      slot.state = r0dump_ObservationSlotState::kDeleted;
+      --*observation_count;
+      return;
+    }
+  }
+}
