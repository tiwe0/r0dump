+TEST(r0dump_BufferTest, ReferencesExistingDexWithoutAcquiringAnotherPoolLease) {
+  auto pool = std::make_shared<r0dump_BufferPool>(kR0dumpChunkBytes);
+  r0dump_Staging staging(pool, 2u, 4u, 2u, kR0dumpChunkBytes);
+  const uint8_t bytes[] = {'d', 'e', 'x'};
+  const uint64_t hash = r0dump_HashBytes(bytes, sizeof(bytes));
+  ASSERT_EQ(staging
+                .r0dump_SubmitDex(r0dump_CaptureKind::kDexView,
+                                  r0dump_DexFormat::kStandard,
+                                  pool->r0dump_TryAcquire(bytes, sizeof(bytes)),
+                                  r0dump_Context(r0dump_Point::kOpenCommonReturn, "first", 1u))
+                .status,
+            r0dump_SubmitStatus::kAccepted);
+  const size_t reserved = pool->r0dump_ReservedBytes();
+  r0dump_RecordMetadata metadata = {
+      .source_kind = "vdex",
+      .source_ordinal = 0u,
+      .source_count = 1u,
+      .source_in_memory = false,
+  };
+  std::optional<r0dump_SubmitResult> referenced =
+      staging.r0dump_TryReferenceDex(r0dump_CaptureKind::kDexView,
+                                     r0dump_DexFormat::kStandard,
+                                     bytes,
+                                     sizeof(bytes),
+                                     hash,
+                                     r0dump_Context(r0dump_Point::kVdexLoadComplete, "source", 2u),
+                                     std::move(metadata));
+  ASSERT_TRUE(referenced.has_value());
+  EXPECT_EQ(referenced->status, r0dump_SubmitStatus::kDuplicate);
+  EXPECT_EQ(pool->r0dump_ReservedBytes(), reserved);
+  const uint8_t missing[] = {'o', 'a', 't'};
+  EXPECT_FALSE(
+      staging
+          .r0dump_TryReferenceDex(r0dump_CaptureKind::kDexView,
+                                  r0dump_DexFormat::kStandard,
+                                  missing,
+                                  sizeof(missing),
+                                  r0dump_HashBytes(missing, sizeof(missing)),
+                                  r0dump_Context(r0dump_Point::kVdexLoadComplete, "missing", 3u))
+          .has_value());
+  EXPECT_EQ(staging
+                .r0dump_TryReferenceDexOrMetadata(
+                    r0dump_CaptureKind::kDexView,
+                    r0dump_DexFormat::kStandard,
+                    bytes,
+                    sizeof(bytes),
+                    hash,
+                    r0dump_Context(r0dump_Point::kBdclFindClassSuccess, "route-reference", 4u))
+                .status,
+            r0dump_SubmitStatus::kDuplicate);
+  EXPECT_EQ(staging
+                .r0dump_TryReferenceDexOrMetadata(
+                    r0dump_CaptureKind::kDexView,
+                    r0dump_DexFormat::kStandard,
+                    missing,
+                    sizeof(missing),
+                    r0dump_HashBytes(missing, sizeof(missing)),
+                    r0dump_Context(r0dump_Point::kDexFileBeforeDefine, "route-metadata", 5u))
+                .status,
+            r0dump_SubmitStatus::kAccepted);
+  EXPECT_EQ(pool->r0dump_ReservedBytes(), reserved);
+
+  r0dump_FreezeResult frozen = staging.r0dump_TryFreeze();
+  ASSERT_EQ(frozen.status, r0dump_FreezeStatus::kFrozen);
+  ASSERT_EQ(frozen.generation->records->size(), 4u);
+  const r0dump_PendingRecord& source = frozen.generation->records->at(1u);
+  EXPECT_EQ(source.payload_id, frozen.generation->records->front().payload_id);
+  EXPECT_EQ(source.metadata.source_kind, "vdex");
+  EXPECT_EQ(source.metadata.source_ordinal, 0u);
+  EXPECT_EQ(source.metadata.source_count, 1u);
+  EXPECT_EQ(source.metadata.source_in_memory, false);
+  EXPECT_EQ(frozen.generation->records->at(2u).status, r0dump_RecordStatus::kDuplicate);
+  EXPECT_EQ(frozen.generation->records->at(2u).payload_id,
+            frozen.generation->records->front().payload_id);
+  EXPECT_EQ(frozen.generation->records->at(3u).capture_kind, r0dump_CaptureKind::kMetadata);
+  EXPECT_EQ(frozen.generation->records->at(3u).payload_id, 0u);
+}
