+    {r0dump_Point::kReflectCtorBeforeInvoke, "Reflect.ctor.before_invoke"},
+    {r0dump_Point::kInstrumentationEnter, "Instrumentation.enter"},
+    {r0dump_Point::kInstrumentationExitValue, "Instrumentation.exit.value"},
+    {r0dump_Point::kInstrumentationExitObject, "Instrumentation.exit.object"},
+    {r0dump_Point::kBdclPathConstructor, "BDCL.path.constructor"},
+    {r0dump_Point::kBdclMemoryConstructor, "BDCL.memory.constructor"},
+    {r0dump_Point::kBdclFindClassSuccess, "BDCL.findClass.success"},
+    {r0dump_Point::kBdclAddDexPathReturn, "BDCL.addDexPath.return"},
+    {r0dump_Point::kDexFileOpenFileReturn, "DexFile.open_file.return"},
+    {r0dump_Point::kDexFileOpenMemoryReturn, "DexFile.open_memory.return"},
+    {r0dump_Point::kDexFileBeforeDefine, "DexFile.before_define"},
+    {r0dump_Point::kWalkCookieDex, "Walk.cookie.dex"},
+    {r0dump_Point::kWalkExecutableMethod, "Walk.executable.method"},
+    {r0dump_Point::kForceInvokeNoExecute, "ForceInvoke.no_execute"},
+    {r0dump_Point::kNterpMethodEntry, "Nterp.method.entry"},
+}};
+
+static_assert(kR0dumpPointDescriptors.size() == kR0dumpPointCount);
+
+}  // namespace
+
+std::string_view r0dump_PointName(r0dump_Point point) {
+  const uint8_t index = r0dump_PointIndex(point);
+  return index < kR0dumpPointDescriptors.size() ? kR0dumpPointDescriptors[index].name
+                                                : std::string_view();
+}
+
+std::optional<r0dump_Point> r0dump_PointFromName(std::string_view name) {
+  for (const r0dump_PointDescriptor& descriptor : kR0dumpPointDescriptors) {
+    if (descriptor.name == name) {
+      return descriptor.point;
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace art HIDDEN
